*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.bmp   binary
*.tga   binary
*.nif   binary
*.esp   binary
*.esm   binary
*.bsa   binary
*.exe   binary
*.dll   binary
*.lib   binary
*.pdb   binary
*.obj   binary
*.bin   binary
*.zip   binary
*.7z    binary
*.wav   binary
*.mp3   binary
*.ogg   binary
*.fbx   binary
