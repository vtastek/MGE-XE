// mgeHost64 — AT1 sorted-alpha pass (fragment stage).
//
// opaque.frag clone for the scene-1 alpha-BLENDED world shapes (banners, tapestries, foliage,
// window glass): identical Tier 1 (sun+ambient+tonemap+fog) + 2b (material/vColSource routing) +
// 3a (point lights) lighting, but outputs REAL alpha for the SRCALPHA blend pipelines:
//     a = albedo.a * vcolA * matAlpha
// where vcolA = In.Color.a when a VertexColorProperty drives the shape (vColSource != 0) else 1,
// and matAlpha = the captured MaterialProperty alpha, bit-cast through the spare overlay
// instance slot (opaque.vert forwards it as the FLAT uint OverlayIndex; asfloat recovers it).
// The terrain DECAL_1 splat does NOT run here — terrain never rides the alpha list, and the
// overlay slot is repurposed for matAlpha.
//
// PAIRING HAZARD: this frag shares VSOutput with opaque.vert and must ONLY be paired with it
// (see [[project_forge_shared_frag_vsoutput]] — a mismatched vert hangs the GPU).

#include "opaque.srt.h"
#include "texsample.h.fsl"   // sampleBase() — MW address mode + AF level
#include "msmrecv.h.fsl"     // sunShadowVisibility() — MSM sun-shadow receiver
#include "skyamb.h.fsl"      // skyAmbFactor() — SH-L1 sky ambient (SH1) + sky AO (SH2)
#include "skydome.h.fsl"     // applyFog() — extinguish into a silhouette, then melt into the SAMPLED sky

STRUCT(VSOutput)
{
    DATA(float4,      Position, SV_Position);
    DATA(float3,      Normal,   NORMAL);
    DATA(float2,      Uv,       TEXCOORD0);
    DATA(FLAT(uint),  TexIndex, TEXCOORD1);
    DATA(float,       Fog,      TEXCOORD2);
    DATA(float4,      Color,    COLOR);       // per-vertex DiffAmb colour
    DATA(float,       AlphaRef, TEXCOORD3);   // alpha-test ref 0..1 (0 = no test)
    DATA(FLAT(float3),MatDiffuse, TEXCOORD4); // Tier 2b material constants (per draw)
    DATA(FLAT(float3),MatAmbient, TEXCOORD5);
    DATA(FLAT(float3),MatEmissive,TEXCOORD6);
    DATA(FLAT(uint),  VColSource, TEXCOORD7); // 0 none, 1 emissive, 2 diffamb
    DATA(float3,      WorldPos,   TEXCOORD8); // Tier 3a: world position for point-light eval
    DATA(FLAT(uint),  OverlayIndex,TEXCOORD9);// AT1: matAlpha bit-cast (overlay slot reused)
    DATA(FLAT(uint),  ClampMode,  TEXCOORD10);// MW texture address mode (0..3) -> sampleBase()
    DATA(FLAT(uint),  DrawIdx,    TEXCOORD11);// AT3: this draw's index into gAlphaStages
};

// Static semi-HDR tonemap — ported verbatim from XE FixedFuncEmu.fx::tonemap.
float3 tonemap(float3 c)
{
    c = clamp(c, 0.0f, 2.2f);
    c = (((0.0548303f * c - 0.189786f) * c - 0.154732f) * c + 1.12969f) * c;
    return c;
}

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN( VSOutput In )
{
    INIT_MAIN;
    float3 N = normalize(In.Normal);

    // Alpha lighting toggles (gFrameData.alphaParams): .z = transmission strength (0 disables),
    // .w = bitmask (1 = receive point-light shadows, 2 = two-sided LIGHTING). The per-DRAW two-sided
    // flag (DRAW_BOTH sheets only) rides ClampMode bit2 — packed by the host in packTexAlpha — so a
    // single-sided draw is never two-sided-lit. Live dev toggles (Alpha tab).
    float  transStrength = gFrameData.alphaParams.z;
    uint   alphaToggles  = (uint)(gFrameData.alphaParams.w + 0.5f);
    bool   receiveShadows = (alphaToggles & 1u) != 0u;
    // Two-sided lighting applies to ALL alpha when the toggle is on — NOT gated on the per-draw
    // DRAW_BOTH flag: MW alpha cloth (wall screens, curtains, banners) almost never carries a
    // NiStencilProperty, so gating on it left two-sided lighting basically never engaging. Alpha is
    // inherently thin/translucent, so lighting both faces is right for the whole class. (ClampMode
    // bit2 still carries the DRAW_BOTH flag from the host but is no longer read here.)
    bool   twoSidedLight  = (alphaToggles & 2u) != 0u;
    uint   clampMode      = In.ClampMode & 3u;   // strip the (now-unused) two-sided bit before sampling
    float3 transLit       = float3(0.0f, 0.0f, 0.0f);   // Change 3: accumulated transmitted (back-face) light

    // AO sample + toggles — identical to opaque.frag (blended shapes share the scene lighting).
    uint   aoFlags  = (uint)(gFrameData.debugParams.w + 0.5f);
    // C3 debug (panel "ALPHA: caster classify colors", debug bit3): the host replaces each
    // draw's matDiffuse instance floats with a shadow-caster classification color — GREEN
    // caster / RED not-alpha-over / ORANGE fading / WHITE strict reject / BLUE captured /
    // GRAY casters-off. Returned flat so the alpha set reads at a glance (opaque ignores bit3).
    if ((aoFlags & 8u) != 0u) { RETURN(float4(In.MatDiffuse, 1.0f)); }
    float2 aoUv     = In.Position.xy * gShadowParams.screenAlloc.zw;   // gAO is ALLOC-sized, not render-sized
    float4 aoSample = SampleTex2D(gAO, gSamplerAnisotropic, aoUv);
    if ((aoFlags & 2u) != 0u) { N = normalize(aoSample.rgb); }

    // Two-sided LIGHTING (the "normal trick"). A DRAW_BOTH sheet's far face is UNLIT under a one-
    // sided N.L, so a point-light shadow landing on it can't be SEEN — the light contributes 0 there,
    // and 0 * shadow = 0. Light BOTH faces with |N.L| so the position-correct shadow shows through.
    // This is NOT an eye-facing normal flip: that put a VIEW-DEPENDENT dark seam on fold creases
    // (flickers as you move). |N.L| is view-independent and adds no crease darkening — it only
    // brightens the back — and it is gated per-draw so single-sided folded carpets keep their
    // correct one-sided shading. The shadow sample itself is position-based (In.Position), unchanged.
    float  sndl = dot(N, -gFrameData.sunDir.xyz);
    // SUN is FRONT-LIT ONLY on transparents, even two-sided ones. The sun has no shadow term on
    // the host yet (directional CSM is deferred), so ANY backlit sun contribution here leaks: a
    // two-sided sheet backlit by the sun would glow with abs(N.L), and the wrap term below pushed
    // sun straight through the far face — both unshadowable today, so a leaf/banner standing inside
    // a building's shadow still lit up. Clamp the sun to the front face (saturate) and drop the sun
    // wrap term until real sun shadows land; two-sided POINT lighting (below) is unaffected because
    // it IS occluded by the point-light mask. (twoSidedLight still drives the point-light path.)
    float  ndl  = saturate(sndl);
    // Phase B: the sun term is now OCCLUDABLE — the MSM map is sampled from THIS fragment's own world
    // position, which is the whole reason the receiver is in-frag rather than a screen-space mask:
    // transparents never enter the depth buffer, so a mask could not shadow them at all. Restoring
    // the two-sided/wrap sun on transparents is a separate visual call, not required by the shadow.
    float  sunVis = sunShadowVisibility(In.WorldPos, N);
    float3 d = gFrameData.sunCol.rgb * ndl * sunVis;
    // SH1 sky-directional ambient — geometric normal, not the possibly-bent N (see skyamb.h.fsl).
    float3 a = ((aoFlags & 4u) != 0u) ? float3(1.0f, 1.0f, 1.0f)
                                      : gFrameData.ambCol.rgb * skyAmbFactor(In.Normal, In.WorldPos);
    if ((aoFlags & 1u) != 0u) { a *= aoSample.a; }
    a *= gFrameData.dbgScales.x;

    // Tier 3a point lights — same evalOnePointLight loop as opaque.frag.
    uint litCount = 0u;   // debug (mode 9): point lights that reach this pixel
    {
        uint nLights = (uint)gLights.lightParams.x;
        float reachK = gLights.lightParams.y;   // host-slaved light reach — see opaque.srt.h
        for (uint i = 0; i < nLights; ++i)
        {
            float4 posR    = gLights.lights[i * 3u + 0u];
            float3 lightCol= gLights.lights[i * 3u + 1u].rgb;
            float3 fo      = gLights.lights[i * 3u + 2u].xyz;
            float  radius  = posR.w;
            float  reach   = radius * reachK;

            float3 toLight = posR.xyz - In.WorldPos;
            float  dist2   = dot(toLight, toLight);
            if (dist2 >= reach * reach) { continue; }
            ++litCount;
            float  invDist = rsqrt(max(dist2, 1e-8f));
            float  dist    = dist2 * invDist;

            float  att = 1.0f / max(fo.z * dist2 + fo.y * dist + fo.x, 1e-4f);
            att *= 1.0f - smoothstep(POINT_LIGHT_TAIL * reach, reach, dist);

            // Change 1: receive point-light shadows — byte-identical to opaque.frag:143-152. The
            // host patches falloff.w = shadow slot + 1 (0 = no shadow); shadowmask.comp already did
            // the cube-face atlas PCF, so the slot's 4-bit visibility just scales the light.
            uint slotP1 = (uint)gLights.lights[i * 3u + 2u].w;
            if (receiveShadows && slotP1 != 0u)
            {
                uint4 mw   = LoadTex2D(gShadowMask, NO_SAMPLER, int2(In.Position.xy), 0).xyzw;
                uint  s    = slotP1 - 1u;
                uint  lane = s >> 3u;
                uint  word = lane == 0u ? mw.x : (lane == 1u ? mw.y : (lane == 2u ? mw.z : mw.w));
                uint  nib  = (word >> ((s & 7u) * 4u)) & 0xFu;
                att *= float(nib) * (1.0f / 15.0f);
            }

            float  ndlp    = dot(N, toLight) * invDist;
            float  lambert = twoSidedLight ? abs(ndlp) : saturate(ndlp);   // two-sided lights the far face
            d += lambert * att * lightCol;
            // Change 3: this light transmitting through the far face — back-facing lambert, reusing
            // the same att (incl. the shadow nibble above, so transmitted light is occluded too).
            transLit += saturate(dot(-N, toLight) * invDist) * att * lightCol;
        }
    }
    d *= gFrameData.dbgScales.y;

    // Tier 2b material routing — identical to opaque.frag.
    float3 lit;
    if (In.VColSource == 2u) {
        lit = In.Color.rgb * (d + a) + In.MatEmissive;
    } else if (In.VColSource == 1u) {
        lit = In.MatDiffuse * d + In.MatAmbient * a + In.Color.rgb;
    } else {
        lit = In.MatDiffuse * d + In.MatAmbient * a + In.MatEmissive;
    }

    float4 albedo = sampleBase(In.TexIndex, clampMode, In.Uv, useLowAF(In.AlphaRef, true));

    // Alpha test (some blended shapes ALSO alpha-test). Same GREATEREQUAL approximation.
    if (albedo.a < In.AlphaRef) { discard; }

    albedo.rgb *= gFrameData.dbgScales.z;

    // AT3 multi-stage: the dark/detail/glow maps MW folded into this same DIP. A CAPTURED blended
    // DIP is reconstructed from D3D8 render state, not from the scene graph, so before this it
    // sampled stage 0 alone and drew at full base brightness — the kurp Enhanced Light VFX pair
    // every base map with a blackmip*/darkmap* MODULATE layer and rendered blown out.
    // gAlphaStages.w is 0 for every cached alpha draw (those are single-map by construction; a
    // cached MULTI-map blend rides Route C / multimap_alpha.frag instead), so this whole block is
    // one uniform branch that costs nothing on the overwhelming majority of the list.
    // Ops match multimap.frag's stage loop exactly — keep them in lockstep.
    // Only the ALPHA of the base stage matters for coverage (MW's alpha chain is SELECTARG1 on
    // stage 0 for this content), so the extra stages fold into rgb only.
    {
        uint4 stg      = gAlphaStages[In.DrawIdx];
        uint  nStages  = stg.w;
        for (uint s = 0u; s < 3u; ++s)
        {
            if (s >= nStages) { break; }
            uint sw = (s == 0u) ? stg.x : (s == 1u) ? stg.y : stg.z;
            uint tex   = sw & 0xFFFFu;
            // uvSet (bits 16-17) is ALWAYS 0 here: the captured VB is single-UV, and the client
            // DROPS any stage that samples another set rather than ship wrong coordinates.
            uint op    = (sw >> 18u) & 0x3u;
            uint scl   = (sw >> 20u) & 0x3u;
            float4 t = sampleBase(tex, scl, In.Uv, useLowAF(In.AlphaRef, true));
            if (op == 1u)      { albedo.rgb *= t.rgb; }          // MODULATE
            else if (op == 2u) { albedo.rgb *= t.rgb * 2.0f; }   // MODULATE2X
            else               { albedo.rgb += t.rgb; }          // ADD
        }
    }

    // AT1 output alpha: texture alpha x per-vertex alpha (only when vertex colour drives the
    // shape) x material alpha (bit-cast through the overlay instance slot).
    float vcolA    = (In.VColSource != 0u) ? In.Color.a : 1.0f;
    float matAlpha = asfloat(In.OverlayIndex);
    float outA     = albedo.a * vcolA * matAlpha;

    float3 c = albedo.rgb * lit;
    // Change 3: add transmitted (wrap) light, tinted by the sheet's own albedo and scaled by its
    // thinness (1 - final opacity: thinner/more-transparent -> more bleed-through). transStrength
    // (alphaParams.z) drives it live; at 0 the far side is flat MW-dark (parity).
    c += transStrength * (1.0f - outA) * transLit * albedo.rgb;
    c *= gFrameData.dbgScales.w;
    c = tonemap(c);
    c = applyFog(c, In.WorldPos, In.Position.xy, In.Fog);

    // F12 debug views (opaque.frag's, alpha forced 1 so the view reads clearly).
    uint dbg = (uint)(gFrameData.debugParams.x + 0.5f);
    if (dbg == 3u || dbg == 4u) {
        if (dbg == 4u) { RETURN(float4(aoSample.rgb, 1.0f)); }
        float v = aoSample.a; RETURN(float4(v, v, v, 1.0f));
    }
    if (dbg == 5u) { RETURN(float4(albedo.rgb, 1.0f)); }
    if (dbg == 6u) { RETURN(float4(lit, 1.0f)); }
    if (dbg == 7u) {                                      // ambient-only (matches opaque.frag)
        float3 al;
        if (In.VColSource == 2u)      { al = In.Color.rgb * a + In.MatEmissive; }
        else if (In.VColSource == 1u) { al = In.MatAmbient * a + In.Color.rgb; }
        else                          { al = In.MatAmbient * a + In.MatEmissive; }
        RETURN(float4(al, 1.0f));
    }
    if (dbg == 8u) {                                      // world-space normal (RGB = N*0.5+0.5)
        RETURN(float4(N * 0.5f + 0.5f, 1.0f));
    }
    if (dbg == 9u) {                                      // point-light count heatmap (matches opaque.frag)
        float t = saturate((float)litCount / 8.0f);
        float3 heat = saturate(float3(t * 2.0f, 1.0f - abs(t - 0.5f) * 2.0f, 1.0f - t * 2.0f));
        RETURN(float4(litCount == 0u ? float3(0.0f, 0.0f, 0.0f) : heat, 1.0f));
    }
    if (dbg == 1u || dbg == 2u) {
        float dist = length(In.WorldPos - gFrameData.eyePos.xyz);
        float g = saturate(dist * (1.0f / 8192.0f));
        RETURN(float4(g, g, g, 1.0f));
    }
    RETURN(float4(c, outA));
}
