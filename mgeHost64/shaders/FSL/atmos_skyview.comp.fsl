// mgeHost64 — LUT 3 of 3: SKY-VIEW (tasks/forge-atmosphere.md S2a).
//
// The sky's radiance in every direction from where the camera stands. This is the one the pixels
// come from (skyhw.frag samples it) AND the one the light comes from (atmos_sh.comp projects it),
// which is the whole point: the sky you see and the light it casts are one texture, so they cannot
// drift apart the way two evaluations of one closed form could.
//
// ⚠ THE MEDIUM IS NOT DEFINED HERE — atmosphere.h.fsl owns it. See the warning at its top.
//
// 192x108, one thread per texel, ~32 march steps. Small because the parameterisation is chosen to
// put texels where the derivative is (atmosSkyViewParams: the v axis splits at the horizon and is
// squared on both sides), not because the sky is smooth — it very much is not, in the two degrees
// either side of the horizon and in the ten around the sun.
//
// ⚠ THE LOWER HEMISPHERE IS REAL, AND IT IS A BEHAVIOUR CHANGE THIS PHASE OWNS. Hosek INVERTED below
// the horizon and had to be clamped to the horizon ring, which meant "looking down from a height"
// showed a frozen band that happened to double as the fog target. Here the ray hits the ground and
// the ground is shaded — so a downhill vista melts into a real below-horizon colour instead of into
// a clamp. skydome.h.fsl's "look down from a height" control is the test for exactly this.

#include "atmosphere.srt.h"
#include "atmosphere.h.fsl"   // THE MEDIUM — one copy, see the warning at its top

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN( SV_DispatchThreadID(uint3) DispatchThreadID )
{
    INIT_MAIN;

    int2 px = int2(DispatchThreadID.xy);
    int  w  = (int)gAtmosParams.lutDims.x;
    int  h  = (int)gAtmosParams.lutDims.y;
    if (px.x >= w || px.y >= h)
    {
        RETURN();
    }

    float Rg = gAtmosParams.planet.x;
    float Rt = gAtmosParams.planet.y;
    float r  = gAtmosParams.planet.w;      // the camera's radius, host-published

    float2 uv = (float2(px) + f2(0.5f)) / float2(float(w), float(h));
    float viewZenithCos, lightViewCos;
    atmosSkyViewParams(gAtmosParams, uv, r, viewZenithCos, lightViewCos);

    // Rebuild a canonical frame in which the sun's azimuth is +x. The medium is horizontally
    // homogeneous, so only the angle to the sun matters and this frame loses nothing.
    float viewSin = sqrt(max(0.0f, 1.0f - viewZenithCos * viewZenithCos));
    float lightViewSin = sqrt(max(0.0f, 1.0f - lightViewCos * lightViewCos));
    float3 rd = float3(viewSin * lightViewCos, viewSin * lightViewSin, viewZenithCos);
    float3 origin = float3(0.0f, 0.0f, r);

    float sunZenithCos = gAtmosParams.sunDir.w;
    float3 sunDir = float3(sqrt(max(0.0f, 1.0f - sunZenithCos * sunZenithCos)), 0.0f, sunZenithCos);
    float cosTheta = clamp(dot(rd, sunDir), -1.0f, 1.0f);

    float tGround = atmosRaySphere(origin, rd, Rg);
    float tTop    = atmosRaySphere(origin, rd, Rt);
    bool  hitG    = (tGround > 0.0f);
    float tMax    = hitG ? tGround : max(tTop, 0.0f);

    float3 L = f3(0.0f);
    if (tMax > 0.0f)
    {
        int steps = (int)max(gAtmosParams.marchP.x, 8.0f);

        float phaseR = atmosPhaseRayleigh(cosTheta);
        float phaseM = atmosPhaseMie(cosTheta, gAtmosParams.mieExt.w);
        // The deck's own phase (S4a). Cloud droplets are hundreds of wavelengths across, so their
        // lobe is strongly forward and GREY — g ~0.85, from cloudType. It gets its own phase for
        // free now that atmosMediumAt() returns scattering per species; before S4a this march had to
        // re-derive Rayleigh's and Mie's densities inline to do the same thing, which was a second
        // copy of the profiles inside the chain whose premise is that there is exactly one.
        float phaseC = atmosPhaseMie(cosTheta, gAtmosParams.cloud.z);

        // ⚠ THE SCHEDULE IS SEGMENTED AT THE DECK (S4a). Quadratic spacing puts ~0.9 km between
        // samples where a 1.2 km lid sits, which is marginal looking up and worse looking along —
        // so the deck gets its own step budget and the open sky keeps the front-loading it needs.
        // With no deck the plan hands back exactly the schedule written inline here before S4a.
        float4 planT; float3 planN;
        int nSteps = atmosMarchPlan(gAtmosParams, origin, rd, tMax,
                                    steps, (int)gAtmosParams.marchP.w, ATMOS_MARCH_QUAD,
                                    planT, planN);

        float3 throughput = f3(1.0f);
        for (int s = 0; s < nSteps; ++s)
        {
            // ⚠⚠ QUADRATIC STEP SPACING, AND UNIFORM SPACING HERE IS A REAL DEFECT RATHER THAN A
            // QUALITY SETTING. Caught by the S2b gate: with uniform steps the horizon probe read
            // 41000 cd/m2 against a real clear horizon's ~5000-10000, and E_sky came out 47% high.
            //
            // The reason is geometric. A ray one degree above the horizon runs ~500 km through the
            // atmosphere; over 32 uniform steps that is a 16 km step, which is TWICE the Rayleigh
            // scale height. The first step's midpoint sits at sea-level density and that density is
            // then applied across 16 km of a column that in reality thins by e^-2 over the same
            // distance — so the densest, nearest part of every grazing ray is integrated as though
            // it extended two scale heights. The zenith, whose ray is short and whose density is
            // near-uniform over a step, was barely affected: the error grows exactly where the sky
            // is brightest and where the parameterisation is spending all its texels.
            //
            // Hillaire's distribution fixes it for free — same step count, t placed at (i/N)^2, so
            // the near field gets most of the samples and the thin far field gets few, which is
            // where the integrand actually lives. This is not an approximation traded for speed; it
            // is the correct quadrature for an exponentially-decaying integrand.
            //
            // ⚠ AND S4a MOVED THAT SCHEDULE INTO atmosMarchStep() RATHER THAN CHANGING IT. The
            // (i/N)^2 placement above is what the helper's ATMOS_MARCH_QUAD mode computes, float for
            // float, whenever the ray misses the deck — which is every ray in clear weather. What it
            // adds is a third segment through the lid, where an exponential's quadrature is the wrong
            // one because a slab is not an exponential.
            float t0, t1;
            atmosMarchStep(planT, planN, s, tMax, ATMOS_MARCH_QUAD, t0, t1);
            float dt = t1 - t0;
            float t  = t0 + dt * 0.5f;
            float3 p = origin + rd * t;
            float  ri = length(p);
            float  hi = ri - Rg;

            // ⚠ THE MEDIUM IS SAMPLED PER STEP, NOT HOISTED. The atmosphere's parameters are a FIELD
            // (atmosphere.h's whole discipline) and a march that evaluates the medium once at the
            // camera is not integrating a field — it will keep working perfectly right up to the day
            // the weather map stops being 1x1, at which point S6 becomes a rewrite of every march
            // instead of a change to one function. Here the field is vertical (density profiles) and
            // in S6 it becomes horizontal too; the call site is already inside the loop.
            //
            // The species' scattering, split so each takes its own phase function. This is the
            // reason a Rayleigh sky is blue overhead and a Mie sky glares white around the sun: one
            // is nearly isotropic and wavelength-selective, the other is strongly forward and grey.
            // The cloud is the third, and it is what makes an overcast sky a flat bright lid.
            float3 scaR, scaM, scaC, extAir, extCloud;
            atmosMediumAt(gAtmosParams, hi, scaR, scaM, scaC, extAir, extCloud);
            float3 sca = scaR + scaM + scaC;
            float3 ext = extAir + extCloud;

            float3 stepT = exp(-ext * dt);
            float3 sInt  = (f3(1.0f) - stepT) / max(ext, f3(1.0e-9f));

            // --- the SUN's contribution -------------------------------------------------------
            float  muS  = dot(normalize(p), sunDir);
            float3 sunT = f3(0.0f);
            if (atmosRaySphere(p, sunDir, Rg) < 0.0f)
            {
                float2 tuv = atmosTransmittanceUv(gAtmosParams, ri, muS);
                sunT = SampleLvlTex2D(gAtmosTransmittance, gSamplerBilinearClamp, tuv, 0).rgb;
            }
            float3 sunIn = (scaR * phaseR + scaM * phaseM + scaC * phaseC)
                         * sunT * gAtmosParams.solar.xyz;

            // --- the MOON's, on exactly the same terms (S2e) -----------------------------------
            // ⚠ A SECOND SOURCE, NOT A SECOND MODEL. The moon enters the identical integral with its
            // own direction and its own top-of-atmosphere irradiance, so moonlight is Rayleigh-
            // scattered into a blue night sky by the same arithmetic that makes the day sky blue —
            // which is what a night actually looks like and is not something a "fade to black" ramp
            // could ever produce. w = 0 disarms it with no branch cost worth naming.
            if (gAtmosParams.moonDir.w > 0.0f)
            {
                float3 mDir = gAtmosParams.moonDir.xyz;
                float  cosM = clamp(dot(rd, mDir), -1.0f, 1.0f);
                float  muM  = dot(normalize(p), mDir);
                float3 moonT = f3(0.0f);
                if (atmosRaySphere(p, mDir, Rg) < 0.0f)
                {
                    float2 muv = atmosTransmittanceUv(gAtmosParams, ri, muM);
                    moonT = SampleLvlTex2D(gAtmosTransmittance, gSamplerBilinearClamp, muv, 0).rgb;
                }
                sunIn += (scaR * atmosPhaseRayleigh(cosM)
                        + scaM * atmosPhaseMie(cosM, gAtmosParams.mieExt.w)
                        + scaC * atmosPhaseMie(cosM, gAtmosParams.cloud.z))
                       * moonT * gAtmosParams.moonDir.w;
            }

            // --- the multiple-scattering term, isotropic by construction ------------------------
            float2 msUv = atmosMultiScatterUv(gAtmosParams, ri, muS);
            float3 ms   = SampleLvlTex2D(gAtmosMultiScatter, gSamplerBilinearClamp, msUv, 0).rgb;
            float3 msIn = sca * ms;

            L += throughput * (sunIn + msIn) * sInt;
            throughput *= stepT;
        }

        // --- THE GROUND, when the ray hits it -------------------------------------------------
        // Lambertian, lit by the sun through the atmosphere. This is what makes the below-horizon
        // half of the LUT a real answer rather than a clamp, and it is also the lower hemisphere the
        // SH pass integrates over — so the ambient sees the lit ground exactly as the CPU projection
        // used to compute it, out of the same texture the pixels come from.
        if (hitG)
        {
            float3 pg = origin + rd * tMax;
            float3 ng = normalize(pg);
            float  muSg = dot(ng, sunDir);
            if (muSg > 0.0f)
            {
                float2 tuv = atmosTransmittanceUv(gAtmosParams, Rg, muSg);
                float3 gT  = SampleLvlTex2D(gAtmosTransmittance, gSamplerBilinearClamp, tuv, 0).rgb;
                L += throughput * gT * muSg * gAtmosParams.solar.xyz
                   * (gAtmosParams.planet.z / ATMOS_PI);
            }
            // ...and the sky's own light landing on it, through the multiscatter term. Without this
            // the ground under an overcast lid is black, because an overcast lid has no direct beam
            // at all — which is precisely the case the medium exists to get right.
            float2 msUv = atmosMultiScatterUv(gAtmosParams, Rg, muSg);
            float3 ms   = SampleLvlTex2D(gAtmosMultiScatter, gSamplerBilinearClamp, msUv, 0).rgb;
            L += throughput * ms * ATMOS_PI * (gAtmosParams.planet.z / ATMOS_PI);
        }
    }

    // ⚠ THE AIRGLOW FLOOR IS ADDED AFTER THE MARCH, NOT INSIDE IT. It stands in for the night sky's
    // own emission (airglow, zodiacal light, unresolved starlight), which is a source with no
    // in-scattering geometry of its own at this scale. Its job is that "the sun is down" stops
    // meaning "there are no photons": a medium is happy to return exactly zero, and zero is a
    // number the exposure servo cannot meter.
    L += f3(gAtmosParams.nightP.x);

    Write2D(gAtmosOutA, px, float4(max(L, f3(0.0f)), 1.0f));

    RETURN();
}
