// mgeHost64 — LUT 1 of 3: TRANSMITTANCE (tasks/forge-atmosphere.md S2a).
//
// For every (altitude, view zenith cosine) pair, how much of a beam survives the trip from that
// point to the top of the atmosphere along that direction. Everything else in the chain is built on
// this: the sun's colour at the ground is one lookup, the sun's colour at cloud altitude will be
// another, and the sky-view march reads it once per step.
//
// ⚠ THE MEDIUM IS NOT DEFINED HERE. Every coefficient, profile and mapping comes from
// atmosphere.h.fsl — see the warning at the top of that file. This is the integral and nothing else.
//
// 256x64, one thread per texel, 40 analytic steps. The step count is high for a LUT this small
// because transmittance is the one term with no smoothing anywhere downstream: an error here is a
// multiplicative error on the sun, which is ~80% of a clear day's light.

#include "atmosphere.srt.h"
#include "atmosphere.h.fsl"   // THE MEDIUM — one copy, see the warning at its top

#define ATMOS_TRANSMITTANCE_STEPS 128

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN( SV_DispatchThreadID(uint3) DispatchThreadID )
{
    INIT_MAIN;

    int2 px = int2(DispatchThreadID.xy);
    int  w  = (int)gAtmosParams.lutDims.z;
    int  h  = (int)gAtmosParams.lutDims.w;
    // RETURN() on its own line: fsl.py's rewrite is line-based and a one-liner `{ RETURN(); }`
    // transpiles to `return ()`.
    if (px.x >= w || px.y >= h)
    {
        RETURN();
    }

    float2 uv = (float2(px) + f2(0.5f)) / float2(float(w), float(h));
    float r, mu;
    atmosTransmittanceParams(gAtmosParams, uv, r, mu);

    // How far the ray runs before it leaves the atmosphere. The parameterisation guarantees this
    // ray does NOT hit the ground (that is what the (r, mu) mapping is built around), so the top of
    // the atmosphere is the only exit.
    float Rt = gAtmosParams.planet.y;
    float d  = max(0.0f, -r * mu + sqrt(max(0.0f, r * r * (mu * mu - 1.0f) + Rt * Rt)));

    // Trapezoid, uniform in path length, with the endpoints half-weighted.
    //
    // ⚠ UNIFORM HERE, QUADRATIC IN atmos_skyview.comp, AND THE DIFFERENCE IS NOT AN INCONSISTENCY.
    // The sky-view march front-loads its samples because the density along a grazing ray falls
    // monotonically away from the camera, so the near field is where the whole integrand lives. That
    // reasoning does NOT hold here: this LUT's parameterisation deliberately includes rays with mu
    // slightly negative, which DESCEND toward their tangent point before climbing back out — their
    // density peaks in the MIDDLE of the path, and front-loading would under-sample exactly that
    // peak. Uniform is the right quadrature for an integrand that is not monotone, and the step
    // count is raised instead to cover the grazing case.
    //
    // ⚠ AND THE COUNT IS HIGH ON PURPOSE. Transmittance is the one term with no smoothing anywhere
    // downstream: an error here is a MULTIPLICATIVE error on the sun, which is ~80% of a clear day's
    // light, and it also reaches the sky through every march step's sun-visibility lookup. 256x64
    // texels once per frame is cheap enough that there is nothing to trade.
    float3 depth = f3(0.0f);
    float  dt    = d / float(ATMOS_TRANSMITTANCE_STEPS);
    for (int i = 0; i <= ATMOS_TRANSMITTANCE_STEPS; ++i)
    {
        float t  = float(i) * dt;
        // Law of cosines: the radius at distance t along a ray leaving radius r at cosine mu.
        float ri = sqrt(max(0.0f, r * r + t * t + 2.0f * r * t * mu));
        float3 scaR, scaM, scaC, extAir, extCloud;
        atmosMediumAt(gAtmosParams, ri - gAtmosParams.planet.x, scaR, scaM, scaC, extAir, extCloud);
        float wgt = (i == 0 || i == ATMOS_TRANSMITTANCE_STEPS) ? 0.5f : 1.0f;
        depth += extAir * wgt;
    }
    depth *= dt;

    // ─── THE DECK, AS ITS OWN INTEGRAL OVER ITS OWN CHORD (S4a) ───────────────────────────────
    // ⚠⚠ SPLITTING BY SPECIES IS EXACT HERE AND NOWHERE ELSE IN THE CHAIN. Optical depth is a plain
    // integral — no throughput, no ordering, nothing multiplied by what came before it — so
    // ∫(air + cloud) ds is ∫air ds + ∫cloud ds, term for term. Two things follow, and both of them
    // are the reason this march is shaped differently from the other two:
    //
    //   1. THE 128-STEP AIR MARCH ABOVE DID NOT HAVE TO CHANGE AT ALL, so the clear sky's
    //      transmittance LUT is BIT FOR BIT what it was before the deck existed. That is the
    //      foundation every other S4a gate row rests on, and a warped schedule could only have got
    //      close to it.
    //   2. A 1.2 km lid gets a march sized for a 1.2 km lid instead of the ~4 km steps a uniform
    //      128-step walk to the top of the atmosphere can offer it.
    //
    // The radiance marches cannot do this: their integrand is multiplied by a throughput that
    // depends on everything nearer the camera, so their species share one ordered walk and they go
    // through atmosMarchPlan/Step instead.
    float deckDepth = 0.0f;   // the DECK's own optical depth along this ray — grey, so scalar
    {
        float3 ro = float3(0.0f, 0.0f, r);
        float3 rd = float3(sqrt(max(0.0f, 1.0f - mu * mu)), 0.0f, mu);
        float4 planT; float3 planN;
        int nDeck = atmosMarchPlan(gAtmosParams, ro, rd, d,
                                   0, int(gAtmosParams.marchP.w), ATMOS_MARCH_UNIFORM,
                                   planT, planN);
        float cloudDepth = 0.0f;
        for (int k = 0; k < nDeck; ++k)
        {
            float ta, tb;
            atmosMarchStep(planT, planN, k, d, ATMOS_MARCH_UNIFORM, ta, tb);
            float tm = 0.5f * (ta + tb);
            float ri = sqrt(max(0.0f, r * r + tm * tm + 2.0f * r * tm * mu));
            cloudDepth += atmosCloudProfile(gAtmosParams, ri - gAtmosParams.planet.x) * (tb - ta);
        }
        // ⚠⚠ cloud.y IS THE DELTA-SCALED beta_ext (S4a/A2), AND THAT IS THE WHOLE OF "WHERE DID THE
        // SUN GO". A cloud's g is 0.84-0.88, so roughly three quarters of what it scatters goes into
        // a forward peak physically indistinguishable from unscattered light — and this march used to
        // extinguish the beam against the RAW coefficient, as though every one of those photons had
        // been removed. Delta scaling truncates the peak into the beam: tau' = (1 - ssa g^2) tau.
        // At the Cloudy row that is tau 1.74 -> 0.512 and beam transmittance 0.176 -> 0.527, a 3x
        // recovery — which is the difference between a frame with shadows in it and one without.
        //
        // ⚠ THE SCALING IS NOT DONE HERE. Atmosphere::deckSolve() applies it once, host-side, to the
        // packed coefficients, so this march, atmos_skyview's phase function and the slab's own
        // source are three views of ONE medium. Delta-Eddington is only correct as a triple (tau',
        // ssa', g'); scaling the beam alone would leave the sky phase-shifting with the unscaled g.
        //
        // ⚠ THE ONE VISIBLE APPROXIMATION IT BUYS, STATED SO A PICTURE CHECK KNOWS WHAT TO LOOK AT:
        // this LUT feeds both the LIGHT and the drawn SUN DISC, and the truncated peak is not really
        // in the disc — it is a tight aureole around it. So under a THIN deck the disc is drawn a
        // little too bright and too hard-edged, while the light it casts is right. That trade is the
        // standard one in every atmospheric model since 1976 and it is the correct way round for a
        // renderer: the complaint this fixes is "there are no shadows", and shadows are cast by the
        // light. Under a full lid it does not arise — tau 24 still scales to 7.07, e^-7.07 = 0.0019.
        deckDepth = gAtmosParams.cloud.y * cloudDepth;
    }

    // ⚠⚠ RGB IS THE AIR ALONE AND ALPHA IS THE DECK ALONE, AND THAT SPLIT IS WHAT MAKES THE COVER
    // MIXTURE AFFORDABLE. atmos_skyview needs BOTH a deck-free beam (for the clear arm, over the
    // 1-cover fraction of sky with no cloud in it) and a through-the-cloud one (for the deck arm),
    // and a second 256x64 LUT plus its own dispatch to carry the difference would have been the
    // obvious way to get them. It is not needed: THE DECK IS GREY BY CONSTRUCTION — a water cloud's
    // droplets are hundreds of wavelengths across, so cloud.y is a scalar and its transmittance is
    // one channel. Alpha was a constant 1.0 and is now that channel.
    //
    //     clear arm   sunT = t.rgb
    //     deck  arm   sunT = t.rgb * t.a
    //     the MEAN    sunT = t.rgb * lerp(1, t.a, cover)      <- what a mean-field consumer wants
    //
    // ⚠ AND `depth` NO LONGER CARRIES THE DECK, so a consumer that reads .rgb and ignores .a now
    // gets a CLEAR-AIR beam where it used to get an extinguished one. There are four of them and
    // all four were changed with this: atmos_skyview (two arms), atmos_multiscatter and atmos_sh
    // (the mean), and atmosview.frag (a debug view, air-only on purpose).
    Write2D(gAtmosOutA, px, float4(exp(-depth), exp(-deckDepth)));

    RETURN();
}
