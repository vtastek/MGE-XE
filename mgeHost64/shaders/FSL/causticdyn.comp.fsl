// mgeHost64 — W24: DYNAMIC CAUSTICS. The same beam splat as caustic.comp, driven by the LIVE wave
// fields instead of by a tiling cosine sum, so the caustics belong to the disturbance that made
// them and the map has no period at all.
//
// WHY THIS EXISTS. W23's map is seamless because its wavevectors are integer multiples of
// 2*pi/tile — and that same condition makes it repeat exactly every `tileWorldUnits`. Nothing
// consumer-side fixes that (a domain warp was tried and removed: it trades a periodic artefact for a
// smeared one, and the smear reads worse). The real answer is the one the technique is FOR: splat
// the actual surface. Two live wave fields are already GPU-resident — the fine ripple grid at
// 1 unit/texel and the dispersive wake grid at 8 — so feeding them through the identical kernel
// costs no new simulation and gives a layer that follows a swimmer's splash and a boat's wedge.
//
// ⚠⚠ THE IDENTITY PREFILL IS WHAT MAKES THIS AFFORDABLE, and it is the one idea in this file.
// Calm water would otherwise cost a full Gaussian splat per source cell doing nothing at all — a
// flat field is not a cheap field, it is the same 25 atomics per cell arranged to cancel. Instead:
//
//   * the RESOLVE leaves the dynamic accumulator holding CAUSTIC_WFIX per texel (misc.z) rather
//     than 0. Because the source grid here is 1:1 with the destination, that is EXACTLY the weight
//     of the beam born in that texel — a uniform lattice of undisturbed beams sums to a uniform
//     field either way, so a prefilled plane already IS the calm answer;
//   * a DISTURBED beam withdraws its own cell's prefill (AtomicAdd of the two's-complement
//     negative; modular arithmetic is exact because the final total is never negative) and then
//     splats normally;
//   * a CALM beam returns immediately. Zero atomics, zero bandwidth.
//
// The BOOKKEEPING is therefore exact and the mean stays 1.0 — the property the exposure servo
// depends on ([[project_forge_apl_region_split]]). What is approximated is only the KERNEL SHAPE of
// a calm beam, as a delta rather than as its sub-texel Gaussian, and that can only matter in a ~1
// texel band at the calm/disturbed boundary — where the disturbed kernel is a near-delta anyway.
//
// ⚠ AND IT NEEDS NO SCROLL HANDLING, unlike the wave sim it reads. The dynamic map is rebuilt from
// scratch every frame, so there is no history to shift when the camera moves. The domain follows the
// field's own texel-snapped origin for free.
//
// ⚠ THE DESTINATION DOES NOT WRAP. The static map is world-periodic and `mod RES` is exact there;
// this one is a camera-anchored window, where wrapping would put a phantom wake on the opposite side
// of the domain. Out-of-range cells are dropped and the kernel renormalises over the survivors, so
// every beam still delivers its full weight — see causticsplat.h.fsl.
//
// ⚠ ONE SHADER FOR BOTH LAYERS. Ripple and wake differ ONLY in cbuffer contents: which field is
// bound to gCausticDynField (a descriptor-set instance, not a branch), the integer stride/offset
// into it, the slope gain, the slice base, and how many depth slices to loop. The slices are an
// INNER loop and the dispatch is z=1, because slope and Hessian do not depend on depth — five field
// taps serve every slice of the layer.

#include "causticsplat.h.fsl"

#define CAUSTICD_THREADS 8

// The wave field's stored slope is dh per TEXEL and it is the NEGATIVE gradient: ripplenormal.comp
// writes (hL - hR)*0.5, i.e. minus the central difference, because water.frag wants a normal's xy
// directly. The refraction wants grad(h) itself, hence the sign here. Getting this backwards mirrors
// the whole pattern about the disturbance, which is subtle enough on a splash and obvious on a wake.
float2 causticDynSlope(int2 p, int grid, float texPerUnit, float gain)
{
    int2 c = int2(clamp(p.x, 0, grid - 1), clamp(p.y, 0, grid - 1));
    float4 f = LoadTex2D(gCausticDynField, NO_SAMPLER, c, 0);
    return -f.zw * (texPerUnit * gain);
}

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(CAUSTICD_THREADS, CAUSTICD_THREADS, 1)
void CS_MAIN(SV_DispatchThreadID(uint3) did)
{
    INIT_MAIN;
    // NB: every RETURN() MUST start its own line — fsl.py only rewrites a line-leading RETURN.
    if (did.x >= (uint)CAUSTIC_RES || did.y >= (uint)CAUSTIC_RES) {
        RETURN();
    }

    const int R = CAUSTIC_RES;

    float upt    = max(gCausticParams.dynField.x, 1.0e-3f);   // field world units per texel
    int   stride = max((int)gCausticParams.dynField.y, 1);    // field texels per destination texel
    int2  off    = int2((int)gCausticParams.dynField.z, (int)gCausticParams.dynField.w);
    uint  base   = (uint)gCausticParams.dynOut.x;
    float gain   = gCausticParams.dynOut.y;
    int   grid   = max((int)gCausticParams.dynOut.z, 2);
    uint  span   = clamp((uint)gCausticParams.misc.w, 1u, 4u);
    float cRef   = max(gCausticParams.wave.x, 1e-4f);
    float sunTan = max(gCausticParams.wave.z, 0.0f);
    // W27b — the SOURCE low-pass, in FIELD texels. See the Hxx/Hyy/Hxy block below; the host note on
    // g_causticDynHess carries the derivation. gCausticParams.medium.x is deliberately NOT read
    // here — W27 tried the medium's spread as a kernel widening and it made the layers dark rather
    // than soft (forgerender.cpp, fillDyn). A caustic must be low-passed at its SOURCE or not at all.
    int hm = clamp((int)gCausticParams.dynOut.w, 1, 4);
    // ─── W29: SUB-BEAMS, THE REFERENCE'S OWN ANSWER TO VISIBLE ELLIPSES ─────────────────────────
    // Job Talle's caustic write-up (the technique this file implements) states the failure mode
    // exactly: "At low splat counts, the ellipses become visible... increasing the number of splats
    // makes the ellipses disappear in the pattern they create", and "I don't cast them from a square
    // grid, but rather from a hexagonal grid... it makes the gaps between the landed ellipses
    // smaller."
    //
    // ⚠ THIS LAYER WAS RUNNING AT BOTH OF THOSE WORST CASES AT ONCE, and not by accident. The static
    // map casts 512x592 HEX source cells into 512x512 texels — 1.156 beams per texel, staggered. This
    // one cast 512x512 SQUARE — exactly 1.000 per texel, aligned — because that 1:1 lattice is the
    // PRECONDITION for the identity prefill that makes calm water free. The optimisation bought its
    // speed with the one parameter the reference says controls whether you can see the ellipses.
    //
    // Sub-beams buy the density back without giving up the prefill: the cell still owns exactly
    // CAUSTIC_WFIX of weight and still withdraws it exactly once, it is simply delivered by N smaller
    // beams spread across the cell instead of one at its centre. Calm cells are untouched — they
    // early-out above and never reach this.
    uint  nSub = clamp((uint)gCausticParams.cfg.z, 1u, 4u);

    float tpu     = 1.0f / upt;                      // FIELD texels per world unit
    float toTexel = tpu / (float)stride;             // world units -> DESTINATION texels

    // This cell's texel in the wave field. The destination lattice is a sub-lattice of the field's,
    // which is what makes all five taps exact integer loads instead of bilinear fetches.
    int2 ft = int2((int)did.x, (int)did.y) * stride + off;

    // --- the surface: world slope and world Hessian, from five taps -----------------------------
    // .zw is dh per FIELD texel, so a world slope needs texels-per-unit (water.frag:1152 makes the
    // same conversion for the same reason). The Hessian is then a central difference of that slope
    // over `hm` field texels each way.
    //
    // ⚠⚠ hm IS THE NOISE KNOB, AND +-1 IS NOT "THE FINEST SPACING AVAILABLE, WHICH IS WHAT A FOLD
    // NEEDS" — that was W24's note and it is the bug. A +-m second difference has response
    // |2-2cos(m*k*dx)|/(m*dx)^2, which at m=1 rises MONOTONICALLY with k and peaks at the wave
    // grid's own Nyquist. So the Hessian is dominated by whatever sits at grid scale, and q*H with
    // q = c*D = 64 turns that into per-texel speckle no destination resolution can fix. m=2 is zero
    // at that mode EXACTLY and passes the wake's 11-25 texel wavelengths at 90-98%.
    //
    // ⚠ THE SLOPE TAP IS NOT WIDENED, ONLY THE STENCIL. s0 is a direct load and carries the
    // refraction's displacement; widening it would smear the pattern's POSITION, which is a
    // different and worse thing than declining to measure its curvature at grid scale.
    float2 s0 = causticDynSlope(ft,                  grid, tpu, gain);
    float2 sX = causticDynSlope(ft + int2( hm, 0),   grid, tpu, gain);
    float2 sx = causticDynSlope(ft + int2(-hm, 0),   grid, tpu, gain);
    float2 sY = causticDynSlope(ft + int2( 0, hm),   grid, tpu, gain);
    float2 sy = causticDynSlope(ft + int2( 0,-hm),   grid, tpu, gain);

    // ⚠ THE 1/(2*hm) IS NOT OPTIONAL. A central difference is (f(+m) - f(-m)) / (2*m*dx); dropping
    // the m would scale the whole Hessian by hm and move every fold depth with the stencil width,
    // so the knob would read as a strength slider and get blamed for the wrong thing.
    float hnorm = tpu * 0.5f / (float)hm;
    float Hxx = (sX.x - sx.x) * hnorm;
    float Hyy = (sY.y - sy.y) * hnorm;
    // SYMMETRISED. A Hessian is symmetric by construction but a sampled one is not, and the beam
    // covariance below is formed as J*J on the assumption that it is — an asymmetric J would need a
    // transpose that is not taken, so the ellipse would come out subtly wrong rather than loudly so.
    float Hxy = ((sX.y - sx.y) + (sY.x - sy.x)) * (hnorm * 0.5f);

    // The CALM EARLY-OUT. The deepest slice bounds every shallower one (q is linear in depth), so
    // one test in front of the loop rejects a calm cell for the whole layer.
    //
    // ⚠⚠ DEFAULT-OFF (calmD = calmH = 0), AND IT IS UNSOUND AT ANY NONZERO VALUE. Skipping keeps
    // the texel's identity prefill, which is a DELTA; splatting spreads over the kernel floor
    // sigSrc2 + sigMin2 and leaves only 45-58% at home even at zero displacement with J = I. Both
    // uniform populations sum to exactly 1.0, so the error is a STEP at every calm/splat BOUNDARY —
    // 0.83 | 1.17 across a straight edge, 0.45 with a 1.11 halo for a lone splatter. A decaying
    // ripple ring is nothing but boundary, which is why this read as beading at the fade. See
    // forgerender.cpp g_causticCalmDisp for the full derivation; the knobs survive only to price
    // the early-out (+0.20 ms to run every beam).
    float dMax = 0.0f;
    for (uint dm = 0u; dm < span; ++dm) { dMax = max(dMax, gCausticParams.depths[dm]); }

    float hMag  = max(abs(Hxx), max(abs(Hxy), abs(Hyy)));
    float gMag  = length(s0);
    float calmD = max(gCausticParams.dynCfg.x, 0.0f);
    float calmH = max(gCausticParams.dynCfg.y, 0.0f);
    if (gMag * cRef * dMax * toTexel < calmD && hMag * cRef * dMax < calmH) {
        RETURN();
    }

    // One beam per destination texel, so sigma_src is the Gaussian standing for a UNIT cell: 0.5.
    const float sigSrc2 = 0.25f;

    for (uint sl = 0u; sl < span; ++sl)
    {
        float depth = gCausticParams.depths[sl];
        float q     = cRef * depth;

        // Per-slice calm test, same contract and same caveat as the layer-wide one above: it buys
        // one slice instead of two over calm water, and it beads at the boundary for exactly the
        // same reason, so it is off by default with it.
        if (gMag * q * toTexel < calmD && hMag * q < calmH) { continue; }

        uint  slice = base + sl;
        float sigSun  = depth * sunTan * toTexel;
        float sigMin2 = sigSun * sigSun + 0.1089f;

        // dst is in DESTINATION TEXELS and texel k sits at coordinate k, so an undisplaced beam born
        // at the cell centre lands exactly on its own texel — which is what the prefill it withdraws
        // represents. The sub-beams below are born spread ACROSS that cell instead.
        float2 base2 = float2((float)did.x, (float)did.y) + s0 * (q * toTexel);
        float3 Jm    = float3(1.0f + q * Hxx, q * Hxy, 1.0f + q * Hyy);
        uint   wIdx  = (slice * (uint)R + did.y) * (uint)R + did.x;

        // ⚠ WEIGHT IS SPLIT, NOT REPEATED. N sub-beams of CAUSTIC_WFIX/N sum to exactly the weight
        // this cell has always owned, so the mean-1 contract is untouched at any N — and the prefill
        // is withdrawn ONCE (on sub-beam 0), because there is still only one prefill to take back.
        // ⚠ AND sigSrc IS SPLIT WITH IT: a beam standing for 1/N of a unit cell has 1/N the area and
        // therefore 1/N the variance, so sigSrc2 goes 0.25 -> 0.25/N. Leaving it at 0.25 would make N
        // sub-beams N times as wide in total as the one they replace — a blur, not more samples.
        float wSub  = (float)CAUSTIC_WFIX / (float)nSub;
        float ssub2 = sigSrc2 / (float)nSub;

        // ⚠ HEX, NOT A FINER SQUARE GRID. Sub-beams on a regular sub-lattice would just reproduce the
        // same aligned-gap problem one level down. Odd destination ROWS are shifted half a sub-step,
        // which is the row stagger that makes the union of all births a triangular lattice — the
        // hexagonal casting the reference credits for closing the gaps (and the same sqrt(3)/2 idea
        // the static map's 512x592 source encodes).
        float rowHex = ((did.y & 1u) != 0u) ? 0.5f : 0.0f;

        LOOP for (uint sb = 0u; sb < nSub; ++sb)
        {
            // N points on a ring inside the cell, plus the row stagger. r = 0.26 keeps every birth
            // inside its own texel (|off| <= 0.26 + 0.13 < 0.5) so no cell ever donates weight to a
            // neighbour's bookkeeping.
            float2 off = float2(0.0f, 0.0f);
            if (nSub > 1u) {
                float ang = 6.28318531f * ((float)sb + 0.5f) / (float)nSub;
                off = float2(cos(ang), sin(ang)) * 0.26f;
            }
            off.x += rowHex * 0.26f;

            causticSplatBeam(base2 + off, Jm, ssub2, sigMin2, wSub, slice, 0,
                             wIdx, (sb == 0u) ? (uint)CAUSTIC_WFIX : 0u);
        }
    }
    RETURN();
}
