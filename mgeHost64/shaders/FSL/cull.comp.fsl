// mgeHost64 — Stage B (B3) GPU statics cull, PASS 1 of 3: COUNT.
//
// Direct port of dlLiveCullAndBuild's PER-INSTANCE rule (forgerender.cpp): tier range² + near cutoff
// + Gribb-Hartmann frustum-sphere test, in camera-relative space. Every surviving instance:
//   - AtomicAdd(gCullCount[0], numSubsets)  — kept for the post-fence CPU-parity check (== 13,611).
//     gCullCount[0] counts FRUSTUM survivors (PRE-occlusion) so the heartbeat MATCH-vs-CPU stays
//     meaningful; Hi-Z-occluded instances then add numSubsets to gCullCount[1] (hizOccl readback)
//     and skip the gSubsetCount adds — they draw nothing.
//   - AtomicAdd(gSubsetCount[firstSubset+k], 1) for each of its subsets — the per-subset survivor
//     count the prefix-sum (cullscan) turns into per-subset instance offsets + indirect args.
//
// 64-wide groups. Out-of-range tail threads bounds-checked against misc.x (no grid coarse-reject).
// cullscatter.comp re-runs this EXACT test; the two MUST agree (same CullParams, no data races).

#include "cull.srt.h"
#include "hizocclusion.h.fsl"

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(64, 1, 1)
void CS_MAIN( SV_DispatchThreadID(uint3) DispatchThreadID )
{
    INIT_MAIN;
    // NB: every RETURN() MUST start its own line — fsl.py only rewrites RETURN()->return when the
    // line begins (after whitespace) with RETURN (generators/d3d.py); inline `{ RETURN(); }` is
    // left untransformed and fails DXC as `return()`.
    uint i = DispatchThreadID.x;
    if (i >= (uint)gCullParams.misc.x)
        RETURN();

    CullInstance inst = gCullInst[i];
    if (inst.rangeEndIdx == 0xFFFFFFFFu)   // grass / invalid -> skip
        RETURN();

    // Tier range² (x/y/z = near/far/vfar end, squared host-side).
    float rangeEnd2 = (inst.rangeEndIdx == 0u) ? gCullParams.ranges.x
                    : (inst.rangeEndIdx == 1u) ? gCullParams.ranges.y
                                               : gCullParams.ranges.z;

    // Near cut is 3D (includes height): a static far BELOW an airborne camera has a small XY
    // distance but a large true distance, so an XY-only cut wrongly rejected it as near-owned and
    // left a hole under the player. Matches DX9 XE Mod Statics.fx. The far tier range stays
    // HORIZONTAL (MGE tiers are authored as cell distance; a 3D far test would pop distant statics
    // as you gain altitude).
    float dx = inst.posX - gCullParams.eye.x;
    float dy = inst.posY - gCullParams.eye.y;
    float cz = inst.posZ - gCullParams.eye.z;
    float d2 = dx * dx + dy * dy;
    float dNear2 = d2 + cz * cz;
    if (dNear2 < gCullParams.ranges.w || d2 > rangeEnd2)
        RETURN();

    // Frustum-cull the instance sphere (camera-relative center, radius effR).
    UNROLL
    for (uint p = 0u; p < 6u; ++p)
    {
        float4 pl = gCullParams.planes[p];
        float  dist = pl.x * dx + pl.y * dy + pl.z * cz + pl.w;
        if (dist < -inst.effR)
            RETURN();
    }

    uint orig;
    AtomicAdd(gCullCount[0], inst.numSubsets, orig);

    // Occlusion M2: frustum survivor vs the PREVIOUS frame's Hi-Z pyramid (hizEyeDelta rebases
    // this frame's camera-relative center into the pyramid camera's space). Occluded -> counted
    // in gCullCount[1] for the heartbeat, contributes NO subsets (cullscatter skips it too).
    if (hizOccluded(float3(dx, dy, cz) + gCullParams.hizEyeDelta.xyz, inst.effR))
    {
        uint occ;
        AtomicAdd(gCullCount[1], inst.numSubsets, occ);
        RETURN();
    }

    for (uint k = 0u; k < inst.numSubsets; ++k)
    {
        uint sid = inst.firstSubset + k;
        uint prev;
        AtomicAdd(gSubsetCount[sid], 1u, prev);
    }
    RETURN();
}
