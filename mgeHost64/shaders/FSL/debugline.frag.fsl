// mgeHost64 — debug line (fragment stage), --forge-view only.
//
// Constant bright colour, alpha = 1 (opaque overlay). The viewer renders straight to the
// backbuffer, so the alpha convention of the present-seam composite does not apply here.

#include "opaque.srt.h"

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float4, Color,    TEXCOORD0);
};

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN( VSOutput In )
{
    INIT_MAIN;
    RETURN(In.Color);   // flat per-vertex colour (light-box id hash)
}
