// mgeHost64 — Phase 1a distant-land LOD (fragment stage, host-owned DL).
//
// Faithful port of XE Mod Landscape.fx::LandscapePS. Samples the three resident atlas textures by
// bindless slot (gFrameData.lodParams.xyz = base/normal/detail slots): base colour, world normal
// map (2n-1), and the tiled MGE detail map at uv*333 and uv*90. Lighting = sun N.L (to-sun =
// -sunDir) + distant-land ambient (lodSunAmb), then the two-scale detail modulation, then fog.
//
// NOT tonemapped: LandscapePS returns lit*detail directly (unlike opaque.frag, which inlines the
// FFE tonemap because its FFE source did). Matching MGE's DL look means no inline tonemap here.

#include "opaque.srt.h"

// Static semi-HDR tonemap — byte-identical to opaque.frag::tonemap (XE FixedFuncEmu.fx). The near
// path tonemaps its final lit colour; distant land historically did NOT (to match old MGE DL, which
// had no host point lights). Now that near + far share one renderer AND baked point lights, the far
// path must tonemap too, or a bright point-light core stays hot on far while near's is rolled off
// (the "far has a brighter core" difference). Maps 0->0, 1->0.84, clamps 2.2->1.0.
float3 tonemap(float3 c)
{
    c = clamp(c, 0.0f, 2.2f);
    c = (((0.0548303f * c - 0.189786f) * c - 0.154732f) * c + 1.12969f) * c;
    return c;
}

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float2, Uv,       TEXCOORD0);
    DATA(float3, WorldPos, TEXCOORD1);
    DATA(float,  Fog,      TEXCOORD2);
};

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN( VSOutput In )
{
    INIT_MAIN;
    uint baseIdx   = (uint)(gFrameData.lodParams.x + 0.5f);
    uint normalIdx = (uint)(gFrameData.lodParams.y + 0.5f);
    uint detailIdx = (uint)(gFrameData.lodParams.z + 0.5f);

    // Expand + normalize the world normal map (XE Mod Landscape.fx:83).
    float3 normal = normalize(2.0f * SampleTex2D(gTextures[normalIdx], gSamplerAnisotropic, In.Uv).rgb - 1.0f);

    // World base colour.
    float3 result = SampleTex2D(gTextures[baseIdx], gSamplerAnisotropic, In.Uv).rgb;
    float3 albedo = result;   // Phase C: kept for the additive point-light term below

    // Two-scale tiled detail (XE Mod Landscape.fx:89-90).
    float detail = SampleTex2D(gTextures[detailIdx], gSamplerAnisotropic, In.Uv * 333.0f).g + 0.5f;
    detail *= 0.5f * SampleTex2D(gTextures[detailIdx], gSamplerAnisotropic, In.Uv * 90.0f).g + 0.75f;

    // Sun diffuse (to-sun = -sunDir) + distant-land ambient. Matches LandscapePS:93.
    result *= gFrameData.sunCol.rgb * saturate(dot(-gFrameData.sunDir.xyz, normal)) + gFrameData.lodSunAmb.rgb;
    result *= detail;

    // Phase C: baked DISTANT point lights. gLights is bound to the streamed baked set (camera-relative
    // positions — In.WorldPos is also camera-relative here), packed exactly like the near path: per
    // light [i*3+0]=(pos.xyz, radius), [i*3+1]=col.rgb, [i*3+2]=(k0,k1,k2). This replicates the near
    // opaque.frag evalOnePointLight form; the additive diffuse is modulated by albedo + detail so it
    // matches the sun term's shading, then fogged with everything else below.
    // Clustered forward: when the froxel grid is active (froxelDims.x > 0) loop ONLY this fragment's
    // froxel lights (128-bit mask from gFroxelMask); else fall back to the brute gLights loop. Both
    // paths share ONE inlined per-light body — the brute path just synthesizes full-word bitmasks, so
    // the froxel result is byte-identical to brute, just far fewer iterations. Slice metric =
    // length(In.WorldPos), matching froxelassign.comp.
    float3 pointDiffuse = float3(0.0f, 0.0f, 0.0f);
    {
        uint  nL     = (uint)gLights.lightParams.x;
        float reachK = gLights.lightParams.y;
        int   tilesX = (int)gFrameData.froxelDims.x;
        bool  clustered = (tilesX > 0);
        uint  base = 0u;
        if (clustered)
        {
            int   tilesY = (int)gFrameData.froxelDims.y;
            int   NZ     = (int)gFrameData.froxelDims.z;
            float tile   = gFrameData.froxelDims.w;
            int tx = clamp((int)(In.Position.x / tile), 0, tilesX - 1);
            int ty = clamp((int)(In.Position.y / tile), 0, tilesY - 1);
            float dd = length(In.WorldPos);
            int zs = clamp((int)((log(max(dd, 1.0f)) - gFrameData.froxelZ.x) * gFrameData.froxelZ.y * (float)NZ), 0, NZ - 1);
            base = (((uint)ty * (uint)tilesX + (uint)tx) * (uint)NZ + (uint)zs) * 4u;
        }
        for (uint wi = 0u; wi < 4u; ++wi)
        {
            uint bits;
            if (clustered) {
                bits = gFroxelMask[base + wi];
            } else {
                uint lo = wi * 32u;
                uint cnt = (lo >= nL) ? 0u : min(32u, nL - lo);
                bits = (cnt >= 32u) ? 0xFFFFFFFFu : ((1u << cnt) - 1u);
            }
            while (bits != 0u)
            {
                uint i = wi * 32u + firstbitlow(bits);
                bits = bits & (bits - 1u);
                if (i >= nL) { continue; }
                float4 posR = gLights.lights[i * 3u + 0u];
                float3 lcol = gLights.lights[i * 3u + 1u].rgb;
                float3 fo   = gLights.lights[i * 3u + 2u].xyz;   // k0, k1, k2
                float  reach = posR.w * reachK;
                float3 toL  = posR.xyz - In.WorldPos;
                float  d2   = dot(toL, toL);
                if (d2 >= reach * reach) { continue; }
                float invD = rsqrt(max(d2, 1e-8f));
                float d    = d2 * invD;
                float att  = 1.0f / max(fo.z * d2 + fo.y * d + fo.x, 1e-4f);
                att *= 1.0f - smoothstep(POINT_LIGHT_TAIL * reach, reach, d);
                float lambert = saturate(dot(normal, toL) * invD);
                pointDiffuse += lambert * att * lcol;
            }
        }
    }
    result += albedo * pointDiffuse * detail;

    // Match the near path: tonemap the final lit colour BEFORE fog (opaque.frag order). This rolls
    // off the bright point-light core the same way, so near/far cores agree.
    result = tonemap(result);

    // Placeholder distant fog (Phase 1c = atmospheric scatter). lerp toward fogColNear by Fog.
    result = lerp(gFrameData.fogColNear.rgb, result, In.Fog);

    // F12 distance grayscale parity (debugParams.x 1/2): far reads bright, matching opaque.frag.
    uint dbg = (uint)(gFrameData.debugParams.x + 0.5f);
    if (dbg == 1u || dbg == 2u) {
        float dist = length(In.WorldPos - gFrameData.eyePos.xyz);
        float g = saturate(dist * (1.0f / 8192.0f));
        RETURN(float4(g, g, g, 1.0f));
    }
    RETURN(float4(result, 1.0f));
}
