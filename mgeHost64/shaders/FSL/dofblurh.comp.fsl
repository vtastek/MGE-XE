// mgeHost64 — DoF D2: the disc kernel's HORIZONTAL pass. Read dof.srt.h first.
//
// Per pixel, the tile's radius R (gDofTileNb). A sharp tile (R < 0.5) writes nothing. Otherwise
// 2*ceil(R)+1 taps along the row, each weighted by BOTH components' complex taps F0/F1(i, R) and by its
// own COVERAGE of this pixel (dofCoverage: scatter-as-gather). The sums are divided by component 0's
// envelope sum — one scale for both, so they stay comparable — which depends on R alone, so values
// stay at the scale of the input and an HDR row fits in fp16.

#include "dof.srt.h"
#include "dofcommon.h.fsl"

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN( SV_DispatchThreadID(uint3) DispatchThreadID )
{
    INIT_MAIN;

    int2 p        = int2(DispatchThreadID.xy);
    int2 deliverN = int2(gDofParams.rects.xy);
    if (p.x >= deliverN.x || p.y >= deliverN.y)
    {
        RETURN();
    }
    float R = LoadRWTex2D(gDofTileNb, p / DOF_TILE);
    if (R < 0.5f)
    {
        RETURN();
    }
    float  Rk  = max(R, 1.0f);
    int    n   = int(ceil(R));
    float  cp  = LoadRWTex2D(gDofCoc, p);
    float4 re0 = f4(0.0f);
    float4 im0 = f4(0.0f);
    float4 re1 = f4(0.0f);
    float4 im1 = f4(0.0f);
    float4 wc  = f4(0.0f);
    float  env = 0.0f;
    for (int i = -n; i <= n; ++i)
    {
        float2 F0 = dofKernelTap(float(i), Rk, DOF_K0.xy);
        float2 F1 = dofKernelTap(float(i), Rk, DOF_K1.xy);
        float  x  = DOF_KEDGE * float(i) / Rk;
        env += exp(-DOF_K0.x * x * x);
        int2  s  = int2(clamp(p.x + i, 0, deliverN.x - 1), p.y);
        float cs = LoadRWTex2D(gDofCoc, s);
        float w  = dofCoverage(cs, cp, abs(float(i)));
        if (w > 0.0f)
        {
            float4 col = LoadTex2D(gDofColor, NO_SAMPLER, s, 0) * w;
            re0 += F0.x * col;
            im0 += F0.y * col;
            re1 += F1.x * col;
            im1 += F1.y * col;
            wc  += float4(F0, F1) * w;
        }
    }
    float inv = 1.0f / max(env, 1.0e-6f);
    Write2D(gDofRe,  p, re0 * inv);
    Write2D(gDofIm,  p, im0 * inv);
    Write2D(gDofRe1, p, re1 * inv);
    Write2D(gDofIm1, p, im1 * inv);
    Write2D(gDofW,   p, wc * inv);
}
