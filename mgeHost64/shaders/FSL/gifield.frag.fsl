// mgeHost64 — GI FIELD producer (tasks/forge-gi.md v2; memory feedback_gi_is_energy_and_tint).
//
// One texel = the average RGB radiance the WORLD SURFACE reflects over a 512-unit square of
// gSkyHeight's window (same mapping, gShadowParams.skyAOMap): albedo x (sun x sun visibility x N.L +
// ambient x upward share). It is what an occluded receiver nearby actually sees in place of the sky,
// so skyamb.h.fsl uses it as the occluded share's fill instead of a constant.
//
// Deliberately LOW-FREQUENCY and DETERMINISTIC (the user: "boundaries, gradients, not really shapes",
// "hate bubbling, pixels"): a fixed 4x4 sample grid per texel, no rays, no noise; the host blends each
// frame's result into the display texture at gShadowParams.skyAOFloor.w, so a change (sun, weather,
// window scroll) eases in over about a second instead of stepping.
//
// Inputs, all already resident for other features:
//   gSkyHeight  — top-down max(terrain, statics) height: the surface Z and, by differences, its normal;
//   gSunOcc     — the sun-blocked Z per texel (long-range sun visibility, same window);
//   gTerrainTex + gTerrainArrays — each land square's texture; its last mip is its mean colour.
// Statics on top of the ground get the ground's albedo (the map cannot tell a roof's colour), water
// below the plane a dark constant.

#include "opaque.srt.h"
#include "terraindisp.h.fsl"   // terrainCellAt / landSquareIndexVS / TERRAIN_* (grid lookups)

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float2, Uv,       TEXCOORD0);
};

#define GI_SUB 4

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN( VSOutput In )
{
    INIT_MAIN;
    const float4 m      = gShadowParams.skyAOMap;
    const float  extent = 1.0f / max(m.z, 1.0e-9f);
    const int2   hdim = GetDimensions(gSkyHeight, NO_SAMPLER);
    const float2 texH = 1.0f / float2(max(hdim, int2(1, 1)));

    const uint spanX = (uint)gShadowParams.terrainDisp3.z;
    const uint spanY = (uint)gShadowParams.terrainDisp3.w;
    const float3 L   = -normalize(gFrameData.sunDir.xyz);
    const bool  water = gShadowParams.waterFogPlane.w > 0.5f;
    const float waterZ = gShadowParams.waterFogPlane.x;

    // The output texel's footprint in uv, sampled on a fixed GI_SUB x GI_SUB grid.
    const float2 dOut = float2(ddx(In.Uv.x), ddy(In.Uv.y));
    float3 acc = float3(0.0f, 0.0f, 0.0f);
    float  n   = 0.0f;
    for (int sy = 0; sy < GI_SUB; ++sy)
    {
        for (int sx = 0; sx < GI_SUB; ++sx)
        {
            const float2 uv = In.Uv + (float2((float)sx, (float)sy) + 0.5f - 0.5f * (float)GI_SUB) / (float)GI_SUB * dOut;
            const float  z  = SampleLvlTex2D(gSkyHeight, gSamplerPointClamp, uv, 0.0f).r;
            if (z < -20000.0f) { continue; }   // SKY_HEIGHT_NONE: no surface here
            const float zx0 = SampleLvlTex2D(gSkyHeight, gSamplerPointClamp, uv - float2(texH.x, 0.0f), 0.0f).r;
            const float zx1 = SampleLvlTex2D(gSkyHeight, gSamplerPointClamp, uv + float2(texH.x, 0.0f), 0.0f).r;
            const float zy0 = SampleLvlTex2D(gSkyHeight, gSamplerPointClamp, uv - float2(0.0f, texH.y), 0.0f).r;
            const float zy1 = SampleLvlTex2D(gSkyHeight, gSamplerPointClamp, uv + float2(0.0f, texH.y), 0.0f).r;
            const float  span = 2.0f * extent * texH.x;
            float3 N = normalize(float3(-(max(zx1, -20000.0f) - max(zx0, -20000.0f)) / span,
                                        -(max(zy1, -20000.0f) - max(zy0, -20000.0f)) / span, 1.0f));
            const float2 wxy = m.xy + uv * extent;

            float3 albedo = float3(0.25f, 0.25f, 0.25f);
            float  zs = z;
            if (water && z < waterZ)
            {
                albedo = float3(0.04f, 0.05f, 0.06f);
                N = float3(0.0f, 0.0f, 1.0f);
                zs = waterZ;
            }
            else if (spanX != 0u && spanY != 0u)
            {
                const float invCell = 1.0f / (TERRAIN_SPACING * float(TERRAIN_QUADS));
                const float cx = floor(wxy.x * invCell);
                const float cy = floor(wxy.y * invCell);
                const int   lx = (int)cx - (int)gShadowParams.terrainDisp3.x;
                const int   ly = (int)cy - (int)gShadowParams.terrainDisp3.y;
                const float gx = (wxy.x - cx * (TERRAIN_SPACING * float(TERRAIN_QUADS))) / TERRAIN_SPACING;
                const float gy = (wxy.y - cy * (TERRAIN_SPACING * float(TERRAIN_QUADS))) / TERRAIN_SPACING;
                const int   tx = clamp((int)(gx * 0.25f), 0, 15);
                const int   ty = clamp((int)(gy * 0.25f), 0, 15);
                const uint  idx = landSquareIndexVS(lx, ly, spanX, spanY, tx, ty);
                if (idx != TERRAIN_NO_SQUARE_VS)
                {
                    const uint slot = gTerrainTex[idx];
                    albedo = SampleLvlDispArray(gTerrainArrays[slot >> 16u], gSamplerBilinearWrap,
                                                float3(0.5f, 0.5f, float(slot & 0xFFFFu)), 14.0f).rgb;
                }
            }

            // Sun visibility from the long-range map (msmrecv.h.fsl sunOccMapOcclusion, inline: its
            // include chain wants the receiver's whole context).
            float sunVis = 1.0f;
            const float4 so = gShadowParams.sunOcc;
            if (so.x > 0.0f)
            {
                const float blockZ = SampleLvlTex2D(gSunOcc, gSamplerBilinearClamp, uv, 0.0f).r;
                float t = saturate(((blockZ - so.z) - (zs + 8.0f)) / max(so.y, 1.0e-3f));
                t = t * t * (3.0f - 2.0f * t);
                sunVis = 1.0f - t * so.x;
            }
            const float  ndl = saturate(dot(N, L));
            const float3 rad = albedo * (gFrameData.sunCol.rgb * ndl * sunVis
                                       + gFrameData.ambCol.rgb * (0.5f + 0.5f * N.z));
            acc += rad;
            n   += 1.0f;
        }
    }
    const float3 avg = (n > 0.0f) ? acc / n : float3(0.0f, 0.0f, 0.0f);
    // alpha = this frame's blend weight; with the host's (SRC_ALPHA, INV_SRC_ALPHA) colour blend and
    // (ONE, INV_SRC_ALPHA) alpha blend the display holds premultiplied radiance and its alpha climbs
    // to 1 = "settled". A texel with no surface contributes weight 0.
    const float a = (n > 0.0f) ? gShadowParams.skyAOFloor.w : 0.0f;
    RETURN(float4(avg, a));
}
