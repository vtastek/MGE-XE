// mgeHost64 — Phase F distant-light GLOW billboard (fragment stage, host-owned, PRIVATE frag).
//
// Additive procedural sprite: a radial analytic falloff, no texture. The colour (light chromaticity)
// and intensity ride FLAT per-instance; the radial UV is the only smooth interpolator (non-centroid,
// matching convention — no lighting term needs `centroid` here). Output float4(Colour·f, Intensity·f)
// with f = saturate(1 - r²)² — the additive PSO (SRCALPHA/ONE) accumulates dst += rgb·a, so the
// on-screen contribution is Colour·Intensity·f². LDR ceiling (B8G8R8A8 clamps additive at 1.0/channel)
// is known + temporary — fine to PROVE the pass; overshoot for bloom waits on the HDR post path.
//
// DELIBERATELY UNCONVERTED under step 6a — class 3, and the only member of it (scenecolor.h.fsl).
// Every other never-tonemapped pass takes liftInPass() so the curve moving into resolve.frag cannot
// dim it, but this one reproduces nothing: Colour·Intensity·f² is invented radiance with a host
// knob behind it, and liftInPass clamps its input to [0,1] — i.e. it would clamp away precisely the
// overshoot the line above is waiting for. So it writes raw and lets the resolve roll it off. If
// these read dim once HDR is on, the answer is the Intensity knob, not a lift.
//
// Own VSOutput (private frag ⇒ no shared-frag hazard); shares opaque.srt.h / DefaultRootSignature.

#include "opaque.srt.h"

STRUCT(VSOutput)
{
    DATA(float4,       Position,  SV_Position);
    DATA(float2,       Uv,        TEXCOORD0);
    DATA(FLAT(float3), Colour,    TEXCOORD1);
    DATA(FLAT(float),  Intensity, TEXCOORD2);
    DATA(FLAT(float),  Fog,       TEXCOORD3);
};

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN( VSOutput In )
{
    INIT_MAIN;
    float r2 = dot(In.Uv, In.Uv);
    float f  = saturate(1.0f - r2);
    f = f * f;                                  // saturate(1 - r²)²
    // Fog fades the sprite toward 0, the ADDITIVE identity (glow.vert). On BOTH lanes: the PSO
    // accumulates dst += rgb·a, so dimming only one of them still leaves the product carrying a
    // fogged light at reduced-but-nonzero strength. Squaring the fade this way also matches the
    // sprite's own f² contribution curve, so a light dims as it recedes rather than shrinking.
    float fg = saturate(In.Fog);
    RETURN(float4(In.Colour * f * fg, In.Intensity * f * fg));
}
