// mgeHost64 — Tier 2: GTAO compute stage (horizon-search AO + native bent normals, option A).
//
// Reads the single-sample reverse-Z DEVICE depth (gLinearDepthIn from the linearize pass),
// reconstructs WORLD positions per tap via gAOParams.invViewProj (only the combined viewProj is
// available host-side — no separate view/proj — so the whole search runs in world space keyed off
// gAOParams.eyePos), reconstructs the surface normal from min-difference depth neighbours, runs a
// Jimenez-style GTAO horizon integral, and writes float4(bentNormalWS, visibility) to gAOOut.
//
//   a (visibility)  : 1 = fully open (white), 0 = fully occluded (cavity). Tier 3 will do ambient *= a.
//   rgb (bent normal): world-space mean unoccluded direction (debug mode 4 shows it *0.5+0.5).
//
// Tier 2 is AO-in-isolation: nothing here feeds the colour pass except the F12 debug views. Seeds
// follow scene-walk (radius/falloff/intensity in gAOParams); they are WORLD-unit knobs and may need
// MW-scale tuning — host-side constants, one line to change. Spatial/temporal denoise = follow-up.

#include "gtao.srt.h"

#define GTAO_PI       3.14159265359f
#define GTAO_HALF_PI  1.57079632679f
#define NUM_SLICES    2
#define NUM_STEPS     8

float3 reconstructWorld(float2 uv, float deviceZ)
{
    float ndcX = uv.x * 2.0f - 1.0f;
    float ndcY = 1.0f - uv.y * 2.0f;
    float4 p = mul(gAOParams.invViewProj, float4(ndcX, ndcY, deviceZ, 1.0f));
    return p.xyz / p.w;
}

float loadDeviceZ(int2 c)
{
    return LoadTex2D(gLinearDepthIn, NO_SAMPLER, c, 0).r;
}

// Interleaved gradient noise — rotates the slice set per pixel to hide banding.
float ignoise(float2 p)
{
    return frac(52.9829189f * frac(dot(p, float2(0.06711056f, 0.00583715f))));
}

// One side of one slice: GTAO inner integral term for a clamped horizon angle h vs normal angle n.
float gtaoInner(float h, float n)
{
    return 0.25f * (-cos(2.0f * h - n) + cos(n) + 2.0f * h * sin(n));
}

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN( SV_DispatchThreadID(uint3) DispatchThreadID )
{
    INIT_MAIN;
    int2   px        = int2(DispatchThreadID.xy);
    float2 screen    = gAOParams.screenParams.xy;
    float2 invScreen = gAOParams.screenParams.zw;
    float2 uv        = (float2(px) + 0.5f) * invScreen;

    float deviceZ = loadDeviceZ(px);
    // Reverse-Z far/cleared = 0.0 (sky / no geometry) → fully unoccluded.
    if (deviceZ <= 0.0f)
    {
        Write2D(gAOOut, px, float4(0.0f, 0.0f, 1.0f, 1.0f));
        RETURN();
    }

    float3 P = reconstructWorld(uv, deviceZ);
    float3 V = normalize(gAOParams.eyePos.xyz - P);

    // Screen-axis world deltas (also map screen directions → world tangent for the slices).
    float3 Pr = reconstructWorld(uv + float2(invScreen.x, 0.0f), loadDeviceZ(px + int2(1, 0)));
    float3 Pl = reconstructWorld(uv - float2(invScreen.x, 0.0f), loadDeviceZ(px - int2(1, 0)));
    float3 Pu = reconstructWorld(uv + float2(0.0f, invScreen.y), loadDeviceZ(px + int2(0, 1)));
    float3 Pd = reconstructWorld(uv - float2(0.0f, invScreen.y), loadDeviceZ(px - int2(0, 1)));

    // Min-difference neighbours (smaller world gap = same surface; rejects silhouette bleed).
    float3 dxr = Pr - P, dxl = P - Pl;
    float3 ddxv = (dot(dxr, dxr) < dot(dxl, dxl)) ? dxr : dxl;
    float3 dyr = Pu - P, dyl = P - Pd;
    float3 ddyv = (dot(dyr, dyr) < dot(dyl, dyl)) ? dyr : dyl;
    float3 N = normalize(cross(ddxv, ddyv));
    if (dot(N, V) < 0.0f) { N = -N; }   // orient toward the camera

    // Adaptive screen radius: keep the world search extent ~constant regardless of distance.
    float wpp = max(min(length(dxr), length(dxl)), 1e-4f);   // world units per pixel (approx)
    float radiusWorld = gAOParams.aoParams.x;
    float searchPixels = clamp(radiusWorld / wpp, 2.0f, 96.0f);
    float stepPx = searchPixels / float(NUM_STEPS);
    float falloff = max(gAOParams.aoParams.y, 1e-3f);

    float  rnd   = ignoise(float2(px));
    float  ao    = 0.0f;
    float3 bentN = float3(0.0f, 0.0f, 0.0f);

    UNROLL
    for (int s = 0; s < NUM_SLICES; ++s)
    {
        float  phi = (float(s) + rnd) * (GTAO_PI / float(NUM_SLICES));
        float2 dir = float2(cos(phi), sin(phi));            // screen-space (pixels)
        float3 sliceDirW = normalize(ddxv * dir.x + ddyv * dir.y);

        // Slice plane spanned by V and sliceDirW; project the normal into it.
        float3 planeN = normalize(cross(sliceDirW, V));
        float3 Np = N - planeN * dot(N, planeN);
        float  nLen = length(Np);
        if (nLen < 1e-4f) { continue; }
        float3 Npn = Np / nLen;
        float  n = atan2(dot(Npn, sliceDirW), dot(Npn, V));  // projected-normal angle from V

        float2 cosH = float2(-1.0f, -1.0f);   // x = +dir horizon cos, y = -dir horizon cos

        for (int t = 1; t <= NUM_STEPS; ++t)
        {
            float off = (float(t) - 0.5f) * stepPx;
            // +dir
            int2  scp = px + int2(dir * off + 0.5f);
            float dzp = loadDeviceZ(scp);
            if (dzp > 0.0f)
            {
                float3 S = reconstructWorld((float2(scp) + 0.5f) * invScreen, dzp);
                float3 ds = S - P;
                float  dl = length(ds);
                float  c  = dot(ds / max(dl, 1e-6f), V);
                c = lerp(-1.0f, c, saturate(1.0f - dl / falloff));   // distance falloff
                cosH.x = max(cosH.x, c);
            }
            // -dir
            int2  scm = px - int2(dir * off + 0.5f);
            float dzm = loadDeviceZ(scm);
            if (dzm > 0.0f)
            {
                float3 S = reconstructWorld((float2(scm) + 0.5f) * invScreen, dzm);
                float3 ds = S - P;
                float  dl = length(ds);
                float  c  = dot(ds / max(dl, 1e-6f), V);
                c = lerp(-1.0f, c, saturate(1.0f - dl / falloff));
                cosH.y = max(cosH.y, c);
            }
        }

        // Clamp horizons into the visible hemisphere around the projected normal.
        float th1 = n + max(-acos(clamp(cosH.y, -1.0f, 1.0f)) - n, -GTAO_HALF_PI);   // -dir (<=0)
        float th2 = n + min( acos(clamp(cosH.x, -1.0f, 1.0f)) - n,  GTAO_HALF_PI);   // +dir (>=0)
        ao += nLen * (gtaoInner(th1, n) + gtaoInner(th2, n));

        float  bentAngle = 0.5f * (th1 + th2);
        bentN += (V * cos(bentAngle) + sliceDirW * sin(bentAngle)) * nLen;
    }

    ao = saturate(ao / float(NUM_SLICES));
    // intensity scales OCCLUSION (scene-walk feel: forwardAO = 1 - intensity*occlusion).
    float occ = (1.0f - ao) * gAOParams.aoParams.z;
    float vis = saturate(1.0f - occ);

    float3 bn = bentN + N * 1e-3f;   // guard fully-degenerate accumulation
    bn = normalize(bn);

    Write2D(gAOOut, px, float4(bn, vis));
    RETURN();
}
