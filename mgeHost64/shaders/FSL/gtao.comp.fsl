// mgeHost64 — GTAO: ground-truth ambient occlusion (Jimenez et al. 2016), + native bent normals.
//
// Mode 0 of four (see aocommon.h.fsl for the shared core and the invariants all four keep;
// hbao/vbao/ssaofast are the others). This is the reference mode: a cosine-weighted horizon-arc
// integral, which is what "ground truth" in the name refers to — the other three approximate it.
//
// Per slice:
//   1. Build an orthonormal basis (V, T) in the slice plane; every angle below is measured from V
//      toward T, so a tap's angle is +acos(dot(d,V)) on the +T side and -acos(...) on the -T side.
//   2. Project the surface normal into that plane: its angle n and its length projLen (the slice's
//      weight — a slice edge-on to the normal contributes almost nothing, which is what makes the
//      few-slice average come out right).
//   3. Search the horizon on each side as a RUNNING MAX of dot(d, V): the tap closest in angle to
//      the view ray is the one that occludes most. Distance-attenuated taps lerp toward -1 (fully
//      open), so the falloff can only ever REDUCE occlusion, monotonically in distance.
//   4. Clamp each horizon into the hemisphere around n (n +- 90 degrees = fully open) and evaluate
//      the arc integral. A flat plane has no tap above its own tangent plane, so both horizons hit
//      the clamp exactly and the slice integrates to 1 at ANY camera angle — the view-independence
//      the whole design rests on.
//
// The bent normal is the mid-angle of the open arc, accumulated in the same (V,T) basis and
// weighted by projLen. opaque.frag/multimap.frag shade with it when "bent normal" is ticked.

#include "gtao.srt.h"
#include "aocommon.h.fsl"

// Inner term of the GTAO arc integral for one clamped horizon angle h against the in-slice normal
// angle n. It is the antiderivative of cos(theta - n)*|sin theta| plus the constant that makes the
// two sides sum from the shared origin at theta = 0.
float gtaoInner(float h, float n)
{
    return 0.25f * (-cos(2.0f * h - n) + cos(n) + 2.0f * h * sin(n));
}

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN( SV_DispatchThreadID(uint3) DispatchThreadID )
{
    INIT_MAIN;
    int2   px        = int2(DispatchThreadID.xy);
    float2 screen    = gAOParams.screenParams.xy;
    float2 invScreen = gAOParams.screenParams.zw;
    if (px.x >= (int)screen.x || px.y >= (int)screen.y)
    {
        RETURN();
    }
    float2 uv = (float2(px) + 0.5f) * invScreen;

    float3 P, N, V, ddxv, ddyv;
    float  wpp;
    if (!aoSurface(px, uv, invScreen, P, N, V, ddxv, ddyv, wpp))
    {
        Write2D(gAOOut, px, AO_SKY_RESULT);
        RETURN();
    }

    int    slices = aoSlices();
    int    steps  = aoSteps();
    float  stepPx = aoStepPixels(wpp, steps);
    float2 dither = aoDither(px);
    float  bias   = aoBias();

    float  visSum  = 0.0f;
    float3 bentSum = float3(0.0f, 0.0f, 0.0f);

    for (int s = 0; s < slices; ++s)
    {
        float  phi = (float(s) + dither.x) * (AO_PI / float(slices));
        float2 dir = float2(cos(phi), sin(phi));

        // In-slice basis: T is the slice direction made perpendicular to V.
        float3 T  = aoSliceDirW(ddxv, ddyv, dir);
        T = T - V * dot(T, V);
        float tl = length(T);
        if (tl < 1e-5f)
        {
            continue;   // degenerate slice (looking straight down this tangent)
        }
        T = T / tl;

        // Normal projected into the slice plane.
        float nV      = dot(N, V);
        float nT      = dot(N, T);
        float projLen = sqrt(nV * nV + nT * nT);
        if (projLen < 1e-5f)
        {
            continue;
        }
        float n = atan2(nT, nV);

        // Horizon search, running max of the cosine to V. -1 = nothing found = fully open.
        float cosP = -1.0f;
        float cosM = -1.0f;
        for (int t = 0; t < steps; ++t)
        {
            float off = aoStepOffset(t, stepPx, dither.y);

            int2  sp = aoTap(px, dir, off);
            float zp = aoLoadZ(sp);
            if (zp > 0.0f)
            {
                float3 ds = aoReconstructWorld((float2(sp) + 0.5f) * invScreen, zp) - P;
                float  dl = max(length(ds), 1e-6f);
                float3 d  = ds / dl;
                if (dot(d, N) > bias)   // must rise above the tangent plane: view-independent
                {
                    cosP = max(cosP, lerp(-1.0f, dot(d, V), aoFalloffWeight(dl)));
                }
            }

            int2  sm = aoTap(px, -dir, off);
            float zm = aoLoadZ(sm);
            if (zm > 0.0f)
            {
                float3 ds = aoReconstructWorld((float2(sm) + 0.5f) * invScreen, zm) - P;
                float  dl = max(length(ds), 1e-6f);
                float3 d  = ds / dl;
                if (dot(d, N) > bias)
                {
                    cosM = max(cosM, lerp(-1.0f, dot(d, V), aoFalloffWeight(dl)));
                }
            }
        }

        float h1 =  acos(clamp(cosP, -1.0f, 1.0f));   // +T side
        float h0 = -acos(clamp(cosM, -1.0f, 1.0f));   // -T side
        h1 = n + min(h1 - n,  AO_HALF_PI);
        h0 = n + max(h0 - n, -AO_HALF_PI);

        visSum += projLen * (gtaoInner(h0, n) + gtaoInner(h1, n));

        float bentAngle = 0.5f * (h0 + h1);
        bentSum += (V * cos(bentAngle) + T * sin(bentAngle)) * projLen;
    }

    // Per-slice values legitimately exceed 1 for a tilted normal and fall short for a slice
    // edge-on to it; projLen is what makes the average land back on 1. saturate() only guards the
    // few-slice residual.
    float vis = saturate(visSum / float(slices));
    Write2D(gAOOut, px, aoResolve(1.0f - vis, bentSum, N));
    RETURN();
}
