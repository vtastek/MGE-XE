// mgeHost64 — evaluate the SHADER's Hosek-Wilkie form at a fixed direction set, once, at startup.
//
// See hosekcheck.srt.h for why this exists. In one sentence: the model is evaluated twice, in two
// languages, and the two halves feed the sky and the light respectively — so the only honest way to
// claim they agree is to measure it.
//
// One group, kHosekCheckDirs threads, one dispatch per host session. The host reads the result back
// on a later frame (after the fence the frame already has) and prints the max relative deviation
// against its own Hosek::radiance() at the same directions.

#include "hosekcheck.srt.h"
#include "hosek.h.fsl"      // the expression under test — the SAME include skyhw.frag uses

// ⚠ NUM_THREADS TAKES A LITERAL, NOT A MACRO THAT EXPANDS TO ONE WITH A SUFFIX. fsl.py substitutes
// first and then asserts the result is either an integer literal or a known #define, so `64u` fails
// the build with "arg 64u to NUM_THREADS needs to be defined!". Written out here and kept in step
// with kHosekCheckDirs host-side (forgerender.cpp), which is the number that actually sizes the
// buffers — this shader only has to agree with it.
#define HOSEK_CHECK_DIRS 64u

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(64, 1, 1)
void CS_MAIN( SV_DispatchThreadID(uint3) DispatchThreadID )
{
    INIT_MAIN;
    uint i = DispatchThreadID.x;
    // ⚠ RETURN() ON ITS OWN LINE. fsl.py rewrites the macro statement-wise and leaves a
    // same-line `{ RETURN(); }` untranslated, which reaches DXC as a literal RETURN() and fails
    // with "expected expression" pointing at the FSL source. Every other compute shader in the tree
    // writes early-outs this way; this is why.
    if (i >= HOSEK_CHECK_DIRS)
    {
        RETURN();
    }

    float3 dir = normalize(gHosekDirs[i].xyz);
    float3 L   = hosekRadiance(dir);

    gHosekOut[i * 4u + 0u] = asuint(L.x);
    gHosekOut[i * 4u + 1u] = asuint(L.y);
    gHosekOut[i * 4u + 2u] = asuint(L.z);
    gHosekOut[i * 4u + 3u] = 1u;
    RETURN();
}
