// mgeHost64 — MB-2 pass 3: THE GATHER.  Read motionblur.srt.h first; it carries the whole argument.
//
// A 1D line integral along this pixel's velocity: the shutter was open for `shutter/360` of a frame,
// the pixel moved `v` in a frame, so what landed on it is the average of the scene along a segment
// of length `|v| * shutter/360` centred on where it is now.
//
// ⚠⚠ ONE PASS ALONG ONE DIRECTION, AND IT MUST STAY THAT WAY. Separating this into X-then-Y — the
// obvious next optimisation, and the one the dilation legitimately takes — turns a diagonal streak
// into an axis-aligned box. `max` is separable; a line integral is not a convolution and has no
// separable form. STRAFE to test it: a screenshot taken walking forward has every streak radial from
// screen centre and cannot tell the two apart.
//
// ⚠ EVERY FETCH IS AN INTEGER LOAD, NOT A SAMPLE. Two reasons, and the second is the load-bearing
// one: (1) the adaptive tap count puts the taps at most ~1.25 px apart, so a bilinear filter would
// add almost nothing; (2) every screen target here is ALLOC-sized with the frame in a sub-rect, so a
// hardware CLAMP address mode clamps to never-written border rather than to the frame
// ([[project_forge_alloc_vs_render_uv]]). Loads clamp in PIXEL space, against the rect the host put
// in the cbuffer, which is the only bound that is actually right.
//
// ⚠ THE COLOUR IS PREMULTIPLIED (rgb already scaled by coverage) and this is a FILTER, so every
// weight hits all four channels identically. Not a radiometric scale; see motionblur.srt.h.
//
// ⚠⚠ SINGLE EXIT, AND IT IS STRUCTURAL. Every early case here — out of rect, below the velocity
// floor, a sub-pixel streak — wants to be a RETURN() and is instead a branch that leaves `outv` as
// the centre pixel, because the statistics at the tail tree-reduce in groupshared and EVERY thread
// must reach EVERY GroupMemoryBarrier. A divergent return before a barrier is undefined behaviour of
// the kind that works on the hardware it was written on (cullscan / apl / atmos_sh all carry this
// note). The out-of-rect threads still compute; they simply do not WRITE and contribute 0.

#include "motionblur.srt.h"
#include "mbcommon.h.fsl"

#ifndef AtomicMax
#define AtomicMax(DEST, VALUE, ORIGINAL_VALUE) InterlockedMax(DEST, VALUE, ORIGINAL_VALUE)
#endif

GroupShared(uint, g_mbHit[64]);    // pixels that RAN the gather
GroupShared(uint, g_mbTaps[64]);   // their tap counts, summed
GroupShared(uint, g_mbLen[64]);    // their streak lengths, asuint, max-reduced
GroupShared(uint, g_mbChg[64]);    // pixels the gather actually CHANGED

ROOT_SIGNATURE(ComputeRootSignature)
NUM_THREADS(8, 8, 1)
void CS_MAIN( SV_DispatchThreadID(uint3) DispatchThreadID )
{
    INIT_MAIN;

    int2   p         = int2(DispatchThreadID.xy);
    float2 delivered = gMbParams.rects.xy;
    float2 mvRect    = gMbParams.rects.zw;
    int2   deliverN  = int2(delivered);

    // The dispatch covers the delivered rect rounded up to an 8x8 group, so the tail threads are
    // in-bounds for the resource and OUTSIDE the frame. They must not WRITE — the resolve reads this
    // target clamped to the same rect, and a texel written outside it is one nobody will ever read —
    // but they must still run, for the barrier reason above. Their loads are clamped into the rect,
    // so they read valid data and simply throw it away.
    bool inRect = (p.x < deliverN.x) && (p.y < deliverN.y);
    int2 pc     = clamp(p, int2(0, 0), max(deliverN - int2(1, 1), int2(0, 0)));

    float4 centre = LoadTex2D(gMbColor, NO_SAMPLER, pc, 0);
    float4 outv   = centre;

    int   K        = int(gMbParams.tile.x);
    // ⚠ THE MAXIMUM STREAK IS THE DILATION'S REACH (R*K), NOT THE TILE SIZE. They were one number
    // until MB-2l, which is why every clamp below used to read K. See motionblur.srt.h / mbcover.h.
    float maxLen   = gMbParams.opts2.z;
    int2  tiles    = int2(gMbParams.tile.yz);
    float outScale = gMbParams.tile.w;
    float shutter  = gMbParams.blur.x;
    uint  maxTaps  = uint(gMbParams.blur.y);
    float floorPx  = gMbParams.blur.z;
    float softZ    = gMbParams.blur.w;

    // This pixel's own velocity, and the fastest thing within one tile of it.
    int2   vq    = mbVelocityTexel(float2(pc), delivered, mvRect);
    float2 vSelf = LoadTex2D(gMbVelocity, NO_SAMPLER, vq, 0).xy * outScale;
    // ⚠⚠ JITTER THE TILE FETCH, BECAUSE A SHARED ANSWER OVER A HARD FOOTPRINT IS A GRID.
    //
    // Every pixel in a K-wide tile searches along that ONE tile's dominant velocity, and
    // NeighborMax is a 3x3 tile max, so at K=96 any mover within 288 px sets the direction for
    // your face. Cross a boundary, a different mover wins the max, and the direction flips along a
    // perfectly straight line on a 96 px grid. Reported from play as "half of it is blurred in one
    // direction, a clear straight seam, other half is blurred in another direction".
    //
    // MEASURED FROM THE SCREENSHOT, not inferred: edge energy binned by phase against candidate
    // periods over the blurred region of squaretiles.png (2560x1600) picks K=96 phase 0 on BOTH
    // axes — columns 1.26x the mean of other phases (z=+4.5), rows 1.30x (z=+4.7), against 1.12x
    // / 1.13x at 64 and 1.19x / 1.03x at 128. The grid is the tile grid, aligned to the origin.
    //
    // ⚠ K WAS NOT THE LEVER WHILE K WAS ALSO THE CLAMP, and the log said so: 17 of 55 windows
    // reported maxLen pinned at exactly 96, so LOWERING K clamped more streaks and RAISING it made
    // the tiles coarser. MB-2l removed that trade — the reach is R*K now — so K IS a lever, and the
    // jitter is no longer the only defence against the grid. It is still on, because a small tile
    // still has a boundary; it is simply now jittering by a much smaller K.
    //
    // Offsetting the lookup by up to half a tile per pixel means neighbours near a boundary
    // consult DIFFERENT tiles, so the step is spread over a K-wide band of dither instead of
    // landing on one line. The tap loop below is already dithered, so this is the same trade the
    // filter has already made once: structured artifacts read as bugs, noise reads as grain.
    // ⚠ A SECOND HASH, NOT THE TAP DITHER. Reusing mbDither(pc) for both would correlate the
    // tile a pixel consults with where it starts sampling, which is a pattern again.
    float2 tj = f2(0.0f);
    if (gMbParams.opts.x > 0.0f)
    {
        float r1 = mbDither(float2(pc) + f2(17.0f));
        float r2 = mbDither(float2(pc) + f2(37.0f));
        tj = (float2(r1, r2) - f2(0.5f)) * (float(K) * gMbParams.opts.x);
    }
    int2   tq    = clamp(int2((float2(pc) + tj) / float(max(K, 1))),
                         int2(0, 0), max(tiles - int2(1, 1), int2(0, 0)));
    float2 vTile = LoadRWTex2D(gMbTileIn, tq);

    // ⚠⚠ THE DILATED VELOCITY SETS THE DIRECTION AND EXTENT. IT DOES **NOT** SET THE ANSWER.
    // This is the correction that the first in-game look forced (*"motion blur in rectangular tiles
    // instead of on object's own pixels"*). The first build wrote
    //     float2 v = (dot(vTile,vTile) > dot(vSelf,vSelf)) ? vTile : vSelf;
    // which looks like a choice and is not one: vTile is a max over a 3x3 tile neighbourhood that
    // CONTAINS this pixel's own tile, so |vTile| >= |vSelf| identically and the ternary always picks
    // vTile. Every pixel in a tile was then blurred along that tile's dominant velocity — K-quantised
    // rectangles, which is precisely what was reported.
    //
    // The dilation still has to choose the SEARCH direction: that is what lets a mover's streak reach
    // past its own silhouette, and it is the entire reason the tile passes exist. What decides how
    // much of each tap survives is the AGREEMENT test below, on the tap's own velocity and this
    // pixel's own velocity. See mbcommon.h.fsl.
    float  speed = length(vTile);                 // the SEARCH speed — always >= |vSelf|
    // ⚠⚠ CLAMPED TO maxLen, AND SO IS THE TAP'S STREAK BELOW — THE WEIGHT MUST DESCRIBE THE
    // STREAK THAT WAS ACTUALLY SEARCHED. `d` is clamped to maxLen a few lines down because the cover
    // passes searched R tiles in each direction; for a while these two were not, and that asymmetry
    // WAS the tiling. mbCone is 1 - dist/streak, so a body whose true streak is 300 px against a
    // K of 96 scores >= 0.84 at EVERY tap the search can reach — the cone stops being a taper and
    // degenerates into a box average over the whole +-K/2 line, at near-uniform weight, which then
    // ends WHERE THE SEARCH ENDS rather than where the object's streak ends. The search ends at the
    // tile grid. Hence: "motion blur on bodies are too much, and tiles visible", one defect, and
    // the clamp on `d` alone could never have prevented it — shortening the search does not
    // shorten the claim.
    //
    // Measured on the session that reported it: `maxLen=96.00 px` pinned exactly at K with
    // `avgTaps=32.0` saturated, on 17 heartbeat windows, at a shutter scale of x1.56-1.85 (16.7 ms
    // exposure against a ~10 ms frame).
    //
    // With both clamped the filter is self-consistent: it weights as if the streak were K, tapers
    // to zero across the reach it has, and the only falloff left at the boundary is the ordinary
    // end-of-streak one a correct filter has anyway. The blur is then SHORTER than physical for
    // anything past K — which is the honest trade, and the direction the complaint points.
    float  selfStreak = min(length(vSelf) * shutter, maxLen);    // THIS pixel's own streak, px

    // The displacement during the exposure. ⚠ `shutter` here is `exposure_ms / frameDt_ms`, NOT
    // `angle/360`: the vector is per RENDERED FRAME, so a constant multiplier would shrink the smear
    // as the framerate rises — which is what the first build did and what "the blur is too subtle"
    // was. Dividing the real exposure by the real frame interval is what makes this independent of
    // the machine. See motionblur.srt.h.
    float2 d   = vTile * shutter;
    float  len = length(d);

    // ⚠ CLAMPED TO THE DILATION'S REACH. The cover passes searched R tiles in each direction, so no
    // pixel has been told about motion further away than R*K; a longer streak would run into pixels
    // whose tile never heard of it and end in a hard edge. The streak spans +-len/2, so this leaves
    // a factor of two in hand.
    if (len > maxLen)
    {
        d   = d * (maxLen / max(len, 1.0e-6f));
        len = maxLen;
    }

    // ── THE VELOCITY FLOOR, AND IT IS AN EXACT PASS-THROUGH ──────────────────────────────────────
    // ⚠⚠ MANDATORY. Only a BIT-IDENTICAL camera frame reaches exact zero, and MW's camera matrix is
    // bit-stable on a MINORITY of parked frames (measured worst deltas 4.3e-4, 2.9e-11, 1.5e-3
    // across three consecutive still frames — on most of them the camera really did move a hair and
    // the small vector is the CORRECT answer, which is precisely why it cannot be fixed upstream).
    // Without this every still frame gets a sub-pixel smear, and a still image that softens is the
    // most visible failure available to this pass.
    //
    // ⚠ TESTED ON THE **DILATED** SPEED, not this pixel's own. A static pixel that a fast mover is
    // sweeping across must still run the gather — that is where the mover's colour comes from. The
    // weights, not the gate, are what leave it untouched when nothing actually reaches it.
    bool blurred = (speed >= floorPx) && (len >= 1.0e-4f);

    // ── THE ADAPTIVE TAP COUNT, WHICH THE DX9 FILTER COMPUTED AND THEN NEVER USED ────────────────
    // One tap per pixel of streak, floored at 3 (below that the box is not a box) and capped by the
    // knob. A 4 px streak costs 4 taps; only genuinely fast motion pays the maximum. The original
    // derived exactly this number and then ran its loop to MAX_SAMPLES, so it was a fixed 9-tap that
    // oversampled every slow pixel and undersampled every fast one.
    uint taps = clamp(uint(ceil(len)), 3u, max(maxTaps, 3u));

    // Did anything actually reach this pixel? Distinct from `blurred`, which only says the gather
    // RAN — see the statistics at the tail, and the report that made the difference matter.
    bool changed = false;
    // MB-2k rides inside MB-2j: it re-weights a mixture that only the corrected reconstruction
    // produces, so arming it against the legacy weighting would describe nothing.
    bool prov = (gMbParams.opts.w > 0.5f) && (gMbParams.opts2.x > 0.5f);

    // MB-2i. Split the accepted weight by whether the tap was NEARER than this pixel or not, so
    // "nothing reached me" and "something in front reached me" stop being the same picture. Cost
    // when the diagnostic is off: two adds in a loop that already does four texture loads.
    float wFront = 0.0f;
    float wBack  = 0.0f;
    // ⚠ THE THIRD BUCKET IS THE ONE THAT MATTERED. The first cut of this lumped "a tap on my own
    // surface" in with "a tap behind me", and they are the same colour for opposite reasons: the
    // second is correct occlusion, the first is the pixel counting ITSELF over and over.
    float wSame  = 0.0f;

    if (blurred)
    {
        // A per-pixel offset inside the tap spacing. Turns the banding of a low tap count into grain.
        float  jitter  = mbDither(float2(pc)) - 0.5f;
        // ⚠⚠ AND SAMPLE ALONG THIS PIXEL'S OWN VELOCITY TOO, NOT ONLY THE TILE'S.
        //
        // The tile direction exists so a fast NEIGHBOUR can smear onto you; it is the wrong axis
        // for your own streak whenever the tile is not velocity-coherent, which is exactly the
        // case that draws the seam. Alternating taps between the two axes (Jimenez) means a face
        // is sampled along the FACE's direction on both sides of a boundary, whichever mover won
        // the tile max — so the answer stops depending on which tile the pixel fell in.
        //
        // Clamped to K like the tile axis, for the reason selfStreak is: the weight must describe
        // the streak that was actually searched.
        float2 dSelf   = vSelf * shutter;
        float  lenSelf = length(dSelf);
        if (lenSelf > maxLen) { dSelf = dSelf * (maxLen / max(lenSelf, 1.0e-6f)); lenSelf = maxLen; }
        // ⚠ OFF BELOW A PIXEL OF OWN MOTION. A static pixel has no axis of its own, and
        // splitting its budget onto a zero-length one would collapse half the taps onto the centre
        // and over-weight it — the static world must keep the single-axis behaviour exactly.
        bool   twoDir  = (gMbParams.opts.y > 0.5f) && (lenSelf >= 1.0f) && (taps >= 4u);
        uint   nHalf   = max(taps >> 1u, 1u);
        float  dCentre = LoadTex2D(gMbDepth, NO_SAMPLER, vq, 0).r;

        // ⚠ THE CENTRE IS IN THE SUM WITH WEIGHT 1, ALWAYS, AND THAT IS WHAT MAKES THIS SAFE BY
        // CONSTRUCTION. Every tap weight below is >= 0, so the denominator is >= 1 and can never be
        // zero — which retires the `wsum > 1e-5 ? sum/wsum : centre` branch the first build needed
        // ([[project_nan_survives_zero_multiply]] is handled by arithmetic here rather than by a
        // guard). It also gives the exactly-right answer in the case this whole change is about: a
        // static pixel whose every tap disagrees keeps weight 1 on itself and 0 elsewhere, so it
        // comes out BIT-IDENTICAL to the source rather than merely close to it.
        float4 sum  = centre;
        float  wsum = 1.0f;

        // ── MB-2k: "HOW MUCH BACKGROUND" AND "WHICH BACKGROUND" ARE DIFFERENT QUESTIONS ──────────
        // The revealed background is kept in its own bucket: `covB` is how much of the exposure it
        // is entitled to (which MB-2j already gets right), `sumB/wB` is what colour it wears. See
        // the block in the loop for why those two must not be decided by the same weight.
        float4 sumB = f4(0.0f);
        float  wB   = 0.0f;
        float  covB = 0.0f;

        // ── THE SHUTTER INTEGRAL, WEIGHTED BY WHAT COULD ACTUALLY HAVE REACHED HERE ──────────────
        // The shutter is open or it is not, so the kernel ALONG the streak is uniform — there is no
        // cone or tent applied to distance for its own sake. Every weight below is a statement about
        // VISIBILITY, not about a filter shape:
        //
        //   f * cone(dist, sampleStreak)  a blurry sample IN FRONT of us swept over this pixel. Gated
        //                                 by the SAMPLE's own streak: it can only have got here if it
        //                                 moved at least this far. **This is the term that stops a
        //                                 static neighbour being smeared by its tile's mover.**
        //   b * cone(dist, selfStreak)    WE are blurry and swept over a sample BEHIND us. Gated by
        //                                 OUR own streak — so a static centre contributes nothing
        //                                 here either, however fast its tile is.
        //   2 * cyl * cyl                 both blurry: neither is cleanly foreground, and they mix.
        LOOP for (uint i = 0u; i < taps; ++i)
        {
            // Even taps walk the TILE axis, odd taps this pixel's OWN axis. Each axis therefore
            // spans its own full streak with half the samples, rather than both sharing one line.
            bool   useSelf = twoDir && ((i & 1u) == 1u);
            float2 dir = useSelf ? dSelf : d;
            uint   n   = twoDir ? nHalf : taps;
            uint   j   = twoDir ? (i >> 1u) : i;
            float  t   = (float(j) + 0.5f + jitter) / float(n) - 0.5f;
            float2 off = dir * t;
            float2 sp  = float2(pc) + off;
            int2   spi = clamp(int2(sp + f2(0.5f)), int2(0, 0), max(deliverN - int2(1, 1), int2(0, 0)));
            float  dist = length(off);

            // The depth and velocity fields are BOTH at the INPUT rect — the same mapping, so the
            // two can never describe different pixels.
            int2   dq = mbVelocityTexel(float2(spi), delivered, mvRect);
            float  ds = LoadTex2D(gMbDepth, NO_SAMPLER, dq, 0).r;
            float2 vs = LoadTex2D(gMbVelocity, NO_SAMPLER, dq, 0).xy * outScale;
            float  sampleStreak = min(length(vs) * shutter, maxLen);     // see selfStreak

            float f = mbDepthWeight(ds, dCentre, softZ);   // sample in FRONT of the centre
            float b = mbDepthWeight(dCentre, ds, softZ);   // sample BEHIND the centre
            // Reverse-Z: BIGGER IS CLOSER. A tap in front of us is one that could legitimately
            // have smeared over us, which is the event the blade/skirt report is about.
            float relD = ds / max(dCentre, 1.0e-7f) - 1.0f;

            float cs = mbCone(dist, sampleStreak);
            float cc = mbCone(dist, selfStreak);
            float a  = f * cs + b * cc
                     + 2.0f * mbCylinder(dist, sampleStreak) * mbCylinder(dist, selfStreak);

            // ── MB-2j: THE RECONSTRUCTION, AND THE TWO THINGS IT PUTS RIGHT ──────────────
            // Both were measured against GROUND TRUTH in mgeHost64/mbsynth, where an analytic
            // scene averaged over the exposure IS the correct answer, so "how much blur" stops
            // being a matter of opinion. Against ship, on the lone-mover smear: delivery
            // 1.415 -> 1.000 and RMSE 0.3084 -> 0.0108.
            //
            // (1) A TAP ON MY OWN SURFACE IS NOT THREE KINDS OF EVIDENCE.
            //     At equal depth f == b == 1 and both cylinders are ~1 inside the streak, so a
            //     tap on the CENTRE'S OWN surface scores up to 1 + 1 + 2 = 4, while a tap on a
            //     genuinely foreground surface scores at most 1. The receiver therefore outvotes
            //     the smear 4:1 PER TAP before the tap COUNT is even counted, and the faster the
            //     receiver moves the more taps land inside its own streak. Measured over a skirt
            //     moving 8 px/frame: 94.8% of the answer was the pixel re-sampling ITSELF.
            //     That IS the reported *"blade gray smear is cut with the dark purple skirt"*,
            //     and it is why a STATIC receiver takes the smear fine (selfStreak = 0 kills
            //     both terms) while a moving one does not.
            //     `b` ("I am blurry and swept over something behind me") and the cylinder term
            //     ("two different blurry things mix") are both claims about TWO surfaces.
            //     Neither is true of ONE surface sampled twice. Keep f*cone -- the self-blur
            //     that genuinely exists. Skirt delivery at 8 px/frame: 0.666 -> 0.918.
            //
            // (2) A TAP IS A SLICE OF THE EXPOSURE, NOT A VOTE.
            //     Weights were SUMMED per tap with nothing dividing by sampling density, so the
            //     answer moved with the tap count: delivery 0.954 at 6 taps, 1.415 at 32, 1.513
            //     at 64. A reconstruction filter may get NOISIER when undersampled; it must not
            //     get STRONGER. Each tap stands for 1/n of the shutter and can cover us for at
            //     most all of that slice, so its weight is bounded by 1/n and the total by 1;
            //     the centre then takes whatever the taps did NOT claim, instead of a fixed 1
            //     that the taps can outvote arbitrarily. Spread across 6..64 taps: 0.559 -> 0.000.
            //
            // ⚠ THE FACTOR OF 2 IS COVERAGE, NOT A FUDGE. mbCone is 1 - d/L, which averaged over
            // its own support is 0.5 -- it is a DENSITY, not a coverage probability. The streak
            // spans +-L/2, so the surface at distance d actually passes over us iff d <= L/2, and
            // min(2*(1 - d/L), 1) IS that box with a soft outer edge. The sweep confirms it:
            // delivery rises to exactly 1.000 at gain 2.0 and is flat for every larger value.
            if (gMbParams.opts.w > 0.5f)
            {
                if (abs(relD) <= 0.01f) { a = f * cs; }
                a = min(a * 2.0f, 1.0f) / float(max(n, 1u));
            }

            // ── MB-2k: THE OFFSETS ARE A SEARCH, NOT A DESCRIPTION ───────────────────────
            // `b * cone(dist, selfStreak)` answers HOW MUCH: what fraction of the exposure are we
            // swept off this pixel, so that whatever is behind us shows through. MB-2j's cap makes
            // that fraction come out right -- on a 16 px blade at 60 px/frame the blade's own share
            // is 0.167 against a ground-truth coverage of 0.160, and ship's was 0.533.
            //
            // But the COLOUR came from averaging every background tap along the streak equally, and
            // the thing being revealed is AT THIS PIXEL -- for a static background it never moved at
            // all. Measured with the exact coverage backed out (`out = cov*blade + (1-cov)*bg`), the
            // background this filter showed through a thin fast mover had **0.26 of the true
            // contrast and was ANTI-CORRELATED with it, corr -0.98**: averaging a texture over +-50
            // px does not blur it, it inverts it. That is the reported *"sometimes the sword is a
            // refraction"*, and MB-2j did not cause it -- MB-2j made it VISIBLE by correctly raising
            // the background's share of a thin mover's pixels from 0.47 to 0.83.
            //
            // So the offsets are a SEARCH for somewhere the background can be seen unoccluded, not a
            // statement about where it is, and a search should prefer the NEAREST place it found
            // one. 1/dist^4 has no radius to pick: whatever the closest unoccluded sample turns out
            // to be, it wins, at any mover width. A cone scaled to the streak was tried first and is
            // NOT equivalent -- its best width tracks the mover's own width (0.15 of the streak at
            // 8 px, 0.25 at 32), which the gather cannot know, and when it is too narrow NO tap
            // qualifies, the bucket's weight sum collapses and the background it hands back is
            // BLACK: RMSE 0.0414 on a 160 px body against 0.0045 here. The exponent is an optimum,
            // not a trend: 0.0559 at 3, 0.0544 at 4, 0.0579 at 6, and 0.4161 at 12 where it has
            // collapsed onto one tap.
            //
            // ⚠ IT TRADES A LOW-FREQUENCY ERROR FOR A SMALLER HIGH-FREQUENCY ONE. A sharper estimate
            // depends on WHICH taps landed where, so the tap hash decides more of it: dither
            // 0.0074 -> 0.0296. Whole error on the mover's pixels still falls 0.1849 -> 0.0544.
            float4 tapC = LoadTex2D(gMbColor, NO_SAMPLER, spi, 0);
            if (prov && relD < -0.01f)
            {
                float id = 1.0f / max(dist, 1.0f);
                float pw = (id * id) * (id * id);            // 1 / dist^4
                sumB += tapC * (a * pw);
                wB   += a * pw;
                covB += a;                                   // the AMOUNT is untouched
            }
            else
            {
                sum  += tapC * a;
                wsum += a;
            }
            if      (relD >  0.01f) { wFront += a; }   // NEARER  -- something in front reached us
            else if (relD < -0.01f) { wBack  += a; }   // BEHIND  -- we reached something behind
            else                    { wSame  += a; }   // OUR OWN SURFACE, and this is the defect
        }

        if (gMbParams.opts.w > 0.5f)
        {
            // The centre went into `sum` at weight 1; back it out and re-add it at the weight
            // the taps left unclaimed. wsum - 1 is exactly the taps' total, and covB is the part of
            // that total MB-2k routed into the background bucket -- so `wt` is the same number it
            // would have been, and with `prov` off covB is 0 and this is the MB-2j line unchanged.
            float wt = (wsum - 1.0f) + covB;
            float wc = max(0.0f, 1.0f - wt);
            float4 bg = (wB > 1.0e-20f) ? (sumB / wB) : f4(0.0f);
            outv    = ((sum - centre) + centre * wc + bg * covB) / max(wt + wc, 1.0e-6f);
            changed = (wt > 1.0e-4f);
        }
        else
        {
            outv    = sum / wsum;
            changed = (wsum > 1.0001f);
        }
    }

    // ── MB-2i: THE INSTRUMENT ────────────────────────────────────────────────────────────────
    // Replaces the frame with a diagnostic. Placed AFTER the statistics are decided and BEFORE the
    // write, so `searched%`/`changed%` keep reporting the real pass while the picture changes —
    // an instrument that alters what it measures is worse than none (motionblur.srt.h says this
    // about the atomics; it is just as true of a debug view).
    uint dbg = uint(gMbParams.opts.z + 0.5f);
    if (dbg > 0u)
    {
        float3 dv = f3(0.0f);
        if (dbg == 1u)
        {
            // THE FIELD THE BLUR ACTUALLY READS. F12 mode 17 shows pMotionVectors — the TOTAL
            // field — and in object-only mode that is a completely different picture: there the
            // whole static world carries the camera's vector, here it is exactly zero.
            //
            // ⚠ SUB-PIXEL SCALE AND NO GREY CLIFF. mode 17 saturates at 32 px and jumps from a
            // flat grey 0.5 straight to ~0.10 the instant it leaves its dead zone, so a pixel
            // drifting across the threshold flickers grey/black — 128 to 26 for an arbitrarily
            // small change. Here 0 IS grey and the ramp LEAVES grey continuously, so a gradient
            // reads as a gradient and speckle reads as speckle.
            float  m = length(vSelf);
            float  t = saturate(log2(1.0f + m * 8.0f) / log2(1.0f + 8.0f * 4.0f));
            float  h = atan2(vSelf.y, vSelf.x) * (0.5f / 3.14159265f) + 0.5f;
            float3 hue = clamp(abs(frac(f3(h) + float3(0.0f, 0.6666667f, 0.3333333f)) * 6.0f - f3(3.0f)) - f3(1.0f),
                               f3(0.0f), f3(1.0f));
            dv = lerp(f3(0.5f), hue, t);
        }
        else if (dbg == 2u)
        {
            // DEPTH ORDER, brighter = NEARER, on a log scale so near geometry does not all
            // saturate to white. Raw reverse-Z is ~1/z, so 1/d is proportional to view distance.
            float dC = LoadTex2D(gMbDepth, NO_SAMPLER, vq, 0).r;
            float z  = 1.0f / max(dC, 1.0e-7f);
            float t  = saturate(1.0f - log2(1.0f + z) / log2(1.0f + 65536.0f));
            dv = f3(t);
        }
        else if (dbg == 4u)
        {
            // MODE 3 WITH `KEPT` SPLIT OFF FROM `BEHIND`. Mode 3's blue adds the centre's own
            // retained weight to everything genuinely behind it, and those are two different
            // answers: "nothing reached me" and "I am a mover, and what showed through me came
            // from behind". On a FIRST-PERSON ARM — which has nothing in front of it, so wFront
            // is ~0 — those two are the entire question, and mode 3 renders both as the same
            // cyan. Here BLACK is what the pixel kept, so the revealed background is blue ALONE
            // and the arm resampling its own surface is green alone.
            if (!blurred)
            {
                dv = f3(0.0f);
            }
            else
            {
                float tot = 1.0f + wFront + wBack + wSame;
                dv = float3(wFront / tot, wSame / tot, wBack / tot);
            }
        }
        else
        {
            // WHO WON THIS PIXEL. The centre always carries exactly 1.0 and every tap's weight
            // went into one of the two accumulators, so 1 + wFront + wBack IS wsum — recomputed
            // here rather than reaching for wsum, which is scoped to the branch above.
            //
            // ⚠ BLACK IS A FOURTH ANSWER AND IT IS NOT BLUE. A pixel that never ran the gather
            // (below the velocity floor — its whole tile neighbourhood is slower than mbMinPx)
            // and a pixel that ran and rejected every tap would otherwise BOTH read pure blue,
            // and those are different faults: the first never looked, the second looked and said
            // no. The blade/skirt question is exactly which of the two is happening on the skirt.
            // RED   = a NEARER surface reached us (the smear arriving, and what SHOULD dominate
            //         where a sword crosses in front of something).
            // GREEN = OUR OWN SURFACE reached us -- the same pixel counted once per tap that fell
            //         inside our own streak. Measured at 85-95% over a moving receiver, against 0%
            //         over a static one, which is the whole of the blade/skirt report.
            // BLUE  = what the pixel kept of itself, plus anything genuinely behind it.
            // BLACK = the gather never ran (below the velocity floor).
            if (!blurred)
            {
                dv = f3(0.0f);
            }
            else
            {
                float tot = 1.0f + wFront + wBack + wSame;
                dv = float3(wFront / tot, wSame / tot, (1.0f + wBack) / tot);
            }
        }
        outv = float4(dv, 1.0f);
    }

    if (inRect)
    {
        Write2D(gMbOut, p, outv);
    }

    // ── THE STATISTICS ───────────────────────────────────────────────────────────────────────────
    // Reduced in groupshared and committed with ONE atomic set per group — an instrument that costs
    // enough to move the millisecond beside it is not an instrument. See motionblur.srt.h.
    // ⚠ TWO POPULATIONS, AND SINCE THE AGREEMENT WEIGHTS LANDED THEY ARE GENUINELY DIFFERENT
    // QUESTIONS. `hit` = the gather RAN here, which is what the pass COSTS. `chg` = at least one tap
    // actually agreed, which is what the pass DOES. Before the weights the two were the same number
    // by construction — every pixel that ran was blurred, which is exactly why the output looked
    // like rectangles. Now a static pixel beside a fast mover runs the gather (it must: the mover's
    // colour has to come from somewhere) and comes out bit-identical, so `blurred%` staying high
    // while `changed%` collapses onto the movers IS the fix, as a number.
    uint tid   = (DispatchThreadID.y & 7u) * 8u + (DispatchThreadID.x & 7u);
    bool count = inRect && blurred;
    g_mbHit[tid]  = count ? 1u : 0u;
    g_mbTaps[tid] = count ? taps : 0u;
    g_mbLen[tid]  = count ? asuint(len) : 0u;
    g_mbChg[tid]  = (count && changed) ? 1u : 0u;
    GroupMemoryBarrier();

    // Tree reduce, atmos_sh's shape: read into a register, barrier, guarded write, barrier. The
    // guard wraps only the WRITE so every thread still reaches every barrier.
    for (uint s = 32u; s > 0u; s >>= 1u)
    {
        uint h = (tid < s) ? g_mbHit[tid + s]  : 0u;
        uint k = (tid < s) ? g_mbTaps[tid + s] : 0u;
        uint l = (tid < s) ? g_mbLen[tid + s]  : 0u;
        uint c = (tid < s) ? g_mbChg[tid + s]  : 0u;
        GroupMemoryBarrier();
        if (tid < s)
        {
            g_mbHit[tid]  = g_mbHit[tid] + h;
            g_mbTaps[tid] = g_mbTaps[tid] + k;
            g_mbLen[tid]  = max(g_mbLen[tid], l);
            g_mbChg[tid]  = g_mbChg[tid] + c;
        }
        GroupMemoryBarrier();
    }

    if (tid == 0u && g_mbHit[0] > 0u)
    {
        uint prev;
        AtomicAdd(gMbStats[0], g_mbHit[0],  prev);
        AtomicAdd(gMbStats[1], g_mbTaps[0], prev);
        AtomicMax(gMbStats[2], g_mbLen[0],  prev);
        AtomicAdd(gMbStats[3], g_mbChg[0],  prev);
    }
    RETURN();
}
