// mgeHost64 — Moment Shadow Map RECEIVER (forge-sun-shadows.md, Phase B).
//
// The analytic inverse of msmpack.h.fsl's PackMoments plus the Hamburger-4MSM reconstruction from
// Peters & Klein, "Moment Shadow Mapping" (I3D 2015), Algorithm 3 — ported verbatim from The-Forge
// 09_LightShadowPlayground/visibilityBufferShade.frag.fsl so the caster/receiver pair stays exactly
// the reference pair. Given the four moments of the caster-depth distribution in a texel, it answers
// "what fraction of that distribution lies IN FRONT of this receiver" — a smooth, filterable,
// low-leak occlusion estimate. That is the whole point of MSM here: the map can be bilinearly
// filtered (and later blurred / MSAA'd) like a colour texture, so we get soft edges with no PCF tap
// storm and none of VSM's light leaking.
//
// DEPTH CONVENTION (must match the casters): the sun ortho is reverse-Z, so device z is 1 at the
// sun-facing plane and 0 at the far plane. Both the caster (sunshadow*.frag) and this receiver use
//     depth = 1 - deviceZ
// which INCREASES with distance from the sun — the orientation Algorithm 3 assumes ("an occluder is
// at smaller depth than the shadowed receiver"). Feeding it raw reverse-Z inverts the test.
//
// Requires (include AFTER opaque.srt.h): gSunMoments (PerFrame) + gShadowParams.sunViewProj/sunParams.

#ifndef MSM_RECV_H
#define MSM_RECV_H

// Moment-quantisation slack. The reconstruction inverts a 3x3 Hankel matrix built from the moments;
// a texel holding a single Dirac (one flat caster, or the "no caster" clear) makes that matrix
// singular. Biasing every unpacked moment vector a hair toward the moments of a uniform-ish
// distribution regularises it — standard MSM practice, and it costs a sliver of contact hardness.
#define MSM_ROUNDING_CORRECTION 6.0e-5f

// CASCADES. Every cascade is the same camera-centred ortho box at a different half-extent, so
// "which cascade covers this point" is a max-norm test in clip space and the FIRST (sharpest) box
// that holds it wins. Two constants shape the hand-off, both in CLIP units (1.0 == the box edge):
//
//   MSM_CASCADE_INSET — how far inside its own edge a cascade stops being usable. The atlas packs
//     cascades side by side, so a bilinear tap right at u=0/1 of a tile would reach its neighbour's
//     texels; the inset keeps every tap inside its own tile. (0.008 clip = 0.004 uv = 8 texels at
//     2048.) The blur is already tile-clamped, so this only has to cover the bilinear footprint.
//   MSM_CASCADE_FADE — width of the hand-off band just inside the inset. Crossing a cascade
//     boundary changes the texel size several-fold, and with it the penumbra width, so a hard
//     switch draws a visible ring around the player. Inside the band the receiver evaluates BOTH
//     cascades and lerps. The outermost cascade has nothing to hand off to, so it fades to fully
//     lit there instead — that is also the map's outer border ramp.
#define MSM_CASCADE_INSET 0.008f
#define MSM_CASCADE_FADE  0.12f

float4 UnpackMoments(float4 packedMoments)
{
    packedMoments -= float4(0.5f, 0.0f, 0.5f, 0.0f);

    float4x4 inv = make_f4x4_row_elems(-1.0f/3.0f, 0.0f,   sqrt(3.0f),         0.0f,
                                        0.0f,      0.125f, 0.0f,               1.0f,
                                       -0.75f,     0.0f,   0.75f * sqrt(3.0f), 0.0f,
                                        0.0f,     -1.125f, 0.0f,               1.0f);

    float4 unpackedMoments = mul(inv, packedMoments);
    return lerp(unpackedMoments, float4(0.0f, 0.63f, 0.0f, 0.63f), MSM_ROUNDING_CORRECTION);
}

float3x3 msmInverse3x3(float3x3 A)
{
    float3x3 result;
    float detA = dot(A[0], cross(A[1], A[2]));
    float invDetA = 1.0f / detA;
    result[0] = invDetA * cross(A[1], A[2]);
    result[1] = invDetA * cross(A[2], A[0]);
    result[2] = invDetA * cross(A[0], A[1]);
    result = transpose(result);
    return result;
}

// Returns 0 = fully lit .. 1 = fully shadowed, for a receiver at depth zf given moments b.
float ComputeMSMShadowIntensity(float4 b, float zf)
{
    // https://momentsingraphics.de/Media/I3D2015/MomentShadowMapping.pdf, Page 6, Algorithm 3.
    float3x3 B = float3x3(float3(1.0f, b.x, b.y),
                          float3(b.x,  b.y, b.z),
                          float3(b.y,  b.z, b.w));

    float3 c = mul(msmInverse3x3(B), float3(1.0f, zf, zf*zf));

    // Solve c.z*z^2 + c.y*z + c.x = 0 for the two depths the 3-point quadrature places mass at.
    float discriminant = sqrt(max(c.y * c.y - 4.0f * c.z * c.x, 0.0f));

    float z2 = (-c.y - discriminant) / (2.0f * c.z);
    float z3 = (-c.y + discriminant) / (2.0f * c.z);

    if (z3 < z2) { float temp = z2; z2 = z3; z3 = temp; }

    float case2 = step(z2, zf) * step(zf, z3);
    float case3 = step(z3, zf);

    float result2 =        (zf * z3 - b.x * (zf + z3) + b.y) / ((z3 - z2) * (zf - z2));
    float result3 = 1.0f - (z2 * z3 - b.x * (z2 + z3) + b.y) / ((zf - z2) * (zf - z3));

    return saturate(case2 * result2 + case3 * result3);
}

// One cascade's occlusion estimate at `p` (camera-relative, already normal-offset). `c` indexes both
// the matrix array and the atlas tile: tile c owns u in [c/N, (c+1)/N], so the tile's own 0..1 uv is
// squeezed into that slice. uv is saturated first because a caller in the hand-off band may be a
// hair outside the NEXT cascade's [0,1] — clamping keeps the tap inside the tile rather than letting
// it wander into the neighbour's.
float sunCascadeOcclusion(int c, float3 p, float zBias)
{
    float4 posLS = mul(gShadowParams.sunViewProj[c], float4(p, 1.0f));
    // The sun projection is ORTHOgraphic, so w is exactly 1 — the divide is kept only so a future
    // perspective-shadow variant drops in unchanged.
    posLS.xyz /= posLS.w;

    float2 uvTile = saturate(posLS.xy * float2(0.5f, -0.5f) + float2(0.5f, 0.5f));
    float2 uv     = float2((float(c) + uvTile.x) * (1.0f / float(SUN_CASCADES)), uvTile.y);
    float  zf     = (1.0f - posLS.z) - zBias;   // depth grows away from the sun

    float4 moments = UnpackMoments(SampleLvlTex2D(gSunMoments, gSamplerBilinearClamp, uv, 0));
    return ComputeMSMShadowIntensity(moments, zf);
}

// ---------------------------------------------------------------------------------------------
// PCSS + rotated-disc PCF over the RAW depth (gSunDepth) — the COLOUR receiver, all cascades.
//
// Why MSM lost the colour pass entirely. Its penumbra comes only from the moments blur, so its width
// is capped by that blur's tap radius (4 texels) — past that the softness knob does nothing, and what
// is left is a truncated separable kernel whose iso-contours are axis-aligned. It looked least bad on
// statics (a static sits well above its receiver: wide depth gap, the quadrature in its stable
// regime, a real ramp) and worst on terrain (receiver and occluder at nearly equal depth is exactly
// where the 3-point quadrature is least accurate and most sensitive to the map's 16-bit
// quantisation, so the transition collapses onto the texel grid). Distance did not rescue it: the
// far cascade's 8-unit texels put the blocky iso-contours on a bigger world grid, not a finer one.
//
// PCSS has no such ceiling: penumbra width is measured from the actual blocker/receiver separation
// and applied as a sampling radius, so it is bounded by the tap count, not by a pre-filter. The depth
// it reads is the caster pass's own z-buffer — already rendered, previously discarded.
//
// The moments are NOT dead — they just have a different consumer. Volumetric fog ray-marches the sun
// shadow and needs ONE cheap filterable tap per step, which is precisely what a moment map is for and
// precisely what this disc could never afford. See volfog.frag.fsl.

#define SUN_PCSS_BLOCKER_TAPS 12
#define SUN_PCF_TAPS          16

// Atlas geometry. Cascade c owns u in [c/N, (c+1)/N]; one tile texel is 1/(RES*N) of the atlas in u
// and 1/RES in v.
#define SUN_ATLAS_TEXEL float2(1.0f / float(SUN_SHADOW_RES * SUN_CASCADES), 1.0f / float(SUN_SHADOW_RES))
#define SUN_ATLAS_DIMS  float2(float(SUN_SHADOW_RES * SUN_CASCADES), float(SUN_SHADOW_RES))

// Vogel/golden-angle disc — equal-area sample spacing with none of a grid's axis alignment, which is
// the whole point here (a square kernel is what we are running away from). `rot` decorrelates the
// pattern per fragment so the residual under-sampling reads as fine grain instead of banding.
float2 sunDiscTap(int i, int n, float rot)
{
    float r  = sqrt((float(i) + 0.5f) / float(n));
    float th = float(i) * 2.39996323f + rot;   // golden angle
    return float2(r * cos(th), r * sin(th));
}

// Per-fragment rotation, hashed from the WORLD position rather than screen position on purpose.
// Screen-space noise (interleaved gradient etc.) is the usual choice, but it assumes a temporal
// resolve to average it away; this renderer has MSAA and no TAA, so screen-locked noise would crawl
// across every surface as the camera moves. A world-locked hash is frozen to the surface — it grains,
// it does not swim.
float sunDiscRotation(float3 worldPosRel)
{
    float2 h = float2(dot(worldPosRel, float3(0.7391f, 0.3179f, 0.5107f)),
                      dot(worldPosRel, float3(0.2311f, 0.6203f, 0.1157f)));
    return frac(sin(dot(h, float2(12.9898f, 78.233f))) * 43758.5453f) * 6.2831853f;
}

// One 2x2 PCF tap: gather the four depths around `uv`, compare EACH against the reference, then
// bilerp the four BINARY results. Comparing first and filtering second is the correct order across a
// depth discontinuity (filtering depth first invents an occluder at the average of two surfaces) and
// it is what removes the texel staircase at contact, where the disc is only a texel or two wide.
// One gather instruction per tap, so it costs about what a point tap would.
// Returns 1 = occluded, 0 = lit.
float sunPcfTap(float2 uv, float ref)
{
    float4 g = GatherRedTex2D(gSunDepth, gSamplerPointClamp, uv);
    // Reverse-Z: a STORED depth greater than the reference means that caster is nearer the sun.
    float4 occ = step(ref, g);
    // Gather returns (0,1),(1,1),(1,0),(0,0) in x,y,z,w relative to the lower-left texel of the quad.
    float2 t = frac(uv * SUN_ATLAS_DIMS - 0.5f);
    return lerp(lerp(occ.w, occ.z, t.x), lerp(occ.x, occ.y, t.x), t.y);
}

// Cascade c's occlusion. `p` is already normal-offset. Returns 0 = lit .. 1 = fully shadowed.
float sunPcssOcclusion(int c, float3 p, float3 worldPosRel, float slopeBias)
{
    float4 posLS = mul(gShadowParams.sunViewProj[c], float4(p, 1.0f));
    posLS.xyz /= posLS.w;

    float2 uvTile = saturate(posLS.xy * float2(0.5f, -0.5f) + float2(0.5f, 0.5f));
    float2 uvC    = float2((float(c) + uvTile.x) * (1.0f / float(SUN_CASCADES)), uvTile.y);

    float  ref  = posLS.z + gShadowParams.sunPcf1.x + slopeBias;   // reverse-Z: push TOWARD the sun
    float  rot  = sunDiscRotation(worldPosRel);
    float  srch = gShadowParams.sunPcf0.x;

    // Keep every tap inside cascade c's OWN tile: the atlas packs the cascades side by side, so clamp
    // addressing at the atlas edge would let a tap read the neighbouring cascade's texels — which,
    // being a different world scale, is not a slightly-wrong shadow but a completely unrelated one.
    float2 lo = float2((float(c)        ) * (1.0f / float(SUN_CASCADES)), 0.0f) + SUN_ATLAS_TEXEL;
    float2 hi = float2((float(c) + 1.0f) * (1.0f / float(SUN_CASCADES)), 1.0f) - SUN_ATLAS_TEXEL;

    // --- Blocker search: how far in front of this receiver is the stuff that shadows it? ---
    float blockerSum = 0.0f;
    float blockerCnt = 0.0f;
    UNROLL for (int i = 0; i < SUN_PCSS_BLOCKER_TAPS; ++i)
    {
        float2 sp = clamp(uvC + sunDiscTap(i, SUN_PCSS_BLOCKER_TAPS, rot) * srch * SUN_ATLAS_TEXEL, lo, hi);
        float  d  = SampleLvlTex2D(gSunDepth, gSamplerPointClamp, sp, 0).r;
        float  hit = step(ref, d);
        blockerSum += d * hit;
        blockerCnt += hit;
    }
    // No blocker found anywhere in the search disc — fully lit, and we skip the PCF entirely.
    if (blockerCnt < 0.5f) { return 0.0f; }

    // --- Penumbra: PCSS similar triangles. sunPcf0.y carries the host's dimensionless world SPREAD
    // already multiplied by the depth slab, so this product is a WORLD penumbra width; dividing by
    // THIS cascade's world texel size turns it into that cascade's texels. Doing the divide here
    // rather than host-side is what makes one knob correct for every cascade — cascades differ only
    // in texel size, and a penumbra is a physical width, not a texel count. ---
    float dzNorm  = max(blockerSum / blockerCnt - posLS.z, 0.0f);
    float texelW  = max(gShadowParams.sunCascadeTexel[c], 1.0e-3f);
    float radius  = clamp(gShadowParams.sunPcf0.y * dzNorm / texelW,
                          gShadowParams.sunPcf0.z, gShadowParams.sunPcf0.w);

    // --- Variable-radius PCF ---
    float occlusion = 0.0f;
    UNROLL for (int j = 0; j < SUN_PCF_TAPS; ++j)
    {
        float2 sp = clamp(uvC + sunDiscTap(j, SUN_PCF_TAPS, rot) * radius * SUN_ATLAS_TEXEL, lo, hi);
        occlusion += sunPcfTap(sp, ref);
    }
    return occlusion * (1.0f / float(SUN_PCF_TAPS));
}

// ---------------------------------------------------------------------------------------------
// LONG-RANGE sun occlusion from the height map (gSunOcc, sunocc.comp.fsl).
//
// Everything above this line stops at the outermost cascade — 8192 world units, one MW cell. Past
// it both receivers returned 1.0, so the entire distant world was unshadowed BY CONSTRUCTION: no
// mountain shadowed a valley two cells away, and the volumetric march lit up air that a ridge in the
// next cell should have blacked out. That last one is what made the gap visible; it was never a fog
// bug.
//
// gSunOcc stores the sun-BLOCKED world Z per texel, so the test is a compare against the point's own
// height and costs ONE sample at any altitude. Returns occlusion, 0 = lit .. 1 = fully shadowed, and
// already carries its own strength lane and border fade — so a caller can use it raw.
//
// worldAbs is ABSOLUTE world position: every Forge path carries camera-relative, so callers add
// gFrameData.lodEye.xyz exactly as skyAmbFactor does.
float sunOccMapOcclusion(float3 worldAbs)
{
    float4 so = gShadowParams.sunOcc;
    if (so.x <= 0.0f) { return 0.0f; }

    // Same window, hence the SAME published mapping, as the sky-AO height map this is derived from.
    float4 m  = gShadowParams.skyAOMap;
    float2 uv = (worldAbs.xy - m.xy) * m.z;
    // Outside the window there is no data. A clamp sampler would smear the border texel across the
    // rest of the world — one ridge at the edge would shadow everything behind it forever — so fade
    // the term out over the outer eighth instead, exactly as skyAOVisibility does.
    float2 e    = abs(uv - 0.5f) * 2.0f;
    float  edge = saturate((1.0f - max(e.x, e.y)) * 8.0f);
    if (edge <= 0.0f) { return 0.0f; }

    float blockZ = SampleLvlTex2D(gSunOcc, gSamplerBilinearClamp, uv, 0).r;
    // The ramp runs DOWNWARD from (blockZ - bias): a point at the blocked height is fully lit and one
    // `soft` below it is fully shadowed. Biasing toward lit is deliberate — the map is coarse and is
    // built from the very surfaces that receive from it, so the failure mode to design out is a
    // surface shadowing itself.
    float t = saturate(((blockZ - so.z) - worldAbs.z) / max(so.y, 1.0e-3f));
    t = t * t * (3.0f - 2.0f * t);            // smoothstep — a linear ramp shows its own edges
    return t * so.x * edge;
}

// VOLUMETRIC sun visibility at an arbitrary point in the air — THE moment map's remaining job.
//
// A ray march evaluates this once per step, dozens of times per pixel, so the per-sample budget is
// one texture instruction. That rules out PCSS (28 taps) and even plain PCF, and it is exactly what
// a moment map is built for: the moments are linear, so the blurred atlas is legitimately
// bilinear-filterable, and one tap returns a smooth partial-occlusion estimate rather than a binary
// answer. Hard-edged binary shadow tests are also the classic source of banded, aliased shafts —
// pre-filtered moments give the march a soft, already-anti-aliased signal for free.
//
// No normal offset (there is no surface), no slope bias (no normal), and a small constant bias only.
// Returns 1 = lit .. 0 = fully shadowed.
// THE RANGE POLICY MUST MATCH sunShadowVisibility'S, EXACTLY, AND THAT IS NOT A STYLE CHOICE.
//
// The two functions answer the same question about the same world — one for a surface, one for the
// air above it — and a shaft is only legible when the two AGREE. Every lit patch of ground has to be
// traceable up its own shaft, and it is that correspondence, not the absolute value, that the eye
// reads as "the sun is coming from over there".
//
// This was got wrong once, and it is worth recording what it looked like: the fog took
// min(cascade, map) EVERYWHERE while the surface receiver used the map only past the last cascade.
// Inside cascade range the ground and the air above it were then answering to different sources, so
// the map could cut a shaft away over ground the cascade still called lit — the pool of light stayed,
// its shaft did not. Worse, the two disagreed with different GEOMETRY: gSunOcc stores one blocked
// height per XY column, so its boundary is a surface of constant Z — a HORIZONTAL cut — while a
// cascade's boundary is swept along the sun. A horizontal edge sweeping through the ray march, laid
// over sun-aligned shafts, reads as two light directions cancelling each other.
//
// So: cascade where it covers, map beyond, and the outermost cascade's hand-off band fades from one
// into the other. Identical to the surface path below.
float sunShadowVolumetric(float3 p)
{
    if (gShadowParams.sunParams.x <= 0.0f) { return 1.0f; }

    // Which cascade covers this point (the first/sharpest that does), and how close to its edge.
    int   sel = -1;
    float m   = 0.0f;
    UNROLL for (int i = 0; i < SUN_CASCADES; ++i)
    {
        if (sel < 0)
        {
            float4 q  = mul(gShadowParams.sunViewProj[i], float4(p, 1.0f));
            float  mm = max(abs(q.x), abs(q.y));
            if (mm < 1.0f - MSM_CASCADE_INSET && q.z > 0.0f && q.z < 1.0f) { sel = i; m = mm; }
        }
    }

    float mapOcc = sunOccMapOcclusion(p + gFrameData.lodEye.xyz);
    // Past every cascade the map is the whole answer — the distant fog gets ridge shadows for the
    // first time, and the distant GROUND under it gets the same ones from the same map.
    if (sel < 0) { return 1.0f - mapOcc; }

    float occ = sunCascadeOcclusion(sel, p, gShadowParams.sunParams.y);

    // Hand-off band, outermost cascade only: fade into the map rather than switching at its edge.
    // Without this the map's arrival is a ring 8192 units out that travels with the player — and in
    // fog, which integrates dozens of samples per pixel, a ring is far more visible than it is on a
    // surface. (The cascade-to-cascade fade the surface path also does is deliberately NOT copied
    // here: the fog has always hard-switched between cascades, that boundary is interior to the
    // cascade set, and it is not what this change is about.)
    float band = 1.0f - MSM_CASCADE_INSET - MSM_CASCADE_FADE;
    if (m > band && sel + 1 >= SUN_CASCADES)
    {
        occ = lerp(occ, mapOcc, saturate((m - band) / MSM_CASCADE_FADE));
    }
    return 1.0f - occ;
}

// Strategy dispatch for the COLOUR pass. PCSS on every cascade; MSM survives only as the A/B
// (sunPcf1.z == 0) and as the volumetric fog's sampler, which is a different file.
//
// It was worth trying MSM-for-far — one bilinear tap instead of 28 is a real saving and distance
// usually forgives a filter. It did not survive looking at it: a coarser cascade does not soften the
// blockiness, it just draws the same axis-aligned iso-contours on an 8-unit world grid instead of a
// 2-unit one, so the artefact scaled up with the texels rather than fading out.
float sunCascadeShadow(int c, float3 p, float3 worldPosRel, float zBias, float slopeBias)
{
    if (gShadowParams.sunPcf1.z > 0.5f) { return sunPcssOcclusion(c, p, worldPosRel, slopeBias); }
    return sunCascadeOcclusion(c, p, zBias);
}

// THE receiver entry point. worldPosRel = the fragment's CAMERA-RELATIVE world position (what every
// Forge frag already interpolates); N = its world normal (for the normal-offset bias — pass the same
// normal the sun N.L uses). Returns sun visibility: 1 = lit, 0 = fully shadowed.
//
// Two sources, in ascending order of range and descending order of precision: the cascades (one MW
// cell) and the long-range height map (the whole world). Each covers a band the other cannot, and
// the outermost cascade's hand-off band fades from one into the other.
//
// Everything early-outs to 1.0 (fully lit, zero cost beyond the branch) when the feature is off — so
// a fragment no source covers is never darkened.
float sunShadowVisibility(float3 worldPosRel, float3 N)
{
    float strength = gShadowParams.sunParams.x;
    if (strength <= 0.0f) { return 1.0f; }

    // The long-range map's answer for this fragment. Resolved up front because BOTH exits below want
    // it: past the last cascade it is the only answer there is, and inside the outermost cascade's
    // hand-off band it is what that band now fades INTO (it used to fade into fully lit, which is
    // where a mountain shadow stopped dead at 8192 units).
    float mapOcc = sunOccMapOcclusion(worldPosRel + gFrameData.lodEye.xyz);

    // Cascade select on the UN-offset position: the normal offset is sub-texel-ish and depends on
    // the cascade we are about to pick, so resolving it first would be circular. Picking on the raw
    // position and offsetting afterwards costs one extra projection for the chosen cascade only.
    int   sel = -1;
    float m   = 0.0f;   // max-norm in the chosen cascade's clip box: 0 = centre, 1 = edge
    UNROLL for (int i = 0; i < SUN_CASCADES; ++i)
    {
        if (sel < 0)
        {
            float4 q  = mul(gShadowParams.sunViewProj[i], float4(worldPosRel, 1.0f));
            float  mm = max(abs(q.x), abs(q.y));
            // Every cascade shares one depth slab, so this z test is the same for all of them — it
            // rejects only geometry genuinely outside the sun's depth range.
            if (mm < 1.0f - MSM_CASCADE_INSET && q.z > 0.0f && q.z < 1.0f) { sel = i; m = mm; }
        }
    }
    // Past every cascade the map is the whole answer, and this is the first time anything out here
    // has been shadowed at all.
    if (sel < 0) { return 1.0f - mapOcc * strength; }

    float  bias  = gShadowParams.sunParams.y;
    float  noff  = gShadowParams.sunParams.w;            // in TEXELS of the sampled cascade
    float4 texel = gShadowParams.sunCascadeTexel;        // world units per texel, per cascade

    // Slope-scaled bias for the near cascade only. A binary depth compare needs it (a surface at a
    // grazing angle to the sun crosses several texels' worth of depth inside one texel); MSM does
    // not, because the quadrature already integrates over that spread. tan(acos(NdotL)) blows up at
    // the terminator, so it is capped — past ~84 degrees N.L is dark anyway and the bias would start
    // detaching contact.
    float  NdotL     = saturate(dot(N, -gFrameData.sunDir.xyz));
    float  slopeBias = gShadowParams.sunPcf1.y * min(sqrt(1.0f - NdotL * NdotL) / max(NdotL, 0.1f), 10.0f);

    float occlusion = sunCascadeShadow(sel, worldPosRel + N * (noff * texel[sel]), worldPosRel,
                                       bias, slopeBias);

    // Hand-off band. Inside it, cross-fade into the next (coarser) cascade — or, for the OUTERMOST
    // cascade, into the long-range map, which is literally what lies beyond it. That last case used
    // to fade to fully lit, so every shadow in the world ended at a ring 8192 units from the camera
    // that travelled with the player; fading into the map makes the ring a change of representation
    // instead of a change of answer.
    float band  = 1.0f - MSM_CASCADE_INSET - MSM_CASCADE_FADE;
    float t     = (m > band) ? saturate((m - band) / MSM_CASCADE_FADE) : 0.0f;
    bool  toMap = (sel + 1 >= SUN_CASCADES);
    if (t > 0.0f && !toMap)
    {
        float occNext = sunCascadeShadow(sel + 1, worldPosRel + N * (noff * texel[sel + 1]),
                                         worldPosRel, bias, slopeBias);
        occlusion = lerp(occlusion, occNext, t);
    }

    // Light-bleeding reduction. "Light bleeding" is light leaking INTO a region that should be fully
    // shadowed: the 3-point quadrature under-reports occlusion (returns e.g. 0.8 where the truth is
    // 1.0), so shadow cores read washed out. The fix is to AMPLIFY occlusion so a nearly-occluded
    // pixel saturates to fully occluded — the reference's `shadingFactor / bleedingReductionMultiplier`
    // with multiplier = 1 - lbr. Raising lbr therefore DEEPENS shadows and removes bleed.
    // (Crushing the low end instead — linstep(lbr,1,occlusion) — is the opposite operation: it erases
    // partial occlusion, which washes shadows out and reads as MORE bleeding, not less.)
    // Fully-lit pixels sit near 0 occlusion, so the amplification leaves them alone.
    // Applied AFTER the cascade-to-cascade blend so the band cannot amplify a half-faded value into a
    // hard edge — and BEFORE the cascade-to-map one, because this correction is a property of the
    // MOMENT QUADRATURE and the map has no quadrature. Amplifying the map instead would put a step of
    // exactly 1/(1-lbr) at the outer edge of the band, where the same fragment is answered by the map
    // alone a texel later.
    float lbr = gShadowParams.sunParams.z;
    occlusion = saturate(occlusion / max(1.0f - lbr, 1.0e-4f));

    if (t > 0.0f && toMap) { occlusion = lerp(occlusion, mapOcc, t); }

    return 1.0f - occlusion * strength;
}

#endif // MSM_RECV_H
