// mgeHost64 — Tier 4 multi-map scene (fragment stage).
//
// Computes the SAME lit term as opaque.frag (Tier 2b vColSource material routing + Tier 3a
// point lights), then runs a fixed-function stage loop replicating rendercachedcolor.cpp's
// reconstruction of MW's PPL multi-texture blend (ordered by texCoordSet on the client):
//   BASE  : c = tex.rgb * lit;  baseA = tex.a   (arg2 = DIFFUSE even when not stage 0)
//   MOD   : c *= tex.rgb        MOD2X : c *= tex.rgb*2        ADD : c += tex.rgb
// alpha test runs on the BASE stage. The lit + point-light block below is DUPLICATED from
// opaque.frag — keep the two in LOCKSTEP so Tier 1/2b/3a stay identical across both paths.

#include "opaque.srt.h"

STRUCT(VSOutput)
{
    DATA(float4,      Position, SV_Position);
    DATA(float3,      Normal,   NORMAL);
    DATA(float2,      Uv0,      TEXCOORD0);
    DATA(float2,      Uv1,      TEXCOORD1);
    DATA(float2,      Uv2,      TEXCOORD2);
    DATA(float2,      Uv3,      TEXCOORD3);
    DATA(float,       Fog,      TEXCOORD4);
    DATA(float4,      Color,    COLOR);
    DATA(FLAT(float3),MatDiffuse, TEXCOORD5);
    DATA(FLAT(float3),MatAmbient, TEXCOORD6);
    DATA(FLAT(float3),MatEmissive,TEXCOORD7);
    DATA(float3,      WorldPos,   TEXCOORD8);
    DATA(FLAT(uint4), Stages,     TEXCOORD9);
    DATA(FLAT(uint),  Packed,     TEXCOORD10);
};

// Static semi-HDR tonemap — ported verbatim from XE FixedFuncEmu.fx::tonemap (== opaque.frag).
float3 tonemap(float3 c)
{
    c = clamp(c, 0.0f, 2.2f);
    c = (((0.0548303f * c - 0.189786f) * c - 0.154732f) * c + 1.12969f) * c;
    return c;
}

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN( VSOutput In )
{
    INIT_MAIN;
    float3 N = normalize(In.Normal);

    // Sample the AO buffer once (rgb = bent normal, a = visibility). gAO is the bilateral-blurred
    // pAOBlur, so a single tap suffices. debugParams.w = toggle bitmask (bit0 AO->ambient, bit1
    // bent normal). Kept in lockstep with opaque.frag.
    uint   aoFlags  = (uint)(gFrameData.debugParams.w + 0.5f);
    float2 aoUv     = In.Position.xy * gFrameData.debugParams.yz;
    float4 aoSample = SampleTex2D(gAO, gSamplerAnisotropic, aoUv);
    if ((aoFlags & 2u) != 0u) { N = normalize(aoSample.rgb); }   // "Bent normal enable" tick

    // --- BEGIN lit block (DUPLICATED from opaque.frag — keep in lockstep) ---
    float  ndl = saturate(dot(N, -gFrameData.sunDir.xyz));
    float3 d = gFrameData.sunCol.rgb * ndl;
    // "Ambient = white (debug)" tick (bit2): force ambient to 1.0 so AO darkening is visible.
    float3 a = ((aoFlags & 4u) != 0u) ? float3(1.0f, 1.0f, 1.0f) : gFrameData.ambCol.rgb;
    // Tier 3: GTAO modulates AMBIENT only — gated by the "AO enable" tick (debugParams.w bit0).
    if ((aoFlags & 1u) != 0u) { a *= aoSample.a; }
    a *= gFrameData.dbgScales.x;   // dev panel: ambient intensity modifier (lockstep w/ opaque.frag)
    {
        uint nLights = (uint)gLights.lightParams.x;
        for (uint i = 0; i < nLights; ++i)
        {
            float4 posR    = gLights.lights[i * 3u + 0u];
            float3 lightCol= gLights.lights[i * 3u + 1u].rgb;
            float3 fo      = gLights.lights[i * 3u + 2u].xyz;
            float  radius  = posR.w;

            float3 toLight = posR.xyz - In.WorldPos;
            float  dist2   = dot(toLight, toLight);
            // EXACT early-out at the smoothstep cutoff (att = 0 beyond 2r) — see opaque.frag.
            if (dist2 >= 4.0f * radius * radius) { continue; }
            float  invDist = rsqrt(max(dist2, 1e-8f));
            float  dist    = dist2 * invDist;

            float  att = 1.0f / max(fo.z * dist2 + fo.y * dist + fo.x, 1e-4f);
            att *= 1.0f - smoothstep(radius, 2.0f * radius, dist);

            // P1 point-light shadows (lockstep with opaque.frag): the host patches
            // falloff.w = shadow slot + 1 (0 = no shadow). shadowmask.comp already did the
            // cube-face atlas test for this pixel — scale the light by the slot's 4-bit
            // visibility (15 = lit, 0 = shadowed). Fixes multimap receivers (NPC heads,
            // interior walls/trim) that previously took point lights with no shadow.
            uint slotP1 = (uint)gLights.lights[i * 3u + 2u].w;
            if (slotP1 != 0u)
            {
                uint4 mw   = LoadTex2D(gShadowMask, NO_SAMPLER, int2(In.Position.xy), 0).xyzw;
                uint  s    = slotP1 - 1u;
                uint  lane = s >> 3u;
                uint  word = lane == 0u ? mw.x : (lane == 1u ? mw.y : (lane == 2u ? mw.z : mw.w));
                uint  nib  = (word >> ((s & 7u) * 4u)) & 0xFu;
                att *= float(nib) * (1.0f / 15.0f);
            }

            float  lambert = saturate(dot(N, toLight) * invDist);
            d += lambert * att * lightCol;
        }
    }
    d *= gFrameData.dbgScales.y;   // dev panel: diffuse (sun + point) intensity modifier
    uint vColSource = (In.Packed >> 3u) & 0x3u;
    float3 lit;
    if (vColSource == 2u) {
        lit = In.Color.rgb * (d + a) + In.MatEmissive;
    } else if (vColSource == 1u) {
        lit = In.MatDiffuse * d + In.MatAmbient * a + In.Color.rgb;
    } else {
        lit = In.MatDiffuse * d + In.MatAmbient * a + In.MatEmissive;
    }
    // --- END lit block ---

    // Fixed-function stage loop. CURRENT defaults to the lit material (DIFFUSE). BASE replaces
    // c with tex*lit and records the base alpha; MOD/MOD2X/ADD fold the sibling maps over it.
    uint  stageCount = In.Packed & 0x7u;
    float alphaRef   = float((In.Packed >> 8u) & 0xFFu) * (1.0f / 255.0f);
    float albScale   = gFrameData.dbgScales.z;   // dev panel: albedo (texture) intensity modifier (BASE stage)
    float3 c   = lit;
    float3 alb = float3(1.0f, 1.0f, 1.0f);        // texture-only product (debug mode 5 albedo view)
    float  baseA = 1.0f;
    for (uint s = 0u; s < 4u; ++s)
    {
        if (s >= stageCount) { break; }
        // Manual selects avoid dynamic indexing of the uint4 / float2 interpolators.
        uint sw = (s == 0u) ? In.Stages.x : (s == 1u) ? In.Stages.y
                : (s == 2u) ? In.Stages.z : In.Stages.w;
        uint tex   = sw & 0xFFFFu;
        uint uvSet = (sw >> 16u) & 0x3u;
        uint op    = (sw >> 18u) & 0x3u;
        float2 uv = (uvSet == 0u) ? In.Uv0 : (uvSet == 1u) ? In.Uv1
                  : (uvSet == 2u) ? In.Uv2 : In.Uv3;
        float4 t = SampleTex2D(gTextures[tex], gSamplerAnisotropic, uv);
        if (op == 0u)      { float3 b = t.rgb * albScale; c = b * lit; baseA = t.a; alb = b; } // BASE (MOD x DIFFUSE)
        else if (op == 1u) { c *= t.rgb;        alb *= t.rgb; }          // MOD
        else if (op == 2u) { c *= t.rgb * 2.0f; alb *= t.rgb * 2.0f; }   // MOD2X
        else               { c += t.rgb;        alb += t.rgb; }          // ADD
    }

    // Alpha test on the BASE stage (other stages keep-prev alpha; irrelevant to coverage).
    if (baseA < alphaRef) { discard; }

    c *= gFrameData.dbgScales.w;   // dev panel: overall output intensity modifier
    c = tonemap(c);
    c = lerp(gFrameData.fogColNear.rgb, c, In.Fog);
    // F12 debug views (see opaque.frag — kept in lockstep). gAO sampled at SV_Position.xy * invScreen.
    uint dbg = (uint)(gFrameData.debugParams.x + 0.5f);
    if (dbg == 3u || dbg == 4u) {
        if (dbg == 4u) { RETURN(float4(aoSample.rgb, 1.0f)); }              // mode 4: bent normal (raw float3, no remap)
        float v = aoSample.a; RETURN(float4(v, v, v, 1.0f));                 // mode 3: AO/visibility
    }
    if (dbg == 5u) { RETURN(float4(alb, 1.0f)); }                            // mode 5: albedo only (texture product)
    if (dbg == 6u) { RETURN(float4(lit, 1.0f)); }                           // mode 6: lit only (lighting, no texture)
    if (dbg == 7u) {                                                        // mode 7: ambient-only lighting (diffuse removed)
        float3 al;
        if (vColSource == 2u)      { al = In.Color.rgb * a + In.MatEmissive; }
        else if (vColSource == 1u) { al = In.MatAmbient * a + In.Color.rgb; }
        else                       { al = In.MatAmbient * a + In.MatEmissive; }
        RETURN(float4(al, 1.0f));
    }
    if (dbg == 1u || dbg == 2u) {   // world-distance grayscale (reverse-Z NDC is too crushed to read)
        float dist = length(In.WorldPos - gFrameData.eyePos.xyz);
        float g = saturate(dist * (1.0f / 8192.0f));  // near=black, far=white; range tunable
        RETURN(float4(g, g, g, 1.0f));
    }
    if (dbg == 10u) {   // mode 10: shadow-mask slot-0 nibble (mirrors opaque.frag)
        uint4 mw = LoadTex2D(gShadowMask, NO_SAMPLER, int2(In.Position.xy), 0).xyzw;
        float g = float(mw.x & 0xFu) * (1.0f / 15.0f);
        RETURN(float4(g, g, g, 1.0f));
    }
    RETURN(float4(c, 1.0f));
}
