// mgeHost64 — Tier 4 multi-map scene (vertex stage).
//
// A STATIC opaque part carrying dark/detail/glow sibling maps (e.g. "Glow in the Dark"
// night windows). Wide vertex: pos+normal+color + 4 UV sets (binding 0). Per-INSTANCE
// (binding 1): a Meta word (DrawIndex + stageCount + vColSource + alphaRef), the 4 packed
// stage words, and the Tier 2b material. Reuses the opaque SRT (gFrameData + gBatch.worlds
// as ONE 256-matrix window) + the shared default.rootsig. Same matrix/reverse-Z convention
// as opaque.vert. Emits clip pos + world normal/pos + 4 UVs + per-draw stage/material for
// the multimap.frag fixed-function stage blend.

#include "opaque.srt.h"
#include "fog.h.fsl"    // mwFogFactor() — ONE fog law for every stage
#include "tonemap.h.fsl"    // (scenecolor.h.fsl's prerequisite; the curve is never called in a VS)
#include "linearize.h.fsl" // srgbToLinear() — the scene's transfer function (step 5)
#include "scenecolor.h.fsl" // decodeAuthored() — MW's authored colours enter the scene domain HERE

STRUCT(VSInput)
{
    DATA(float3, Position,   POSITION);
    DATA(float3, Normal,     NORMAL);
    DATA(float4, Color,      COLOR);       // per-vertex DiffAmb colour (white when unused)
    DATA(float2, Uv0,        TEXCOORD0);   // per-vertex UV set 0
    DATA(float2, Uv1,        TEXCOORD1);   // per-vertex UV set 1
    DATA(float2, Uv2,        TEXCOORD2);   // per-vertex UV set 2
    DATA(float2, Uv3,        TEXCOORD3);   // per-vertex UV set 3
    DATA(uint,   Meta,       TEXCOORD4);   // per-instance: DrawIndex(0-9)|stageCount(10-12)|vColSource(13-14)|enchantGlow(15)|alphaRef*255(16-23)|uvAnimId(24-31)
    DATA(uint4,  Stages,     TEXCOORD5);   // per-instance: 4 packed stage words (texIndex(16)|uvSet(16-17)|op(18-19))
    DATA(float3, MatDiffuse, TEXCOORD6);   // per-instance: material diffuse rgb
    DATA(float3, MatAmbient, TEXCOORD7);   // per-instance: material ambient rgb
    DATA(float3, MatEmissive,TEXCOORD8);   // per-instance: material emissive rgb
    // .x = MaterialProperty::alpha (FFE per-draw fade); .yzw = the emissive flux/area gain, a
    // RATIO that is never decoded (see the apply below). ONE float4 rather than a float plus a new
    // float3 because The Forge's ShaderSemantic enum stops at TEXCOORD9 and this VSInput already
    // uses all ten — and because instance lanes [14..17] are contiguous anyway, so the wider
    // attribute reads the same bytes with no extra vertex-layout element.
    DATA(float4, MatAlphaGain, TEXCOORD9);
};

STRUCT(VSOutput)
{
    DATA(float4,      Position, SV_Position);
    DATA(float3,      Normal,   NORMAL);
    DATA(float2,      Uv0,      TEXCOORD0);
    DATA(float2,      Uv1,      TEXCOORD1);
    DATA(float2,      Uv2,      TEXCOORD2);
    DATA(float2,      Uv3,      TEXCOORD3);
    DATA(CENTROID(float), Fog,      TEXCOORD4);   // MW fog scalar (1 = clear)
    DATA(float4,      Color,    COLOR);       // per-vertex DiffAmb colour
    DATA(FLAT(float3),MatDiffuse, TEXCOORD5); // Tier 2b material (per draw)
    DATA(FLAT(float3),MatAmbient, TEXCOORD6);
    DATA(FLAT(float3),MatEmissive,TEXCOORD7);
    DATA(float3,      WorldPos,   TEXCOORD8); // Tier 3a: world position for point-light eval
    DATA(FLAT(uint4), Stages,     TEXCOORD9); // 4 packed stage words
    DATA(FLAT(uint),  Packed,     TEXCOORD10);// stageCount(0-2)|vColSource(3-4)|enchantGlow(5)|alphaRef*255(8-15)
    // IR5 real water reflection: below-water clip, identical to opaque.vert's. Pass-all (0,0,0,1)
    // in every frame cbuffer EXCEPT pReflectFrameCbvGeo → a constant Clip = 1 >= 0 (nothing clipped)
    // in the colour, Z-prepass and shadow-caster passes this vert also drives. In the mirror it keeps
    // the above-water half-space, so the seabed's heads/lamps never reflect.
    // SV_ClipDistance0 is a RASTERIZER system value: no frag input, no PSO clip state — which is what
    // keeps it clear of the shared-frag VSOutput hazard, since multimap.frag, multimap_alpha.frag and
    // depthonly_mm.frag all simply omit it from their own structs. opaque.vert already proves this
    // across the same four pass types.
    DATA(float,       Clip,       SV_ClipDistance0);
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN( VSInput In )
{
    INIT_MAIN;
    VSOutput Out;

    // Meta layout (kMaxMultiMap=1024 widened the index to 10 bits):
    //   idx(0-9) | stageCount(10-12) | vColSource(13-14) | enchantGlow(15) | alphaRef*255(16-23) |
    //   uvAnimId(24-31)
    uint drawIndex  = In.Meta & 0x3FFu;
    uint stageCount = (In.Meta >> 10u) & 0x7u;
    uint vColSource = (In.Meta >> 13u) & 0x3u;
    uint glowBit    = (In.Meta >> 15u) & 0x1u;   // MW's enchanted-item glow (Meta's last spare bit)
    uint alphaRefB  = (In.Meta >> 16u) & 0xFFu;
    uint uvAnimId   = (In.Meta >> 24u) & 0xFFu;
    // Cbuffer matrices are column-major (DXC default), so mul(M, v) with the D3DX bytes
    // uploaded as-is == D3DX v*M. The worlds buffer is ONE 1024-matrix window for multimap.
    float4x4 world = gBatch.worlds[drawIndex];
    float4 worldPos = mul(world, float4(In.Position, 1.0f));
    Out.Position = mul(gFrameData.viewProj, worldPos);
    Out.Normal = mul((float3x3)world, In.Normal);
    Out.WorldPos = worldPos.xyz;
    Out.Uv0 = In.Uv0;
    Out.Uv1 = In.Uv1;
    Out.Uv2 = In.Uv2;
    Out.Uv3 = In.Uv3;
    // NiUVController takeover: host-evaluated scroll delta, applied to the controller's
    // textureSet only (gUVAnim[id].z carries the set index).
    if (uvAnimId != 0u) {
        float4 anim = gUVAnim[uvAnimId];
        uint setIdx = uint(anim.z);
        if      (setIdx == 0u) { Out.Uv0 += anim.xy; }
        else if (setIdx == 1u) { Out.Uv1 += anim.xy; }
        else if (setIdx == 2u) { Out.Uv2 += anim.xy; }
        else                   { Out.Uv3 += anim.xy; }
    }
    // MaterialProperty::alpha rides the interpolated vertex alpha rather than its own interpolator:
    // Out.Color.a is read ONLY by multimap_alpha.frag (multimap.frag and depthonly_mm.frag take
    // In.Color.rgb and nothing else), and adding a VSOutput field would ripple through every frag
    // paired with this vert — the GPU-hang pairing hazard. The wide VB ships white (a = 1) whenever
    // no VertexColorProperty drives the shape, so this reduces to matAlpha in that case.
    // Step 5: the authored colours enter the scene's domain here, in the vertex stage — see
    // opaque.vert.fsl for why here and not in the frag, and why .a is deliberately left alone
    // (it is coverage, and MaterialProperty::alpha rides it).
    Out.Color = float4(decodeAuthored(In.Color.rgb), In.Color.a * In.MatAlphaGain.x);
    Out.MatDiffuse  = decodeAuthored(In.MatDiffuse);
    Out.MatAmbient  = decodeAuthored(In.MatAmbient);
    Out.MatEmissive = decodeAuthored(In.MatEmissive);
    // ── THE GAIN IS A RATIO, AND A RATIO MUST NOT MEET A TRANSFER FUNCTION ──
    //
    // In.EmisGain is the client's flux/area emissive boost (kEmissiveFlux * ownLight.diffuse /
    // fixtureArea — scenegraph_geometry_cache.cpp::computeEmissiveGain). It is a SCALE, so it is
    // the one per-instance float3 here that must NOT be decoded. It rides its own lane for exactly
    // that reason: it used to arrive folded into In.MatEmissive by the client, which put it on the
    // wrong side of the decode above. srgbToLinear is unclamped past 1.0, so a gain g reached the
    // frag as ~g^2.4 — measured 2.11 -> 5.61, 3.18 -> 14.7, 25.95 -> 2189, and a candle flame's
    // 401 -> 1.56e6. That is the glass lantern that read 1069 in a linear EXR dump.
    //
    // ⚠ IT MULTIPLIES WHICHEVER LANE vColSource MADE THE EMISSIVE. That is the other half of the
    // same bug: on vColSource 1 (SRC_EMISSIVE) the emissive IS the vertex colour and every paired
    // frag reads In.Color.rgb, never In.MatEmissive — so a gain folded into matEmissive was
    // silently discarded for precisely the small hot emitters that most need it (candle and torch
    // flames). Two bugs pulling opposite ways: lanterns nuclear, flames dead.
    //
    // ⚠ HERE AND NOT IN THE FRAG — and yes, opaque.frag says the opposite. Its comment is about its
    // OWN scalar (calParams.x), which multiplies AFTER the select and therefore has to live where
    // the select is. This is a different claim: the vert unpacks vColSource a dozen lines above, so
    // it knows the branch too, and doing it here costs NO new VSOutput field. A frag-side fix needs
    // one, and this vert's VSOutput is shared by opaque / alpha / depthonly / shadowcaster /
    // sunshadow / alphadepth / alphashadowdepth / portalgate / portalhull — nine
    // structs that must ALL gain the field or the GPU hangs — here the shared set is
    // multimap.frag / multimap_alpha.frag / depthonly_mm.frag ([[project_forge_shared_frag_vsoutput]]).
    // Scaling Color.rgb is safe because on vColSource 1 it is read ONLY as the emissive addend —
    // verified in all nine. The shadowcaster's MatEmissive.x/.y overload is safe because every
    // instance buffer it draws from ships gain 1,1,1.
    //
    // ⚠ .rgb ONLY. Alpha is coverage and has no transfer function and no radiometric scale — the
    // same split the bloom prefilter makes between filter weights and exposure
    // ([[project_forge_premultiplied_pair]]).
    float3 emisGain = max(In.MatAlphaGain.yzw, float3(0.0f, 0.0f, 0.0f));
    if (vColSource == 1u) { Out.Color.rgb *= emisGain; }
    else                  { Out.MatEmissive *= emisGain; }
    Out.Stages = In.Stages;
    // Packed keeps the LEGACY interpolator layout — stageCount(0-2)|vColSource(3-4)|
    // alphaRef*255(8-15) — repacked explicitly from the new Meta bits, so multimap.frag /
    // depthonly_mm.frag are byte-for-byte unchanged. Bit 5 was spare in that layout and now carries
    // the enchant-glow flag; depthonly_mm.frag reads neither it nor anything above bit 4.
    Out.Packed = stageCount | (vColSource << 3u) | (glowBit << 5u) | (alphaRefB << 8u);
    // MW near fog (per-vertex, matches opaque.vert).
    float dist = length(worldPos.xyz - gFrameData.eyePos.xyz);
    Out.Fog = mwFogFactor(dist);   // ramp only — the submerged test is PER PIXEL (mwFogAir)
    // Below-water clip (reflect pass only) — see the VSOutput comment. worldPos is camera-relative,
    // matching the plane the host writes.
    Out.Clip = dot(gFrameData.gReflWaterClip.xyz, worldPos.xyz) + gFrameData.gReflWaterClip.w;
    RETURN(Out);
}
