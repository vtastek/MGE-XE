// mgeHost64 — Route C: alpha-BLEND multi-map (fragment stage).
//
// A byte-for-byte copy of multimap.frag EXCEPT the final output alpha: this frag is paired with
// the UNCHANGED multimap.vert and drawn in the alpha stage with a blend PSO (SRCALPHA/INVSRCALPHA,
// depth GEQUAL no-write) for alpha-BLEND multi-map shapes — Glow-in-the-Dahrk night windows (base
// orange x dark shape), and any other blended shape carrying a dark/detail/glow sibling map.
// multimap.frag forces alpha = 1.0 (opaque coverage); here the blend needs MW's REAL FFE alpha,
// texA * vcolA * matAlpha (see the RETURN at the bottom for why all three factors matter).
// VSOutput is still multimap.vert's verbatim — matAlpha rides In.Color.a — so no pairing-hazard
// ripple onto the other frags paired with that vert.
//
// The lit + point-light + stage-combine blocks below are IDENTICAL to multimap.frag — keep them in
// lockstep with multimap.frag / opaque.frag (Tier 1/2b/3a). Only the last RETURN differs.

#include "opaque.srt.h"
#include "texsample.h.fsl"   // sampleBase() — MW address mode + AF level
#include "skyamb.h.fsl"      // skyAmbFactor() — SH-L1 sky ambient (SH1) + sky AO (SH2)
#include "skydome.h.fsl"     // applyFog() — extinguish into a silhouette, then melt into the SAMPLED sky
#include "tonemap.h.fsl"     // tonemap() — the shared semi-HDR curve (was six byte-identical copies)
#include "enchantglow.h.fsl" // enchantGlow() — MW's caustic env map over enchanted items

STRUCT(VSOutput)
{
    DATA(float4,      Position, SV_Position);
    DATA(float3,      Normal,   NORMAL);
    DATA(float2,      Uv0,      TEXCOORD0);
    DATA(float2,      Uv1,      TEXCOORD1);
    DATA(float2,      Uv2,      TEXCOORD2);
    DATA(float2,      Uv3,      TEXCOORD3);
    DATA(CENTROID(float), Fog,      TEXCOORD4);
    DATA(float4,      Color,    COLOR);
    DATA(FLAT(float3),MatDiffuse, TEXCOORD5);
    DATA(FLAT(float3),MatAmbient, TEXCOORD6);
    DATA(FLAT(float3),MatEmissive,TEXCOORD7);
    DATA(float3,      WorldPos,   TEXCOORD8);
    DATA(FLAT(uint4), Stages,     TEXCOORD9);
    DATA(FLAT(uint),  Packed,     TEXCOORD10);
};

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN( VSOutput In )
{
    INIT_MAIN;
    float3 N = normalize(In.Normal);

    uint   aoFlags  = (uint)(gFrameData.debugParams.w + 0.5f);
    float2 aoUv     = In.Position.xy * gShadowParams.screenAlloc.zw;   // gAO is ALLOC-sized, not render-sized
    float4 aoSample = SampleTex2D(gAO, gSamplerAnisotropic, aoUv);
    // NO bent-normal bend and NO AO scalar — alpha sheets are not in the Z-prepass gAO is built
    // from, so aoSample here belongs to whatever is BEHIND the sheet. Same reasoning and same
    // decision as alpha.frag; keep the two in lockstep. Read only for the F12 AO views below.

    // --- BEGIN lit block (DUPLICATED from multimap.frag — keep in lockstep) ---
    float  ndl = saturate(dot(N, -gFrameData.sunDir.xyz));
    float3 d = gFrameData.sunCol.rgb * ndl;
    // SH1 sky-directional ambient — geometric normal, not the possibly-bent N (see skyamb.h.fsl).
    float3 a = ((aoFlags & 4u) != 0u) ? float3(1.0f, 1.0f, 1.0f)
                                      : gFrameData.ambCol.rgb * skyAmbFactor(In.Normal, In.WorldPos);
    // NO AO on ambient — aoSample belongs to the opaque surface BEHIND the sheet, so this was
    // stamping the wall's occlusion onto a transparent surface in front of it. Same reasoning and
    // same decision as alpha.frag; keep the two in lockstep. aoSample stays sampled for the F12
    // AO views (dbg 3/4) below.
    a *= gFrameData.dbgScales.x;
    {
        uint nLights = (uint)gLights.lightParams.x;
        float reachK = gLights.lightParams.y;
        int   nfTilesX = (int)gLights.froxelDimsNear.x;
        bool  clustered = (nfTilesX > 0);
        uint  fbase = 0u;
        if (clustered)
        {
            int   nfTilesY = (int)gLights.froxelDimsNear.y;
            int   nfNZ     = (int)gLights.froxelDimsNear.z;
            float nfTile   = gLights.froxelDimsNear.w;
            int tx = clamp((int)(In.Position.x / nfTile), 0, nfTilesX - 1);
            int ty = clamp((int)(In.Position.y / nfTile), 0, nfTilesY - 1);
            float dd = length(In.WorldPos);
            int zs = clamp((int)((log(max(dd, 1.0f)) - gLights.froxelZNear.x) * gLights.froxelZNear.y * (float)nfNZ), 0, nfNZ - 1);
            fbase = (((uint)ty * (uint)nfTilesX + (uint)tx) * (uint)nfNZ + (uint)zs) * 4u;
        }
        for (uint wi = 0u; wi < 4u; ++wi)
        {
            uint bits;
            if (clustered) {
                bits = gFroxelMaskNear[fbase + wi];
            } else {
                uint lo = wi * 32u;
                uint cnt = (lo >= nLights) ? 0u : min(32u, nLights - lo);
                bits = (cnt >= 32u) ? 0xFFFFFFFFu : ((1u << cnt) - 1u);
            }
            while (bits != 0u)
            {
                uint i = wi * 32u + firstbitlow(bits);
                bits = bits & (bits - 1u);
                if (i >= nLights) { continue; }
                float4 posR    = gLights.lights[i * 3u + 0u];
                float3 lightCol= gLights.lights[i * 3u + 1u].rgb;
                float3 fo      = gLights.lights[i * 3u + 2u].xyz;
                float  radius  = posR.w;
                float  reach   = radius * reachK;

                float3 toLight = posR.xyz - In.WorldPos;
                float  dist2   = dot(toLight, toLight);
                if (dist2 >= reach * reach) { continue; }
                float  invDist = rsqrt(max(dist2, 1e-8f));
                float  dist    = dist2 * invDist;

                float  att = 1.0f / max(fo.z * dist2 + fo.y * dist + fo.x, 1e-4f);
                att *= 1.0f - smoothstep(POINT_LIGHT_TAIL * reach, reach, dist);

                uint slotP1 = (uint)gLights.lights[i * 3u + 2u].w;
                if (slotP1 != 0u)
                {
                    uint4 mw   = LoadTex2D(gShadowMask, NO_SAMPLER, int2(In.Position.xy), 0).xyzw;
                    uint  s    = slotP1 - 1u;
                    uint  lane = s >> 3u;
                    uint  word = lane == 0u ? mw.x : (lane == 1u ? mw.y : (lane == 2u ? mw.z : mw.w));
                    uint  nib  = (word >> ((s & 7u) * 4u)) & 0xFu;
                    att *= float(nib) * (1.0f / 15.0f);
                }

                float  lambert = saturate(dot(N, toLight) * invDist);
                d += lambert * att * lightCol;
            }
        }
    }
    d *= gFrameData.dbgScales.y;
    uint vColSource = (In.Packed >> 3u) & 0x3u;
    float3 lit;
    if (vColSource == 2u) {
        lit = In.Color.rgb * (d + a) + In.MatEmissive;
    } else if (vColSource == 1u) {
        lit = In.MatDiffuse * d + In.MatAmbient * a + In.Color.rgb;
    } else {
        lit = In.MatDiffuse * d + In.MatAmbient * a + In.MatEmissive;
    }
    // --- END lit block ---

    // Fixed-function stage loop (IDENTICAL to multimap.frag): BASE = tex*lit + record baseA,
    // MOD/MOD2X/ADD fold the sibling maps (the dark map is what makes the glow orange).
    uint  stageCount = In.Packed & 0x7u;
    float alphaRef   = float((In.Packed >> 8u) & 0xFFu) * (1.0f / 255.0f);
    float albScale   = gFrameData.dbgScales.z;
    float3 c   = lit;
    float3 alb = float3(1.0f, 1.0f, 1.0f);
    float  baseA = 1.0f;
    for (uint s = 0u; s < 4u; ++s)
    {
        if (s >= stageCount) { break; }
        uint sw = (s == 0u) ? In.Stages.x : (s == 1u) ? In.Stages.y
                : (s == 2u) ? In.Stages.z : In.Stages.w;
        uint tex   = sw & 0xFFFFu;
        uint uvSet = (sw >> 16u) & 0x3u;
        uint op    = (sw >> 18u) & 0x3u;
        uint clampMode = (sw >> 20u) & 0x3u;
        float2 uv = (uvSet == 0u) ? In.Uv0 : (uvSet == 1u) ? In.Uv1
                  : (uvSet == 2u) ? In.Uv2 : In.Uv3;
        float4 t = sampleBase(tex, clampMode, uv, useLowAF(alphaRef, false));
        if (op == 0u)      { float3 b = t.rgb * albScale; c = b * lit; baseA = t.a; alb = b; }
        else if (op == 1u) { c *= t.rgb;        alb *= t.rgb; }
        else if (op == 2u) { c *= t.rgb * 2.0f; alb *= t.rgb * 2.0f; }
        else               { c += t.rgb;        alb += t.rgb; }
    }

    // Alpha test on the BASE stage (kept for parity; these windows carry no test → alphaRef 0).
    if (baseA < alphaRef) { discard; }

    // MW's enchanted-item glow (Packed bit5 — see multimap.vert). Multiplicative on the shaded
    // result, and not scaled by the output alpha: the blend PSO is SRCALPHA, so coverage is applied
    // at blend time, as alpha.frag notes.
    c *= 1.0f + enchantGlow(In.Normal, In.WorldPos, (In.Packed & 0x20u) != 0u);
    c *= gFrameData.dbgScales.w;
    c = tonemap(c);
    c = applyFog(c, In.WorldPos, In.Position.xy, In.Fog);

    // F12 debug views (lockstep with multimap.frag; alpha forced 1 so the view reads clearly).
    uint dbg = (uint)(gFrameData.debugParams.x + 0.5f);
    if (dbg == 3u || dbg == 4u) {
        // mode 4: the gAO bend term, remapped *0.5+0.5 so zero reads as mid grey. It is not a
        // normal (aocommon.h.fsl): it runs from EXACTLY zero where nothing occludes to the
        // absolute bent direction where everything does. So flat mid grey == "no bend here",
        // and it must be flat on an OPEN surface — any 4x4 dither-tile texture there means the
        // quadrature reference is not cancelling. Cavities legitimately read as a normal map.
        if (dbg == 4u) { RETURN(float4(aoSample.rgb * 0.5f + 0.5f, 1.0f)); }
        float v = aoSample.a; RETURN(float4(v, v, v, 1.0f));
    }
    if (dbg == 5u) { RETURN(float4(alb, 1.0f)); }
    if (dbg == 6u) { RETURN(float4(lit, 1.0f)); }
    if (dbg == 7u) {
        float3 al;
        if (vColSource == 2u)      { al = In.Color.rgb * a + In.MatEmissive; }
        else if (vColSource == 1u) { al = In.MatAmbient * a + In.Color.rgb; }
        else                       { al = In.MatAmbient * a + In.MatEmissive; }
        RETURN(float4(al, 1.0f));
    }
    if (dbg == 1u || dbg == 2u) {
        float dist = length(In.WorldPos - gFrameData.eyePos.xyz);
        float g = saturate(dist * (1.0f / 8192.0f));
        RETURN(float4(g, g, g, 1.0f));
    }
    if (dbg == 10u) {
        uint4 mw = LoadTex2D(gShadowMask, NO_SAMPLER, int2(In.Position.xy), 0).xyzw;
        float g = float(mw.x & 0xFu) * (1.0f / 15.0f);
        RETURN(float4(g, g, g, 1.0f));
    }

    // Route C output: MW's full FFE alpha, texA * vcolA * matAlpha — the same expression
    // alpha.frag uses for single-map blends. `baseA` is the BASE stage's texture alpha, recorded
    // by the stage loop above; vcolA * matAlpha arrives folded into In.Color.a by multimap.vert
    // (white = 1 when the shape carries no VertexColorProperty).
    //
    // This used to be `(vColSource != 0) ? In.Color.a : 1.0`, dropping baseA on the floor. It read
    // correctly on the Glow-in-the-Dahrk windows it was measured against — their base maps are
    // fully opaque, so baseA really was 1 — but Route C claims EVERY blended multi-map shape, and
    // a shape whose glow map IS its own base map (in_c_rich_r_swin_bay_01.nif's light rays: base =
    // glow = textures\glow\ray_alpha.dds, MODULATE then ADD for double brightness) keeps all of its
    // transparency in that base alpha channel and has no vertex colours at all. Result: outA = 1,
    // a hard opaque quad where MW draws soft rays. Before Route C existed those rays fell through
    // to the AT3 captured path and got alpha.frag's correct alpha — hence "we used to render it".
    float outA = baseA * In.Color.a;
    RETURN(float4(c, outA));
}
