// mgeHost64 — opaque scene (fragment stage).
//
// Lighting fidelity: real MW sun (directional N·L) + scene ambient + static tonemap + near fog,
// fed per-frame via gFrameData (sunDir/sunCol/ambCol/fogColNear/fogParams). Tier 2b adds the FFE
// vertexMaterial routing (per-draw material constants matDiffuse/matAmbient/matEmissive + the
// vColSource diffamb/emissive/none selection), replicating XE FixedFuncEmu.fx PerPixelPS for the
// same opaque set the cache color path draws. Point lights and multi-map are the following tiers.
// The base map is the bindless gTextures[TexIndex] (slot 0 = white), MODULATE'd over the material.

#include "opaque.srt.h"

STRUCT(VSOutput)
{
    DATA(float4,      Position, SV_Position);
    DATA(float3,      Normal,   NORMAL);
    DATA(float2,      Uv,       TEXCOORD0);
    DATA(FLAT(uint),  TexIndex, TEXCOORD1);
    DATA(float,       Fog,      TEXCOORD2);
    DATA(float4,      Color,    COLOR);       // per-vertex DiffAmb colour
    DATA(float,       AlphaRef, TEXCOORD3);   // alpha-test ref 0..1 (0 = no test)
    DATA(FLAT(float3),MatDiffuse, TEXCOORD4); // Tier 2b material constants (per draw)
    DATA(FLAT(float3),MatAmbient, TEXCOORD5);
    DATA(FLAT(float3),MatEmissive,TEXCOORD6);
    DATA(FLAT(uint),  VColSource, TEXCOORD7); // 0 none, 1 emissive, 2 diffamb
    DATA(float3,      WorldPos,   TEXCOORD8); // Tier 3a: world position for point-light eval
    DATA(FLAT(uint),  OverlayIndex,TEXCOORD9);// terrain DECAL_1 bindless slot (0 = no decal)
};

// Static semi-HDR tonemap — ported verbatim from XE FixedFuncEmu.fx::tonemap.
// Maps 0->0, 1.0->0.84, up to 2.2->1.0 (lets sun+ambient overshoot 1 without clipping flat).
float3 tonemap(float3 c)
{
    c = clamp(c, 0.0f, 2.2f);
    c = (((0.0548303f * c - 0.189786f) * c - 0.154732f) * c + 1.12969f) * c;
    return c;
}

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN( VSOutput In )
{
    INIT_MAIN;
    float3 N = normalize(In.Normal);
    // MW lighting: sun diffuse (to-sun = -sunDir) + scene ambient. FFE convention.
    float  ndl = saturate(dot(N, -gFrameData.sunDir.xyz));
    // FFE PerPixelPS lighting terms: d = sun diffuse + point lights, a = scene ambient.
    // (matches lightSunDiffuse*N.L + Σ pointlights + lightSceneAmbient.)
    float3 d = gFrameData.sunCol.rgb * ndl;
    float3 a = gFrameData.ambCol.rgb;

    // Tier 3a point lights — replicates XE FixedFuncEmu.fx evalOnePointLight EXACTLY, in WORLD
    // space (Forge normals + positions are world-space, like the Tier 1 sun). pointLightMult is
    // already baked into each light's colour client-side (the main cache path uses 1.0). The
    // lights cbuffer packs 3 float4 per light: [i*3+0]=(pos.xyz, radius), [i*3+1]=(col.rgb,_),
    // [i*3+2]=(k0,k1,k2,_). lightParams.x is the active count (host-written).
    {
        uint nLights = (uint)gLights.lightParams.x;
        for (uint i = 0; i < nLights; ++i)
        {
            float4 posR    = gLights.lights[i * 3u + 0u];
            float3 lightCol= gLights.lights[i * 3u + 1u].rgb;
            float3 fo      = gLights.lights[i * 3u + 2u].xyz;   // x=k0 const, y=k1 linear, z=k2 quad
            float  radius  = posR.w;

            float3 toLight = posR.xyz - In.WorldPos;
            float  dist2   = dot(toLight, toLight);
            float  invDist = rsqrt(max(dist2, 1e-8f));
            float  dist    = dist2 * invDist;

            // Full 1/(k0 + k1·d + k2·d²) attenuation. The linear k1 term is essential —
            // MW candle/torch lights are pure-linear (k0=k2=0). max() guards d->0.
            float  att = 1.0f / max(fo.z * dist2 + fo.y * dist + fo.x, 1e-4f);
            // Soft cutoff: ramp 1->0 over [radius, 2·radius] so the future CPU cull boundary
            // has no hard seam (matches evalOnePointLight / OpenMW PerObjectUniform).
            att *= 1.0f - smoothstep(radius, 2.0f * radius, dist);

            float  lambert = saturate(dot(N, toLight) * invDist);
            d += lambert * att * lightCol;
        }
    }

    // Tier 2b material routing — replicates XE FixedFuncEmu.fx vertexMaterial* EXACTLY (the
    // PROVEN cache color path's selection via matSrcDiffuse/matSrcEmissive):
    //   vColSource 2 (DiffAmb):   col.rgb * (d + a) + matEmissive
    //   vColSource 1 (Emissive):  matDiffuse * d + matAmbient * a + col.rgb
    //   vColSource 0 (None):      matDiffuse * d + matAmbient * a + matEmissive
    // The client forces vColSource 0 unless the mesh has colours AND its VertexColorProperty
    // says to use them (else real material colours get white-washed), so the col-using
    // branches only run on genuine DiffAmb/Emissive meshes.
    float3 lit;
    if (In.VColSource == 2u) {
        lit = In.Color.rgb * (d + a) + In.MatEmissive;
    } else if (In.VColSource == 1u) {
        lit = In.MatDiffuse * d + In.MatAmbient * a + In.Color.rgb;
    } else {
        lit = In.MatDiffuse * d + In.MatAmbient * a + In.MatEmissive;
    }

    // gSamplerAnisotropic: FSL built-in STATIC sampler (anisotropic 8x, WRAP), baked into
    // DefaultRootSignature. We deliberately do NOT use a dynamic sampler: one sharing the Persistent
    // set with the 1024-entry bindless array gets pushed to mOffset=1024 by FSL's single per-set
    // descriptor counter, so the host's bind lands at sampler-table slot 1024 while the shader reads
    // s0 (= null sampler => POINT filter + non-REPEAT address => tiled UVs sample black). A static
    // sampler sidesteps that entirely. See opaque.srt.h.
    float4 albedo = SampleTex2D(gTextures[In.TexIndex], gSamplerAnisotropic, In.Uv);

    // Terrain DECAL_1 splat — replicates cacheTerrainLitColor (XE Mod Landscape Lit.fx):
    //   albedo = lerp(base, overlay, vcol.a)   (overlay shares uv0; vcol ALPHA = AlphaGrid).
    // Gated on OverlayIndex != 0 so every non-terrain / single-texture draw is byte-for-byte
    // unchanged. Lands BEFORE the alpha test and c = albedo.rgb * lit, so terrain computes
    // lerp(base,overlay,vcol.a) * vcol.rgb*(d+a) — matching the D3D9 oracle.
    if (In.OverlayIndex != 0u) {
        float3 ov = SampleTex2D(gTextures[In.OverlayIndex], gSamplerAnisotropic, In.Uv).rgb;
        albedo.rgb = lerp(albedo.rgb, ov, In.Color.a);
    }

    // Alpha test (cutout foliage/grates/fences). MW drives this per-part via D3DRS_ALPHAREF
    // with GREATER; we approximate with GREATEREQUAL (keep a >= ref). Strict '<' means a ref of
    // 0 (non-alpha-test geometry) never discards — opaque base maps with stray low alpha are safe.
    if (albedo.a < In.AlphaRef) { discard; }

    float3 c = albedo.rgb * lit;
    c = tonemap(c);
    // Near fog: lerp toward fogColNear as Fog -> 0 (matches FFE's lerp(fogColNear, c, fog)).
    c = lerp(gFrameData.fogColNear.rgb, c, In.Fog);
    // F12 depth view: visualize world distance (reverse-Z NDC is too crushed to read).
    if (gFrameData.debugParams.x > 0.5f) {
        float dist = length(In.WorldPos - gFrameData.eyePos.xyz);
        float g = saturate(dist * (1.0f / 8192.0f));  // near=black, far=white; range tunable
        RETURN(float4(g, g, g, 1.0f));
    }
    RETURN(float4(c, 1.0f));
}
