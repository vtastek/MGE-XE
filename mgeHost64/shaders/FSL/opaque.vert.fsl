// mgeHost64 — M1c opaque scene (vertex stage, GPU-driven).
//
// Model-space pos+normal (binding 0, per-vertex) + a per-INSTANCE DrawIndex (binding 1)
// that selects this part's world matrix from gWorlds. Camera from gFrameData. Emits clip
// position + world-space normal for flat N.L shading.

#include "opaque.srt.h"

STRUCT(VSInput)
{
    DATA(float3, Position,  POSITION);
    DATA(float3, Normal,    NORMAL);
    DATA(uint,   DrawIndex, TEXCOORD0);   // per-instance: index into gWorlds
};

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float3, Normal,   NORMAL);
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN( VSInput In )
{
    INIT_MAIN;
    VSOutput Out;

    float4x4 world = gScene.worlds[In.DrawIndex];
    // Cbuffer matrices are column-major (DXC default), so mul(M, v) with the D3DX bytes
    // uploaded as-is == D3DX v*M (proven by the working per-draw-cbuffer M1c-256).
    float4 worldPos = mul(world, float4(In.Position, 1.0f));
    Out.Position = mul(gScene.viewProj, worldPos);
    Out.Normal = mul((float3x3)world, In.Normal);
    RETURN(Out);
}
