// mgeHost64 — M1c opaque scene (vertex stage, GPU-driven).
//
// Model-space pos+normal (binding 0, per-vertex) + a per-INSTANCE DrawIndex (binding 1)
// that selects this part's world matrix from gWorlds. Camera from gFrameData. Emits clip
// position + world-space normal for flat N.L shading.

#include "opaque.srt.h"
#include "handover.h.fsl" // handoverNearClip() — the near/far plane, shared with statics.vert
#include "fog.h.fsl"    // mwFogFactor() — ONE fog law for every stage
#include "tonemap.h.fsl"    // (scenecolor.h.fsl's prerequisite; the curve is never called in a VS)
#include "linearize.h.fsl" // srgbToLinear() — the scene's transfer function (step 5)
#include "scenecolor.h.fsl" // decodeAuthored() — MW's authored colours enter the scene domain HERE

STRUCT(VSInput)
{
    DATA(float3, Position,  POSITION);
    DATA(float3, Normal,    NORMAL);
    DATA(float2, Uv,        TEXCOORD0);    // per-vertex: base-map UV
    DATA(float4, Color,      COLOR);        // per-vertex: DiffAmb colour (white when unused)
    DATA(uint,   DrawIndex,  TEXCOORD1);    // per-instance: gWorlds index (low 16) | UV-anim id (bits 16+, 0 = none)
    DATA(uint,   TexAlpha,   TEXCOORD2);    // per-instance packed: texIndex (16) | alphaRef*255 (8) | vColSource (bits 24-25)
    DATA(float3, MatDiffuse, TEXCOORD3);    // per-instance: material diffuse rgb
    DATA(float3, MatAmbient, TEXCOORD4);    // per-instance: material ambient rgb
    DATA(float3, MatEmissive,TEXCOORD5);    // per-instance: material emissive rgb
    DATA(uint,   OverlayIndex,TEXCOORD6);   // per-instance: terrain DECAL_1 bindless slot (0 = none)
    DATA(float3, EmisGain,   TEXCOORD7);    // per-instance: emissive flux/area gain — a RATIO, never decoded
    DATA(uint,   ParamIndex, TEXCOORD8);    // per-instance: PBR _paramh bindless slot (0 = no PBR material)
};

STRUCT(VSOutput)
{
    DATA(float4,      Position, SV_Position);
    DATA(float3,      Normal,   NORMAL);
    DATA(float2,      Uv,       TEXCOORD0);
    DATA(FLAT(uint),  TexIndex, TEXCOORD1);
    DATA(CENTROID(float), Fog,      TEXCOORD2);   // MW fog scalar (1 = clear, 0 = full fogColNear)
    DATA(float4,      Color,    COLOR);       // per-vertex DiffAmb colour (shared opaque.frag)
    DATA(float,       AlphaRef, TEXCOORD3);   // alpha-test ref 0..1 (shared opaque.frag; 0 = no test)
    DATA(FLAT(float3),MatDiffuse, TEXCOORD4); // per-draw material (Tier 2b; FLAT = constant per draw)
    DATA(FLAT(float3),MatAmbient, TEXCOORD5);
    DATA(FLAT(float3),MatEmissive,TEXCOORD6);
    DATA(FLAT(uint),  VColSource, TEXCOORD7); // 0 none, 1 emissive, 2 diffamb
    DATA(float3,      WorldPos,   TEXCOORD8); // Tier 3a: world position for point-light eval
    DATA(FLAT(uint),  OverlayIndex,TEXCOORD9);// terrain DECAL_1 bindless slot (0 = no decal)
    DATA(FLAT(uint),  ClampMode,  TEXCOORD10);// MW texture address mode (0..3) -> sampleBase()
    // This draw's instance index — the same value that selected gBatch.worlds above. Forwarding it
    // is what lets a paired frag read ARBITRARY per-draw data out of a side table without adding
    // instance lanes: kStaticInstU32 and the binding-1 vertex layout are shared by every
    // opaque-layout pipeline, so growing them for one frag ripples through all of them. alpha.frag
    // uses it for gAlphaStages; every other paired frag simply omits it from its own VSOutput.
    DATA(FLAT(uint),  DrawIdx,    TEXCOORD11);
    // PBR param-map slot (tasks/forge-pbr-materials.md). AFTER DrawIdx, which is what keeps every
    // paired frag's struct a PREFIX of this one: depthonly/shadowcaster/sunshadow stop at ClampMode,
    // alpha.frag at DrawIdx, and only opaque.frag reads this far. skinned.vert — the other vert that
    // feeds opaque.frag — carries the same field at the same place, pinned to 0
    // ([[project_forge_shared_frag_vsoutput]]: a frag reading a field its vert never wrote is a
    // bindless index into garbage, and a GPU hang).
    DATA(FLAT(uint),  ParamIndex, TEXCOORD12);
    // Real water reflection (IR3): below-water clip, the same mechanism statics.vert/terrain.vert
    // already use. Pass-all (0,0,0,1) in every frame cbuffer EXCEPT pReflectFrameCbvGeo → a constant
    // Clip = 1 >= 0 (nothing clipped) in the main/FP/sun/shadow-face passes. In the mirror it keeps
    // the above-water half-space, so the seabed (and an interior's sub-floor) never reflects.
    // SV_ClipDistance0 is a RASTERIZER system value: no frag input, no PSO clip state — which is
    // exactly what keeps this clear of the shared-frag VSOutput hazard, since opaque.frag,
    // depthonly.frag, shadowcaster.frag and alpha.frag all simply omit it from their own structs.
    DATA(float,       Clip,       SV_ClipDistance0);
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN( VSInput In )
{
    INIT_MAIN;
    VSOutput Out;

    // Word [0] low 16 bits = the LOCAL index within the bound batch window (0..1023); bits
    // 16+ = the per-frame UV-animation table id (NiUVController takeover; 0 = none). Every
    // other opaque-layout writer (shadow/sky/FP/reflect instance bufs) leaves the high bits
    // 0, so the mask is a no-op there.
    uint drawIndex = In.DrawIndex & 0xFFFFu;
    uint uvAnimId  = In.DrawIndex >> 16u;
    float4x4 world = gBatch.worlds[drawIndex];
    // Cbuffer matrices are column-major (DXC default), so mul(M, v) with the D3DX bytes
    // uploaded as-is == D3DX v*M. viewProj likewise.
    float4 worldPos = mul(world, float4(In.Position, 1.0f));
    Out.Position = mul(gFrameData.viewProj, worldPos);
    Out.Normal = mul((float3x3)world, In.Normal);
    Out.WorldPos = worldPos.xyz;   // Tier 3a: point lights evaluate in world space
    Out.Uv = In.Uv;
    // NiUVController takeover: host-evaluated scroll delta for this draw (opaque wire carries
    // one UV set, so setIndex is ignored here). Wrap handled by the sampler's address mode.
    if (uvAnimId != 0u) {
        Out.Uv += gUVAnim[uvAnimId].xy;
    }
    // Unpack the per-instance texIndex (low 16) + alpha-test ref (bits 16-23, /255) + vColSource (bits 24-25).
    Out.TexIndex = In.TexAlpha & 0xFFFFu;
    Out.AlphaRef = float((In.TexAlpha >> 16u) & 0xFFu) * (1.0f / 255.0f);
    Out.VColSource = (In.TexAlpha >> 24u) & 0x3u;
    // MW texture address mode (NiTexturingProperty::Map::clampMode, bits 26-27). 3 = WRAP_S_WRAP_T =
    // MW's default; before this the host sampled everything REPEAT and clamped meshes tiled.
    // Bit 28 (packed by packTexAlpha for two-sided DRAW_BOTH alpha) rides along as ClampMode bit2:
    // alpha.frag reads (ClampMode & 4) for two-sided lighting.
    // Bit 29 (MW's enchanted-item glow) rides along as ClampMode bit3 — enchantglow.h.fsl reads it.
    // Both flags share the word with the address mode, which is why sampleBase()/sampleFlip() mask
    // it to & 3 at the point of sampling rather than trusting each caller to.
    //
    // This is a lane, not a new interpolator, on purpose: opaque.vert's VSOutput is shared by
    // opaque.frag, depthonly.frag, shadowcaster.frag, sunshadow.frag, alpha.frag, alphadepth.frag
    // and alphashadowdepth.frag, and a field added here has to be added to EVERY one of them or the
    // GPU hangs ([[project_forge_shared_frag_vsoutput]]).
    Out.ClampMode  = (In.TexAlpha >> 26u) & 0xFu;
    // STEP 5 — THE AUTHORED COLOURS ENTER THE SCENE'S DOMAIN, AND THEY DO IT IN THE VERTEX STAGE.
    //
    // Every one of these is MW's display-referred data: In.Color is the D3DCOLOR a
    // VertexColorProperty painted, the three material lanes are the NiMaterialProperty's own bytes.
    // Their partner in the very next multiply — the base texel — is decoded by the sampler, so
    // leaving these encoded would put two domains inside one product, which shows as a HUE shift
    // rather than a brightness one and is correspondingly hard to attribute.
    //
    // ⚠ HERE AND NOT IN THE FRAG. Decode-then-interpolate is the same ordering rule that makes an
    // _SRGB view mandatory for textures: the rasterizer's interpolation is a filter, and filtering
    // gamma values then linearising the average is wrong in exactly the way a shader pow() after
    // bilinear is. The material lanes are FLAT and could go either way; they ride along so that one
    // rule covers the whole struct and nobody has to remember which lane was which.
    //
    // ⚠ .a NEVER COMES HERE. Alpha is coverage, not a colour; it has no transfer function. That is
    // why this decodes .rgb and rebuilds the float4 rather than converting In.Color wholesale.
    Out.Color = float4(decodeAuthored(In.Color.rgb), In.Color.a);
    Out.MatDiffuse  = decodeAuthored(In.MatDiffuse);
    Out.MatAmbient  = decodeAuthored(In.MatAmbient);
    Out.MatEmissive = decodeAuthored(In.MatEmissive);
    // ── THE GAIN IS A RATIO, AND A RATIO MUST NOT MEET A TRANSFER FUNCTION ──
    //
    // In.EmisGain is the client's flux/area emissive boost (kEmissiveFlux * ownLight.diffuse /
    // fixtureArea — scenegraph_geometry_cache.cpp::computeEmissiveGain). It is a SCALE, so it is
    // the one per-instance float3 here that must NOT be decoded. It rides its own lane for exactly
    // that reason: it used to arrive folded into In.MatEmissive by the client, which put it on the
    // wrong side of the decode above. srgbToLinear is unclamped past 1.0, so a gain g reached the
    // frag as ~g^2.4 — measured 2.11 -> 5.61, 3.18 -> 14.7, 25.95 -> 2189, and a candle flame's
    // 401 -> 1.56e6. That is the glass lantern that read 1069 in a linear EXR dump.
    //
    // ⚠ IT MULTIPLIES WHICHEVER LANE vColSource MADE THE EMISSIVE. That is the other half of the
    // same bug: on vColSource 1 (SRC_EMISSIVE) the emissive IS the vertex colour and every paired
    // frag reads In.Color.rgb, never In.MatEmissive — so a gain folded into matEmissive was
    // silently discarded for precisely the small hot emitters that most need it (candle and torch
    // flames). Two bugs pulling opposite ways: lanterns nuclear, flames dead.
    //
    // ⚠ HERE AND NOT IN THE FRAG — and yes, opaque.frag says the opposite. Its comment is about its
    // OWN scalar (calParams.x), which multiplies AFTER the select and therefore has to live where
    // the select is. This is a different claim: the vert unpacks vColSource a dozen lines above, so
    // it knows the branch too, and doing it here costs NO new VSOutput field. A frag-side fix needs
    // one, and this vert's VSOutput is shared by opaque / alpha / depthonly / shadowcaster /
    // sunshadow / alphadepth / alphashadowdepth / portalgate / portalhull — nine
    // structs that must ALL gain the field or the GPU hangs ([[project_forge_shared_frag_vsoutput]]).
    // Scaling Color.rgb is safe because on vColSource 1 it is read ONLY as the emissive addend —
    // verified in all nine. The shadowcaster's MatEmissive.x/.y overload is safe because every
    // instance buffer it draws from ships gain 1,1,1.
    //
    // ⚠ .rgb ONLY. Alpha is coverage and has no transfer function and no radiometric scale — the
    // same split the bloom prefilter makes between filter weights and exposure
    // ([[project_forge_premultiplied_pair]]).
    float3 emisGain = max(In.EmisGain, float3(0.0f, 0.0f, 0.0f));
    if (Out.VColSource == 1u) { Out.Color.rgb *= emisGain; }
    else                      { Out.MatEmissive *= emisGain; }
    Out.OverlayIndex = In.OverlayIndex;   // terrain DECAL_1 slot (0 = no decal)
    Out.DrawIdx      = drawIndex;         // side-table index (alpha.frag -> gAlphaStages)
    Out.ParamIndex   = In.ParamIndex;     // PBR _paramh slot (0 = shade exactly as before)
    // MW near fog (per-vertex, as FFE): dist is camera distance = |worldPos - eye| (the view
    // transform is rigid, so this equals length(viewpos)). fog = saturate((end-dist)/(end-start)).
    float dist = length(worldPos.xyz - gFrameData.eyePos.xyz);
    Out.Fog = mwFogFactor(dist);   // ramp only — the submerged test is PER PIXEL (mwFogAir)
    // Below-water clip (reflect pass only) — see the VSOutput comment. worldPos is camera-relative,
    // matching the plane the host writes.
    // ...and, in the world camera, the near/far HANDOVER plane: MW's near set stops where DL starts.
    Out.Clip = handoverNearClip(worldPos.xyz,
                                dot(gFrameData.gReflWaterClip.xyz, worldPos.xyz) + gFrameData.gReflWaterClip.w);
    RETURN(Out);
}
