// mgeHost64 — M1c opaque scene (vertex stage, GPU-driven).
//
// Model-space pos+normal (binding 0, per-vertex) + a per-INSTANCE DrawIndex (binding 1)
// that selects this part's world matrix from gWorlds. Camera from gFrameData. Emits clip
// position + world-space normal for flat N.L shading.

#include "opaque.srt.h"

STRUCT(VSInput)
{
    DATA(float3, Position,  POSITION);
    DATA(float3, Normal,    NORMAL);
    DATA(float2, Uv,        TEXCOORD0);    // per-vertex: base-map UV
    DATA(float4, Color,      COLOR);        // per-vertex: DiffAmb colour (white when unused)
    DATA(uint,   DrawIndex,  TEXCOORD1);    // per-instance: index into gWorlds (instance buf .x)
    DATA(uint,   TexAlpha,   TEXCOORD2);    // per-instance packed: texIndex (16) | alphaRef*255 (8) | vColSource (bits 24-25)
    DATA(float3, MatDiffuse, TEXCOORD3);    // per-instance: material diffuse rgb
    DATA(float3, MatAmbient, TEXCOORD4);    // per-instance: material ambient rgb
    DATA(float3, MatEmissive,TEXCOORD5);    // per-instance: material emissive rgb
};

STRUCT(VSOutput)
{
    DATA(float4,      Position, SV_Position);
    DATA(float3,      Normal,   NORMAL);
    DATA(float2,      Uv,       TEXCOORD0);
    DATA(FLAT(uint),  TexIndex, TEXCOORD1);
    DATA(float,       Fog,      TEXCOORD2);   // MW fog scalar (1 = clear, 0 = full fogColNear)
    DATA(float4,      Color,    COLOR);       // per-vertex DiffAmb colour (shared opaque.frag)
    DATA(float,       AlphaRef, TEXCOORD3);   // alpha-test ref 0..1 (shared opaque.frag; 0 = no test)
    DATA(FLAT(float3),MatDiffuse, TEXCOORD4); // per-draw material (Tier 2b; FLAT = constant per draw)
    DATA(FLAT(float3),MatAmbient, TEXCOORD5);
    DATA(FLAT(float3),MatEmissive,TEXCOORD6);
    DATA(FLAT(uint),  VColSource, TEXCOORD7); // 0 none, 1 emissive, 2 diffamb
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN( VSInput In )
{
    INIT_MAIN;
    VSOutput Out;

    // DrawIndex is the LOCAL index within the bound batch window (0..1023).
    float4x4 world = gBatch.worlds[In.DrawIndex];
    // Cbuffer matrices are column-major (DXC default), so mul(M, v) with the D3DX bytes
    // uploaded as-is == D3DX v*M. viewProj likewise.
    float4 worldPos = mul(world, float4(In.Position, 1.0f));
    Out.Position = mul(gFrameData.viewProj, worldPos);
    Out.Normal = mul((float3x3)world, In.Normal);
    Out.Uv = In.Uv;
    // Unpack the per-instance texIndex (low 16) + alpha-test ref (bits 16-23, /255) + vColSource (bits 24-25).
    Out.TexIndex = In.TexAlpha & 0xFFFFu;
    Out.AlphaRef = float((In.TexAlpha >> 16u) & 0xFFu) * (1.0f / 255.0f);
    Out.VColSource = (In.TexAlpha >> 24u) & 0x3u;
    Out.Color = In.Color;
    Out.MatDiffuse  = In.MatDiffuse;
    Out.MatAmbient  = In.MatAmbient;
    Out.MatEmissive = In.MatEmissive;
    // MW near fog (per-vertex, as FFE): dist is camera distance = |worldPos - eye| (the view
    // transform is rigid, so this equals length(viewpos)). fog = saturate((end-dist)/(end-start)).
    float dist = length(worldPos.xyz - gFrameData.eyePos.xyz);
    Out.Fog = saturate((gFrameData.fogParams.y - dist)
                       / (gFrameData.fogParams.y - gFrameData.fogParams.x));
    RETURN(Out);
}
