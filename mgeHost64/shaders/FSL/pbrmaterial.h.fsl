// mgeHost64 — PBR materials: height-derived normals and the specular BRDF (FSL ONLY).
// tasks/forge-pbr-materials.md, Track C. The offline rig that chose between these arms is
// mgeHost64/pbrsynth/ — its README is the measured case for every mode below.
//
// Include AFTER opaque.srt.h and texsample.h.fsl (needs gTextures, the static samplers,
// gShadowParams and TEX_ADDR_MASK / TEX_WRAP_S_WRAP_T).
//
// THE MATERIAL. texturematcher's Morrowind export writes <base>_paramh.dds beside the base texture:
// DXT5, R = metalness, G = roughness, B = IOR/specular, A = HEIGHT. Height sits in the alpha because
// DXT5's alpha is a different CODEC (a BC4 block: 8 levels on its own ramp) from its colour block
// (BC1: 4 levels, three channels chained to one line) — and height is the one channel this shader
// DIFFERENTIATES, where quantisation invisible in a displayed scalar becomes a staircase.
//
// The host uploads it as DATA (IPC::kTexUploadData): stored UNORM, never through the scene's sRGB
// view, so the RGB here is the raw parameter and the alpha is the raw height.
//
// ⚠ EVERY TEXTURE READ HERE TAKES EXPLICIT GRADIENTS OR AN EXPLICIT LEVEL. The caller runs this inside
// a per-draw branch (ParamIndex != 0), and the screen derivatives it needs are taken ONCE at the top
// of opaque.frag, in uniform control flow, and passed in. Nothing below calls ddx/ddy.

// ─── Sampling ───────────────────────────────────────────────────────────────────────────────────

// The param map through the SAME address mode and anisotropy as the base map (sampleBase), with the
// base UV's own gradients — so the param map filters exactly as its albedo does, and the four cd taps
// all read the same mip the hardware would pick for the base.
float4 pbrParamGrad(uint slot, uint clampModeIn, float2 uv, float2 dx, float2 dy)
{
    const uint clampMode = clampModeIn & TEX_ADDR_MASK;
    if (clampMode == TEX_CLAMP_S_CLAMP_T) { return SampleGradTex2D(gTextures[slot], gSamplerAnisoClampClamp, uv, dx, dy); }
    if (clampMode == TEX_CLAMP_S_WRAP_T)  { return SampleGradTex2D(gTextures[slot], gSamplerAnisoClampWrap,  uv, dx, dy); }
    if (clampMode == TEX_WRAP_S_CLAMP_T)  { return SampleGradTex2D(gTextures[slot], gSamplerAnisoWrapClamp,  uv, dx, dy); }
    return SampleGradTex2D(gTextures[slot], gSamplerAnisotropic, uv, dx, dy);
}

// Height at an explicit level through a PLAIN BILINEAR sampler — what the B-spline arms need. Their
// linear-filtering trick (four bilinear fetches standing in for sixteen point taps) is only exact when
// the hardware does one bilinear lerp at the requested texel grid; anisotropy would add probes along
// the major axis and bend the kernel. Any clamp mode is treated as CLAMP on both axes: the static set
// has no mixed bilinear clamp, and the difference is confined to the texture's own border.
float pbrHeightLvl(uint slot, bool clampUV, float2 uv, float lvl)
{
    return clampUV ? SampleLvlTex2D(gTextures[slot], gSamplerBilinearClamp, uv, lvl).a
                   : SampleLvlTex2D(gTextures[slot], gSamplerBilinearWrap,  uv, lvl).a;
}

// ─── The cubic B-spline, four bilinear fetches per evaluation ───────────────────────────────────
// Uniform cubic B-spline over the texel grid of one mip. APPROXIMATING, not interpolating: its weights
// never go negative, so it cannot sharpen the 8-bit staircase the way Catmull-Rom's negative lobes do
// (rig: Catmull-Rom is the best reconstruction of the field and the WORST of a quantised one). It is
// C2, so its derivative is C1 and the NORMAL built from it has no kink at a cell edge — which is the
// facet.
//
// coord = uv*size - 0.5 puts texel k's centre at coord k. For taps k-1..k+2 with weights w0..w3, each
// same-sign pair collapses into ONE bilinear fetch placed between its two texels at the ratio of their
// weights: w0*T[k-1] + w1*T[k] = (w0+w1) * lerp(T[k-1], T[k], w1/(w0+w1)).
void pbrBSplineW(float2 f, out float2 w0, out float2 w1, out float2 w2, out float2 w3)
{
    const float2 f2 = f * f;
    const float2 f3 = f2 * f;
    const float2 g  = 1.0f - f;
    w0 = g * g * g * (1.0f / 6.0f);
    w1 = (3.0f * f3 - 6.0f * f2 + 4.0f) * (1.0f / 6.0f);
    w2 = (-3.0f * f3 + 3.0f * f2 + 3.0f * f + 1.0f) * (1.0f / 6.0f);
    w3 = f3 * (1.0f / 6.0f);
}

// d/df of the same basis. dw0, dw1 <= 0 and dw2, dw3 >= 0 on [0,1], so the pairs fold into bilinear
// fetches exactly as the value weights do; the pair sums are -0.5-f+f^2 and its negation, which never
// reach zero on [0,1], so the ratio below cannot divide by nothing.
void pbrBSplineDW(float2 f, out float2 d0, out float2 d1, out float2 d2, out float2 d3)
{
    const float2 f2 = f * f;
    const float2 g  = 1.0f - f;
    d0 = -0.5f * g * g;
    d1 = 1.5f * f2 - 2.0f * f;
    d2 = -1.5f * f2 + f + 0.5f;
    d3 = 0.5f * f2;
}

// B-spline VALUE of the height at uv on level lvl (size = that level's texel dimensions).
float pbrHeightBS(uint slot, bool clampUV, float2 uv, float2 size, float lvl)
{
    const float2 coord = uv * size - 0.5f;
    const float2 k = floor(coord);
    float2 w0, w1, w2, w3;
    pbrBSplineW(coord - k, w0, w1, w2, w3);
    const float2 g0 = w0 + w1, g1 = w2 + w3;
    const float2 p0 = (k - 1.0f + w1 / g0 + 0.5f) / size;   // uv of each pair's single fetch
    const float2 p1 = (k + 1.0f + w3 / g1 + 0.5f) / size;
    return g0.y * (g0.x * pbrHeightLvl(slot, clampUV, float2(p0.x, p0.y), lvl)
                 + g1.x * pbrHeightLvl(slot, clampUV, float2(p1.x, p0.y), lvl))
         + g1.y * (g0.x * pbrHeightLvl(slot, clampUV, float2(p0.x, p1.y), lvl)
                 + g1.x * pbrHeightLvl(slot, clampUV, float2(p1.x, p1.y), lvl));
}

// ANALYTIC gradient of the B-spline height, per texel of level lvl. Eight fetches: derivative weights
// along one axis against value weights along the other.
float2 pbrHeightGradBS(uint slot, bool clampUV, float2 uv, float2 size, float lvl)
{
    const float2 coord = uv * size - 0.5f;
    const float2 k = floor(coord);
    const float2 f = coord - k;
    float2 w0, w1, w2, w3, d0, d1, d2, d3;
    pbrBSplineW(f, w0, w1, w2, w3);
    pbrBSplineDW(f, d0, d1, d2, d3);
    const float2 g0 = w0 + w1, g1 = w2 + w3;       // value pairs
    const float2 e0 = d0 + d1, e1 = d2 + d3;       // derivative pairs (e0 < 0 < e1 on [0,1])
    const float2 p0 = (k - 1.0f + w1 / g0 + 0.5f) / size;
    const float2 p1 = (k + 1.0f + w3 / g1 + 0.5f) / size;
    const float2 q0 = (k - 1.0f + d1 / e0 + 0.5f) / size;
    const float2 q1 = (k + 1.0f + d3 / e1 + 0.5f) / size;
    const float hx = g0.y * (e0.x * pbrHeightLvl(slot, clampUV, float2(q0.x, p0.y), lvl)
                           + e1.x * pbrHeightLvl(slot, clampUV, float2(q1.x, p0.y), lvl))
                   + g1.y * (e0.x * pbrHeightLvl(slot, clampUV, float2(q0.x, p1.y), lvl)
                           + e1.x * pbrHeightLvl(slot, clampUV, float2(q1.x, p1.y), lvl));
    const float hy = g0.x * (e0.y * pbrHeightLvl(slot, clampUV, float2(p0.x, q0.y), lvl)
                           + e1.y * pbrHeightLvl(slot, clampUV, float2(p0.x, q1.y), lvl))
                   + g1.x * (e0.y * pbrHeightLvl(slot, clampUV, float2(p1.x, q0.y), lvl)
                           + e1.y * pbrHeightLvl(slot, clampUV, float2(p1.x, q1.y), lvl));
    return float2(hx, hy);
}

// ─── Axis 1: dH/duv out of the texture ──────────────────────────────────────────────────────────
// Returns dh/du, dh/dv in PER-UV units for every mode, so the three are estimates of ONE quantity and
// the depth below means the same thing whichever is selected.
//   0 cd      the live DX9 shader: a central difference at +-`radius` BASE texels through the
//             ANISOTROPIC sampler at the base's own gradients. ⚠ The rig (T8) tested the plan's
//             "base-texel offsets collapse the bump at distance" and REFUTED it — the taps read a
//             continuous trilinear field, and offsetting in mip texels was worse at every distance.
//             So the offset stays in base texels.
//   1 cdbs    the same +-`radius` difference with each tap a B-spline read (16 fetches).
//   2 bspline the B-spline's own analytic gradient (8 fetches). `radius` is INERT here: this arm has
//             no baseline to widen — its support is the kernel's own four texels.
//   4 cdblur  A BLUR THAT DOES NOT GHOST. `radius` becomes a blur WIDTH rather than a tap offset:
//             the height is read at the mip whose box is 2*radius texels across and the difference
//             stays at +-1 texel OF THAT LEVEL, so a feature SOFTENS in place instead of splitting
//             into two copies. This is what arms 0 and 1 are asked for when `radius` is raised and
//             what they do not do. Plain bilinear like arms 1 and 2 (no anisotropy), but 4 fetches
//             rather than 16. (Mode 3, the baked `_paramd` map, is RETIRED; the host publishes a 3
//             as 4, so this function never sees one.)
//
// ⚠⚠ MODES 1 AND 2 ARE NOT A CLEAN A/B AGAINST 0, AND THE DIFFERENCE IS FILTERING, NOT
// RECONSTRUCTION. Mode 0 samples through the anisotropic sampler with real gradients; the B-spline
// arms cannot, because their four-fetch trick needs exact bilinear weights and AF bends the kernel —
// so they take plain bilinear at ONE level, floor(log2(footprint)). They therefore give up 8x
// anisotropy (blurrier at grazing angles, which is most of a screen) and the trilinear blend (a faint
// band where a surface crosses a mip boundary). From play: *"0 is better, detailed and more blurry at
// the same time"* — the detail is the AF these two do not have. Judge them on a surface facing the
// camera, where that handicap is smallest; the rig could not see it at all (isotropic footprints).
//
// ⚠⚠ `radius` IS NOT A BLUR, AND THIS COMMENT USED TO CLAIM IT WAS. It said the difference
// "LOW-PASSES the height's 8-bit staircase over 2*radius texels". It does not. Widening a central
// difference is a COMB, not a low-pass, and it GHOSTS rather than softens. Both measured:
//
//   * GHOSTING. One ridge of sigma 1.5 texels, swept radius. Each lobe of the response keeps a FWHM
//     of exactly 4.0 texels at radius 1.5, 3, 6, 10 and 16 — it never softens, it only walks out to
//     +-radius. (Blur-then-difference at matched width goes 5 -> 6 -> 11 -> 17 -> 26, i.e. it
//     actually softens.) So a thin feature does not dissolve as the knob opens: it becomes TWO crisp
//     copies 2*radius apart. Play saw exactly that: *"I see double (offset features at high blurs),
//     which is not expected, I expect in place blur"*.
//   * THE COMB. Gain of (h(u+r)-h(u-r))/2r is |sin(2*pi*f*r)|/2r — periodic in f with period 1/r, so
//     it has passbands, not a rolloff. At radius 1.5 the gain at NYQUIST is 1.000, its maximum, with
//     a zero at f=0.333 and back to 0.707 at 0.417. At radius 3 it peaks at 0.25 AND 0.417. High
//     frequency is re-weighted, never removed. A real low-pass falls monotonically to 0.000.
//
// ⚠ ARM 4 IS THE ONE THAT ACTUALLY BLURS, and it is here because play asked for a ghostless one —
// but it was also looked at and disliked: *"hard surfaces look subsurface, or just low quality
// blurry normal map look. I would sacrifice detail for a sharp look overall."* A softened gradient
// reads as a soft SURFACE, which is a material error rather than a filtering trade, so treat arm 4
// as a fallback and not a destination. In arms 0 and 1 this dial has one setting that is right:
// 1.5, the live DX9 shader.
//
// ⚠ THE SHIPPED DEFAULT IS NO LONGER THE DX9 BASELINE. Play settled on arm 4 at radius 1.75 with
// pbrDepth 0.025, so the default now blurs and the DX9 look is a setting you have to ask for rather
// than the one you start from. It is still exactly reachable — mode 0, radius 1.5, depth 0.01171875
// — and that triple is the A/B; nothing about arm 0 changed.
//
// The baked derivative map (gradMode 3) was planned as the sharp answer to terracing. It is RETIRED:
// arm 4 beat it in play, so what ships is the veil described next, not the fix.
//
// ⚠ It is not a FIX for terracing, it is a veil over it. Terracing is 8-bit quantisation amplified by
// differentiation, and the rig (T6) measured that NO runtime arm survives it: on a field spanning
// 3/255, every one of them flattens to retention 0.000 while a baked BC5 derivative map — quantised
// AFTER differentiating — keeps 1.001. That map is retired; this dial is what ships.
float2 pbrHeightGradUV(uint mode, uint slot, uint clampModeIn, float2 uv,
                       float2 duvdx, float2 duvdy, float2 size0, float radius)
{
    const float  r = max(radius, 0.25f);            // below ~a quarter texel the difference is noise
    const float2 o = r / size0;                     // the tap offset, in BASE texels, as the live code
    if (mode == 0u)
    {
        const float hL = pbrParamGrad(slot, clampModeIn, uv - float2(o.x, 0.0f), duvdx, duvdy).a;
        const float hR = pbrParamGrad(slot, clampModeIn, uv + float2(o.x, 0.0f), duvdx, duvdy).a;
        const float hD = pbrParamGrad(slot, clampModeIn, uv - float2(0.0f, o.y), duvdx, duvdy).a;
        const float hU = pbrParamGrad(slot, clampModeIn, uv + float2(0.0f, o.y), duvdx, duvdy).a;
        return float2(hR - hL, hU - hD) * (size0 / (2.0f * r));   // divided by its own span
    }
    const bool  clampUV = (clampModeIn & TEX_ADDR_MASK) != TEX_WRAP_S_WRAP_T;
    const float fp  = max(length(duvdx * size0), length(duvdy * size0));   // footprint, base texels
    const float lvl = max(0.0f, floor(log2(max(fp, 1e-8f))));
    const float2 sizeL = max(floor(size0 * exp2(-lvl)), float2(1.0f, 1.0f));
    if (mode == 1u)
    {
        const float hL = pbrHeightBS(slot, clampUV, uv - float2(o.x, 0.0f), sizeL, lvl);
        const float hR = pbrHeightBS(slot, clampUV, uv + float2(o.x, 0.0f), sizeL, lvl);
        const float hD = pbrHeightBS(slot, clampUV, uv - float2(0.0f, o.y), sizeL, lvl);
        const float hU = pbrHeightBS(slot, clampUV, uv + float2(0.0f, o.y), sizeL, lvl);
        return float2(hR - hL, hU - hD) * (size0 / (2.0f * r));
    }
    if (mode == 4u)
    {
        // The blur IS the mip chain: a box 2*r base texels wide is level log2(2r), already filtered
        // at full precision when the map was built. Never below the footprint's own level —
        // blurring LESS than the hardware already is would be a sharpen, and an aliasing one.
        const float  blvl  = max(lvl, log2(max(2.0f * r, 1.0f)));
        const float2 sizeB = max(floor(size0 * exp2(-blvl)), float2(1.0f, 1.0f));
        const float2 ob    = 1.0f / sizeB;        // ONE texel of the BLURRED level, not of the base
        const float hL = pbrHeightLvl(slot, clampUV, uv - float2(ob.x, 0.0f), blvl);
        const float hR = pbrHeightLvl(slot, clampUV, uv + float2(ob.x, 0.0f), blvl);
        const float hD = pbrHeightLvl(slot, clampUV, uv - float2(0.0f, ob.y), blvl);
        const float hU = pbrHeightLvl(slot, clampUV, uv + float2(0.0f, ob.y), blvl);
        // Divided by the span it was actually taken over, so depth stays calibrated exactly as the
        // other arms: two texels of level B.
        return float2(hR - hL, hU - hD) * (sizeB * 0.5f);
    }
    return pbrHeightGradBS(slot, clampUV, uv, sizeL, lvl) * sizeL;
}

// (The BAKED DERIVATIVE MAP, `<base>_paramd.dds` from mgeHost64/pbrbake, was read here as gradient
// mode 3. RETIRED 2026-09-18: arm 4 beat it in play even at matched resolution, the maps were
// deleted, and the reader went with them. Its measurements are in git history — 809c96af and before.)

// ─── Axis 2: dH/duv to a normal, with no mesh tangents ──────────────────────────────────────────
// depth = the height range as a fraction of one UV unit (pbrParams.z). "Relative to the texture's own
// size" is the live DX9 convention — a texture stretched 2x gets bumps 2x wider AND 2x deeper — and
// both frames implement exactly it, so on an orthonormal UV map they agree to rounding (rig T7).
//
// ⚠ THE JACOBIAN SIGN, and why this is a correction rather than a transcription. The cotangent frame
// (Schüler; BuildPerPixelTBN in the live common.hlsl) solves for the frame WITHOUT dividing by its
// determinant det = N . (dPdx x dPdy), normalising the scale away instead — which also throws away the
// SIGN. The formula is derived for det > 0. On D3D's y-DOWN screen det is NEGATIVE for a front face,
// so T and B come out reversed and every bump lights from the wrong side. The rescued pbr.hlsl negates
// ddy for exactly this reason; the live common.hlsl does not. Neither is copied: det's sign is applied
// here, which is right on either screen convention and under a mirrored UV map as well. The rig cannot
// see this — its synthetic screen has det > 0 — so the --forge-scene probe checks it on the GPU: a
// ramp rising toward +u, lit from -x, must come out BRIGHTER than the flat control.

// ─── HEIGHT AO: how far below its own local average does this pixel sit ─────────────────────────
// Ported from the shadertoy the user supplied (https://www.shadertoy.com/view/Ms3yWn, adapted),
// which is a CHEAP two-tap ambient occlusion off a height field: read the height at this pixel's
// own level and again at a coarser one, and the difference over the coarse level's own footprint is
// a horizon angle. A pixel sitting below its neighbourhood is in a pit and sees less sky.
//
// `solidAngleOcclusion` is the source's analytic fit for the visible solid angle above a horizon at
// `cosAngle`, for a surface with the given N.L.
//
// ⚠ THREE THINGS WERE FIXED ON THE WAY IN, and the first one made the original a no-op.
//   1. `vec3 o = (p, heightlod * 120.2) - p;` is the COMMA OPERATOR, not a constructor: `(p, X)`
//      discards p and yields the float X, so it evaluated as `float - vec3` and broadcast to
//      `vec3(X - uv.x, X - uv.y, X - p.z)`. X reaches 120.2 against a uv of 0..1, so |o| was
//      dominated by two garbage lateral terms, cosHorizonAngle collapsed to ~0, and the function
//      returned solidAngleOcclusion(1, 0) = 1.0013 EVERYWHERE — a constant. The intent was
//      `vec3(p.xy, heightlod * 120.2) - p`, i.e. (0, 0, dH), which is what is written below.
//      ⚠ Which also means the source's `120.2` and `1.66` were never tuned against anything: they
//      were dialled against a flat output. Neither is carried over.
//   2. The fit is a VISIBILITY and it OVERSHOOTS 1: it returns 1.0013 at cosAngle 0. Left alone
//      that is a 0.13% ambient LIFT on flat ground, so "no occlusion" would not be exactly 1.0 and
//      every unoccluded pixel in the frame would move. Saturated here, which is what makes the knob
//      at 0 bit-identical rather than nearly so.
//   3. The source hardcodes `exp2(8.0)` for the lateral offset while `heightlod` is fetched by its
//      caller, with nothing tying the two together — and if they disagree the angle is simply
//      wrong. Here the averaging level is ONE parameter, used for both the fetch and the offset.
//
// `depth` is this project's own convention and NOT the source's 120.2: the height must be expressed
// in the same units as uv for an angle to mean anything, and `depth` is exactly that conversion
// (slope = depth * dH/duv — see pbrPerturbSurfGrad and g_pbrTerrainDepth). So height AO and relief
// are calibrated by the SAME number and cannot disagree about how deep the surface is.
float solidAngleOcclusion(float nl, float cosAngle)
{
    return (0.674753f + ((0.821827f * cosAngle * (0.600465f + 0.43519f * cosAngle + nl) + 0.495457f)
                         * (-0.340972f + nl))) * (1.0f - cosAngle);
}

// hSharp  the height at this pixel's own footprint level
// hAvg    the same height at `avgLvl`, the neighbourhood it sits in
// size0   base texels of the map, so the lateral offset comes out in the same uv units as hAvg
// avgLvl  ABSOLUTE mip level of hAvg — both the fetch level and the offset's width
float pbrHeightAO(float hSharp, float hAvg, float2 size0, float avgLvl, float depth)
{
    // Straight up out of the surface to the local average, pushed sideways by HALF the averaging
    // footprint — which is what makes the angle mean "how deep inside its own neighbourhood".
    const float2 om = exp2(avgLvl) / size0 * 0.5f;
    const float3 o  = float3(om.x, om.y, (hAvg - hSharp) * depth);
    const float  c  = saturate(o.z * rsqrt(max(dot(o, o), 1e-20f)));
    // nl = 1: this is pure AO, so the fit's N.L dependence is deliberately not used. That argument
    // is the hook for a directional (Drobot) soft shadow later; it is not free, so it is not taken.
    return saturate(solidAngleOcclusion(1.0f, c));
}

// ─── The cotangent frame itself, WITH the sign fix, lifted out so there is exactly one copy ─────
// Schüler's cotangent frame: T and B solved from the screen derivatives of position and uv, with no
// mesh tangents anywhere — which is the only kind of frame this renderer can have, since nothing in
// the host carries per-vertex tangents.
//
// ⚠ LIFTED OUT OF pbrPerturbCotangent RATHER THAN COPIED, and the reason is the sign above. The
// rescued DX9 `BuildPerPixelTBN` is this function WITHOUT the sign(det) factor, so on a
// right-handed world frame it hands back -T and -B and lights every bump from the wrong side. A
// second consumer arrived (parallax.h.fsl needs the tangent-space VIEW and LIGHT vectors) and the
// obvious move — porting the legacy TBN beside it — would have reintroduced exactly that bug in a
// new place. There is one copy of the math and both readers take it.
//
// T and B are normalised as a PAIR (one shared rsqrt of the larger), not individually: an
// anisotropic uv island keeps its aspect rather than having it flattened away. The legacy
// BuildPerPixelTBN does the same, which is what lets DX9's tuned `parallaxScale` transfer.
void pbrTangentFrame(float3 N, float3 dPdx, float3 dPdy, float2 duvdx, float2 duvdy,
                     out float3 T, out float3 B)
{
    const float3 dp2perp = cross(dPdy, N);
    const float3 dp1perp = cross(N, dPdx);
    const float3 t = dp2perp * duvdx.x + dp1perp * duvdy.x;   // = det * grad(u)
    const float3 b = dp2perp * duvdx.y + dp1perp * duvdy.y;   // = det * grad(v)
    const float det = dot(dPdx, dp2perp);
    const float s = ((det < 0.0f) ? -1.0f : 1.0f) * rsqrt(max(max(dot(t, t), dot(b, b)), 1e-30f));
    T = t * s;
    B = b * s;
}

float3 pbrPerturbCotangent(float3 N, float3 dPdx, float3 dPdy, float2 duvdx, float2 duvdy,
                           float2 dhduv, float depth)
{
    float3 T, B;
    pbrTangentFrame(N, dPdx, dPdy, duvdx, duvdy, T, B);
    const float3 nTS = normalize(float3(-dhduv.x * depth, -dhduv.y * depth, 1.0f));
    return normalize(nTS.x * T + nTS.y * B + nTS.z * N);
}

// Mikkelsen's surface gradient (the rescued SurfgradScaleDependent + ResolveNormalFromSurfaceGradient).
// It works in WORLD height units and divides by the real Jacobian determinant, so an anisotropic or
// sheared UV island is carried rather than normalised away — the rig's T7 island (1.6:1 + 20 deg shear)
// is where the cotangent frame floors at ~2.7 deg and this does not. The world height is depth * L * h,
// L = sqrt(world area / uv area) per pixel: the texture's own world scale, i.e. the SAME depth
// convention the cotangent frame uses.
float3 pbrPerturbSurfGrad(float3 N, float3 dPdx, float3 dPdy, float2 duvdx, float2 duvdy,
                          float2 dhduv, float depth)
{
    const float3 vR1 = cross(dPdy, N);
    const float3 vR2 = cross(N, dPdx);
    const float det   = dot(dPdx, vR1);
    const float uvDet = duvdx.x * duvdy.y - duvdx.y * duvdy.x;
    const float L     = sqrt(abs(det) / max(abs(uvDet), 1e-30f));
    const float2 dHduv = dhduv * (depth * L);
    const float dHdx = dot(dHduv, duvdx);
    const float dHdy = dot(dHduv, duvdy);
    const float s = ((det < 0.0f) ? -1.0f : 1.0f) / max(abs(det), 1.192093e-15f);
    return normalize(N - s * (dHdx * vR1 + dHdy * vR2));
}

float3 pbrPerturb(uint frameMode, float3 N, float3 dPdx, float3 dPdy, float2 duvdx, float2 duvdy,
                  float2 dhduv, float depth)
{
    return (frameMode == 1u) ? pbrPerturbSurfGrad(N, dPdx, dPdy, duvdx, duvdy, dhduv, depth)
                             : pbrPerturbCotangent(N, dPdx, dPdy, duvdx, duvdy, dhduv, depth);
}

// ─── The BRDF (ported from the rescued pbr.hlsl, one deviation carried across ON PURPOSE) ────────
// GGX distribution + Heitz height-correlated Smith visibility + Schlick Fresnel.
//
// ⚠ NO DIVISION BY PI, as pbr.hlsl: "Morrowind uses lighting tuned for non-PBR punctual lights". That
// is not a shortcut here, it is the unit convention of this whole frag: the diffuse term is FFE's
// albedo * lightCol * N.L — Lambert WITHOUT its 1/pi — and every light level in the project is
// calibrated against it. A specular lobe normalised the physical way would sit pi times dimmer than the
// diffuse it is paired with. Dropping the 1/pi on both keeps the ratio physical.
//
// NOT ported from the live DX9 lighting.hlsl, which is a different model (GGX WITH its pi, Schlick-GGX
// Smith with k = (r+1)^2/8, lights through INTENSITY * pow(col, 2.2)) built on a different light scale.
// Returns the specular response SPLIT BY F0: spec = F0 * t.x + t.y, per colour channel. Schlick's
// F = F0 + (1 - F0)*m^5 is affine in F0, so the split is exact — and it is what lets opaque.frag
// accumulate every light's specular in its light loop, which runs BEFORE the albedo is sampled, and
// apply a metal's F0 (= its albedo) once, afterwards. Hoisting the albedo sample instead would have
// moved code the non-PBR path depends on being textually untouched.
float2 pbrSpecTerms(float3 N, float3 L, float3 V, float NoL, float NoV, float alpha2)
{
    const float3 H  = normalize(V + L);
    const float NoH = saturate(dot(N, H));
    const float m   = 1.0f - saturate(dot(H, L));
    const float m5  = (m * m) * (m * m) * m;                                  // Schlick weight
    const float dd  = (NoH * alpha2 - NoH) * NoH + 1.0f;
    const float D   = alpha2 / max(dd * dd, 1e-12f);                          // GGX, no 1/pi
    const float lv  = NoL * sqrt((-NoV * alpha2 + NoV) * NoV + alpha2);
    const float ll  = NoV * sqrt((-NoL * alpha2 + NoL) * NoL + alpha2);
    const float DV  = D * (0.5f / max(lv + ll, 1e-6f));                       // x height-correlated Smith
    return float2(DV * (1.0f - m5), DV * m5);
}

// Karis' analytic fit of the split-sum environment BRDF (as used by the live DX9 lighting.hlsl, with
// its scale/bias in the original order): the fraction of an environment the lobe reflects, as F0*A + B.
// SPLIT so the raw (A, B) pair is reachable on its own: A + B is the lobe's directional albedo at
// F0 = 1, which is exactly the E_ss that the multiple-scatter compensation below needs. Same
// expression tree, only named — pbrEnvBRDF is unchanged term for term.
float2 pbrEnvAB(float NoV, float rough)
{
    const float4 c0 = float4(-1.0f, -0.0275f, -0.572f, 0.022f);
    const float4 c1 = float4(1.0f, 0.0425f, 1.04f, -0.04f);
    const float4 r  = rough * c0 + c1;
    const float a004 = min(r.x * r.x, exp2(-9.28f * NoV)) * r.x + r.y;
    return float2(-1.04f, 1.04f) * a004 + r.zw;
}
float3 pbrEnvBRDF(float3 f0, float NoV, float rough)
{
    const float2 AB = pbrEnvAB(NoV, rough);
    return f0 * AB.x + AB.y;
}

// ─── THE ENERGY SPLIT: WHAT SPECULAR TAKES, DIFFUSE MUST LOSE ───────────────────────────────────
//
// ⚠⚠ UNTIL THIS EXISTED THERE WAS NONE, AND THAT IS A STRUCTURAL LEAK, NOT A TUNING ERROR. All
// three PBR fragment shaders built their colour the same way:
//
//     c  = albedo * lit;                        // diffuse, at FULL strength
//     c += f0 * specA + specB;                  // direct specular   — ADDED
//     c += env * pbrEnvBRDF(f0, NoV, rough);    // ambient specular  — ADDED
//
// The only thing ever removed from diffuse was metalness. Nothing took the DIELECTRIC's specular
// energy out of it, so every specular photon was energy the surface never paid for. Specular on a
// dielectric is achromatic and albedo is the only term carrying colour, so the visible result is
// white light piling onto full-strength colour: the reported symptom was *"sheen is really strong.
// Albedo almost doesn't survive. I am looking at gray and shade."* That is what an unpaid specular
// lobe looks like, and no amount of retuning specBase fixes it — it changes how much grey, not
// whether the grey is free.
//
// ⚠ THE BIAS TERM IS WHY IT SURVIVES A DARK F0. pbrEnvBRDF is the split-sum form `f0 * A + B`, and
// **B does not depend on f0 at all**. A material with zero reflectance still had `env * B` added to
// it, at every pixel, rising steeply toward grazing angles. Lowering specBase could never reach
// that half.
//
// What is subtracted is exactly what the specular side adds: pbrEnvBRDF IS the directional-
// hemispherical reflectance of the specular lobe for this view, so `1 - it` is the fraction left
// for diffuse. Using the same function on both sides is the point — the two cannot drift apart,
// and a change to one is a change to the other by construction.
//
// ⚠ STRENGTH 0 RETURNS EXACTLY (1,1,1), so the arm off is bit-identical to the shader that shipped
// before it and the A/B is exact by inspection rather than by measurement — the house rule this
// project already applies to the W32 gobo and the multi-scatter specular.
//
// The same factor is applied to the AMBIENT diffuse as to the direct: the ambient term is the sky's
// irradiance on the same surface, and the same lobe takes the same fraction of it. Applying it to
// one and not the other would make a surface's energy depend on which light it stood under.
float3 pbrKdEnergy(float3 f0, float NoV, float rough, float strength)
{
    const float3 eSpec = saturate(pbrEnvBRDF(f0, NoV, rough));
    return lerp(float3(1.0f, 1.0f, 1.0f), saturate(float3(1.0f, 1.0f, 1.0f) - eSpec),
                saturate(strength));
}

// ─── MULTIPLE-SCATTERING SPECULAR (Turquin / Frostbite) ─────────────────────────────────────────
//
// Single-scattering GGX loses the energy that bounced between microfacets more than once — at
// roughness 1 this fit puts E_ss at 0.45, i.e. 55% of it. The compensation is a single scalar per
// channel, `1 + F0 * (1/E_ss - 1)`, reusing the same split-sum A + B the environment term already
// computes, so it costs a reciprocal and a mad.
//
// ⚠ READ THE F0 FACTOR BEFORE EXPECTING ANYTHING FROM THIS ON ROCK. The correction is PROPORTIONAL
// TO F0, so at a dielectric's 0.04 it is +4.9% at roughness 1 and at this project's shipped decode
// (0.04*b^2 = 0.01 at the authored default) it is +1.2%. On a METAL, F0 near 1, it is +122% — which
// is where it belongs and why it is here. It is correctness for the metal ladder; it is not the
// answer to "rough ground reads plasticy". That is the diffuse lobe, above.
float3 pbrSpecMulti(float3 f0, float2 ab, float strength)
{
    const float ess = max(ab.x + ab.y, 1e-2f);
    return float3(1.0f, 1.0f, 1.0f) + (strength * (1.0f / ess - 1.0f)) * f0;
}

// ─── GEOMETRIC SPECULAR ANTIALIASING (Tokuyoshi & Kaplanyan 2019) ───────────────────────────────
//
// There was none in this project at all. A rough rock keeps its authored roughness as it recedes
// while its normal detail averages away inside one pixel's footprint, so the lobe stays tighter
// than the surface it is standing in for — which shimmers in motion and reads as a uniform waxy
// sheen when it does not. The fix is to fold the normal's screen-space VARIANCE into the lobe's own
// width, which is the one place it belongs: a distribution of normals is what alpha^2 already is.
//
// ⚠ THE CALLER TAKES ddx/ddy, NOT THIS FUNCTION, and must take them in UNIFORM control flow.
// terrain.frag's PBR branch is per-PIXEL (it asks whether this pixel's four texture squares carry a
// `_paramh`), and a derivative inside per-pixel divergent flow is undefined — the exact class of
// spec violation this project has already paid for once. Hence the gradients as parameters, which
// is also the contract the top of this file states for every texture read below it.
//
// `alpha2` here is the GGX alpha^2 the callers already hold (roughness^4). The clamp is Tokuyoshi's
// kappa: without it a silhouette texel, where the interpolated normal swings through 90 degrees in
// one pixel, would be told it is a mirror made of noise.
float pbrSpecAAAlpha2(float alpha2, float3 dNdx, float3 dNdy, float strength, float clampMax)
{
    const float variance = 0.25f * strength * (dot(dNdx, dNdx) + dot(dNdy, dNdy));
    return saturate(alpha2 + min(2.0f * variance, max(clampMax, 0.0f)));
}

// The _paramh's material, decoded exactly as the live DX9 PS decodes it, so the art reads here as it
// was authored against there. Three separate reads because opaque.frag needs them at three different
// points: roughness before its light loop, metalness before it folds diffuse into `lit`, and F0 only
// once the albedo exists.
//
// ⚠ F0 = 0.04 * b^2 gives 0.01 at the export's default b = 0.5, although the live comment calls 0.5
// "standard dielectric" (0.04, which would be Disney's 0.08*b). The decode is carried across unchanged
// on purpose: the maps were judged against it. It is flagged in the plan, not fixed here.
float pbrRoughness(float4 param) { return clamp(param.g, 0.05f, 1.0f); }   // the live 0.05 floor
float pbrMetalness(float4 param) { return saturate(param.r); }
// ⚠ `specBase` WAS THE LITERAL 0.04 AND IS NOW A KNOB, because the decode it sits in squares its
// input: 0.04*b^2 at the export's default b = 0.5 is F0 = 0.01, four times darker than a standard
// dielectric, and the comment it was carried across with called 0.5 "standard dielectric". The
// constant that makes b = 0.5 land on Disney's 0.04 exactly is 0.16 (0.16 * 0.25 = 0.04); anything
// above that is a deliberately hot dielectric. The decode's SHAPE is unchanged, so every authored
// map still varies the way it was judged to.
float3 pbrF0(float4 param, float3 albedo, float specBase)
{
    const float b = saturate(param.b);
    return lerp(float3(specBase, specBase, specBase) * (b * b), albedo, pbrMetalness(param));
}

// ─── EON: an energy-preserving Oren-Nayar diffuse lobe ──────────────────────────────────────────
//
// Portsmouth / Kutz / Hill, "EON: A practical energy-preserving rough diffuse BRDF" (JCGT 2024).
//
// WHY THIS AND NOT A SPECULAR CHANGE. Every diffuse surface in this project is Lambert, and Lambert
// IS the diffuse shading of a smooth dielectric — which is what "plasticy" names. Rough soil, gravel
// and rock backscatter toward the light and flatten their own terminator; that is a different LOBE,
// not a different texture. The multi-scattering specular compensation that usually gets reached for
// here cannot do it: Turquin's factor is `1 + F0*(1/E_ss - 1)`, i.e. PROPORTIONAL TO F0, and at this
// project's dielectric F0 (pbrF0 decodes 0.04*b^2 = 0.01 at the authored default) that is +1.0% on
// the lobe at roughness 0.9. Worth having, and it is in pbrSpecMulti below — but it is not the fix.
//
// ⚠ NORMALISED THE WAY THIS PROJECT NORMALISES LAMBERT — NO 1/pi. Every light level here is
// calibrated against `albedo * lightCol * N.L` (pbrSpecTerms says the same thing for the specular
// side). So eonSingle returns a MULTIPLIER on a term that already carries N.L, and it is exactly
// 1.0 at sigma = 0: the arm off is the identity by construction, not by a bet on the compiler.
//
// ⚠ THE CALLER MUST APPLY IT TO A TERM THAT ALREADY CONTAINS N.L. `s/t` alone diverges at
// grazing-grazing — that is Oren-Nayar's bright limb and it is real — but N.L * s/t is bounded by 1
// because t = max(N.L, N.V) is one of the two.
//
// THE TWO CONSTANTS ARE DERIVED, AND EACH ONE CHECKS ITSELF. Writing E_QON's directional albedo out
// as E(mu) = A * (1 + sigma*G(mu)) with
//     G(mu) = (1/pi) * [ 2*s*( (1-s^3)/(3*mu) + pi/4 - (mu*s + asin mu)/2 ) - (2/3)*s ],  s=sqrt(1-mu^2)
// gives G(1) = 0 and max G = G(0) = 1/2 - 2/(3pi) = 0.287793409. That maximum is EON_C1, the
// normalisation constant the paper states — so deriving the integral and finding its peak lands on
// the published constant to nine digits, which is the check that the derivation is right. Its
// cosine-weighted average is EON_K = 2/3 - 28/(15pi) = 0.072488212, confirmed to twelve digits
// against a 400k-sample numerical integration of the same G.
#define EON_C1      0.287793409f
#define EON_K       0.072488212f
#define EON_C1MK    0.215305197f    // EON_C1 - EON_K, the multiple-scatter denominator (see below)

// A and B, hoisted once per pixel. A = 1/(1 + c1*sigma) is what makes the peak directional albedo
// exactly 1 (at grazing); B = sigma*A is the retro-reflective term's weight.
float2 eonAB(float sigma)
{
    const float A = 1.0f / (1.0f + EON_C1 * sigma);
    return float2(A, sigma * A);
}

// The single-scattering (qualitative Oren-Nayar) shape, as a multiplier on an N.L-carrying term.
// EXACTLY 1.0 when sigma == 0, because eonAB returns (1, 0) there.
float eonSingle(float2 ab, float NoL, float NoV, float LoV)
{
    const float s = LoV - NoL * NoV;                       // cos(dphi) * sin(th_l) * sin(th_v)
    const float t = (s > 0.0f) ? max(max(NoL, NoV), 1e-4f) : 1.0f;
    return ab.x + ab.y * (s / t);
}

// G(mu), as a cubic in u = 1 - mu with BOTH endpoints exact: the leading u factor gives G(1) = 0,
// and the four coefficients sum to 1 so that G(0) = EON_C1. Max error 0.0022 against the closed
// form over the whole range, on a quantity bounded by 0.288 — the closed form needs an asin, this
// needs three mads.
float eonG(float mu)
{
    const float u = 1.0f - saturate(mu);
    return EON_C1 * u * (0.132551f + u * (2.136720f + u * (-1.914293f + u * 0.645021f)));
}

// THE MULTIPLE-SCATTER LOBE, and the reason it costs almost nothing here.
//
// Kulla-Conty's structure — the SAME one the specular side uses — is separable in the two
// directions, f_ms ~ (1 - E(mu_i)) * (1 - E(mu_o)) / (1 - E_avg), so it accumulates across the light
// loop exactly the way pbrSpecA/pbrSpecB already do and takes its albedo once at the combine.
//
// The naive form divides two quantities that BOTH vanish as sigma -> 0. They do not have to:
//     1 - E(mu) = 1 - A*(1 + sigma*G) = sigma * A * (EON_C1 - G(mu))
// so sigma and A cancel out of the ratio exactly, leaving (c1 - G(mu_o)) / (c1 - EON_K). Hence the
// split below — a per-light weight with no sigma in it at all, and one per-pixel scalar that carries
// the sigma*A. No small-number division anywhere, and the arm is exactly zero at sigma = 0.
float eonMsWeight(float mu) { return EON_C1 - eonG(mu); }                       // per LIGHT
float eonMsScale(float2 ab, float sigma, float NoV)                              // per PIXEL
{
    return sigma * ab.x * eonMsWeight(NoV) * (1.0f / EON_C1MK);
}

// The multiple-scatter albedo. rho^2 at leading order — the energy HAS bounced twice, so it is
// darker AND more saturated than the surface, which is most of what separates rough dirt from
// painted plastic — and exactly rho at rho = 1, which is the white-furnace condition.
float3 eonMsAlbedo(float3 rho, float eAvg)
{
    return rho * rho * eAvg / max(1.0f - rho * (1.0f - eAvg), 1e-4f);
}
float eonEavg(float2 ab, float sigma) { return ab.x * (1.0f + sigma * EON_K); }
