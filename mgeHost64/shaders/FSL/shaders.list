// mgeHost64 FSL driver list (Milestone D2/D3 first-light triangle).
//
// fsl.py is fed THIS file, not the bare *.fsl bodies. The top-level
// defaults.h include pulls in fsl_srt.h -> d3d12_srt.h, which is what defines
// ROOT_SIGNATURE / DefaultRootSignature for every stage below. Each #vert/#frag
// block names the output binary (loaded at runtime as RD_SHADER_BINARIES/
// DIRECT3D12/<name>) and #includes the matching shader body. Mirrors the stock
// 01_Transformations/Shaders/FSL/shaders.list pattern.

#include "../../../3rdparty/The-Forge/Common_3/Graphics/FSL/defaults.h"

#rootsig default.rootsig
#end

// Tier 2 depth-takeover: the host's FIRST compute root signature. fsl.py unions every shader
// that declares ROOT_SIGNATURE(ComputeRootSignature) (linearizedepth + gtao below) into this one
// compute.rootsig — see [[project_forge_fsl_shader_compile]] / 09_LightShadowPlayground.
#rootsig compute.rootsig
#end

#vert tri.vert
#include "tri.vert.fsl"
#end

#frag tri.frag
#include "tri.frag.fsl"
#end

#vert opaque.vert
#include "opaque.vert.fsl"
#end

#frag opaque.frag
#include "opaque.frag.fsl"
#end

#frag depthonly.frag
#include "depthonly.frag.fsl"
#end

// STENCIL "FAKE HOLE" PORTALS (comGravePit and its family). Two stages, both on opaque.vert:
//   portalgate  stamps a 1-bit R8 gate where a portal MASK quad passes its own depth test
//   portalhull  erases the occluder's depth, discarding wherever that gate is 0
// The hull comes in two SAMPLE_COUNT variants because the gate render target shares pDepth's
// sample count (they are bound together) and Tex2DMS needs the count as a literal — the same
// _sc1/_sc4 split, and the same host-side pick, that linearizedepth and hizfirst use.
#frag portalgate.frag
#include "portalgate.frag.fsl"
#end

#frag portalhull_sc1.frag
#define PORTAL_GATE_SAMPLES 1
#include "portalhull.frag.fsl"
#end

#frag portalhull_sc4.frag
#define PORTAL_GATE_SAMPLES 4
#include "portalhull.frag.fsl"
#end

// Point-light shadow-caster frag: depthonly.frag + a per-texel EMISSIVE carve (drop glowing
// texels, keep dark lettering/imperfections). SEPARATE from depthonly.frag so the main Z-prepass
// keeps CMP_EQUAL parity. Used only by the pShadowPipeline* atlas caster PSOs. Reads opaque.vert's
// VSOutput (MatEmissive) + gTextures; threshold rides gFrameData.atlasDbg.z (g_shadowEmissiveTexel).
#frag shadowcaster.frag
#include "shadowcaster.frag.fsl"
#end

// SUN (directional) shadow moments map — writes 4-moment MSM (Hamburger 4MSM) for the single sun.
// Reuses opaque.vert (same VSOutput); the sun caster pass draws the visible set into a COLOR
// moments RT (vs the point atlas's depth-only). Alpha cutout, no emissive carve. See forge-sun-shadows.md.
#frag sunshadow.frag
#include "sunshadow.frag.fsl"
#end

// SUN shadow moments for DL STATICS (the PRIMARY caster proxy — casts off-screen into the near
// scene). Pairs with statics.vert's VSOutput; statics bindless sample + 133/255 cutout.
#frag sunshadow_statics.frag
#include "sunshadow_statics.frag.fsl"
#end

// SUN shadow moments-map DEBUG VIEW (F12 mode 13). Reuses shadowatlasview.vert (fullscreen tri);
// blits gSunMoments.x greyscale so the sun caster pass can be verified before any receiver.
#frag sunshadowview.frag
#include "sunshadowview.frag.fsl"
#end

// VOLUMETRIC height fog / sun shafts. Reuses shadowatlasview.vert (fullscreen tri) + the opaque
// PerFrame set; ray-marches the scene depth sampling the MSM moments ONE tap per step — the job the
// moment map keeps now that PCSS owns the colour pass. Blends ONE / SRC_ALPHA over the composited
// frame, after water + alpha, before the first-person arms.
#frag volfog.frag
#include "volfog.frag.fsl"
#end

// UNDERWATER BACKSTOP (W8). Same fullscreen tri + PerFrame set as volfog, but a FILL-HOLES blend
// (INV_DEST_ALPHA / ONE) so it writes only where nothing was drawn — the horizon band, past the
// shelf, wherever terrain ends. Reads no depth at all: "no depth" is precisely the state it exists
// to answer, and the answer is that the water goes on forever.
#frag waterfill.frag
#include "waterfill.frag.fsl"
#end

// AT1 sorted-alpha takeover: the scene-1 blended world shapes, drawn after water with depth
// GEQUAL test / no write. Pairs with opaque.vert (SAME VSOutput — shared-frag hazard) on 4 blend/
// winding PSOs; outputs real alpha (tex.a * vcolA * matAlpha) for the premultiplied composite.
#frag alpha.frag
#include "alpha.frag.fsl"
#end

// AT1 near-opaque depth prepass: runs BEFORE the alpha colour draws, writes depth ONLY at pixels
// that are near-opaque (a >= gFrameData.alphaParams.x). Keeps the fold fix (solid cloth self-
// occludes) while translucent pixels (glass) write nothing, so they can never depth-kill a
// translucent draw that sorts after them (the flame-in-a-lantern bug). Pairs with opaque.vert AND
// with skinned.vert (identical VSOutput) — the skinned list runs the same prepass, which is what
// stops a blended-but-solid body compositing itself back-to-front (Dagoth Ur inside out).
#frag alphadepth.frag
#include "alphadepth.frag.fsl"
#end

// Alpha SHADOW-RECEIVE depth prepass — twin of alphadepth.frag at a separate, lower opacity
// threshold (alphaShadowParams.x), rendered into the dedicated pAlphaShadowDepth so a near-opaque sheet
// (paper curtain) receives its own point-light shadow without weakening the 0.95 fold-fix.
// THIS one is the CASTER half (skinned.vert -> shadow atlas, LIGHT space); the main-camera
// receiver runs alphashadowrecv.frag below, which adds a screen-space world-occlusion clip that
// would be nonsense here.
#frag alphashadowdepth.frag
#include "alphashadowdepth.frag.fsl"
#end

// ...and the RECEIVER half: same shader plus a manual GEQUAL against the opaque scene depth, so a
// sheet the world hides cannot claim pAlphaShadowDepth and hand its own shadow to whatever alpha
// layer is drawn in front of it (smoke behind a wall punching a hole in the dust). Screen space
// only — hence the split from the caster above.
#frag alphashadowrecv.frag
#include "alphashadowrecv.frag.fsl"
#end

#frag depthonly_mm.frag
#include "depthonly_mm.frag.fsl"
#end

// P1 point-light shadows: per-tile atlas clear (viewport-covering triangle at z=0,
// CMP_ALWAYS + write — LOAD_ACTION_CLEAR would wipe every cached tile). Depth-only PSO.
#vert shadowclear.vert
#include "shadowclear.vert.fsl"
#end

#frag shadowclear.frag
#include "shadowclear.frag.fsl"
#end

#vert skinned.vert
#include "skinned.vert.fsl"
#end

#vert multimap.vert
#include "multimap.vert.fsl"
#end

#frag multimap.frag
#include "multimap.frag.fsl"
#end

#frag multimap_alpha.frag
#include "multimap_alpha.frag.fsl"
#end

// SK1 sky takeover: alpha-blended sky shapes (SK1 = the gradient dome). Reuses opaque.srt.h /
// DefaultRootSignature + the opaque GeomVertexWire layout; the host's FIRST blend pipeline
// (SRCALPHA/INVSRCALPHA, depth off). sky.frag outputs real RGBA for the premultiplied composite.
#vert sky.vert
#include "sky.vert.fsl"
#end

#frag sky.frag
#include "sky.frag.fsl"
#end

// THE PHYSICAL SKY (tasks/forge-atmosphere.md S2c): a fullscreen sample of the ATMOSPHERE's sky-view
// LUT, retiring the dome mesh, the painted horizon band and — since S2 — the Hosek-Wilkie closed form
// that stood in for a medium. Same fullscreen triangle as volfog/waterfill (shadowatlasview.vert),
// but blend OFF / depth OFF / alpha 1 — it is the backdrop, drawn FIRST in the colour pass and again
// in the mirror, and it covers the whole sphere so there is no lower rim. Reads gSkyView off the
// PerBatch set for THIS view's invViewProj, and gAtmosSkyView/gAtmosParams off PerFrame.
#frag skyhw.frag
#include "skyhw.frag.fsl"
#end

// SK V2 viewer sky MESH (--forge-view only): baked MW sky meshes (dome + clouds) + a host-generated
// sun billboard, all in the StaticElem 20B layout. Binding 1 = per-instance world rows + packed sky
// params (P0..P3). Reuses opaque.srt.h / DefaultRootSignature + bindless gTextures. Three blend PSOs
// share these shaders (dome opaque, cloud SRCALPHA, sun additive). See tasks/forge-viewer-sky.md.
#vert skymesh.vert
#include "skymesh.vert.fsl"
#end

#frag skymesh.frag
#include "skymesh.frag.fsl"
#end

// Phase F distant-light GLOW billboards: one additive camera-facing sprite per light FIXTURE, drawn
// after water / before sorted-alpha so the lamp still reads once its tier-0 static mesh has coverage-
// culled (~2 cells). Binding 0 = static unit-quad corner+radial UV; binding 1 = per-instance survivor
// record (cam-rel centre+size, colour+intensity). PRIVATE frag (no shared-frag hazard). Reuses
// opaque.srt.h / DefaultRootSignature verbatim — brightness/fade/min-pixel resolved host-side.
#vert glow.vert
#include "glow.vert.fsl"
#end

#frag glow.frag
#include "glow.frag.fsl"
#end

// Host-owned TERRAIN (tasks/forge-terrain.md): the real Morrowind heightfield, read from the plugin
// LAND records at launch and drawn as one shared 65x65 lattice VB instanced per cell, with the
// height fetched per-vertex out of gTerrainHeights in the VS. LOD = index-buffer stride, cracks
// closed by edge stitching (no skirts). Reuses opaque.srt.h / DefaultRootSignature; the two data
// buffers are appended to the PerFrame set. This REPLACED distantland.vert/.frag (deleted in T4).
#vert terrain.vert
#include "terrain.vert.fsl"
#end

#frag terrain.frag
#include "terrain.frag.fsl"
#end

// SUN shadow moments for host-owned TERRAIN — the landscape as a CASTER. Pairs with terrain.vert
// (whose VSOutput it mirrors byte for byte); no alpha test, terrain is opaque. Without it a mountain
// shadows nothing, which is also why sun shafts lit valleys a ridge should have blacked out.
#frag sunshadow_terrain.frag
#include "sunshadow_terrain.frag.fsl"
#end

// Phase 1b: host-owned distant STATICS. Binding 0 = StaticElem vertex (20B); binding 1 = per-
// INSTANCE world matrix + bindless texSlot. Drawn GPU-driven (mega VB/IB + instance stream +
// cmdExecuteIndirect). Reuses opaque.srt.h / DefaultRootSignature + bindless gTextures.
#vert statics.vert
#include "statics.vert.fsl"
#end

#frag statics.frag
#include "statics.frag.fsl"
#end

// Phase 4 hero distant statics blend pass: the SAME statics.vert body built HERO_PASS=1 (keeps only
// the hero-blend subsets, clips the rest) + a blend frag (statics.frag minus discard, real alpha).
// Drawn after water on a SRCALPHA/INVSRCALPHA depth-GEQUAL/no-write PSO. No GPU-cull change — reuses
// the same gArgs/instance stream; the opaque statics.vert (HERO_PASS=0) clips these same subsets.
#vert statics_heroblend.vert
#define HERO_PASS 1
#include "statics.vert.fsl"
#end

#frag statics_blend.frag
#include "statics_blend.frag.fsl"
#end

// GitD lit-window multi-map LAYER pass: the SAME statics.vert body built MULTIPLY_PASS=1 (keeps only
// the multiply-layer subsets, clips the rest) + a frag that outputs the layer's raw texture. Drawn
// right after the opaque statics draw on a DESTCOLOR/ZERO depth-EQUAL/no-write PSO, so each layer
// multiplies onto its own base pixels. Reuses the same gArgs/instance stream; the opaque
// statics.vert (MULTIPLY_PASS=0) clips these same subsets.
#vert statics_layer.vert
#define LAYER_PASS 1
#include "statics.vert.fsl"
#end

#frag statics_multiply.frag
#include "statics_multiply.frag.fsl"
#end

// ...and the ADDITIVE (glow-map) layer pass: LAYER_PASS=2 keeps only the ADD layers, drawn ONE/ONE.
// MW folds a glow map with ADD after lighting, so this is unlit and is what gives a lit window its
// punch — without it the stack can only darken and windows read as barely emissive.
#vert statics_addlayer.vert
#define LAYER_PASS 2
#include "statics.vert.fsl"
#end

#frag statics_add.frag
#include "statics_add.frag.fsl"
#end

// G1 host-owned GRASS. Same resident library, vertex format and instance-stream shape as the distant
// statics above (grass IS a distant-static type in the bake) — what differs is the CULL LANE feeding
// it and these two stages: four-harmonic wind displacement in the vert, two-sided sun + ambient with
// backscatter, and a distance fade spent on the A2C coverage. grass.vert's VSOutput is statics.vert's
// field for field, which is what lets the sun-caster pass pair it with sunshadow_statics.frag above
// and get a shadow carrying the identical displacement. See tasks/forge-grass.md.
#vert grass.vert
#include "grass.vert.fsl"
#end

#frag grass.frag
#include "grass.frag.fsl"
#end

// Forge water takeover (WT1): host-generated geo-clipmap water. Position-only verts + per-instance
// clipmap level; reuses opaque.srt.h / DefaultRootSignature (worlds+params ride gBatch, 4 water SRVs
// appended to the PerFrame set). Depth-write reverse-Z GEQUAL, cull NONE, frag outputs alpha=1.
#vert water.vert
#include "water.vert.fsl"
#end

#frag water.frag
#include "water.frag.fsl"
#end

// CUSTOM MSAA RESOLVE (tasks/forge-postprocess.md step 4): filtered Catmull-Rom reconstruction with
// inverse-luminance firefly weighting, replacing cl->ResolveSubresource. It has to exist before HDR
// can, because a hardware resolve cannot format-convert — fp16 MSAA -> BGRA8 shared RT is not a
// legal ResolveSubresource, so step 3's "flip pSceneColor and change nothing else" probe is not
// actually executable and this is its prerequisite. Built LDR-first so its cost is measurable in
// isolation against the 0.14-0.18 ms fixed-function baseline (live A/B in the dev panel).
//
// PRIVATE vert/frag pairing (no shared-frag hazard) + its own ResolveSrtData PerDraw set, following
// The-Forge's own Examples_3/Visibility_Buffer resolve. One frag variant per sample count, the
// linearizedepth/apl idiom — Tex2DMS needs SAMPLE_COUNT as a literal.
//
// ⚠ THERE IS AN sc1 VARIANT NOW (M0, tasks/forge-upscale.md), and the note that stood here — "no sc1
// variant: at 1x the scene renders straight into pRT" — stopped being true when the 1x path got its
// own scene-referred staging target. At 1x + fp16 this pass is the only thing that can deliver a
// frame at all. It does no antialiasing there (one sample, offset (0,0), kernel collapses to
// identity); it does the fp16 -> BGRA8 convert, exposure, bloom, AgX, the encode and the dither.
// Same Tex2DMS/Tex2D split bloomprefilter_sc{1,4} already carries.
#vert resolve.vert
#include "resolve.vert.fsl"
#end

#frag resolve_sc1.frag
#define SAMPLE_COUNT 1
#include "resolve.frag.fsl"
#end

#frag resolve_sc2.frag
#define SAMPLE_COUNT 2
#include "resolve.frag.fsl"
#end

#frag resolve_sc4.frag
#define SAMPLE_COUNT 4
#include "resolve.frag.fsl"
#end

#frag resolve_sc8.frag
#define SAMPLE_COUNT 8
#include "resolve.frag.fsl"
#end

// M1 CAMERA-ONLY MOTION VECTORS (tasks/forge-upscale.md): one compute dispatch at the colour->water
// seam reconstructs where every pixel's surface was on the previous frame's screen, from the depth
// buffer and two camera matrices. NO per-draw velocity output and no change to any colour frag —
// that is the simplification the whole milestone rests on.
//
// ⚠ ONE VARIANT, NO SAMPLE_COUNT SPLIT, because it reads pLinearDepth rather than pDepth — and
// pLinearDepth's name lies in our favour: linearizedepth's actual job is the MSAA resolve + SRV
// exposure, and what it stores is the raw reverse-Z DEVICE depth, single-sample, at full R32F.
#comp motionvectors.comp
#include "motionvectors.comp.fsl"
#end

// ...and the vectors LOOKED AT (F12 mode 17). Ships in the same step as the pass for the reason
// atmosview does: nothing consumes motion vectors yet, so this picture is the only evidence they
// are right. Fullscreen (modes 11-16's corner overlay cannot show a vector field), reusing
// shadowatlasview.vert + the opaque.srt.h PerFrame set where gMotionVectors is bound.
#frag mvview.frag
#include "mvview.frag.fsl"
#end

// M1 step 4b — THE UPSCALER SEAM'S FIRST BACKEND (tasks/forge-upscale.md): pSceneColor's INPUT
// sub-rect resampled into a separate alloc-sized target's OUTPUT sub-rect, Catmull-Rom with an
// anti-ringing clamp. The permanent fallback for the AMD / Intel / GTX-1080 tiers, which is why it
// is a real reconstruction and not a blit.
//
// ⚠ ONE VARIANT, NO SAMPLE_COUNT SPLIT, AND IT MUST NEVER GROW ONE. An upscaler REPLACES MSAA —
// they are mutually exclusive by construction, and resolve_sc4.frag binds a Tex2DMS where the
// single-sample upscaled output would go, which is a TYPE mismatch and not a quality question. The
// host refuses to create the backend at sampleCount > 1 and logs the refusal.
//
// COMPUTE, so it hot-reloads with F8 — the same call bloom and reflectmip made, and the FILTER is
// exactly the thing that wants walking in a running game.
#comp upscale.comp
#include "upscale.comp.fsl"
#end

// Debug line (--forge-view only): solid-colour world-space line list for distance reference rings.
#vert debugline.vert
#include "debugline.vert.fsl"
#end

#frag debugline.frag
#include "debugline.frag.fsl"
#end

// Shadow-atlas debug view (F12 mode 11 static / 12 dynamic): fullscreen triangle that blits the
// whole D32 shadow atlas, tinting tiles by per-slot active/dyn state. Reuses opaque.srt.h /
// DefaultRootSignature (gFrameData + the two atlas SRVs appended to the PerFrame set). Graphics
// shader → loads at host startup only (kill mgeHost64 to reload).
#vert shadowatlasview.vert
#include "shadowatlasview.vert.fsl"
#end

#frag shadowatlasview.frag
#include "shadowatlasview.frag.fsl"
#end

// --- Tier 2 depth-takeover compute passes (ComputeRootSignature) ---
// Linearize/resolve: two SAMPLE_COUNT variants; host picks by g_live.sampleCount at pipeline build.
#comp linearizedepth_sc1.comp
#define SAMPLE_COUNT 1
#include "linearizedepth.comp.fsl"
#end

#comp linearizedepth_sc4.comp
#define SAMPLE_COUNT 4
#include "linearizedepth.comp.fsl"
#end

// APL instrument (tasks/forge-postprocess.md step 2): reduces the finished scene colour to
// mean RGB + mean log-luma, one 256-thread group, straight into the heartbeat. The measuring stick
// for the linear migration — it must ship ON so that today's runs are the BEFORE baseline.
// ONE variant, unlike linearizedepth above: step 6a moved the dispatch past the resolve, so it
// always reads pRT (the delivered, single-sample image) and the SAMPLE_COUNT 4 twin was dropped.
// The name keeps its _sc1 suffix because the source still compiles through that define.
#comp apl_sc1.comp
#define SAMPLE_COUNT 1
#include "apl.comp.fsl"
#end

// ─── THE ATMOSPHERE (tasks/forge-atmosphere.md S2) ────────────────────────────────────────────────
// Bruneton's participating medium in Hillaire's per-frame LUT packaging, replacing the Hosek-Wilkie
// closed form (whose C++/FSL cross-check used to sit here — deleted with the model it guarded, S2f).
// All four share compute.rootsig + one AtmosphereSrtData PerBatch set over four instances, and all
// four are COMPUTE so they hot-reload on F8: tuning an atmosphere means watching a sunset, and a
// graphics-pipeline shader would cost a host restart per try.
//
// ⚠ THE ORDER IS A DEPENDENCY CHAIN AND THE HOST DISPATCHES THEM IN IT: transmittance feeds
// multiscatter, both feed sky-view, and all three feed the SH measurement.
#comp atmos_transmittance.comp
#include "atmos_transmittance.comp.fsl"
#end

#comp atmos_multiscatter.comp
#include "atmos_multiscatter.comp.fsl"
#end

#comp atmos_skyview.comp
#include "atmos_skyview.comp.fsl"
#end

// ...and THE MEASUREMENT, which is also THE GATE (S2b). Projects the LIVE sky-view LUT into SH-L1
// over the full sphere and computes E_sky / E_sun / the zenith and horizon probes in the same pass,
// so the LIGHT is a measurement of the DRAWN SKY rather than a parallel derivation of it. That is
// what deletes the two-copies problem instead of instrumenting it.
#comp atmos_sh.comp
#include "atmos_sh.comp.fsl"
#end

// ...and the LUTs' DEBUG VIEW (F12 mode 15 sky-view / 16 transmittance). Reuses shadowatlasview.vert
// (fullscreen tri). Ships WITH the chain rather than after it, for the reason the file states: in
// S2a nothing samples the LUTs, so this picture is the only evidence they are right.
#frag atmosview.frag
#include "atmosview.frag.fsl"
#end

// Screen-space AO — FOUR interchangeable modes behind one SRT (AOSrtData) and one descriptor set.
// The host holds pAOShader[]/pAOPipeline[] indexed by the "AO mode" dropdown and binds one of them;
// all four read the already-resolved single-sample depth (never the MSAA DSV) and write
// float4(bentNormalWS, visibility) to pAO, so aoblur.comp and the colour frags are untouched by the
// choice. Shared core (depth load, world reconstruct, min-difference normal, search geometry, slice
// basis, dither, resolve) is aocommon.h.fsl — the four differ ONLY in their accumulator.
#comp gtao.comp
#include "gtao.comp.fsl"
#end

#comp hbao.comp
#include "hbao.comp.fsl"
#end

#comp vbao.comp
#include "vbao.comp.fsl"
#end

// ...and the same bitmask body at a fixed 2 slices / 4 steps (literal bounds => fully unrolled).
#comp ssaofast.comp
#include "ssaofast.comp.fsl"
#end

// AO bilateral blur: third compute pass — denoises pAO -> pAOBlur (depth-aware, no silhouette bleed).
#comp aoblur.comp
#include "aoblur.comp.fsl"
#end

// Half-res AO chain (the "AO half-res" panel toggle; default OFF, so the full-res path above stays
// byte-identical until it is ticked). The AO pass and the blur are UNCHANGED — they simply run
// against half-res descriptor sets — so only the two ends of the chain are new: a depth downsample
// in front and a depth+normal-adaptive Lanczos-2 upscale behind. pAOBlur stays full res and stays
// what the colour frags sample as gAO, so no frag is touched. See aoupscale.srt.h.
#comp aodepthdown.comp
#include "aodepthdown.comp.fsl"
#end

#comp aoupscale.comp
#include "aoupscale.comp.fsl"
#end

// SH2 sky AO: the TERRAIN layer of the top-down world height map. One thread per texel, straight
// off the resident heightfield (no cull, no instance build, no draw); runs LAST in the rebuild so it
// folds max() over the statics raster. Rebuilt only when the camera leaves its snap cell.
#comp skyheight.comp
#include "skyheight.comp.fsl"
#end

// ...and the STATICS layer of the same map: statics.vert under a top-down ortho, writing absolute
// world Z with BM_MAX blending (so the highest occluder wins with no depth attachment at all).
#frag skyheight_statics.frag
#include "skyheight_statics.frag.fsl"
#end

// SUN-OCCLUSION map, derived from the SAME height map: the sun-blocked world Z per texel, i.e. the
// LONG-range sun shadow the 8192-unit cascades cannot reach. One tap answers "is this point lit",
// at any altitude, which is what the volumetric march needs and what a horizon ANGLE could not give
// it. Rebuilt only when the sun moves past a threshold or the height map itself rebuilds.
#comp sunocc.comp
#include "sunocc.comp.fsl"
#end

// ...and the map's DEBUG VIEW (F12 mode 14). Reuses shadowatlasview.vert (fullscreen tri); false-
// colour elevation plot of gSkyHeight, because sky AO has no silhouette of its own and a wrong map
// is otherwise close to undiagnosable.
#frag skyheightview.frag
#include "skyheightview.frag.fsl"
#end

// SUN shadow moments blur: the pass that makes MSM soft (a raw texel is a Dirac, whose Hankel
// matrix is singular → hard, pixel-shaped edges). Separable, run as two dispatches over two
// instances of one SRT set. Compute → hot-reloadable.
#comp sunblur.comp
#include "sunblur.comp.fsl"
#end

// P1 point-light shadows: screen-space visibility mask. Reads the RESOLVED single-sample
// prepass depth (pLinearDepth) — no MSAA variants needed — plus the shadow atlas; writes the
// R32G32_UINT per-slot mask the forward frags load. Hot-reloadable (rides the gtao mtime poll).
#comp shadowmask.comp
#include "shadowmask.comp.fsl"
#end

// Hi-Z mip-pyramid build (occlusion M2). FIRST copies sample 0 of the scene DSV (pDepth, FULL
// scene depth at the colour->water seam) -> mip 0, in two SAMPLE_COUNT variants picked by
// g_live.sampleCount (linearizedepth's pattern); the reduce (prologue cmd, tail-submitted after
// the frame fence) MIN-halves mip i-1 -> mip i (reverse-Z min = farthest = conservative for the
// Hi-Z cull in cull.comp/cullscatter.comp).
#comp hizfirst_sc1.comp
#define HIZ_FIRST 1
#define SAMPLE_COUNT 1
#include "hizreduce.comp.fsl"
#end

#comp hizfirst_sc4.comp
#define HIZ_FIRST 1
#define SAMPLE_COUNT 4
#include "hizreduce.comp.fsl"
#end

#comp hizreduce.comp
#include "hizreduce.comp.fsl"
#end

// Planar-reflection mip pyramid (WT4d / PBR water, P2). Same two-variant shape as the Hi-Z above,
// but a BOX AVERAGE instead of a min — this is radiance, not conservative depth — and over all four
// PREMULTIPLIED channels with identical weights (see reflectmip.srt.h). Feeds water.frag's
// roughness-driven reflection LOD; without it a rough surface would sample a mirror-sharp RT and
// alias. Both run in the main cmd where pReflectColor flips to SHADER_RESOURCE.
// W5: the first pass is now also the mirror pass's RESOLVE — pReflectColor/Depth are MSAA at
// g_live.sampleCount, so it averages the colour samples into mip 0 and writes a single-sample copy of
// the depth for water.frag's hit-distance term. Two SAMPLE_COUNT variants, hizfirst's pattern, because
// Tex2DMS needs SAMPLE_COUNT as a literal. The reduce below stays single-variant: it only ever reads
// the already-resolved pyramid.
#comp reflectmipfirst_sc1.comp
#define REFLMIP_FIRST 1
#define SAMPLE_COUNT 1
#include "reflectmip.comp.fsl"
#end

#comp reflectmipfirst_sc4.comp
#define REFLMIP_FIRST 1
#define SAMPLE_COUNT 4
#include "reflectmip.comp.fsl"
#end

#comp reflectmip.comp
#include "reflectmip.comp.fsl"
#end

// Bloom pyramid (tasks/forge-postprocess.md step 4). Same three-stage shape as the two pyramids
// above, and the prefilter is likewise the MSAA RESOLVE — which is why bloom needed no
// resolve/composite split: a 2x downsample of an MSAA target already averages the sub-samples, so it
// reads pSceneColor directly. Two SAMPLE_COUNT variants for the same reason reflectmipfirst has them
// (Tex2DMS needs the count as a literal); the down/up passes read the already-resolved pyramid and
// stay single-variant. All three share the ONE BloomSrtData Persistent set, over 13 instances (1
// prefilter + 6 down + 6 up), each carrying its own level's render rects in its own cbuffer.
#comp bloomprefilter_sc1.comp
#define SAMPLE_COUNT 1
#include "bloomprefilter.comp.fsl"
#end

#comp bloomprefilter_sc4.comp
#define SAMPLE_COUNT 4
#include "bloomprefilter.comp.fsl"
#end

#comp bloomdown.comp
#include "bloomdown.comp.fsl"
#end

#comp bloomup.comp
#include "bloomup.comp.fsl"
#end

// Stage B (B3) GPU statics cull — count -> prefix-sum -> scatter -> execute-indirect (drives the far
// statics draw; the CPU cull stays for parity until visually verified). All three share compute.rootsig
// + the CullSrtData PerBatch set. cull.comp = COUNT (survivors atomic-add numSubsets for the CPU parity
// check AND per-subset counts). See tasks/forge-gpu-occlusion.md.
#comp cull.comp
#include "cull.comp.fsl"
#end

// PREFIX-SUM: single thread, per-subset survivor count -> instance offset + one IndirectDrawIndexArguments.
#comp cullscan.comp
#include "cullscan.comp.fsl"
#end

// SCATTER: re-test survivors, write each (instance,subset) camera-relative row into the GPU instance ring.
#comp cullscatter.comp
#include "cullscatter.comp.fsl"
#end

// Follow-on 3: occlusion-cull SHADOW LIGHTS vs the Hi-Z pyramid. One thread per shadow slot (32,
// one group); reuses hizocclusion.h.fsl (same test as cull.comp). ORs each fully-occluded slot's
// bit into gLightOccBits[0] — the host reads it back and skips that slot's atlas bake (bakes-only,
// never the cached tile / mask). Shares compute.rootsig + its own ShadowLightCullSrtData PerBatch set.
#comp shadowlightcull.comp
#include "shadowlightcull.comp.fsl"
#end

// Clustered forward lighting: froxel light-assignment. froxelclear.comp zeros the 128-bit-per-froxel
// mask; froxelassign.comp scatters each uploaded distant light's bit into every froxel its reach-sphere
// touches (screen-tile box x radial-slice range). distantland.frag/statics.frag then loop only their
// froxel's lights. Both share compute.rootsig + FroxelSrtData PerBatch. See tasks/forge-clustered-lighting.md.
#comp froxelclear.comp
#include "froxelclear.comp.fsl"
#end

#comp froxelassign.comp
#include "froxelassign.comp.fsl"
#end

// R2 actor-ripple wave SIM. Two dispatches over a fixed 1024² grid, ping-ponged, replacing the
// per-pixel analytic loop that cost the water pass 0.31 -> 32.81 ms once a wake was in view.
// Fixed cost regardless of ripple count, and a moving impulse train through a real wave equation
// interferes into a wedge — which independent analytic packets cannot do. Both share
// compute.rootsig + RippleSimSrtData Persistent. See ripplesim.srt.h.
#comp ripplesim.comp
#include "ripplesim.comp.fsl"
#end

// R2c: the DISPERSIVE wake step, on its own coarse grid. ripplesim.comp cannot produce a Kelvin
// wedge at any setting — it is the non-dispersive wave equation, in which a moving source draws
// nested circles or a Mach cone and nothing else. This one applies omega^2 = g|k| as a 21x21
// convolution, which is what makes long waves outrun short ones and closes the wake into a wedge.
#comp ripplewave.comp
#include "ripplewave.comp.fsl"
#end

// R2d: MGE's OWN dynamic-wave sim, ported from XE Main.fx's WaveStepPS + PlayerWavePS. Same
// non-dispersive Laplacian as ripplesim.comp — the V comes from a FIXED 80 Hz timestep putting the
// wave speed at 75 units/s, below swim speed, so the source is supercritical.
#comp ripplemge.comp
#include "ripplemge.comp.fsl"
#end

// Runs over EVERY grid — it only takes central differences of whatever gRippleSimNext holds.
#comp ripplenormal.comp
#include "ripplenormal.comp.fsl"
#end

// W23: TILING CAUSTICS. A photon SCATTER (not a forward 1/|det J| map — see caustic.srt.h for why
// the fold is the whole effect and only scattering gets it), then a resolve that normalises to a
// mean of exactly 1.0 and clears the counter on its way out.
#comp caustic.comp
#include "caustic.comp.fsl"
#end

#comp causticresolve.comp
#include "causticresolve.comp.fsl"
#end

// W24: DYNAMIC CAUSTICS — the same beam kernel (causticsplat.h.fsl, shared with caustic.comp) fed by
// the LIVE ripple and wake fields instead of by a tiling cosine sum, into slices 4-6. One shader for
// both layers: which field, which domain and which slices are entirely a descriptor-set instance and
// its cbuffer. Cost is proportional to the DISTURBED AREA, not to the grid, because the resolve
// leaves an identity prefill that a calm beam simply does not touch.
#comp causticdyn.comp
#include "causticdyn.comp.fsl"
#end

// G7 GRASS PLASTICITY — the crush field (tasks/forge-grass.md, grasscrush.srt.h). Three compute
// passes over one 512² clearance-height map: scroll+recover+seed, an AtomicMin scatter of every
// skinned bone's disc, then a resolve that publishes the height and derives the lay direction from
// its own gradient. All three are COMPUTE so they hot-reload on F8 — tuning a crush profile means
// watching a body lie in grass, and a graphics-pipeline shader would cost a host restart per try.
#comp grasscrush.comp
#include "grasscrush.comp.fsl"
#end

#comp grasscrushsplat.comp
#include "grasscrushsplat.comp.fsl"
#end

#comp grasscrushresolve.comp
#include "grasscrushresolve.comp.fsl"
#end

// MB-1 OBJECT VELOCITY (tasks/forge-postprocess.md — motion blur). A mover-only redraw that
// OVERWRITES the camera-only field in pMotionVectors for the one population depth reprojection
// cannot describe: things that moved under their own power. Graphics, not compute, because it needs
// the rasterizer and the depth test — so it does NOT hot-reload; kill mgeHost64 to pick up an edit.
//
// ⚠ No SAMPLE_COUNT split and none is needed: it binds NO colour target (mRenderTargetCount = 0) and
// writes its result through a UAV, so the scene's sample count never reaches this pipeline. The
// depth format does, and that is D32_SFLOAT in every arm.
#vert objvelocity.vert
#include "objvelocity.vert.fsl"
#end

#frag objvelocity.frag
#include "objvelocity.frag.fsl"
#end

// MB-1b: the SKINNED half of the same pass. A second VERT, not a variant of the first — a skinned
// part's position comes from a bone palette, not a world matrix — pairing with the SAME
// objvelocity.frag above, which reads only CurClip/PrevClip and already carries
// EARLY_FRAGMENT_TESTS. Graphics, so it does NOT hot-reload; kill mgeHost64 to pick up an edit.
#vert objvelocity_skin.vert
#include "objvelocity_skin.vert.fsl"
#end

// ...and the statistics of the FINISHED field, measured AFTER the object-velocity overwrite. The
// producing shader's own gMvStats describe an intermediate that no longer exists once a second
// writer lands on the same texture; this one describes what F12 mode 17 actually draws. Its headline
// counter is `nonzero` (m != 0 EXACTLY) — which STARTED as mvview.frag's grey-branch predicate and
// is now deliberately stricter than it (the view moved to a 0.01 px tolerance because the exact test
// was unreachable in this engine). Kept exact because it is the only readout that can prove the
// parked-camera lane reaches the GPU: 0.000% on a bit-identical frame. It also carries that frame's
// parked flag back out in slot [6], so the percentage and its precondition describe ONE frame.
#comp mvfieldstats.comp
#include "mvfieldstats.comp.fsl"
#end

// ─── MB-2: THE MOTION BLUR FILTER (tasks/forge-postprocess.md) ──────────────────────────────────
// MB-1 produced the field; these three consume it. Read motionblur.srt.h for the whole argument —
// the rect mapping, the reverse-Z depth sign, and what the deliberately-absent velocity-agreement
// weights cost.
//
// ⚠ ALL THREE ARE COMPUTE, and that is two decisions in one. Shutter angle, tap count and K are
// exactly the knobs that want walking in a running game, and compute hot-reloads with F8. It also
// puts the pass out of reach of the late-Z trap that cost MB-1a three rounds: a UAV-writing PIXEL
// shader has side effects, so D3D12 runs it BEFORE the depth test.
//
// ⚠ THE DILATION SPLITS AND THE GATHER DOES NOT, and that is not a cost decision either way. `max`
// is separable; a line integral along an arbitrary direction is not a convolution and has no
// separable form. X-then-Y here turns a diagonal streak into an axis-aligned box.
#comp mbtilemax.comp
#include "mbtilemax.comp.fsl"
#end

#comp mbneighbormax.comp
#include "mbneighbormax.comp.fsl"
#end

#comp mbgather.comp
#include "mbgather.comp.fsl"
#end
