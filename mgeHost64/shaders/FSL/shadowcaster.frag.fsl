// mgeHost64 — point-light shadow-caster fragment stage (depth-only, alpha + emissive carve).
//
// A CLONE of depthonly.frag used ONLY by the shadow-atlas caster PSOs (pShadowPipeline*). It
// must NOT replace depthonly.frag on the main Z-prepass: the prepass clip() has to stay bit-
// identical to the colour pass for CMP_EQUAL parity, and the emissive carve below would punch
// holes in that. Keeping it a separate frag isolates the shadow behaviour entirely.
//
// Two discards:
//   1. Alpha cutout — identical to depthonly.frag (the hammock/foliage cutout that already casts).
//   2. Emissive carve — a self-illuminated caster (lantern glass, candle paper, torch shade) casts
//      only its DARK texels: the printed lettering, seams, and small imperfections. The GLOWING
//      texels ARE the light source and must not black-cage it. This is the alpha-cutout trick
//      applied to emitted brightness instead of coverage — so the old all-or-nothing whole-mesh
//      emissive skip (forgerender C3b) becomes a per-texel carve.
//
//      OWNER-KEYED. The carve exists to stop a fixture caging ITS OWN light — that is the only
//      light it may be see-through to. From any OTHER light the fixture is just an object, and its
//      glowing texels must cast like the opaque geometry they are (a lit lantern across the room is
//      not a hole in the shadow). So the host tags each caster instance with its OWNER slot in
//      MatEmissive.y and stamps the slot being baked into gFrameData.atlasDbg.w; the carve fires
//      only when they match. MatEmissive.y: 0 = no owner (never carve — cast fully opaque),
//      -1 = the legacy un-keyed carve (see-through from every light; host A/B).
//
//      emit scale rides MatEmissive.x (host writes 1 on an emissive-hot caster, 0 otherwise), so an
//      ordinary caster has emit≈0 → this never fires — the same self-gating the whole-mesh
//      classifier relied on, now per-texel and free.
//
//      Threshold rides gFrameData.atlasDbg.z (lanes the per-face shadow cbuffer leaves spare — only
//      faceVP[0..15] is filled there), = host g_shadowEmissiveTexel. thr <= 0 disables the carve
//      (every emissive texel casts). Graphics shader: loads at host startup, so the knobs are
//      plumbed through the cbuffer, not a #define.
//
// Shares opaque.vert's VSOutput (declare the full struct for a matched signature; read only
// Uv / TexIndex / AlphaRef / MatEmissive).

#include "opaque.srt.h"
#include "texsample.h.fsl"   // sampleBase() — MW address mode + AF level

STRUCT(VSOutput)
{
    DATA(float4,      Position, SV_Position);
    DATA(float3,      Normal,   NORMAL);
    DATA(float2,      Uv,       TEXCOORD0);
    DATA(FLAT(uint),  TexIndex, TEXCOORD1);
    DATA(float,       Fog,      TEXCOORD2);
    DATA(float4,      Color,    COLOR);
    DATA(float,       AlphaRef, TEXCOORD3);
    DATA(FLAT(float3),MatDiffuse, TEXCOORD4);
    DATA(FLAT(float3),MatAmbient, TEXCOORD5);
    DATA(FLAT(float3),MatEmissive,TEXCOORD6);
    DATA(FLAT(uint),  VColSource, TEXCOORD7);
    DATA(float3,      WorldPos,   TEXCOORD8);
    DATA(FLAT(uint),  OverlayIndex,TEXCOORD9);
    DATA(FLAT(uint),  ClampMode,  TEXCOORD10);// MW texture address mode (0..3) -> sampleBase()
};

ROOT_SIGNATURE(DefaultRootSignature)
void PS_MAIN( VSOutput In )
{
    INIT_MAIN;
    float4 tex = sampleBase(In.TexIndex, In.ClampMode, In.Uv, useLowAF(In.AlphaRef, false));
    // 1. Alpha cutout — MUST match depthonly.frag / opaque.frag exactly (strict '<').
    clip(tex.a < In.AlphaRef ? -1.0f : 1.0f);
    // 2. Emissive carve — drop the glowing texels, keep the dark detail. ONLY in the owner's bake:
    //    a fixture is see-through to its own light and opaque to every other.
    float3 emit    = In.MatEmissive.x * tex.rgb;
    float  emitLum = dot(emit, float3(0.299f, 0.587f, 0.114f));
    float  thr     = gFrameData.atlasDbg.z;
    float  owner   = In.MatEmissive.y;        // 0 = none (never carve), -1 = every light (legacy A/B)
    float  bakeSlot= gFrameData.atlasDbg.w;   // slot being baked, +1
    bool   ownsMe  = (owner < -0.5f) || (owner > 0.5f && abs(owner - bakeSlot) < 0.5f);
    clip((thr > 0.0f && ownsMe && emitLum > thr) ? -1.0f : 1.0f);
    RETURN();
}
