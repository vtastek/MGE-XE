// mgeHost64 — shared point-light shadow SLOT params.
//
// The ShadowMaskParams cbuffer describes every ACTIVE shadow slot (camera-relative light
// pos/radius, its 3x2 cube-face atlas tile, bias/flicker state). Two consumers read it:
//   - shadowmask.comp  (ShadowMaskSrtData) — the once-per-frame screen-space mask pass.
//   - opaque.frag      (SrtData, PerFrame gShadowParams) — the FIRST-PERSON direct-atlas path,
//     which samples the cube atlas straight from the interpolated world pos + vertex normal
//     (the screen mask reconstructs the WORLD behind the arm, not the arm itself).
// Factored here so both share ONE definition — the cbuffer bytes are identical, so the host
// binds the SAME pShadowMaskParamsCbv to either root signature.
#pragma once

#define MAX_SHADOW_SLOTS 32   // MUST match host kMaxShadowLights (forgerender.cpp)

// SUN (directional) shadow CASCADE count. MUST match host kSunCascades (forgerender.cpp) — it sizes
// the matrix array below, so a mismatch silently shifts every float offset publishSunShadowParams
// writes. Cascades are CONCENTRIC camera-centred ortho boxes at increasing half-extent, packed side
// by side into ONE moments atlas (cascade c owns u in [c/N, (c+1)/N]) so every receiver keeps its
// single gSunMoments binding and no PerFrame set has to grow.
#define SUN_CASCADES 2
// PER-CASCADE tile resolution. MUST match host kSunShadowRes (static_asserted there). Needed in the
// shader only by the near cascade's PCSS/PCF, which works in TEXELS and therefore has to know the
// atlas's pixel grid — the moments receiver is pure uv and never cared.
#define SUN_SHADOW_RES 2048

STRUCT(ShadowMaskParams)
{
    DATA(float4x4, invViewProj,  None);   // inverse of the reverse-Z camera-relative viewProj
    // maskParams: x = shadow TEST RANGE in light radii (live knob, host g_shadowRangeK; 2.0 =
    //             the atlas far plane = old behaviour). Range cull + slot test use it; the
    //             refZ depth mapping always uses farZ = 2r (the atlas render far plane),
    //             y = face near plane (world u),
    //             z = relative reverse-Z compare slack (acne knob, live-tunable),
    //             w = debug mode (0 off, 1 face-id nibble, 2 atlas-depth view)
    DATA(float4,   screenParams, None);   // xy = screen w,h ; zw = 1/w, 1/h
    DATA(float4,   maskParams,   None);
    DATA(float4,   slotPosRad[MAX_SHADOW_SLOTS], None);   // xyz = camera-relative light pos, w = radius (far = 2r)
    DATA(float4,   slotTile[MAX_SHADOW_SLOTS],   None);   // xy = 3x2 face-block origin (atlas px), z = face size (px), w = temporal fade-in
    // biasParams: x = ABSOLUTE reverse-Z compare bias (contact/interpenetration knob, live).
    //             y = NORMAL-OFFSET bias in atlas texels (live).
    //             z = base-rate flame phase (diagnostic only).
    //             w = BASE flicker wobble amplitude in radians (0 = off), scaled per slot by slotFlick.x.
    DATA(float4,   biasParams,   None);
    // slotBits: the 32-bit slot masks as REAL uints (float lanes drop bits >= 24).
    //             x = ACTIVE-slot bitmask, y = DYNAMIC-slot bitmask (valid dyn tile this frame),
    //             z = FLICKER-class bitmask, w = SOFT bitmask (reduced-res tile).
    DATA(uint4,    slotBits,     None);
    // Per-slot flame state (flicker slots only). x = wobble amp gain, y = flame phase (rad),
    // z = the face-frustum uvScale this slot's tile was BAKED with (< 1 = wider than 90°), w = spare.
    DATA(float4,   slotFlick[MAX_SHADOW_SLOTS], None);
    // --- SUN (directional) CASCADED shadow, Phase B/C receiver (forge-sun-shadows.md) ----------
    // Per-cascade sun MSM ortho view*proj, CAMERA-RELATIVE (eye at origin) — the same matrices the
    // caster pass projected by, so every receiver reconstructs the identical mapping. They live HERE
    // rather than in FrameData because FrameData is exactly full at its 512B CBV, while this cbuffer
    // has room — and it is already bound into every PerFrame set AND the compute mask, so one write
    // reaches all receivers. Same convention as gFrameData.viewProj:
    // mul(M, worldPos) == D3DX row-vector worldPos*M.
    // Every cascade shares ONE depth slab (half-extent 2*outermost range) so a caster high up-sun is
    // inside all of them and the NORMALISED depth — hence the single depth bias below — is cascade-
    // independent. Only the two axes perpendicular to the sun shrink per cascade.
    DATA(float4x4, sunViewProj[SUN_CASCADES], None);
    // sunParams: x = shadow STRENGTH 0..1 (0 = sun shadows OFF — the receiver's early-out, so the
    //                whole feature A/Bs from one float; also the "no map this frame" signal),
    //            y = depth bias in NORMALISED sun-depth units — the host converts it from a
    //                WORLD-unit knob (the shared slab spans 4*g_sunShadowRange world units), so the
    //                tuned value survives a change to the extent knob,
    //            z = light-bleeding reduction 0..0.95 (AMPLIFIES the reconstructed occlusion by
    //                1/(1-z) so an under-reported shadow core saturates to fully occluded; higher =
    //                deeper, tighter shadows. Raising it must never LIGHTEN a shadow — see msmrecv),
    //            w = NORMAL-OFFSET in TEXELS of the sampled cascade (the receiver samples from
    //                worldPos + N*w*texel — the cheap slope-acne fix that costs no depth precision).
    //                Texels, not world units: the acne it fixes is a one-texel depth-quantisation
    //                error, so an offset fixed in world units is simultaneously too small for the
    //                coarse far cascade and a peter-panning gap in the fine near one.
    DATA(float4,   sunParams,   None);
    // Cascade c's shadow-map texel size in WORLD units (x = c0 .. w = c3; lanes past SUN_CASCADES
    // are 0). Feeds the normal-offset scaling above.
    DATA(float4,   sunCascadeTexel, None);
    // --- NEAR-cascade PCSS + PCF (the hard-surface receiver) -----------------------------------
    // Cascade 0 does NOT use the moments above. MSM's penumbra is bounded by the moments blur's tap
    // radius (4 texels), so its softness saturates and what is left is a truncated, axis-aligned
    // kernel — the "square vectorisation" that shows up worst on terrain, where receiver and occluder
    // depths are close and the quadrature is least stable. Cascade 0 instead runs a blocker search +
    // variable-radius rotated-disc PCF over the RAW depth the caster pass already wrote
    // (gSunDepth) — penumbra decoupled from any map-space blur. The moments stay live for every OTHER
    // cascade and for volumetrics, which need one cheap filterable tap per ray step and cannot afford
    // a tap storm. Both representations come out of the SAME caster pass; neither costs a second one.
    // sunPcf0: x = blocker-search radius in TEXELS,
    //          y = light size in TEXELS (penumbra = y * (zRecv - zBlocker)/zBlocker, the PCSS
    //              similar-triangles term — this is THE softness knob),
    //          z = min PCF radius in TEXELS (contact hardness floor; below ~1 the grid shows),
    //          w = max PCF radius in TEXELS (bounds the tap spread so the disc cannot outrun its
    //              sample count and break into rings).
    DATA(float4,   sunPcf0,     None);
    // sunPcf1: x = PCF depth bias in NORMALISED sun-depth (converted host-side from a WORLD knob,
    //              like sunParams.y — a binary depth compare needs its OWN, usually smaller, bias
    //              than MSM's quadrature, so it does not share that number),
    //          y = slope-scaled bias in the same units, multiplied by tan(acos(N.L)),
    //          z = 1 = PCSS/PCF near cascade ON, 0 = fall back to MSM everywhere (the A/B),
    //          w = spare.
    DATA(float4,   sunPcf1,     None);
    // --- VOLUMETRIC height fog (volfog.frag.fsl) ------------------------------------------------
    // The moments map's actual job now that PCSS owns the colour pass: a ray march wants ONE cheap
    // filterable tap per step and cannot afford PCSS's 28, so shafts read the MSM atlas.
    // volFog0: x = density per world unit at the fog base,
    //          y = height falloff in WORLD units (density *= exp(-(h - base)/y)),
    //          z = fog BASE height in ABSOLUTE world units (Morrowind Z is up),
    //          w = max march distance in world units (the ray stops at the depth buffer or here).
    DATA(float4,   volFog0,     None);
    // volFog1: x = FORWARD-lobe Henyey-Greenstein g (0 = isotropic, ->1 = tight sun glow),
    //          y = step count,
    //          z = 1 = fog pass ON,
    //          w = HAZE shadow response 0..1: how much a sun shadow dims the haze term. 0 (default)
    //              = not at all, which is the energy-safe setting — a shadow then removes only the
    //              SHAFT, never the fog. Above 0 the pass becomes a net darkener at occlude 1.
    DATA(float4,   volFog1,     None);
    // volFog2: xyz = fog TINT, w = overall intensity. Applied to the FINAL in-scatter, which already
    //          carries its own colour: the lobes are sun-coloured (shafts), the isotropic pedestal and
    //          the ambient floor are FOG-coloured (haze). Multiplying everything by the sun colour is
    //          what made the horizon band light up over MW's own fog band.
    DATA(float4,   volFog2,     None);
    // volFog3: x = OCCLUDE amount 0..1 — how much of the underlying image the fog removes before its
    //              own colour is added (Sunshafts.fx `sunrayocclude`, 0.75 there). 1.0 == the
    //              physically exact composite dst*transmittance; below that the fog is less
    //              destructive of the scene behind it, which is what stops bright shafts blowing out.
    //          y = BACK-lobe g (signed; negative = back-scatter, the anti-sun brightening),
    //          z = forward-lobe GAIN, w = back-lobe GAIN.
    DATA(float4,   volFog3,     None);
    // --- DUAL-LOBE phase + water clamp ----------------------------------------------------------
    // A single HG lobe couples three things that want independent control: the sun halo, the anti-sun
    // brightening, and the SIDE (~90 deg to the sun) scattering that is most of what reads as "fog".
    // Raising density to get visible side fog necessarily explodes the forward lobe, because HG's
    // peak scales with the same number. So the phase is a WEIGHTED SUM of three normalised terms —
    // isotropic + forward HG + backward HG — each with its own gain:
    //     phase = iso + fwdGain * HG_n(cos, gF) + backGain * HG_n(cos, gB)      (HG_n: 1 == isotropic)
    // and the sum is passed through a soft ceiling so the forward lobe asymptotes instead of blowing
    // out (a hard clamp would draw a visible disc edge around the sun).
    // volFog4: x = HAZE gain — the side/horizontal knob (raises fog at every angle without touching
    //              either lobe; reach for this when "there is not enough fog"). 1.0 is the
    //              ENERGY-NEUTRAL point: the haze then returns exactly the (1-T) of fog radiance that
    //              the occlude term removed, so at occlude 1 the composite is an exact lerp toward
    //              the fog colour. Below 1 the pass darkens the scene; above 1 it brightens it.
    //          y = phase soft ceiling (Reinhard knee; the phase asymptotes to this),
    //          z = water-plane clamp: ABSOLUTE world Z of the water surface,
    //          w = 1 = water clamp ACTIVE this frame (water drawn and camera above it).
    // The water clamp exists because water writes depth AFTER the seam gSceneLinDepth is taken at
    // (it must not clamp its own refraction source), so over open sea that depth holds the seabed —
    // or nothing at all, which reads as sky. Either way the ray marches straight through the water
    // surface and keeps accumulating near-ground-density fog, which is exactly the bright band above
    // the horizon over water.
    DATA(float4,   volFog4,     None);
    // ALLOCATION size of the screen-sized render targets — NOT the current render size.
    // These differ: the host allocates every size-dependent RT at the render-scale CEILING
    // (2x backbuffer) and draws into a sub-VIEWPORT of it, so at scale 1.0 the live image occupies
    // the top-left QUARTER of each texture. Anything sampling a screen-sized texture by uv must
    // therefore scale by pixel/alloc, while anything reconstructing NDC must use pixel/render.
    // screenParams above is the RENDER size; these two are not interchangeable.
    //   xy = alloc w,h ; zw = 1/alloc w,h
    DATA(float4,   screenAlloc, None);
    // --- SKY ambient, projected to SH-L1 (SH1, tasks/lighting.md) --------------------------------
    // Ambient used to be ONE flat colour, so a surface facing the sky and a surface facing the dirt
    // received identically — the only thing breaking that up was screen-space GTAO, which has no idea
    // where the sky is. The sky is already an analytic function of direction (sky.frag's VColSource 3
    // dome: lerp(fogColNear, skyZenith, saturate(dir.z)), plus a sun lobe), i.e. a light source we
    // were not sampling. The host projects THAT function into an L1 basis once per frame; the
    // receiver costs three dot products.
    // Packed Unity-style so evaluation is exactly a dot: irr.r = dot(shAr, float4(N, 1)).
    // NORMALISED BY ITS OWN DC, so what these publish is a directional FACTOR whose spherical average
    // is 1 — not a replacement ambient. That is what makes strength 0 bit-identical to flat ambient
    // and strength 1 a pure redistribution: the slider cannot make the world darker or brighter.
    DATA(float4,   shAr, None);
    DATA(float4,   shAg, None);
    DATA(float4,   shAb, None);
    // skyParams: x = SH STRENGTH 0..1 (0 = the directional half off — the receiver's early-out AND
    //                the interior gate, the same "one float disarms it at every receiver" idiom
    //                sunParams.x uses; there is no sky to project in an interior, so the host
    //                publishes 0 there),
    //            y = SH2 sky-AO STRENGTH 0..1 (0 = no taps taken at all, i.e. bit-identical to the
    //                SH1 build). Its OWN lane rather than sharing x: occlusion is a separate
    //                measurement from direction and each has to be A/B-able against the other. Also
    //                0 in interiors — the height map covers the exterior world only.
    //            z = INNER tap radius in world units. The march STARTS here so it does not restate
    //                what screen-space GTAO already multiplied into the same ambient; the two are
    //                complementary bands, not stacked copies of one.
    //            w = OUTER tap radius in world units — how far a cliff can still shade you.
    DATA(float4,   skyParams, None);
    // --- SH2: where the top-down world height map lives, in WORLD space ------------------------
    // gSkyHeight is a camera-following window, so a receiver cannot know its mapping from the
    // texture alone. Publishing it (rather than deriving it from the eye) is what keeps the map's
    // addressing in ONE place: the host snaps the origin to a coarse grid and rebuilds wholesale
    // when the camera leaves it, and because the content is WORLD-LOCKED a rebuild reproduces
    // identical values over the overlap — nothing pops, only the far edge changes. Swapping this
    // for toroidal addressing later changes the host update and the one uv line in skyamb.h.fsl.
    //   xy = ABSOLUTE world XY of the map's (0,0) texel CORNER,
    //   z  = 1 / (world extent) — i.e. uv = (worldXY - origin) * z,
    //   w  = tap COUNT per direction (the cost knob; 0 is treated as 1).
    DATA(float4,   skyAOMap,  None);
    // --- LONG-RANGE sun occlusion (gSunOcc / sunocc.comp.fsl, tasks/lighting.md) -----------------
    // The cascades reach ONE MW cell and return fully lit outside it, so until this landed the whole
    // distant world was unshadowed by construction — a ridge three cells away shadowed neither the
    // ground nor the fog. gSunOcc holds the sun-BLOCKED world Z per texel; a point is lit iff its own
    // z is at or above it, which is one sample and is correct in the air as well as on the ground.
    //
    // It shares gSkyHeight's window, so its ADDRESSING is skyAOMap.xy/.z above — deliberately not
    // duplicated here, because two copies of one origin is exactly how a derived map ends up sampled
    // through the wrong mapping for a frame. The host keeps the two in lockstep by rebuilding this
    // one inside the height map's own rebuild.
    // sunOcc: x = STRENGTH 0..1 (0 = off — the receiver's early-out, the A/B, and the "no map"
    //             signal: night, interior, or not yet built),
    //         y = SOFT transition height in WORLD units. The stored value is a hard boundary and the
    //             map is coarse, so a binary test would draw a stair-stepped shadow line across the
    //             landscape; the ramp runs from blockZ (lit) DOWNWARD, never upward, so the soft
    //             band can only ever lighten and never invents shadow above the blocked height.
    //         z = BIAS in world units, subtracted from blockZ before the compare. The map is
    //             max(terrain, statics) sampled coarsely, so a point standing ON the surface that
    //             generated its own texel would otherwise shadow itself — the height-map equivalent
    //             of depth acne, and fixed the same way.
    //         w = spare.
    DATA(float4,   sunOcc,    None);
    // --- SH2 OVERHANG correction (skyamb.h.fsl) --------------------------------------------------
    // A height map cannot represent that the space under a roof is open — every column reads as solid
    // from -inf up to its stored height — so a point under Baar Dau, on a tower shaft, or beneath an
    // arch is reported near-black when the sky is in fact open toward the horizon in every direction.
    // One point-sampled tap at the receiver's OWN texel detects it: geometry above my head at my own
    // XY proves this column is not solid below its top.
    // x = ramp START in world units of overhead clearance. Below it the map is trusted completely —
    //     a receiver standing ON the surface that generated its own texel reads ~0 here, which is the
    //     overwhelmingly common case and must stay untouched.
    // y = ramp WIDTH in world units over which trust falls from 1 to the floor.
    // z = trust FLOOR 0..1. Not 0: a genuinely enormous overhead blocker really does take a bite out
    //     of the sky, so the correction may lighten toward the truth and never past it. What is left
    //     of the occlusion in that band is GTAO's, which sees the real geometry and is already
    //     multiplied into this same ambient.
    // w = spare.
    DATA(float4,   skyAO2,    None);
    // --- SCENE COLOUR UNITS (tasks/forge-postprocess.md step 6a) ---------------------------------
    // x = 1 when the scene render target is SCENE-REFERRED, 0 when it is DISPLAY-REFERRED.
    //
    // This is the host's folded `g_hdrSceneColor && sampleCount > 1` and NOTHING may re-derive it.
    // Scene-referred and fp16 are ONE switch, not two correlated ones: scene-referred values exceed
    // 1.0 and B8G8R8A8_UNORM would clamp them, which is strictly worse than tonemapping in the pass.
    // Same "one float disarms it at every receiver" idiom as sunParams.x / skyParams.x above — a
    // receiver asks this lane and never asks about a format.
    //
    // Read by tonemapInPass() in skydome.h.fsl, which is where every colour frag now ends: 0 keeps
    // the curve in the pass (today's image, byte for byte), 1 defers it to resolve.frag so the target
    // carries radiance for bloom to read. It lives HERE rather than in gFrameData because that
    // cbuffer is exactly full at its 512 B CBV and its six copies are TRUNCATED at three different
    // lengths — a flag past float 115 would read zero in the reflect-geo pass, which draws
    // statics.frag and terrain.frag. gShadowParams is bound by pointer into every PerFrame set, so
    // one host write reaches all of them.
    // z = THE EXPONENTIAL FOG DISTANCE SCALE (fog.h.fsl), and 0 means MW's linear ramp. One lane
    // holds the mode AND the constant deliberately: an exponential fog with no scale, or a scale
    // with no exponential fog, are both unrepresentable. The host writes
    // `(linearScene && g_fogExp) ? g_fogExpScale : 0`, so the gamma build is byte-identical and the
    // A/B is a dev-panel tick. Ported value 4.4, from the DX9 path (distantland.cpp:818) — see
    // fog.h.fsl for why that constant is the fog WALL's position and fogStart is then free to be
    // the density.
    // w = THE CURVE SELECT (tasks/forge-postprocess.md step 3 / S2). 0 = the legacy semi-HDR cubic in
    // tonemap.h.fsl, 1 = AgX (agx.h.fsl). AgX is the default; the legacy curve is the A/B.
    //
    // ⚠ EXACTLY ONE READER, AND IT READS IT TO DO NOTHING: scenecolor.h.fsl's liftInPass(). Class-2
    // passes (sky, statics_add, statics_blend) write inverseTonemap(authored) so the final curve
    // hands MW's authored value back unchanged — and that inverse is the CUBIC's. Under AgX nothing
    // applies the cubic, so the lift is not preserving a reference, it is pre-distorting the sky by
    // the inverse of a function that no longer runs. This lane is what turns it off.
    //
    // ⚠⚠ ONE HOST EXPRESSION, TWO RECEIVERS — the same house rule as toneParams.x/.y, and here it is
    // the whole design of the A/B. The identical folded bool reaches resolve.frag as
    // gResolveParams.tone.y (which curve to APPLY) and reaches liftInPass() here (whether to
    // PRE-COMPENSATE for it). A frame in which those two disagree renders the sky through half of a
    // transform, so they are not allowed to be two expressions. resolve.frag has a private SRT and
    // cannot see this cbuffer, which is why there are two lanes at all.
    //
    // PREVIOUS TENANT, for anyone following an old comment here: this carried THE AIR-FOG CHANGEOVER
    // DEPTH (fog.h.fsl) — how far below the water plane a fragment stopped carrying its own air ramp
    // — published as waterTrueLevel - waterMeshZ so the two planes could not drift apart. That
    // boundary was deleted 2026-08-15 (a per-PIXEL decision about a pixel holding both dry beach and
    // seabed; no value of it could serve both sample groups). water.frag is a BLENDED surface now,
    // what is behind it arrives per SAMPLE and never gets re-fogged, and the object shaders take the
    // smooth water SHARE instead — see tasks/forge-water-blend.md. The lane sat at 0 for one commit
    // and is re-used here rather than renumbered, because renumbering a published float costs every
    // reader a rebuild to save four bytes.
    DATA(float4,   toneParams, None);
    // --- UNIFIED WATER FOG (waterfog.h.fsl, tasks/forge-water.md) --------------------------------
    // ONE extinction law for the water surface AND for everything submerged under it. Before this
    // the renderer fogged water three incompatible ways — the surface faded toward the XE depth tint
    // on a perpendicular depth, the underwater refraction faded toward the atmosphere on a slant
    // distance, and the seabed itself got MW's per-vertex AIR ramp — so crossing the surface swapped
    // both the colour and the model, and a submerged rock never matched the water above it.
    //
    // waterFogCol: xyz = the fog TARGET, MW's own `UnderwaterColor*w + fogColor*(1-w)` from
    //                    Morrowind.ini [Water] (LIFTED + DECODED host-side exactly like fogColNear —
    //                    it is an authored display-referred colour that reaches the target without
    //                    passing through the curve, so it takes the identical boundary treatment),
    //              w   = extinction coefficient per WORLD UNIT (the host inverts a readable
    //                    visibility-distance knob and folds in the time-of-day density).
    DATA(float4,   waterFogCol,   None);
    // waterFogPlane: x = ABSOLUTE world Z of the water surface, at the TRUE level (WaterLevel - 1) —
    //                    the threshold the client's `underwater` bit itself trips at, so .z below and
    //                    this plane can never disagree about which side the eye is on. Nearly the
    //                    same quantity volFog4.z carries, and deliberately not shared with it:
    //                    volFog4.w is CLEARED when the camera submerges (an air-fog march below the
    //                    surface is meaningless) and this feature needs exactly the opposite,
    //                y = 1 = water fog ACTIVE this frame (cell has water, knob on) — the receiver's
    //                    early-out and the A/B, the same "one float disarms every receiver" idiom
    //                    sunParams.x uses,
    //                z = 1 = the CAMERA is under the surface (whole view ray is in water). ⚠ NOT
    //                    ANDed with the feature toggle: this is GEOMETRY, and it feeds the guard that
    //                    keeps MW's air fog off submerged pixels. It used to carry the toggle, so
    //                    switching the water fog off to isolate it re-admitted atmospheric fog
    //                    underwater — the control arm was the broken one. See waterplane.h.fsl,
    //                w = 1 = this cell HAS a water plane, independent of the toggle AND the camera.
    //                    The per-FRAGMENT air-fog test compares a world Z against .x, and .x is a
    //                    latch that holds stale geometry in a waterless cell; without this the test
    //                    would unfog everything below a plane that is not there.
    DATA(float4,   waterFogPlane, None);
    // --- W7b: absorption on the DOWNWARD LIGHT path (waterfog.h.fsl) -----------------------------
    // Same medium, same Beer-Lambert law, applied to the light on its way IN rather than to the view
    // ray on its way out — "absorption is both ways". A submerged surface is therefore dimmer and
    // bluer because of WHERE IT IS, not because of where the camera is, which is the whole point:
    // both MW (x0.19..0.35 on sun+ambient) and OpenMW (an underwater fog ramp starting BEHIND the
    // camera, 60-75% opaque at zero distance) apply a flat, depth-independent, camera-dependent
    // tint instead. W7a cancels MW's; this replaces it.
    //
    // xyz = PER-CHANNEL extinction per world unit for light. Not a second calibration: it is the
    //       view coefficient (waterFogCol.w) times the spectrum of MW's own [Water] UnderwaterColor,
    //       read as a transmittance and inverted — sigma = -ln(UnderwaterColor), normalised to unit
    //       mean so the knob still owns the overall rate and the ini owns only the colour. The
    //       cross-check that this is the right reading: that normalised spectrum lands within ~6% of
    //       the tint MW itself applies (measured), so an authored colour and a hand-picked tint agree
    //       about how fast water eats red.
    // w   = strength 0..1. 0 = transmittance exactly 1, i.e. bit-identical — the A/B.
    DATA(float4,   waterFogLight, None);
    // --- W8: VOLUMETRIC in-scatter (waterfog.h.fsl) ----------------------------------------------
    // The lanes above describe a medium that only ever REMOVES light. That is why the water colour
    // had to be authored: with nothing putting light back, there is no colour to derive. Splitting
    // extinction into its two physical halves is what makes the colour fall out instead of being
    // picked, and it is the same split that makes the in-scatter a RAY integral rather than a
    // per-fragment evaluation — see waterfog.h.fsl for the derivation and for why the integral is
    // closed-form (the depth profile along a straight ray is LINEAR, so the integrand is a single
    // exponential; volfog has to march only because its density is exponential in height).
    //
    // waterFogExt: xyz = TOTAL extinction sigma_t per world unit (absorption + scattering). This is
    //                    the one spectrum the whole medium runs on: the view beam, the downward sun
    //                    beam and the ambient path all attenuate by it, so nothing can disagree
    //                    about how fast water eats red,
    //              w   = VOLUMETRIC strength 0..1. 0 = the fade-toward-a-target model above,
    //                    bit-identical, including waterLightTransmit's spectrum (which lerps between
    //                    waterFogLight.rgb and this one on exactly this lane). The A/B.
    DATA(float4,   waterFogExt,     None);
    // waterFogScatter: xyz = SCATTERING coefficient sigma_s per world unit. sigma_s <= sigma_t by
    //                        construction, and their ratio sigma_s/sigma_t is the single-scattering
    //                        albedo — which IS the colour of deep water, because that ratio is
    //                        exactly what an infinitely long ray converges to,
    //                  w   = in-scatter GAIN. The one calibration constant in the model: the
    //                        derived colour's HUE matches MW's authored UnderwaterColor to ~8%, but
    //                        its magnitude does not, because "sun colour" here is a radiance the
    //                        engine never defined an irradiance for.
    DATA(float4,   waterFogScatter, None);
    // waterFogPhase:  x = forward-lobe HG g, y = forward gain, z = back-lobe g (signed), w = back gain
    DATA(float4,   waterFogPhase,   None);
    // waterFogPhase2: x = isotropic pedestal (also the stand-in for the multiple scattering a
    //                     single-scattering integral cannot see — in a medium this dense that is
    //                     most of the side-scatter),
    //                 y = phase soft ceiling (Reinhard knee on the lobes),
    //                 z = multiple-scattering ISOTROPISATION strength, 0..1. The pedestal in .x is a
    //                     constant; this is the part that has to depend on the PATH, because whether
    //                     a lobe applies at all is a question about optical depth (waterColumn). 0
    //                     reproduces the pre-W8d build exactly,
    //                 w = spare.
    DATA(float4,   waterFogPhase2,  None);
    // waterFogKd: xyz = the DIFFUSE attenuation coefficient K_d per world unit, for the DOWNWELLING
    //                   light path ONLY — how fast the light getting DOWN here dies, which is not how
    //                   fast a beam ACROSS here dies. w = the A/B strength the host already folded
    //                   into xyz, published for readout; at 0 the host writes sigma_t here verbatim
    //                   and every consumer is bit-identical to the pre-W8e build.
    DATA(float4,   waterFogKd,      None);
    // --- S3a SCENE CALIBRATION (tasks/forge-postprocess.md) --------------------------------------
    // x = material EMISSIVE gain. 1.0 = today's image, byte for byte.
    //
    // The linear migration is exact on products and moves every sum, so what it broke is the RATIO
    // between the terms that are summed — ambient, sun, and the self-illuminated term. A tonemap
    // curve cannot restore a ratio and neither can an exposure servo; both rescale a total. Hence a
    // calibration, and hence it is separate from exposure rather than folded into it.
    //
    // ONLY emissive rides a lane. Sun and ambient are folded into gFrameData.sunCol/ambCol host-side
    // at their single decode site, which reaches more passes than a lane could — every truncated copy
    // of gFrameData inherits them. Emissive arrives per-instance in the vertex stream and cannot be
    // caught at one host site, and on vColSource 1 meshes the emissive term IS In.Color.rgb, which
    // the vertex stage cannot distinguish from the modulating vertex colour of a vColSource 0/2 mesh.
    // Only the frag knows which branch it is in, so only the frag can apply this.
    //
    // ⚠ NOT dbgScales. That one is a diagnostic whose PARTIAL reach (four passes) is the feature —
    // it shows what Forge does not draw. A calibration has to be total or it steps at the near/far
    // handover. Read the note beside g_calSunGain before merging them.
    // y = THE EXPOSURE SERVO'S VALUE, E — live since P2b, and this is the lane the comment above
    //     reserved for it. Written from the SAME folded expression the resolve reads
    //     (`(sceneReferred && expEnable) ? g_exposure : 1.0`), from one host site, precisely so the
    //     pass that MULTIPLIES by E and the pass that DIVIDES by it can never disagree about which E
    //     — a moon pinned against a different E than the resolve applies drifts with the servo, and
    //     the drift would be slow enough to read as "the moons look a bit off tonight".
    //     ⚠ ALWAYS >= a tiny floor, never 0: it is a divisor now.
    // zw spare.
    //
    // ⚠ z BRIEFLY CARRIED THE SKY'S PHOTOMETRIC ANCHOR (P1, tasks/forge-physical-sky.md) — a
    // per-frame scale sky.frag multiplied MW's authored sky by, so the sky sat at the physical level
    // for the light MW said it cast. P2 retires the reproduction outright: skyhw.frag GENERATES the
    // sky from a Hosek-Wilkie radiance field that also supplies the sun and the ambient, so there is
    // no authored sky left to anchor. The host writes 0 there now, which is obviously not a scale —
    // a lane left at 1.0 would read as a live identity multiply and invite the next reader to "fix"
    // it. Do NOT resurrect a sky scale here: the physical sky's lanes live in gSkyView
    // (skyview.h.fsl) on a PER-VIEW cbuffer, precisely because THIS struct is bound by POINTER into
    // every PerFrame set and so cannot carry anything the mirror needs a different value of.
    DATA(float4,   calParams,       None);
    // --- P2b: THE ARMED DISPLAY CURVE, so a colour pass can UNDO it ------------------------------
    // The moon pin needs agxInverseNeutral() (agx.h.fsl), and that needs the same three float4s
    // resolve.frag's own private cbuffer carries. They are duplicated HERE rather than reached for
    // there because gResolveParams is a different SRT that a colour frag cannot see, and because
    // gShadowParams is bound by pointer into every PerFrame set — one host write, every consumer.
    //
    // ⚠ WRITTEN FROM THE SAME HOST EXPRESSIONS AS gResolveParams.curve/curveScale/look. Two copies
    // of a curve is exactly how a pass ends up inverting a curve nothing applies; the host writes
    // both from one place for that reason, and the self-test's CLOSED-FORM gate is what proves the
    // inverse still matches the forward after a slider moves.
    //
    // agxCurve      = (slope, toePower, shoulderPower, ARMED) — .w mirrors toneParams.w so a reader
    //                 that has only this float4 can still tell whether AgX is the running curve.
    // agxCurveScale = (toeScale, shoulderScale, pivotX, pivotY) — both scales computed host-side,
    //                 because agxScaleF() returns NaN outside its domain and a NaN survives every
    //                 later multiply including one by zero ([[project_nan_survives_zero_multiply]]).
    // agxLookParams = (slope, power, sat, offset), in agxLook()'s own argument order. sat is carried
    //                 for completeness and is identically a no-op on the neutral axis.
    DATA(float4,   agxCurve,        None);
    DATA(float4,   agxCurveScale,   None);
    DATA(float4,   agxLookParams,   None);
    // W12 — WHAT THE SUN'S BEAM LOSES CROSSING THE SURFACE.
    //   x = strength of the entry term (0 = the pre-W12 image, bit for bit; 1 = the full factor)
    //   y,z,w spare.
    //
    // The factor itself is derived in waterColumn from sunDir alone, so only the A/B weight has to
    // travel. APPENDED at the end of the struct on purpose: every offset above it is referenced by
    // a host constant, and this cbuffer is bound BY POINTER into every PerFrame set, so a field
    // inserted anywhere else would move a lane that some pass reads by index.
    DATA(float4,   waterFogSun,     None);
    // W22 — THE REFRACTION DISTORTION'S ANGULAR FORM.
    //   x = angMix: 0 = the legacy `(windFactor*dist + 0.1)` amplitude, bit for bit; 1 = the
    //       angular one, `(1 - 1/n) * focalPx`, which is CONSTANT in pixels with distance.
    //   y = gain, a multiplier on whichever amplitude x selects (1 = as derived).
    //   z = W22h: how much of the refraction is taken as the surface's OWN term rather than as the
    //       blend's destination once the offset exceeds ~1 px. 0 = the pure residual (today, bit for
    //       bit); 1 = the destination is released where the offset has weight, so no cancellation
    //       has to be exact and no resolve-operator mismatch can leave a rim at a silhouette.
    //   w spare.
    //
    // Only the A/B weight and the gain travel: focalPx is measured in the shader from
    // length(ddy(rayDir)) and n is a shader constant, so there is nothing here for the host to get
    // out of step with. APPENDED after waterFogSun for the reason that field states — every offset
    // above is a host constant into a cbuffer bound BY POINTER into every PerFrame set, so a field
    // inserted anywhere else moves a lane somebody reads by index.
    DATA(float4,   waterDistort,    None);
    // W23 — CAUSTICS (caustic.srt.h, consumed in waterLightTransmit).
    //   x = strength. 0 = the pre-W23 image exactly; the consumer's whole block is behind `x > 0`.
    //   y = 1 / tileWorldUnits, so the consumer multiplies rather than divides.
    //   z,w = the LOG-depth slice map: sliceIndex = z*log2(depth) + w, FADED (not clamped) outside
    //       [0, SLICES-1]. The slice depths are geometric (W26: 32/80/200/500/1250), so a linear map
    //       would spend three quarters of its range between the last two and jump through the
    //       shallow ones — which is exactly where the depth evolution is fastest and most
    //       recognisable. Solved host-side from the first and last slice depth so the two cannot
    //       disagree about the spacing, which also means the ladder's TOP entry is where the static
    //       caustics end: 3125 units (45 m) as of W26, where blue is down to 6% of the surface.
    // Appended after waterDistort for the reason every field down here carries: this cbuffer is
    // bound BY POINTER into every PerFrame set and each offset above is a host constant, so a field
    // inserted anywhere else moves a lane somebody reads by index.
    DATA(float4,   waterCaustic,    None);
    // W23 — CAUSTICS, second lane.
    //   x = the DISPERSION offset for BLUE, as a UV shift PER UNIT DEPTH along the sun bearing.
    //       ⚠ This was a depth-axis offset first, and that was algebraically right and visually
    //       wrong. n(lambda) enters the refraction only through c = 1 - 1/n, which multiplies the
    //       DEPTH and nothing else, so red's caustic really is this pattern at a slightly shallower
    //       effective depth — but reading it that way needs the stored slices close enough that the
    //       pattern between them is a TRANSLATION, and ours are 1.17 octaves apart, across which the
    //       map completely re-folds. Offsetting the blend fraction crossfaded two decorrelated
    //       patterns: chromatic noise of the right magnitude and the wrong kind.
    //       Now it is the real thing, (c_B - c_G)*D*grad(h), with the sun bearing standing in for
    //       grad(h) (which lives at the beam's source and no destination texel knows). Red takes
    //       -0.441x of this — the true (c_R-c_G)/(c_B-c_G), since n is not symmetric about green.
    //       Magnitude rides slopeRms host-side, so rougher water disperses more; the GAIN is an
    //       exaggeration by necessity, because the true 1.8% spread is under a tenth of a texel.
    //   y = W26 — the CAMERA-DISTANCE fade, as the FRACTION of max(lodParams.w, 4096) the caustics
    //       fade out over: causticDistFrac * waterDistortFrac. The consumer rebuilds the distance
    //       the way water.frag.fsl:768 does and fades over 0.5*dFar -> dFar.
    //       ⚠ A FRACTION AND NOT A DISTANCE, ON PURPOSE. What hides the tiling layer's repeat is
    //       water.frag's UV distortion, and that fades on exactly this schedule — so the caustic has
    //       to end where the thing hiding it ends ("in the distance the caustics become apparent").
    //       Publishing a baked distance would drift from it the moment nearViewRange moved; sharing
    //       the fraction means the two expressions cannot disagree, and waterDistortFrac = 0 ("the
    //       distortion is unbounded") reads correctly as "no caustic distance fade" as well.
    //       0 therefore means NO FADE, not "faded out" — the consumer branches on dFar > 0.
    //   z = W26 — the WAKE layer's max depth in world units (default CAUSTIC_WAKE_MAXDEPTH = 350,
    //       i.e. 5 m); the deviation is scaled by min(depth, this)/CAUSTIC_WAKE_DEPTH and faded to
    //       nothing over this -> 1.5x this.
    //   w = W26 — the RIPPLE layer's max depth, same arrangement (default CAUSTIC_RIPPLE_MAXDEPTH =
    //       70, i.e. 1 m). ⚠ BOTH ARE CLAMPED POSITIVE HOST-SIDE: the consumer's smoothstep(m, 1.5m,
    //       depth) divides by 0.5*m, so a zero here would be a NaN on every submerged fragment.
    //       (A consumer-side domain warp lived in y/z briefly, to hide the tile. It was removed:
    //       hiding a repeat by shearing the lookup trades a periodic artefact for a smeared one, and
    //       the smear was the worse of the two. The tile gets broken properly by the DYNAMIC caustic
    //       layer instead — ripples and wakes splatted into a second, camera-anchored map that has
    //       no period at all — and, since W26, by ENDING where the distortion that hides it ends.)
    // Appended after waterCaustic for the reason every field down here carries: this cbuffer is
    // bound BY POINTER into every PerFrame set and each offset above is a host constant, so a field
    // inserted anywhere else moves a lane somebody reads by index.
    DATA(float4,   waterCaustic2,   None);
    // ─── W24 — THE DYNAMIC CAUSTIC LAYERS (causticdyn.comp.fsl) ─────────────────────────────────
    // Two camera-anchored maps splatted from the LIVE wave fields, composited over the tiling one by
    // MULTIPLICATION. That is first-order exact and not a fudge: total displacement is the sum of
    // the layers' displacements, so J = I + A + B ~= (I+A)(I+B), and determinants multiply — which
    // means the GAINS multiply. Independent mean-1 fields multiply to a mean-1 field, so the
    // exposure servo does not move (`w/l` in the APL split is the check).
    //
    // ⚠ THE DOMAINS ARE WORLD-ANCHORED AND FINITE, which is the whole difference from the tiling
    // map: there is no wrap, so a fragment outside the window gets the identity and the consumer
    // fades the last eighth in. Same arrangement water.frag makes for the wave fields themselves.
    //   xy = domain origin, EYE-RELATIVE (the frame is camera-relative; an absolute origin here
    //        would lose precision far from the world origin and make the caustics swim)
    //   z  = 1 / (world units per destination texel)
    //   w  = the map's size in texels (CAUSTIC_RES)
    // Both are zeroed when their layer is off, and the STRENGTH below is what actually disarms the
    // consumer — a zero domain would divide, a zero strength branches out.
    DATA(float4,   waterCausticRip,  None);
    DATA(float4,   waterCausticWake, None);
    // x = RIPPLE strength, y = WAKE strength. 0 in either disarms that layer's whole block and
    //     leaves its factor at exactly 1.0 — which is what makes "dynamic off is pixel-identical to
    //     the W23 build" a claim that can be checked rather than argued.
    // z,w = the RIPPLE layer's LOG-depth slice map, exactly as waterCaustic.zw is for the static
    //     one: sliceIndex = z*log2(depth) + w over its two depths, solved host-side from the first
    //     and the last so the spacing cannot be described two ways.
    //
    // ⚠ THE WAKE LAYER HAS NO SLICE MAP AND NEEDS NO LANE FOR ONE. It is generated at a single
    // reference depth (CAUSTIC_WAKE_DEPTH, shared with the host through caustic.h.fsl) because wake
    // wavelengths of 90-200 units do not fold until ~700-950 units of water: the whole playable
    // range is PRE-FOCUS, where the deviation is LINEAR in depth. `dev * depth /
    // CAUSTIC_WAKE_DEPTH` is therefore exact to first order for one tap, and the reference depth
    // cancels out of that expression — which is why it is a constant and not a knob.
    //
    // ⚠ W26: THE DEPTH SCALE IS WINDOWED, AND THE WINDOW LIVES IN waterCaustic2.z. What licenses
    // "linear in depth" is being pre-focus, and that argument expires — past ~5 m the expression is
    // amplifying a pattern stored at 256 units rather than describing the wake, which is what
    // "looks aliased after 5 m" was. The old `clamp(..., 0, 4)` was not that bound: it only binds
    // past 1024 units, so it let the deviation grow to 4x while the structure stayed put.
    DATA(float4,   waterCausticDyn,  None);
    // ─── W26a — HOW DEEP THE CAUSTIC PATTERN PHYSICALLY SURVIVES ────────────────────────────────
    // x = d0, world units: the consumer scales the composited deviation by exp(-(depth/d0)^1.27).
    //     0 disarms the decay. yzw spare.
    //
    // ⚠ THIS IS THE ANSWER TO "CAUSTICS SHOULD REACH ANY DEPTH LIGHT REACHES", AND THE ANSWER IS
    // THAT LIGHT AND STRUCTURE DO NOT REACH THE SAME DISTANCE. At the shipped extinction defaults a
    // seabed at 806 units still gets 49% of the surface's blue light — but the light arriving there
    // has been forward-scattered into a beam ~37 world units wide, and a pattern whose filaments are
    // ~17 units across does not survive that. Measured contrast against an unblurred field: 53% at
    // 200 units, 19% at 500, 10% at 800, 2% at 1250. The caustic is gone by ~800 units (11 m) in
    // this water while the LIGHT goes on for another 40 m, and the two were being confused.
    //
    // d0 = (L / k)^(2/3), k = sqrt(sigma_s*<theta^2>/3) from the water model and L the pattern's own
    // structure scale, which rides the caustic tile. Deriving it rather than tabling it is what
    // makes the reach follow the water: raise the murk and the caustics stop shallower, on their own.
    // W27c — y = THE STATIC (calm-water) LAYER'S GATE, 1 or 0. Split out of waterCaustic.x, which
    // is the MASTER over all three layers: carrying "the surface has no waves" in the master meant
    // that flattening the calm water to isolate a wake switched the wake off with it. A mirror casts
    // no CALM-water caustic, but a swimmer still deforms the surface at amplitude 0 — water.frag ADDS
    // the ripple and wake slopes to the base normal, so they survive a flat base field. zw spare.
    DATA(float4,   waterCaustic3,    None);
    // ─── W28b: THE WATER CUT'S OWN LANE ─────────────────────────────────────────────────────────
    // x = the GLASS BOX'S HEIGHT in world units. The cut is a box around the eye: waterDistort.w is
    //     its horizontal size, which never varies, and this is its height. The cut is on while the
    //     eye is within this far above the water and off above it, at full size either way — so a
    //     thin box is crossed in a frame or two and the hole appears AT ONCE rather than growing in.
    // ⚠ THIS IS THE ONLY THING THAT DECIDES THE SWITCH-ON HEIGHT, and keeping that away from the
    //   radius is the whole lesson of W28/W28b. A strength fade makes the cut PARTIAL, and a partial
    //   cut is a blend of the surface with what is behind it, so it keeps a fraction of the
    //   surface's REFLECTION — which the premise of the cut says is not there. A radius floor is
    //   worse: the disc opened on the water plane has radius sqrt(R^2 - above^2) and is empty until
    //   R exceeds the eye's height, so a floor silently BECOMES the switch-on height. Size and
    //   activation are separate questions. The cut's strength is 0 or 1, never between. yzw spare.
    DATA(float4,   waterCut,         None);
    // ─── W32: A SUBMERGED LAMP IS A CAUSTIC PROJECTOR ───────────────────────────────────────────
    // x = the strength of the TIR-mirror caustic gobo a light BELOW the surface casts on the world
    //     below it (waterfog.h.fsl, causticProjector). 0 = the feature is off and the image is
    //     bit-identical to the pre-W32 build: the helper returns exactly 1.0 and every call site
    //     multiplies by a literal one.
    // y = W33, the same lamp's ABOVE-water half. Rays leaving it INSIDE the 48.6 deg Snell cone
    //     refract OUT instead of reflecting back down, so this is the pattern on walls and ceilings
    //     beside the water — the pool-house look. Deflection kRefrDevWater (0.3333) against the
    //     mirror's 2.0, which reads the same slices over air paths of 24..936 units. 0 gives back
    //     exactly the W32 build.
    // z = W34, a lamp sitting ABOVE the water refracting DOWN INTO it, focusing on the bottom. This
    //     is the SUN's own mechanism from a point source — deviation kRefrDevAir, the sun's constant,
    //     so D_eff is exactly the path length and the reach is the ladder's own 32..1250 units. It is
    //     the caustic everybody can name, and it is what most authored (often FIXTURELESS) lights
    //     beside water actually need. 0 = off.
    // ⚠ THE LANE IS PICKED BY WHICH SIDES THE LIGHT AND THE FRAGMENT ARE ON, and only one can ever
    //   apply to a given pair: lamp under + frag under = x, lamp under + frag above = y, lamp above +
    //   frag under = z, and both above has no surface between them at all. All three meet at gain 1.0
    //   exactly on the waterline, so every seam is C0 with nothing to cross-fade.
    // ⚠ IT ALSO CARRIES THE MASTER GATE. The projector reads the SAME static/ripple/wake slices the
    //   sun path does, so it must not run while the map is unready or the flat test is on. The host
    //   folds `on` (causticOn && causticReady && !flatTest) into this lane rather than making the
    //   consumer read two, because a second gate is a second thing that can be published wrong.
    // ⚠ NOT A PER-LIGHT LANE, AND THERE IS NOWHERE TO PUT ONE. PointLightWire::color[3] LOOKS free
    //   (every frag reads only .rgb) but carries packLightIdFlags(), which the host shadow manager
    //   reads back out of the cbuffer. None is needed: "this light is underwater" falls out of
    //   posR.z against waterFogPlaneRelZ(), both already camera-relative.
    // w spare. Appended at the END for the reason every field down here states: this cbuffer is
    // bound BY POINTER into every PerFrame set, so an insertion anywhere else moves a lane somebody
    // reads.
    DATA(float4,   waterCausticProj, None);
    // ─── G1: GRASS ──────────────────────────────────────────────────────────────────────────────
    // xy = MW's WIND VECTOR, EWMA-smoothed client-side and shipped whole (lighting[36..37]). The
    //      client used to ship only |wind| (for the flame flicker); grass needs the DIRECTION, so
    //      the vector is the wire quantity now and the host derives the magnitude back off it.
    // z  = the wind CLOCK: MW SIMULATION seconds wrapped to [0, 4).
    //      ⚠ THE WRAP AND THE MOTION RATES ARE ONE DECISION. A wrapped clock is seamless only when
    //      every rate turns a WHOLE number of cycles over the wrap period. grass.vert's wind term
    //      runs at pi and 1.5*pi rad/s and its underwater term at 0.5*pi and 1.5*pi, so the shortest
    //      period all four close on is 4 seconds (2, 3, 1 and 3 turns respectively). timeParams.x
    //      cannot be reused: it wraps at 12.5 s (one V cycle of the ghostfence scroll), a multiple of
    //      none of them, so every wrap would step the whole field at once.
    //      ⚠ This is also why grass.vert spells pi exactly where the reference shader wrote 3.14 —
    //      with the truncated constant none of those rates closes and the wrap is a visible jump.
    //      [[project_wrapped_time_needs_snapped_omega]]
    // w  = sway GAIN, over BOTH the wind and the underwater terms. 1 = the reference's amplitude;
    //      0 = the field stands perfectly still, which is the isolation lever that separates a
    //      motion problem from a placement or lighting one.
    DATA(float4,   grassParams,      None);
    // x  = fade START distance (world units); coverage is full inside it.
    // y  = 1 / (fadeEnd - fadeStart), or 0 to disable the fade (a hard cull edge — MGE's pop).
    //      ⚠ THE FADE RIDES THE A2C COVERAGE, NOT THE COLOUR. Grass is a cutout, so thinning the
    //      sample mask dissolves the blades, where dimming them would lay a grey haze over ground
    //      that is meant to be showing through.
    // z  = the alpha reference, and it is ONE number where MGE had two. MGE discarded at 64/255 and
    //      centred its fixed-RATE coverage ramp at 128/255; a2c.h.fsl's ramp is fwidth-normalised,
    //      so it is one pixel wide about the reference by construction — the 50% contour IS the
    //      silhouette and a second, lower kill threshold has nothing left to do (the mask already
    //      reads 0 well below it). statics.frag's 133/255 is not inherited either: that is the
    //      distant-statics number, and grass is authored against 128.
    // w  = UNDERWATER CURRENT strength, in the same units the wind term's lean comes out in.
    //      Its own knob and NOT derived from |wind|, because that is the whole point: wind does not
    //      reach below the surface, so a gale must not bend the seaweed. 0 stills submerged growth
    //      while leaving the shore grass blowing, which is the A/B for this half on its own.
    DATA(float4,   grassParams2,     None);
    // The enhanced shader's distance LOD, which SINKS a blade into the ground as it recedes rather
    // than cutting it — distant grass gets shorter instead of vanishing, and grass.frag's coverage
    // dissolve finishes off whatever is still poking out.
    // x  = sink DEPTH in world units at the far end of the band (0 disables the sink entirely,
    //      leaving the coverage dissolve as the only LOD — the A/B).
    // y  = how far the per-blade noise may pull a blade's sink distance TOWARD the camera, in world
    //      units. This is what stops the LOD edge being a clean circle centred on the player.
    // z  = the vertex-colour FLAG arm, 0..1. 1 = honour the authored red channel (0 = rigid prop,
    //      1 = foliage); 0 = treat every subset as foliage, which is stock's behaviour and the
    //      fallback for a groundcover pack that never painted the channel.
    // w  = the sink band's WIDTH in world units; it starts where the coverage fade starts
    //      (grassParams2.x) so the two halves of the LOD act over the same stretch.
    DATA(float4,   grassParams3,     None);
    // x = per-blade VALUE (albedo) spread, 0..1 — 0 is the flat field, ~0.15 is a normal sward.
    // y = per-blade HUE spread along the dry<->lush axis, 0..1. Both are mean-preserving: they widen
    //     the distribution about the authored colour and never move its centre, so neither can drag
    //     the exposure servo. See grass.vert::grassTint, which also documents why the axis is one
    //     dry<->lush line rather than a hue rotation.
    // z = grass sun-shadow RECEIVER MODE: 0 = none, 1 = one-tap moments (default), 2 = full PCSS.
    //     Its own arm because grass.frag's receiver call is paid once per OVERDRAWN LAYER of a dense
    //     field — the pass exports SV_Coverage and discards, so it cannot early-reject an occluded
    //     fragment — and PCSS is ~28 taps. Measured at 2,928 clumps: 4.63 ms with PCSS, 1.11 ms with
    //     no receiver at all, i.e. the receiver was 76% of the whole grass draw. Mode 1 keeps the
    //     shadow and spends one tap on it; see grass.frag for why a blade cannot show a penumbra.
    // w = SHADOW SAMPLE DROP in world units — how far below the fragment grass reads the sun
    //     shadow, so the field carries the GROUND's shadow instead of one displaced by its
    //     own height times tan(zenith). ~= mean blade height. 0 = sample at the blade.
    DATA(float4,   grassParams4,     None);
    // x = CONTACT-AO strength at the root, 0..1, scaled per blade by its own tile's canopy
    //     density (the third 8-bit field in the instance's variation code). AMBIENT ONLY —
    //     a low sun shines THROUGH a field horizontally and lights the roots directly, so
    //     darkening the sun half would black out exactly the grass that should blaze at dawn.
    // y = 1 / the model-space height over which that darkening lifts to full.
    // z = grass receives clustered POINT LIGHTS, 0/1. Affordable where the PCSS receiver was
    //     not, because an empty froxel costs nothing and a daylit exterior is nearly all empty
    //     froxels — see pointlights.h.fsl. Measure it at NIGHT, not at midday.
    // w = grass cast-shadow OPACITY, 0..1. 1 = the solid silhouette every other static casts;
    //     below that, sunshadow_statics.frag drops that fraction of grass's caster fragments
    //     (dithered on UV, which is mesh data and so cannot swim as the camera moves) and the
    //     map records PARTIAL occlusion, which the moments blur and cascade 0's PCSS filter
    //     into a partial shadow. ⚠ It has to be stochastic: measured on this bake's
    //     groundcover the alpha is BINARY (84% at 0, 16% at 255, ~0.1% between), so raising
    //     the caster's alpha reference instead would thin it by 0.0%.
    DATA(float4,   grassParams5,     None);
    // ─── G7: GRASS PLASTICITY — the crush field's consumer lanes (grasscrush.srt.h) ────────────
    // xy = the crush domain's origin, EYE-RELATIVE, in world units. grass.vert samples at the blade
    //      ROOT (In.W3.xy), which is camera-relative like everything else in the instance stream, so
    //      an absolute origin here would cost a subtraction of two ~200,000-unit floats to get back
    //      to a number a few hundred units wide ([[project_forge_precision_far_origin]]).
    // z  = 1 / (unitsPerTexel * grid), i.e. world units -> [0,1] uv across the whole domain.
    // w  = (crushOriginZ - lodEye.z): the snapped Z the field's .x is stored RELATIVE TO, expressed
    //      camera-relative for the same reason xy is. Snapped to a 512-unit grid so the re-bias fires
    //      only on a boundary crossing — see grasscrush.srt.h for why absolute Z cannot be stored in
    //      an fp16 texture at Vvardenfell's scale.
    DATA(float4,   grassParams6,     None);
    // x = BEND GAIN over the fold. 1 = a fully crushed blade lies flat (theta = pi/2); below that it
    //     is only pressed over. The fold is length-preserving by construction (sin/cos), so this
    //     moves the ANGLE and never the blade's length.
    // y = SINK fraction: extra retraction at full crush, as a fraction of the blade's own height, so
    //     the folded mat sits below the body pressing it rather than draping over it.
    // z = the master ARM, 0/1. grass.vert branches on it rather than multiplying by it — a cbuffer
    //     lane is wave-uniform at runtime but is NOT a compile-time constant, so a multiply would
    //     still pay the texture fetch on every grass vertex of every frame, in the caster pass too
    //     ([[project_uniform_branch_is_not_free]]). 0 restores the pre-G7 image exactly.
    // w spare. Appended at the END for the reason every field down here states.
    DATA(float4,   grassParams7,     None);
    // G7e/f — THE SPRINGBACK, as the STEP RESPONSE OF A DAMPED SECOND-ORDER SYSTEM. The field's .w is
    // a RELEASE ENVELOPE (1 while a crusher sits on the texel, falling linearly to 0 as the imprint
    // heals), so u = 1 - w is normalised time since release and the whole thing evaluates in the
    // vertex shader with no state and no second texture. See grass.vert's fold.
    // x = PLASTIC fraction: how much of the press is still there once the spring has settled. This is
    //     also what sets the spring's AMPLITUDE, because the elastic part is the rest of it
    //     (cHeld - plastic*cHeld) — the two are one number, not two.
    // y = damped angular frequency wd, PER UNIT u (= wd * healTime), so the shader never needs
    //     healTime.
    // z = the decay rate zeta*wn, per unit u. The ratio z/y is the damping ratio's contribution.
    // w = zeta*wn / wd — the coefficient on the sin term of the step response. ⚠ That term is what
    //     makes the release start from REST: without it the response is a bare exp*cos whose
    //     derivative at t = 0 is -1/tau, i.e. the blade JERKS the instant it is freed instead of
    //     accelerating out of a standstill, which is the difference between a spring and a snap.
    DATA(float4,   grassParams8,     None);
};
