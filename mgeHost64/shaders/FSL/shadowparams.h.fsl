// mgeHost64 — shared point-light shadow SLOT params.
//
// The ShadowMaskParams cbuffer describes every ACTIVE shadow slot (camera-relative light
// pos/radius, its 3x2 cube-face atlas tile, bias/flicker state). Two consumers read it:
//   - shadowmask.comp  (ShadowMaskSrtData) — the once-per-frame screen-space mask pass.
//   - opaque.frag      (SrtData, PerFrame gShadowParams) — the FIRST-PERSON direct-atlas path,
//     which samples the cube atlas straight from the interpolated world pos + vertex normal
//     (the screen mask reconstructs the WORLD behind the arm, not the arm itself).
// Factored here so both share ONE definition — the cbuffer bytes are identical, so the host
// binds the SAME pShadowMaskParamsCbv to either root signature.
#pragma once

#define MAX_SHADOW_SLOTS 32   // MUST match host kMaxShadowLights (forgerender.cpp)

// SUN (directional) shadow CASCADE count. MUST match host kSunCascades (forgerender.cpp) — it sizes
// the matrix array below, so a mismatch silently shifts every float offset publishSunShadowParams
// writes. Cascades are CONCENTRIC camera-centred ortho boxes at increasing half-extent, packed side
// by side into ONE moments atlas (cascade c owns u in [c/N, (c+1)/N]) so every receiver keeps its
// single gSunMoments binding and no PerFrame set has to grow.
#define SUN_CASCADES 2
// PER-CASCADE tile resolution. MUST match host kSunShadowRes (static_asserted there). Needed in the
// shader only by the near cascade's PCSS/PCF, which works in TEXELS and therefore has to know the
// atlas's pixel grid — the moments receiver is pure uv and never cared.
#define SUN_SHADOW_RES 2048

STRUCT(ShadowMaskParams)
{
    DATA(float4x4, invViewProj,  None);   // inverse of the reverse-Z camera-relative viewProj
    // maskParams: x = shadow TEST RANGE in light radii (live knob, host g_shadowRangeK; 2.0 =
    //             the atlas far plane = old behaviour). Range cull + slot test use it; the
    //             refZ depth mapping always uses farZ = 2r (the atlas render far plane),
    //             y = face near plane (world u),
    //             z = relative reverse-Z compare slack (acne knob, live-tunable),
    //             w = debug mode (0 off, 1 face-id nibble, 2 atlas-depth view)
    DATA(float4,   screenParams, None);   // xy = screen w,h ; zw = 1/w, 1/h
    DATA(float4,   maskParams,   None);
    DATA(float4,   slotPosRad[MAX_SHADOW_SLOTS], None);   // xyz = camera-relative light pos, w = radius (far = 2r)
    DATA(float4,   slotTile[MAX_SHADOW_SLOTS],   None);   // xy = 3x2 face-block origin (atlas px), z = face size (px), w = temporal fade-in
    // biasParams: x = ABSOLUTE reverse-Z compare bias (contact/interpenetration knob, live).
    //             y = NORMAL-OFFSET bias in atlas texels (live).
    //             z = base-rate flame phase (diagnostic only).
    //             w = BASE flicker wobble amplitude in radians (0 = off), scaled per slot by slotFlick.x.
    DATA(float4,   biasParams,   None);
    // slotBits: the 32-bit slot masks as REAL uints (float lanes drop bits >= 24).
    //             x = ACTIVE-slot bitmask, y = DYNAMIC-slot bitmask (valid dyn tile this frame),
    //             z = FLICKER-class bitmask, w = SOFT bitmask (reduced-res tile).
    DATA(uint4,    slotBits,     None);
    // Per-slot flame state (flicker slots only). x = wobble amp gain, y = flame phase (rad),
    // z = the face-frustum uvScale this slot's tile was BAKED with (< 1 = wider than 90°), w = spare.
    DATA(float4,   slotFlick[MAX_SHADOW_SLOTS], None);
    // --- SUN (directional) CASCADED shadow, Phase B/C receiver (forge-sun-shadows.md) ----------
    // Per-cascade sun MSM ortho view*proj, CAMERA-RELATIVE (eye at origin) — the same matrices the
    // caster pass projected by, so every receiver reconstructs the identical mapping. They live HERE
    // rather than in FrameData because FrameData is exactly full at its 512B CBV, while this cbuffer
    // has room — and it is already bound into every PerFrame set AND the compute mask, so one write
    // reaches all receivers. Same convention as gFrameData.viewProj:
    // mul(M, worldPos) == D3DX row-vector worldPos*M.
    // Every cascade shares ONE depth slab (half-extent 2*outermost range) so a caster high up-sun is
    // inside all of them and the NORMALISED depth — hence the single depth bias below — is cascade-
    // independent. Only the two axes perpendicular to the sun shrink per cascade.
    DATA(float4x4, sunViewProj[SUN_CASCADES], None);
    // sunParams: x = shadow STRENGTH 0..1 (0 = sun shadows OFF — the receiver's early-out, so the
    //                whole feature A/Bs from one float; also the "no map this frame" signal),
    //            y = depth bias in NORMALISED sun-depth units — the host converts it from a
    //                WORLD-unit knob (the shared slab spans 4*g_sunShadowRange world units), so the
    //                tuned value survives a change to the extent knob,
    //            z = light-bleeding reduction 0..0.95 (AMPLIFIES the reconstructed occlusion by
    //                1/(1-z) so an under-reported shadow core saturates to fully occluded; higher =
    //                deeper, tighter shadows. Raising it must never LIGHTEN a shadow — see msmrecv),
    //            w = NORMAL-OFFSET in TEXELS of the sampled cascade (the receiver samples from
    //                worldPos + N*w*texel — the cheap slope-acne fix that costs no depth precision).
    //                Texels, not world units: the acne it fixes is a one-texel depth-quantisation
    //                error, so an offset fixed in world units is simultaneously too small for the
    //                coarse far cascade and a peter-panning gap in the fine near one.
    DATA(float4,   sunParams,   None);
    // Cascade c's shadow-map texel size in WORLD units (x = c0 .. w = c3; lanes past SUN_CASCADES
    // are 0). Feeds the normal-offset scaling above.
    DATA(float4,   sunCascadeTexel, None);
    // --- NEAR-cascade PCSS + PCF (the hard-surface receiver) -----------------------------------
    // Cascade 0 does NOT use the moments above. MSM's penumbra is bounded by the moments blur's tap
    // radius (4 texels), so its softness saturates and what is left is a truncated, axis-aligned
    // kernel — the "square vectorisation" that shows up worst on terrain, where receiver and occluder
    // depths are close and the quadrature is least stable. Cascade 0 instead runs a blocker search +
    // variable-radius rotated-disc PCF over the RAW depth the caster pass already wrote
    // (gSunDepth) — penumbra decoupled from any map-space blur. The moments stay live for every OTHER
    // cascade and for volumetrics, which need one cheap filterable tap per ray step and cannot afford
    // a tap storm. Both representations come out of the SAME caster pass; neither costs a second one.
    // sunPcf0: x = blocker-search radius in TEXELS,
    //          y = light size in TEXELS (penumbra = y * (zRecv - zBlocker)/zBlocker, the PCSS
    //              similar-triangles term — this is THE softness knob),
    //          z = min PCF radius in TEXELS (contact hardness floor; below ~1 the grid shows),
    //          w = max PCF radius in TEXELS (bounds the tap spread so the disc cannot outrun its
    //              sample count and break into rings).
    DATA(float4,   sunPcf0,     None);
    // sunPcf1: x = PCF depth bias in NORMALISED sun-depth (converted host-side from a WORLD knob,
    //              like sunParams.y — a binary depth compare needs its OWN, usually smaller, bias
    //              than MSM's quadrature, so it does not share that number),
    //          y = slope-scaled bias in the same units, multiplied by tan(acos(N.L)),
    //          z = 1 = PCSS/PCF near cascade ON, 0 = fall back to MSM everywhere (the A/B),
    //          w = spare.
    DATA(float4,   sunPcf1,     None);
    // --- VOLUMETRIC height fog (volfog.frag.fsl) ------------------------------------------------
    // The moments map's actual job now that PCSS owns the colour pass: a ray march wants ONE cheap
    // filterable tap per step and cannot afford PCSS's 28, so shafts read the MSM atlas.
    // volFog0: x = density per world unit at the fog base,
    //          y = height falloff in WORLD units (density *= exp(-(h - base)/y)),
    //          z = fog BASE height in ABSOLUTE world units (Morrowind Z is up),
    //          w = max march distance in world units (the ray stops at the depth buffer or here).
    DATA(float4,   volFog0,     None);
    // volFog1: x = FORWARD-lobe Henyey-Greenstein g (0 = isotropic, ->1 = tight sun glow),
    //          y = step count,
    //          z = 1 = fog pass ON,
    //          w = HAZE shadow response 0..1: how much a sun shadow dims the haze term. 0 (default)
    //              = not at all, which is the energy-safe setting — a shadow then removes only the
    //              SHAFT, never the fog. Above 0 the pass becomes a net darkener at occlude 1.
    DATA(float4,   volFog1,     None);
    // volFog2: xyz = fog TINT, w = overall intensity. Applied to the FINAL in-scatter, which already
    //          carries its own colour: the lobes are sun-coloured (shafts), the isotropic pedestal and
    //          the ambient floor are FOG-coloured (haze). Multiplying everything by the sun colour is
    //          what made the horizon band light up over MW's own fog band.
    DATA(float4,   volFog2,     None);
    // volFog3: x = OCCLUDE amount 0..1 — how much of the underlying image the fog removes before its
    //              own colour is added (Sunshafts.fx `sunrayocclude`, 0.75 there). 1.0 == the
    //              physically exact composite dst*transmittance; below that the fog is less
    //              destructive of the scene behind it, which is what stops bright shafts blowing out.
    //          y = BACK-lobe g (signed; negative = back-scatter, the anti-sun brightening),
    //          z = forward-lobe GAIN, w = back-lobe GAIN.
    DATA(float4,   volFog3,     None);
    // --- DUAL-LOBE phase + water clamp ----------------------------------------------------------
    // A single HG lobe couples three things that want independent control: the sun halo, the anti-sun
    // brightening, and the SIDE (~90 deg to the sun) scattering that is most of what reads as "fog".
    // Raising density to get visible side fog necessarily explodes the forward lobe, because HG's
    // peak scales with the same number. So the phase is a WEIGHTED SUM of three normalised terms —
    // isotropic + forward HG + backward HG — each with its own gain:
    //     phase = iso + fwdGain * HG_n(cos, gF) + backGain * HG_n(cos, gB)      (HG_n: 1 == isotropic)
    // and the sum is passed through a soft ceiling so the forward lobe asymptotes instead of blowing
    // out (a hard clamp would draw a visible disc edge around the sun).
    // volFog4: x = HAZE gain — the side/horizontal knob (raises fog at every angle without touching
    //              either lobe; reach for this when "there is not enough fog"). 1.0 is the
    //              ENERGY-NEUTRAL point: the haze then returns exactly the (1-T) of fog radiance that
    //              the occlude term removed, so at occlude 1 the composite is an exact lerp toward
    //              the fog colour. Below 1 the pass darkens the scene; above 1 it brightens it.
    //          y = phase soft ceiling (Reinhard knee; the phase asymptotes to this),
    //          z = water-plane clamp: ABSOLUTE world Z of the water surface,
    //          w = 1 = water clamp ACTIVE this frame (water drawn and camera above it).
    // The water clamp exists because water writes depth AFTER the seam gSceneLinDepth is taken at
    // (it must not clamp its own refraction source), so over open sea that depth holds the seabed —
    // or nothing at all, which reads as sky. Either way the ray marches straight through the water
    // surface and keeps accumulating near-ground-density fog, which is exactly the bright band above
    // the horizon over water.
    DATA(float4,   volFog4,     None);
    // ALLOCATION size of the screen-sized render targets — NOT the current render size.
    // These differ: the host allocates every size-dependent RT at the render-scale CEILING
    // (2x backbuffer) and draws into a sub-VIEWPORT of it, so at scale 1.0 the live image occupies
    // the top-left QUARTER of each texture. Anything sampling a screen-sized texture by uv must
    // therefore scale by pixel/alloc, while anything reconstructing NDC must use pixel/render.
    // screenParams above is the RENDER size; these two are not interchangeable.
    //   xy = alloc w,h ; zw = 1/alloc w,h
    DATA(float4,   screenAlloc, None);
    // --- SKY ambient, projected to SH-L1 (SH1, tasks/lighting.md) --------------------------------
    // Ambient used to be ONE flat colour, so a surface facing the sky and a surface facing the dirt
    // received identically — the only thing breaking that up was screen-space GTAO, which has no idea
    // where the sky is. The sky is already an analytic function of direction (sky.frag's VColSource 3
    // dome: lerp(fogColNear, skyZenith, saturate(dir.z)), plus a sun lobe), i.e. a light source we
    // were not sampling. The host projects THAT function into an L1 basis once per frame; the
    // receiver costs three dot products.
    // Packed Unity-style so evaluation is exactly a dot: irr.r = dot(shAr, float4(N, 1)).
    // NORMALISED BY ITS OWN DC, so what these publish is a directional FACTOR whose spherical average
    // is 1 — not a replacement ambient. That is what makes strength 0 bit-identical to flat ambient
    // and strength 1 a pure redistribution: the slider cannot make the world darker or brighter.
    DATA(float4,   shAr, None);
    DATA(float4,   shAg, None);
    DATA(float4,   shAb, None);
    // skyParams: x = SH STRENGTH 0..1 (0 = the directional half off — the receiver's early-out AND
    //                the interior gate, the same "one float disarms it at every receiver" idiom
    //                sunParams.x uses; there is no sky to project in an interior, so the host
    //                publishes 0 there),
    //            y = SH2 sky-AO STRENGTH 0..1 (0 = no taps taken at all, i.e. bit-identical to the
    //                SH1 build). Its OWN lane rather than sharing x: occlusion is a separate
    //                measurement from direction and each has to be A/B-able against the other. Also
    //                0 in interiors — the height map covers the exterior world only.
    //            z = INNER tap radius in world units. The march STARTS here so it does not restate
    //                what screen-space GTAO already multiplied into the same ambient; the two are
    //                complementary bands, not stacked copies of one.
    //            w = OUTER tap radius in world units — how far a cliff can still shade you.
    DATA(float4,   skyParams, None);
    // --- SH2: where the top-down world height map lives, in WORLD space ------------------------
    // gSkyHeight is a camera-following window, so a receiver cannot know its mapping from the
    // texture alone. Publishing it (rather than deriving it from the eye) is what keeps the map's
    // addressing in ONE place: the host snaps the origin to a coarse grid and rebuilds wholesale
    // when the camera leaves it, and because the content is WORLD-LOCKED a rebuild reproduces
    // identical values over the overlap — nothing pops, only the far edge changes. Swapping this
    // for toroidal addressing later changes the host update and the one uv line in skyamb.h.fsl.
    //   xy = ABSOLUTE world XY of the map's (0,0) texel CORNER,
    //   z  = 1 / (world extent) — i.e. uv = (worldXY - origin) * z,
    //   w  = tap COUNT per direction (the cost knob; 0 is treated as 1).
    DATA(float4,   skyAOMap,  None);
    // --- LONG-RANGE sun occlusion (gSunOcc / sunocc.comp.fsl, tasks/lighting.md) -----------------
    // The cascades reach ONE MW cell and return fully lit outside it, so until this landed the whole
    // distant world was unshadowed by construction — a ridge three cells away shadowed neither the
    // ground nor the fog. gSunOcc holds the sun-BLOCKED world Z per texel; a point is lit iff its own
    // z is at or above it, which is one sample and is correct in the air as well as on the ground.
    //
    // It shares gSkyHeight's window, so its ADDRESSING is skyAOMap.xy/.z above — deliberately not
    // duplicated here, because two copies of one origin is exactly how a derived map ends up sampled
    // through the wrong mapping for a frame. The host keeps the two in lockstep by rebuilding this
    // one inside the height map's own rebuild.
    // sunOcc: x = STRENGTH 0..1 (0 = off — the receiver's early-out, the A/B, and the "no map"
    //             signal: night, interior, or not yet built),
    //         y = SOFT transition height in WORLD units. The stored value is a hard boundary and the
    //             map is coarse, so a binary test would draw a stair-stepped shadow line across the
    //             landscape; the ramp runs from blockZ (lit) DOWNWARD, never upward, so the soft
    //             band can only ever lighten and never invents shadow above the blocked height.
    //         z = BIAS in world units, subtracted from blockZ before the compare. The map is
    //             max(terrain, statics) sampled coarsely, so a point standing ON the surface that
    //             generated its own texel would otherwise shadow itself — the height-map equivalent
    //             of depth acne, and fixed the same way.
    //         w = spare.
    DATA(float4,   sunOcc,    None);
    // --- SH2 OVERHANG correction (skyamb.h.fsl) --------------------------------------------------
    // A height map cannot represent that the space under a roof is open — every column reads as solid
    // from -inf up to its stored height — so a point under Baar Dau, on a tower shaft, or beneath an
    // arch is reported near-black when the sky is in fact open toward the horizon in every direction.
    // One point-sampled tap at the receiver's OWN texel detects it: geometry above my head at my own
    // XY proves this column is not solid below its top.
    // x = ramp START in world units of overhead clearance. Below it the map is trusted completely —
    //     a receiver standing ON the surface that generated its own texel reads ~0 here, which is the
    //     overwhelmingly common case and must stay untouched.
    // y = ramp WIDTH in world units over which trust falls from 1 to the floor.
    // z = trust FLOOR 0..1. Not 0: a genuinely enormous overhead blocker really does take a bite out
    //     of the sky, so the correction may lighten toward the truth and never past it. What is left
    //     of the occlusion in that band is GTAO's, which sees the real geometry and is already
    //     multiplied into this same ambient.
    // w = spare.
    DATA(float4,   skyAO2,    None);
    // --- SCENE COLOUR UNITS (tasks/forge-postprocess.md step 6a) ---------------------------------
    // x = 1 when the scene render target is SCENE-REFERRED, 0 when it is DISPLAY-REFERRED.
    //
    // This is the host's folded `g_hdrSceneColor && sampleCount > 1` and NOTHING may re-derive it.
    // Scene-referred and fp16 are ONE switch, not two correlated ones: scene-referred values exceed
    // 1.0 and B8G8R8A8_UNORM would clamp them, which is strictly worse than tonemapping in the pass.
    // Same "one float disarms it at every receiver" idiom as sunParams.x / skyParams.x above — a
    // receiver asks this lane and never asks about a format.
    //
    // Read by tonemapInPass() in skydome.h.fsl, which is where every colour frag now ends: 0 keeps
    // the curve in the pass (today's image, byte for byte), 1 defers it to resolve.frag so the target
    // carries radiance for bloom to read. It lives HERE rather than in gFrameData because that
    // cbuffer is exactly full at its 512 B CBV and its six copies are TRUNCATED at three different
    // lengths — a flag past float 115 would read zero in the reflect-geo pass, which draws
    // statics.frag and terrain.frag. gShadowParams is bound by pointer into every PerFrame set, so
    // one host write reaches all of them.
    // yzw spare.
    DATA(float4,   toneParams, None);
    // --- UNIFIED WATER FOG (waterfog.h.fsl, tasks/forge-water.md) --------------------------------
    // ONE extinction law for the water surface AND for everything submerged under it. Before this
    // the renderer fogged water three incompatible ways — the surface faded toward the XE depth tint
    // on a perpendicular depth, the underwater refraction faded toward the atmosphere on a slant
    // distance, and the seabed itself got MW's per-vertex AIR ramp — so crossing the surface swapped
    // both the colour and the model, and a submerged rock never matched the water above it.
    //
    // waterFogCol: xyz = the fog TARGET, MW's own `UnderwaterColor*w + fogColor*(1-w)` from
    //                    Morrowind.ini [Water] (LIFTED + DECODED host-side exactly like fogColNear —
    //                    it is an authored display-referred colour that reaches the target without
    //                    passing through the curve, so it takes the identical boundary treatment),
    //              w   = extinction coefficient per WORLD UNIT (the host inverts a readable
    //                    visibility-distance knob and folds in the time-of-day density).
    DATA(float4,   waterFogCol,   None);
    // waterFogPlane: x = ABSOLUTE world Z of the water surface, at the TRUE level (WaterLevel - 1) —
    //                    the threshold the client's `underwater` bit itself trips at, so .z below and
    //                    this plane can never disagree about which side the eye is on. Nearly the
    //                    same quantity volFog4.z carries, and deliberately not shared with it:
    //                    volFog4.w is CLEARED when the camera submerges (an air-fog march below the
    //                    surface is meaningless) and this feature needs exactly the opposite,
    //                y = 1 = water fog ACTIVE this frame (cell has water, knob on) — the receiver's
    //                    early-out and the A/B, the same "one float disarms every receiver" idiom
    //                    sunParams.x uses,
    //                z = 1 = the CAMERA is under the surface (whole view ray is in water),
    //                w = spare.
    DATA(float4,   waterFogPlane, None);
    // --- W7b: absorption on the DOWNWARD LIGHT path (waterfog.h.fsl) -----------------------------
    // Same medium, same Beer-Lambert law, applied to the light on its way IN rather than to the view
    // ray on its way out — "absorption is both ways". A submerged surface is therefore dimmer and
    // bluer because of WHERE IT IS, not because of where the camera is, which is the whole point:
    // both MW (x0.19..0.35 on sun+ambient) and OpenMW (an underwater fog ramp starting BEHIND the
    // camera, 60-75% opaque at zero distance) apply a flat, depth-independent, camera-dependent
    // tint instead. W7a cancels MW's; this replaces it.
    //
    // xyz = PER-CHANNEL extinction per world unit for light. Not a second calibration: it is the
    //       view coefficient (waterFogCol.w) times the spectrum of MW's own [Water] UnderwaterColor,
    //       read as a transmittance and inverted — sigma = -ln(UnderwaterColor), normalised to unit
    //       mean so the knob still owns the overall rate and the ini owns only the colour. The
    //       cross-check that this is the right reading: that normalised spectrum lands within ~6% of
    //       the tint MW itself applies (measured), so an authored colour and a hand-picked tint agree
    //       about how fast water eats red.
    // w   = strength 0..1. 0 = transmittance exactly 1, i.e. bit-identical — the A/B.
    DATA(float4,   waterFogLight, None);
    // --- W8: VOLUMETRIC in-scatter (waterfog.h.fsl) ----------------------------------------------
    // The lanes above describe a medium that only ever REMOVES light. That is why the water colour
    // had to be authored: with nothing putting light back, there is no colour to derive. Splitting
    // extinction into its two physical halves is what makes the colour fall out instead of being
    // picked, and it is the same split that makes the in-scatter a RAY integral rather than a
    // per-fragment evaluation — see waterfog.h.fsl for the derivation and for why the integral is
    // closed-form (the depth profile along a straight ray is LINEAR, so the integrand is a single
    // exponential; volfog has to march only because its density is exponential in height).
    //
    // waterFogExt: xyz = TOTAL extinction sigma_t per world unit (absorption + scattering). This is
    //                    the one spectrum the whole medium runs on: the view beam, the downward sun
    //                    beam and the ambient path all attenuate by it, so nothing can disagree
    //                    about how fast water eats red,
    //              w   = VOLUMETRIC strength 0..1. 0 = the fade-toward-a-target model above,
    //                    bit-identical, including waterLightTransmit's spectrum (which lerps between
    //                    waterFogLight.rgb and this one on exactly this lane). The A/B.
    DATA(float4,   waterFogExt,     None);
    // waterFogScatter: xyz = SCATTERING coefficient sigma_s per world unit. sigma_s <= sigma_t by
    //                        construction, and their ratio sigma_s/sigma_t is the single-scattering
    //                        albedo — which IS the colour of deep water, because that ratio is
    //                        exactly what an infinitely long ray converges to,
    //                  w   = in-scatter GAIN. The one calibration constant in the model: the
    //                        derived colour's HUE matches MW's authored UnderwaterColor to ~8%, but
    //                        its magnitude does not, because "sun colour" here is a radiance the
    //                        engine never defined an irradiance for.
    DATA(float4,   waterFogScatter, None);
    // waterFogPhase:  x = forward-lobe HG g, y = forward gain, z = back-lobe g (signed), w = back gain
    DATA(float4,   waterFogPhase,   None);
    // waterFogPhase2: x = isotropic pedestal (also the stand-in for the multiple scattering a
    //                     single-scattering integral cannot see — in a medium this dense that is
    //                     most of the side-scatter),
    //                 y = phase soft ceiling (Reinhard knee on the lobes),
    //                 z = multiple-scattering ISOTROPISATION strength, 0..1. The pedestal in .x is a
    //                     constant; this is the part that has to depend on the PATH, because whether
    //                     a lobe applies at all is a question about optical depth (waterColumn). 0
    //                     reproduces the pre-W8d build exactly,
    //                 w = spare.
    DATA(float4,   waterFogPhase2,  None);
    // waterFogKd: xyz = the DIFFUSE attenuation coefficient K_d per world unit, for the DOWNWELLING
    //                   light path ONLY — how fast the light getting DOWN here dies, which is not how
    //                   fast a beam ACROSS here dies. w = the A/B strength the host already folded
    //                   into xyz, published for readout; at 0 the host writes sigma_t here verbatim
    //                   and every consumer is bit-identical to the pre-W8e build.
    DATA(float4,   waterFogKd,      None);
};
