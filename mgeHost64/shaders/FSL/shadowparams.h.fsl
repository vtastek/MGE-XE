// mgeHost64 — shared point-light shadow SLOT params.
//
// The ShadowMaskParams cbuffer describes every ACTIVE shadow slot (camera-relative light
// pos/radius, its 3x2 cube-face atlas tile, bias/flicker state). Two consumers read it:
//   - shadowmask.comp  (ShadowMaskSrtData) — the once-per-frame screen-space mask pass.
//   - opaque.frag      (SrtData, PerFrame gShadowParams) — the FIRST-PERSON direct-atlas path,
//     which samples the cube atlas straight from the interpolated world pos + vertex normal
//     (the screen mask reconstructs the WORLD behind the arm, not the arm itself).
// Factored here so both share ONE definition — the cbuffer bytes are identical, so the host
// binds the SAME pShadowMaskParamsCbv to either root signature.
#pragma once

#define MAX_SHADOW_SLOTS 32   // MUST match host kMaxShadowLights (forgerender.cpp)

// SUN (directional) shadow CASCADE count. MUST match host kSunCascades (forgerender.cpp) — it sizes
// the matrix array below, so a mismatch silently shifts every float offset publishSunShadowParams
// writes. Cascades are CONCENTRIC camera-centred ortho boxes at increasing half-extent, packed side
// by side into ONE moments atlas (cascade c owns u in [c/N, (c+1)/N]) so every receiver keeps its
// single gSunMoments binding and no PerFrame set has to grow.
#define SUN_CASCADES 2
// PER-CASCADE tile resolution. MUST match host kSunShadowRes (static_asserted there). Needed in the
// shader only by the near cascade's PCSS/PCF, which works in TEXELS and therefore has to know the
// atlas's pixel grid — the moments receiver is pure uv and never cared.
#define SUN_SHADOW_RES 2048

STRUCT(ShadowMaskParams)
{
    DATA(float4x4, invViewProj,  None);   // inverse of the reverse-Z camera-relative viewProj
    // maskParams: x = shadow TEST RANGE in light radii (live knob, host g_shadowRangeK; 2.0 =
    //             the atlas far plane = old behaviour). Range cull + slot test use it; the
    //             refZ depth mapping always uses farZ = 2r (the atlas render far plane),
    //             y = face near plane (world u),
    //             z = relative reverse-Z compare slack (acne knob, live-tunable),
    //             w = debug mode (0 off, 1 face-id nibble, 2 atlas-depth view)
    DATA(float4,   screenParams, None);   // xy = screen w,h ; zw = 1/w, 1/h
    DATA(float4,   maskParams,   None);
    DATA(float4,   slotPosRad[MAX_SHADOW_SLOTS], None);   // xyz = camera-relative light pos, w = radius (far = 2r)
    DATA(float4,   slotTile[MAX_SHADOW_SLOTS],   None);   // xy = 3x2 face-block origin (atlas px), z = face size (px), w = temporal fade-in
    // biasParams: x = ABSOLUTE reverse-Z compare bias (contact/interpenetration knob, live).
    //             y = NORMAL-OFFSET bias in atlas texels (live).
    //             z = base-rate flame phase (diagnostic only).
    //             w = BASE flicker wobble amplitude in radians (0 = off), scaled per slot by slotFlick.x.
    DATA(float4,   biasParams,   None);
    // slotBits: the 32-bit slot masks as REAL uints (float lanes drop bits >= 24).
    //             x = ACTIVE-slot bitmask, y = DYNAMIC-slot bitmask (valid dyn tile this frame),
    //             z = FLICKER-class bitmask, w = SOFT bitmask (reduced-res tile).
    DATA(uint4,    slotBits,     None);
    // Per-slot flame state (flicker slots only). x = wobble amp gain, y = flame phase (rad),
    // z = the face-frustum uvScale this slot's tile was BAKED with (< 1 = wider than 90°), w = spare.
    DATA(float4,   slotFlick[MAX_SHADOW_SLOTS], None);
    // --- SUN (directional) CASCADED shadow, Phase B/C receiver (forge-sun-shadows.md) ----------
    // Per-cascade sun MSM ortho view*proj, CAMERA-RELATIVE (eye at origin) — the same matrices the
    // caster pass projected by, so every receiver reconstructs the identical mapping. They live HERE
    // rather than in FrameData because FrameData is exactly full at its 512B CBV, while this cbuffer
    // has room — and it is already bound into every PerFrame set AND the compute mask, so one write
    // reaches all receivers. Same convention as gFrameData.viewProj:
    // mul(M, worldPos) == D3DX row-vector worldPos*M.
    // Every cascade shares ONE depth slab (half-extent 2*outermost range) so a caster high up-sun is
    // inside all of them and the NORMALISED depth — hence the single depth bias below — is cascade-
    // independent. Only the two axes perpendicular to the sun shrink per cascade.
    DATA(float4x4, sunViewProj[SUN_CASCADES], None);
    // sunParams: x = shadow STRENGTH 0..1 (0 = sun shadows OFF — the receiver's early-out, so the
    //                whole feature A/Bs from one float; also the "no map this frame" signal),
    //            y = depth bias in NORMALISED sun-depth units — the host converts it from a
    //                WORLD-unit knob (the shared slab spans 4*g_sunShadowRange world units), so the
    //                tuned value survives a change to the extent knob,
    //            z = light-bleeding reduction 0..0.95 (AMPLIFIES the reconstructed occlusion by
    //                1/(1-z) so an under-reported shadow core saturates to fully occluded; higher =
    //                deeper, tighter shadows. Raising it must never LIGHTEN a shadow — see msmrecv),
    //            w = NORMAL-OFFSET in TEXELS of the sampled cascade (the receiver samples from
    //                worldPos + N*w*texel — the cheap slope-acne fix that costs no depth precision).
    //                Texels, not world units: the acne it fixes is a one-texel depth-quantisation
    //                error, so an offset fixed in world units is simultaneously too small for the
    //                coarse far cascade and a peter-panning gap in the fine near one.
    DATA(float4,   sunParams,   None);
    // Cascade c's shadow-map texel size in WORLD units (x = c0 .. w = c3; lanes past SUN_CASCADES
    // are 0). Feeds the normal-offset scaling above.
    DATA(float4,   sunCascadeTexel, None);
    // --- NEAR-cascade PCSS + PCF (the hard-surface receiver) -----------------------------------
    // Cascade 0 does NOT use the moments above. MSM's penumbra is bounded by the moments blur's tap
    // radius (4 texels), so its softness saturates and what is left is a truncated, axis-aligned
    // kernel — the "square vectorisation" that shows up worst on terrain, where receiver and occluder
    // depths are close and the quadrature is least stable. Cascade 0 instead runs a blocker search +
    // variable-radius rotated-disc PCF over the RAW depth the caster pass already wrote
    // (gSunDepth) — penumbra decoupled from any map-space blur. The moments stay live for every OTHER
    // cascade and for volumetrics, which need one cheap filterable tap per ray step and cannot afford
    // a tap storm. Both representations come out of the SAME caster pass; neither costs a second one.
    // sunPcf0: x = blocker-search radius in TEXELS,
    //          y = light size in TEXELS (penumbra = y * (zRecv - zBlocker)/zBlocker, the PCSS
    //              similar-triangles term — this is THE softness knob),
    //          z = min PCF radius in TEXELS (contact hardness floor; below ~1 the grid shows),
    //          w = max PCF radius in TEXELS (bounds the tap spread so the disc cannot outrun its
    //              sample count and break into rings).
    DATA(float4,   sunPcf0,     None);
    // sunPcf1: x = PCF depth bias in NORMALISED sun-depth (converted host-side from a WORLD knob,
    //              like sunParams.y — a binary depth compare needs its OWN, usually smaller, bias
    //              than MSM's quadrature, so it does not share that number),
    //          y = slope-scaled bias in the same units, multiplied by tan(acos(N.L)),
    //          z = 1 = PCSS/PCF near cascade ON, 0 = fall back to MSM everywhere (the A/B),
    //          w = spare.
    DATA(float4,   sunPcf1,     None);
    // --- VOLUMETRIC height fog (volfog.frag.fsl) ------------------------------------------------
    // The moments map's actual job now that PCSS owns the colour pass: a ray march wants ONE cheap
    // filterable tap per step and cannot afford PCSS's 28, so shafts read the MSM atlas.
    // volFog0: x = density per world unit at the fog base,
    //          y = height falloff in WORLD units (density *= exp(-(h - base)/y)),
    //          z = fog BASE height in ABSOLUTE world units (Morrowind Z is up),
    //          w = max march distance in world units (the ray stops at the depth buffer or here).
    DATA(float4,   volFog0,     None);
    // volFog1: x = FORWARD-lobe Henyey-Greenstein g (0 = isotropic, ->1 = tight sun glow),
    //          y = step count,
    //          z = 1 = fog pass ON,
    //          w = HAZE shadow response 0..1: how much a sun shadow dims the haze term. 0 (default)
    //              = not at all, which is the energy-safe setting — a shadow then removes only the
    //              SHAFT, never the fog. Above 0 the pass becomes a net darkener at occlude 1.
    DATA(float4,   volFog1,     None);
    // volFog2: xyz = fog TINT, w = overall intensity. Applied to the FINAL in-scatter, which already
    //          carries its own colour: the lobes are sun-coloured (shafts), the isotropic pedestal and
    //          the ambient floor are FOG-coloured (haze). Multiplying everything by the sun colour is
    //          what made the horizon band light up over MW's own fog band.
    DATA(float4,   volFog2,     None);
    // volFog3: x = OCCLUDE amount 0..1 — how much of the underlying image the fog removes before its
    //              own colour is added (Sunshafts.fx `sunrayocclude`, 0.75 there). 1.0 == the
    //              physically exact composite dst*transmittance; below that the fog is less
    //              destructive of the scene behind it, which is what stops bright shafts blowing out.
    //          y = BACK-lobe g (signed; negative = back-scatter, the anti-sun brightening),
    //          z = forward-lobe GAIN, w = back-lobe GAIN.
    DATA(float4,   volFog3,     None);
    // --- DUAL-LOBE phase + water clamp ----------------------------------------------------------
    // A single HG lobe couples three things that want independent control: the sun halo, the anti-sun
    // brightening, and the SIDE (~90 deg to the sun) scattering that is most of what reads as "fog".
    // Raising density to get visible side fog necessarily explodes the forward lobe, because HG's
    // peak scales with the same number. So the phase is a WEIGHTED SUM of three normalised terms —
    // isotropic + forward HG + backward HG — each with its own gain:
    //     phase = iso + fwdGain * HG_n(cos, gF) + backGain * HG_n(cos, gB)      (HG_n: 1 == isotropic)
    // and the sum is passed through a soft ceiling so the forward lobe asymptotes instead of blowing
    // out (a hard clamp would draw a visible disc edge around the sun).
    // volFog4: x = HAZE gain — the side/horizontal knob (raises fog at every angle without touching
    //              either lobe; reach for this when "there is not enough fog"). 1.0 is the
    //              ENERGY-NEUTRAL point: the haze then returns exactly the (1-T) of fog radiance that
    //              the occlude term removed, so at occlude 1 the composite is an exact lerp toward
    //              the fog colour. Below 1 the pass darkens the scene; above 1 it brightens it.
    //          y = phase soft ceiling (Reinhard knee; the phase asymptotes to this),
    //          z = water-plane clamp: ABSOLUTE world Z of the water surface,
    //          w = 1 = water clamp ACTIVE this frame (water drawn and camera above it).
    // The water clamp exists because gSceneLinDepth is the OPAQUE PREPASS: water writes depth after
    // it, so over open sea the depth buffer holds the seabed — or nothing at all, which reads as sky.
    // Either way the ray marches straight through the water surface and keeps accumulating
    // near-ground-density fog, which is exactly the bright band above the horizon over water.
    DATA(float4,   volFog4,     None);
    // ALLOCATION size of the screen-sized render targets — NOT the current render size.
    // These differ: the host allocates every size-dependent RT at the render-scale CEILING
    // (2x backbuffer) and draws into a sub-VIEWPORT of it, so at scale 1.0 the live image occupies
    // the top-left QUARTER of each texture. Anything sampling a screen-sized texture by uv must
    // therefore scale by pixel/alloc, while anything reconstructing NDC must use pixel/render.
    // screenParams above is the RENDER size; these two are not interchangeable.
    //   xy = alloc w,h ; zw = 1/alloc w,h
    DATA(float4,   screenAlloc, None);
    // --- SKY ambient, projected to SH-L1 (SH1, tasks/lighting.md) --------------------------------
    // Ambient used to be ONE flat colour, so a surface facing the sky and a surface facing the dirt
    // received identically — the only thing breaking that up was screen-space GTAO, which has no idea
    // where the sky is. The sky is already an analytic function of direction (sky.frag's VColSource 3
    // dome: lerp(fogColNear, skyZenith, saturate(dir.z)), plus a sun lobe), i.e. a light source we
    // were not sampling. The host projects THAT function into an L1 basis once per frame; the
    // receiver costs three dot products.
    // Packed Unity-style so evaluation is exactly a dot: irr.r = dot(shAr, float4(N, 1)).
    // NORMALISED BY ITS OWN DC, so what these publish is a directional FACTOR whose spherical average
    // is 1 — not a replacement ambient. That is what makes strength 0 bit-identical to flat ambient
    // and strength 1 a pure redistribution: the slider cannot make the world darker or brighter.
    DATA(float4,   shAr, None);
    DATA(float4,   shAg, None);
    DATA(float4,   shAb, None);
    // skyParams: x = STRENGTH 0..1 (0 = feature off — the receiver's early-out AND the interior gate,
    //                the same "one float disarms it at every receiver" idiom sunParams.x uses; there
    //                is no sky to project in an interior, so the host publishes 0 there),
    //            y,z,w = spare.
    DATA(float4,   skyParams, None);
};
