// mgeHost64 — M-Skinning skinned scene (vertex stage, GPU palette skinning).
//
// Reuses the opaque SRT (gFrameData viewProj + gBatch.worlds[] read as a 64KB BONE window)
// and the shared default.rootsig — NO new SRT, NO second root signature. There is no
// per-draw world matrix: the bone palette is already model->world. The per-INSTANCE Base
// attribute is this part's palette offset within the bound window (host sets it via
// firstInstance + the identity instance buffer, exactly like the static DrawIndex).
//
//   worldPos = Σ_j Weight[j] * mul(gBatch.worlds[Base + BoneIdx[j]], pos)
//   clip     = mul(gFrameData.viewProj, worldPos)              // reverse-Z viewProj (host-applied)
//   worldNrm = Σ_j Weight[j] * mul((float3x3)gBatch.worlds[Base + BoneIdx[j]], normal)
//
// Emits clip pos + world normal for the shared opaque.frag flat N.L shading.

#include "opaque.srt.h"

STRUCT(VSInput)
{
    DATA(float3, Position, POSITION);
    DATA(float3, Normal,   NORMAL);
    DATA(float4, Weights,  TEXCOORD0);
    DATA(uint4,  BoneIdx,  TEXCOORD1);   // R8G8B8A8_UINT: .x=idx0 .y=idx1 .z=idx2 .w=idx3
    DATA(uint,   Base,     TEXCOORD2);   // per-instance: palette offset in the bound window
    DATA(float2, Uv,       TEXCOORD3);   // per-vertex base-map UV
    DATA(uint,   TexAlpha, TEXCOORD4);   // per-instance packed: texIndex (low 16) | alphaRef*255 (bits 16-23)
    // per-instance: MaterialProperty::alpha, bit-cast. Read ONLY when the packed word's blend bit
    // is set (see SKIN_BLEND_BIT) — on the opaque skinned path it is ignored and OverlayIndex
    // stays 0, which is what keeps opaque.frag's terrain-decal splat gated off.
    DATA(uint,   MatAlphaBits, TEXCOORD5);
};

// Bit 30 of the packed instance word = this part is alpha-BLENDED (host: kSkinBlendBit).
// packTexAlpha owns bits 0-29: 0-15 texIndex, 16-23 alphaRef, 24-25 vColSource, 26-27 clampMode,
// 28 two-sided, 29 ENCHANTED-ITEM GLOW. This bit was 29 until the glow took it, at which point
// every enchanted opaque skinned part read as blended and OverlayIndex handed opaque.frag
// asuint(matAlpha) as a decal slot — white armour. Path-private bits go 30, then 31.
#define SKIN_BLEND_BIT 0x40000000u

STRUCT(VSOutput)
{
    DATA(float4,      Position, SV_Position);
    DATA(float3,      Normal,   NORMAL);
    DATA(float2,      Uv,       TEXCOORD0);   // base-map UV (shared opaque.frag)
    DATA(FLAT(uint),  TexIndex, TEXCOORD1);   // bindless base-map slot (0 = default white)
    DATA(CENTROID(float), Fog,      TEXCOORD2);   // MW fog scalar (shared opaque.frag, matches opaque.vert)
    DATA(float4,      Color,    COLOR);       // Tier 2a: white (skinned VB has no vcol) → (d+a) fidelity
    DATA(float,       AlphaRef, TEXCOORD3);   // alpha-test ref 0..1 (shared opaque.frag; 0 = no test)
    DATA(FLAT(float3),MatDiffuse, TEXCOORD4); // Tier 2b: shared frag struct. Skinned has no captured
    DATA(FLAT(float3),MatAmbient, TEXCOORD5); // material yet → defaults below reduce the frag's
    DATA(FLAT(float3),MatEmissive,TEXCOORD6); // vColSource==2 branch to white*(d+a) = current fidelity.
    DATA(FLAT(uint),  VColSource, TEXCOORD7);
    DATA(float3,      WorldPos,   TEXCOORD8); // Tier 3a: world position for point-light eval
    DATA(FLAT(uint),  OverlayIndex,TEXCOORD9);// opaque: 0 (skinned is never terrain, so no decal).
                                              // BLENDED: matAlpha bit-cast, which is how alpha.frag
                                              // and alphashadowdepth.frag read it (same slot reuse
                                              // opaque.vert already does for the AT1 list).
    DATA(FLAT(uint),  ClampMode,  TEXCOORD10);// MW texture address mode (0..3) -> sampleBase()
    // AT3 stage-table index, so this vert can PAIR WITH alpha.frag (blended skinned parts). A vert
    // may output more than a frag reads — opaque.frag/depthonly.frag simply ignore it — but a frag
    // reading what the vert does NOT output hangs the GPU ([[project_forge_shared_frag_vsoutput]]),
    // and that is exactly what pairing alpha.frag with the old signature would have done. Skinned
    // parts never carry captured multi-stage data, so this is the "no stages" sentinel: the index
    // would otherwise address pInstanceBufSkin's unrelated gAlphaStages entry.
    DATA(FLAT(uint),  DrawIdx,    TEXCOORD11);
    // Real water reflection (IR3): below-water clip — identical to opaque.vert's (see the comment
    // there). Pass-all outside the reflect pass; a rasterizer system value, so opaque.frag's shared
    // VSOutput does not declare it.
    DATA(float,       Clip,       SV_ClipDistance0);
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN( VSInput In )
{
    INIT_MAIN;
    VSOutput Out;

    float4 pos = float4(In.Position, 1.0f);

    // Top-4 influences (manually unrolled — FSL-safe). Cbuffer matrices are column-major
    // (DXC default), so mul(M, v) with the D3DX bytes uploaded as-is == D3DX v*M (same
    // convention as opaque.vert). BoneIdx components map idx0..idx3 to the UBYTE4 byte
    // order (R=low byte), pairing with Weights.x..w.
    float4x4 b0 = gBatch.worlds[In.Base + In.BoneIdx.x];
    float4x4 b1 = gBatch.worlds[In.Base + In.BoneIdx.y];
    float4x4 b2 = gBatch.worlds[In.Base + In.BoneIdx.z];
    float4x4 b3 = gBatch.worlds[In.Base + In.BoneIdx.w];

    float4 worldPos = In.Weights.x * mul(b0, pos)
                    + In.Weights.y * mul(b1, pos)
                    + In.Weights.z * mul(b2, pos)
                    + In.Weights.w * mul(b3, pos);

    float3 worldNrm = In.Weights.x * mul((float3x3)b0, In.Normal)
                    + In.Weights.y * mul((float3x3)b1, In.Normal)
                    + In.Weights.z * mul((float3x3)b2, In.Normal)
                    + In.Weights.w * mul((float3x3)b3, In.Normal);

    Out.Position = mul(gFrameData.viewProj, worldPos);
    Out.Normal = worldNrm;
    Out.WorldPos = worldPos.xyz;   // Tier 3a: point lights evaluate in world space
    Out.Uv = In.Uv;
    // Unpack the per-instance texIndex (low 16) + alpha-test ref (bits 16-23, /255).
    Out.TexIndex = In.TexAlpha & 0xFFFFu;
    Out.AlphaRef = float((In.TexAlpha >> 16u) & 0xFFu) * (1.0f / 255.0f);
    Out.Color = float4(1.0f, 1.0f, 1.0f, 1.0f);
    // Tier 2b defaults: white vcol drives diffuse+ambient (vColSource 2), zero emissive →
    // frag computes white*(d+a) = current skinned fidelity. Per-part skinned material is a
    // later milestone (needs the skinned instance VB / wire extended like the static path).
    //
    // THIS PLACEHOLDER IS LOAD-BEARING FOR BLENDED SKINNED PARTS — read before replacing it.
    // With VColSource 2 and a white Color, alpha.frag's `albedo.a * vcolA * matAlpha` has
    // vcolA == 1, so it degenerates to `albedo.a * matAlpha` and the shape's authored
    // MaterialProperty alpha survives. That is what makes TR_velk.nif's mane render as
    // translucent strands instead of the opaque white card MW and OpenMW draw (see the long
    // note at scenegraph_geometry_cache.cpp `e.vColSource = 0` for the full mechanism and the
    // decision to keep it). Shipping a real per-part material here will hand this line a real
    // vColSource and can silently undo that — re-check the velk mane when that milestone lands.
    //
    // NO VERTEX-COLOUR CHANNEL is coming to SkinnedVertexWire (stride 52), and that is measured,
    // not lazy: of 458 skinned meshes sampled, 51 carry a colour array but ZERO carry a
    // NiVertexColorProperty with source 2 — the only case the client's `hasVertexColor &&
    // vColSource == 2` gate lets through (scenegraph_geometry_cache.cpp:1245/2016). A colour
    // channel would cost 4 bytes on every skinned vertex to feed exactly nothing. It becomes
    // worth adding only if that cache rule is flipped to the MW/OpenMW data-driven default.
    Out.MatDiffuse  = float3(1.0f, 1.0f, 1.0f);
    Out.MatAmbient  = float3(1.0f, 1.0f, 1.0f);
    Out.MatEmissive = float3(0.0f, 0.0f, 0.0f);
    Out.VColSource  = 2u;
    // Bits 26-29, the same four opaque.vert forwards: address mode (0-1), two-sided (2, always 0
    // here — skinned two-sidedness rides blendFlags into its own PSO), enchanted-item glow (3).
    // Taking only two bits used to drop the glow on the skinned path, which is the ONE path
    // enchanted armour and clothing actually travel.
    Out.ClampMode   = (In.TexAlpha >> 26u) & 0xFu;   // MW texture address mode (see opaque.vert)
    // Opaque skinned keeps OverlayIndex 0 — opaque.frag reads this slot as a terrain DECAL_1
    // bindless index and a non-zero value there would sample gTextures[asuint(matAlpha)], far
    // outside the array. Only a BLENDED part (drawn by alpha.frag / alphashadowdepth.frag, which
    // read the slot as matAlpha) may carry it.
    Out.OverlayIndex = ((In.TexAlpha & SKIN_BLEND_BIT) != 0u) ? In.MatAlphaBits : 0u;
    Out.DrawIdx      = 0xFFFFFFFFu;   // no AT3 stage table for skinned parts (alpha.frag sentinel)
    // MW near fog, same per-vertex form as opaque.vert (palette is already world-space).
    float dist = length(worldPos.xyz - gFrameData.eyePos.xyz);
    Out.Fog = saturate((gFrameData.fogParams.y - dist)
                       / (gFrameData.fogParams.y - gFrameData.fogParams.x));
    // Below-water clip (reflect pass only) — the skinned palette is already world-space, so worldPos
    // is in the same camera-relative space as the plane.
    Out.Clip = dot(gFrameData.gReflWaterClip.xyz, worldPos.xyz) + gFrameData.gReflWaterClip.w;
    RETURN(Out);
}
