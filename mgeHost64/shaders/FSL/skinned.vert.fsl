// mgeHost64 — M-Skinning skinned scene (vertex stage, GPU palette skinning).
//
// Reuses the opaque SRT (gFrameData viewProj + gBatch.worlds[] read as a 64KB BONE window)
// and the shared default.rootsig — NO new SRT, NO second root signature. There is no
// per-draw world matrix: the bone palette is already model->world. The per-INSTANCE Base
// attribute is this part's palette offset within the bound window (host sets it via
// firstInstance + the identity instance buffer, exactly like the static DrawIndex).
//
//   worldPos = Σ_j Weight[j] * mul(gBatch.worlds[Base + BoneIdx[j]], pos)
//   clip     = mul(gFrameData.viewProj, worldPos)              // reverse-Z viewProj (host-applied)
//   worldNrm = Σ_j Weight[j] * mul((float3x3)gBatch.worlds[Base + BoneIdx[j]], normal)
//
// Emits clip pos + world normal for the shared opaque.frag flat N.L shading.

#include "opaque.srt.h"

STRUCT(VSInput)
{
    DATA(float3, Position, POSITION);
    DATA(float3, Normal,   NORMAL);
    DATA(float4, Weights,  TEXCOORD0);
    DATA(uint4,  BoneIdx,  TEXCOORD1);   // R8G8B8A8_UINT: .x=idx0 .y=idx1 .z=idx2 .w=idx3
    DATA(uint,   Base,     TEXCOORD2);   // per-instance: palette offset in the bound window
    DATA(float2, Uv,       TEXCOORD3);   // per-vertex base-map UV
    DATA(uint,   TexAlpha, TEXCOORD4);   // per-instance packed: texIndex (low 16) | alphaRef*255 (bits 16-23)
};

STRUCT(VSOutput)
{
    DATA(float4,      Position, SV_Position);
    DATA(float3,      Normal,   NORMAL);
    DATA(float2,      Uv,       TEXCOORD0);   // base-map UV (shared opaque.frag)
    DATA(FLAT(uint),  TexIndex, TEXCOORD1);   // bindless base-map slot (0 = default white)
    DATA(float,       Fog,      TEXCOORD2);   // MW fog scalar (shared opaque.frag, matches opaque.vert)
    DATA(float4,      Color,    COLOR);       // Tier 2a: white (skinned VB has no vcol) → (d+a) fidelity
    DATA(float,       AlphaRef, TEXCOORD3);   // alpha-test ref 0..1 (shared opaque.frag; 0 = no test)
    DATA(FLAT(float3),MatDiffuse, TEXCOORD4); // Tier 2b: shared frag struct. Skinned has no captured
    DATA(FLAT(float3),MatAmbient, TEXCOORD5); // material yet → defaults below reduce the frag's
    DATA(FLAT(float3),MatEmissive,TEXCOORD6); // vColSource==2 branch to white*(d+a) = current fidelity.
    DATA(FLAT(uint),  VColSource, TEXCOORD7);
    DATA(float3,      WorldPos,   TEXCOORD8); // Tier 3a: world position for point-light eval
    DATA(FLAT(uint),  OverlayIndex,TEXCOORD9);// MUST match opaque.frag input sig; skinned = 0 (never terrain)
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN( VSInput In )
{
    INIT_MAIN;
    VSOutput Out;

    float4 pos = float4(In.Position, 1.0f);

    // Top-4 influences (manually unrolled — FSL-safe). Cbuffer matrices are column-major
    // (DXC default), so mul(M, v) with the D3DX bytes uploaded as-is == D3DX v*M (same
    // convention as opaque.vert). BoneIdx components map idx0..idx3 to the UBYTE4 byte
    // order (R=low byte), pairing with Weights.x..w.
    float4x4 b0 = gBatch.worlds[In.Base + In.BoneIdx.x];
    float4x4 b1 = gBatch.worlds[In.Base + In.BoneIdx.y];
    float4x4 b2 = gBatch.worlds[In.Base + In.BoneIdx.z];
    float4x4 b3 = gBatch.worlds[In.Base + In.BoneIdx.w];

    float4 worldPos = In.Weights.x * mul(b0, pos)
                    + In.Weights.y * mul(b1, pos)
                    + In.Weights.z * mul(b2, pos)
                    + In.Weights.w * mul(b3, pos);

    float3 worldNrm = In.Weights.x * mul((float3x3)b0, In.Normal)
                    + In.Weights.y * mul((float3x3)b1, In.Normal)
                    + In.Weights.z * mul((float3x3)b2, In.Normal)
                    + In.Weights.w * mul((float3x3)b3, In.Normal);

    Out.Position = mul(gFrameData.viewProj, worldPos);
    Out.Normal = worldNrm;
    Out.WorldPos = worldPos.xyz;   // Tier 3a: point lights evaluate in world space
    Out.Uv = In.Uv;
    // Unpack the per-instance texIndex (low 16) + alpha-test ref (bits 16-23, /255).
    Out.TexIndex = In.TexAlpha & 0xFFFFu;
    Out.AlphaRef = float((In.TexAlpha >> 16u) & 0xFFu) * (1.0f / 255.0f);
    Out.Color = float4(1.0f, 1.0f, 1.0f, 1.0f);
    // Tier 2b defaults: white vcol drives diffuse+ambient (vColSource 2), zero emissive →
    // frag computes white*(d+a) = current skinned fidelity. Per-part skinned material is a
    // later milestone (needs the skinned instance VB / wire extended like the static path).
    Out.MatDiffuse  = float3(1.0f, 1.0f, 1.0f);
    Out.MatAmbient  = float3(1.0f, 1.0f, 1.0f);
    Out.MatEmissive = float3(0.0f, 0.0f, 0.0f);
    Out.VColSource  = 2u;
    Out.OverlayIndex = 0u;   // skinned parts are never terrain — gates opaque.frag's decal splat off
    // MW near fog, same per-vertex form as opaque.vert (palette is already world-space).
    float dist = length(worldPos.xyz - gFrameData.eyePos.xyz);
    Out.Fog = saturate((gFrameData.fogParams.y - dist)
                       / (gFrameData.fogParams.y - gFrameData.fogParams.x));
    RETURN(Out);
}
