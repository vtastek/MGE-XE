// mgeHost64 — sky takeover (vertex stage).
//
// Model-space pos + base-map UV + per-vertex colour (binding 0) + a per-INSTANCE DrawIndex/
// TexAlpha (binding 1) that selects this shape's world from gBatch.worlds (ONE window, like
// multimap). Camera from gFrameData. Reuses the opaque GeomVertexWire layout (vl) + the same
// instance slots as opaque.vert, so SK2 reads the per-draw material WITHOUT a new vertex layout:
//   MatDiffuse (TEXCOORD3) = material diffuse rgb
//   vColSource (TexAlpha bits 24-25) = vertex-colour routing (dome/stars vs moon material)
//   matAlpha   (asfloat of the overlay slot TEXCOORD6) = per-element fade (star night / cloud).
// SK1 (the dome) had only DrawIndex/TexAlpha; the extra reads are inert for it (vColSource ≠ 0,
// matAlpha 1). No fog / no normal / no lighting — the sky is emissive.
//
// Shares opaque.srt.h / DefaultRootSignature + the same column-major / reverse-Z matrix
// convention as opaque.vert (the host post-multiplies viewProj by Z_rev before upload).

#include "opaque.srt.h"
#include "tonemap.h.fsl"    // (scenecolor.h.fsl's prerequisite; the curve is never called in a VS)
#include "linearize.h.fsl" // srgbToLinear() — the scene's transfer function (step 5)
#include "scenecolor.h.fsl" // decodeAuthored() — MW's authored colours enter the scene domain HERE

STRUCT(VSInput)
{
    DATA(float3, Position,  POSITION);
    DATA(float2, Uv,        TEXCOORD0);    // per-vertex: base-map UV (textured sky shapes, SK2)
    DATA(float4, Color,      COLOR);        // per-vertex: the dome's baked gradient (rgb + alpha)
    DATA(uint,   DrawIndex,  TEXCOORD1);    // per-instance: index into gBatch.worlds
    DATA(uint,   TexAlpha,   TEXCOORD2);    // per-instance packed: texIndex (16) | alphaRef*255 (8) | vColSource (24-25)
    DATA(float3, MatDiffuse, TEXCOORD3);    // per-instance: material diffuse rgb (SK2)
    DATA(float3, UvOff,      TEXCOORD4);    // per-instance: SK3 cloud scroll offset in .xy (matAmbient lane reused; .z 0)
    DATA(uint,   MatAlphaBits,TEXCOORD6);   // per-instance: matAlpha bit-cast (overlay slot reused; SK2)
};

STRUCT(VSOutput)
{
    DATA(float4,      Position, SV_Position);
    DATA(float2,      Uv,       TEXCOORD0);
    DATA(float4,      Color,    COLOR);
    DATA(FLAT(uint),  TexIndex, TEXCOORD1);
    DATA(FLAT(float3),MatDiffuse, TEXCOORD2);  // per-draw material rgb (FLAT = constant per draw)
    DATA(FLAT(uint),  VColSource, TEXCOORD3);  // 0 none (const material), 1 emissive, 2 diffamb, 3 host-gradient dome
    DATA(FLAT(float), MatAlpha,   TEXCOORD4);  // per-element fade (1 = no-op)
    DATA(float3,      WorldDir,  TEXCOORD5);   // camera-relative world position (C4: dome gradient direction, MW Z-up)
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN( VSInput In )
{
    INIT_MAIN;
    VSOutput Out;

    float4x4 world = gBatch.worlds[In.DrawIndex];
    float4 worldPos = mul(world, float4(In.Position, 1.0f));
    Out.Position = mul(gFrameData.viewProj, worldPos);
    // SK3 cloud scroll: MW rebakes the cloud UVs every frame but the VB shipped once — the
    // client ships the live-vs-uploaded diff instead; the wrap sampler handles the modulo.
    // Zero for every non-UV-animated sky shape.
    Out.Uv = In.Uv + In.UvOff.xy;
    // Step 5: MW's own per-vertex atmosphere colours and the moons' material colours are as authored
    // and display-referred as any other MW data — the sky is REPRODUCED, not generated (sky.frag's
    // opening note), which is exactly the class that has to be decoded. .a is coverage and stays.
    Out.Color = float4(decodeAuthored(In.Color.rgb), In.Color.a);
    Out.TexIndex = In.TexAlpha & 0xFFFFu;          // SK1 dome = 0 → host default white
    Out.VColSource = (In.TexAlpha >> 24u) & 0x3u;  // route vertex colour vs constant material
    Out.MatDiffuse = decodeAuthored(In.MatDiffuse);
    Out.MatAlpha = asfloat(In.MatAlphaBits);       // weather/night fade (overlay slot reused)
    // C4: the dome is camera-attached and shipped camera-relative (worldPos already -eye), so
    // worldPos.xyz IS the direction from the eye to this vertex. Pass it raw; the frag normalizes
    // (MW Z-up → .z is the vertical factor for the fog->zenith gradient). Inert for SK2 shapes.
    Out.WorldDir = worldPos.xyz;
    RETURN(Out);
}
