// mgeHost64 — THE PHYSICAL SKY: a fullscreen sample of the ATMOSPHERE's sky-view LUT.
// tasks/forge-atmosphere.md S2c (was forge-physical-sky.md P2, a Hosek-Wilkie closed form).
//
// This retires the dome. MW's sky was a MESH carrying 32 authored per-vertex atmosphere colours and
// a painted horizon band, and §0 measured what that costs: q = L_sky/(E_total/pi) = 0.265 against
// 0.122 for real clear skies (+1.13 stops), and a 2-colour vertical lerp that returns ONE number for
// the whole ring at a given elevation — where a real sky brightens up to 5x toward the sun and dips
// BELOW its own zenith 60-90 degrees away from it. P1 corrected the level with a multiply. P2
// replaced the reproduction with a GENERATOR, and the level stopped being something anyone sets.
//
// ⚠ S2 REPLACED THE GENERATOR WITH A MEDIUM, AND THE CHANGE HERE IS ONE SAMPLE, WHICH IS THE POINT.
// Hosek-Wilkie is a fit to CLEAR skies, ABOVE the horizon, returning radiance for a DIRECTION rather
// than along a RAY — so it could not do overcast, could not do twilight, could not do night, and,
// being a dome rather than a medium, could never make the sky and the fog the same colour by
// construction. All four were reported from play as separate defects. A participating medium closes
// them structurally instead of by tuning, and what arrives HERE is simply a texture sample: the
// sky-view LUT (atmos_skyview.comp), rebuilt every frame from MW's own live weather.
//
// ⚠⚠ AND THE SAME TEXTURE IS THE LIGHT. atmos_sh.comp projects THIS LUT into the SH that lights the
// world. The sky that used to be evaluated twice — C++ for the light, FSL for the pixels, kept
// honest by a startup cross-check — is now evaluated once and MEASURED. There is no second copy left
// to diverge, which is why hosek.h, hosek.h.fsl and hosekcheck.* are gone rather than retained.
//
// ⚠ NO liftInPass(), AND THAT IS THE POINT, NOT AN OMISSION. sky.frag is scenecolor.h.fsl CLASS 2 —
// it reproduces a value MW authored, so the frame's curve has to hand that value back untouched.
// This pass is CLASS 1/3: it MAKES UP radiance, in absolute units, with no authored target to
// preserve. It gets exposed and tone-mapped like every other lit surface, which is the entire
// difference between "a sky that is a display code" and "a sky that is light".
//
// ⚠ FULLSCREEN AND OPAQUE (alpha = 1 everywhere), which changes two contracts on purpose:
//   - gSkyColor, the snapshot every fog site melts into (skydome.h.fsl), now has alpha 1 across the
//     whole frame, so `s.rgb + fogColNear*(1-s.a)` collapses to `s.rgb`: fog melts into the REAL
//     sky in every direction instead of into fogColNear below the dome's old rim. Below the horizon
//     that copy used to be alpha 0, which is why the closed form had to CLAMP to the horizon there;
//     the medium returns the lit ground instead, and it is a better fog target than the clamp was.
//   - the present seam sees full host coverage in exteriors, so MW's own frame stops showing through
//     the band above the dome rim. waterfill.frag's above-water hole fill becomes a no-op there,
//     which is what it was written to survive ("the failure mode is the old image, not a wrong one").
//
// ⚠ THE RAY IS DIFFERENCED FROM TWO POINTS, AND THAT ARITHMETIC IS LOAD-BEARING — copied verbatim
// from waterfill.frag for the reason recorded there: under produce-mode-3 park the payload is
// emitted relative to bakeEye and the view is restamped, so the camera sits at (eyeNow - bakeEye),
// NOT at the origin. Normalising a single reconstructed point returns a ray tilted by
// delta_eye/distance — zero standing still, proportional to speed when moving. A difference cancels
// the origin, so the direction is exact without anyone having to know where the eye is.
// [[project_park_restamp_eye_origin]]
//
// ⚠ AND THE MATRIX IS gSkyView's, NOT gShadowParams'. gShadowParams is bound BY POINTER into every
// PerFrame set including the mirror's, so its invViewProj is always the MAIN view's — reconstructing
// from it in the reflect pass would paint the main view's sky into the water. skyview.h.fsl explains
// why that needed a second cbuffer.

#include "opaque.srt.h"
#include "atmosphere.h.fsl" // THE MEDIUM — one copy. See the warning at the top of that file.
#include "tonemap.h.fsl"    // the curve, for the display-referred (LDR) build
#include "linearize.h.fsl"  // linearToSrgb(), for the gamma-domain build
#include "scenecolor.h.fsl" // tonemapInPass()/sceneIsLinear() — which units the target wants
#include "waterfog.h.fsl"   // the sky is behind water too, exactly as sky.frag has to handle

STRUCT(VSOutput)
{
    DATA(float4, Position, SV_Position);
    DATA(float2, Uv,       TEXCOORD0);
};

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN(VSOutput In)
{
    INIT_MAIN;

    // TWO points on the SAME ray, differenced. 0.25/0.75 rather than 0/1: both stay clear of the
    // reverse-Z far plane, where w can reach 0. Reverse-Z puts the NEARER sample at the LARGER
    // device z, so the outward ray runs B -> A.
    //
    // In.Uv rather than In.Position.xy * invScreen (which is what waterfill uses): the fullscreen
    // triangle already carries the normalised screen coordinate, and it is identical to
    // (pixel + 0.5)/extent by construction. That matters here and did not there — this pass runs at
    // TWO different resolutions (the main target and the 1024^2 mirror) off one shader, and taking
    // the extent from a cbuffer would be one more thing that can be the wrong view's.
    float2 ndc = float2(In.Uv.x * 2.0f - 1.0f, 1.0f - In.Uv.y * 2.0f);
    float4 hpA = mul(gSkyView.invViewProj, float4(ndc, 0.25f, 1.0f));
    float4 hpB = mul(gSkyView.invViewProj, float4(ndc, 0.75f, 1.0f));
    float3 dir = normalize(hpA.xyz / hpA.w - hpB.xyz / hpB.w);

    // ─── ONE SAMPLE OF THE MEDIUM ────────────────────────────────────────────────────────────
    // The LUT is parameterised by the view's ZENITH ANGLE and its AZIMUTH RELATIVE TO THE SUN — the
    // medium is horizontally homogeneous, so those two coordinates carry the whole field and 192x108
    // texels are enough for a full-screen sky. atmosSkyViewUvFromDir does the projection, and it
    // lives in atmosphere.h.fsl beside the mapping the LUT was WRITTEN with, so the two cannot
    // disagree — which is the same "one definition" argument the whole file rests on.
    //
    // The camera radius rides gSkyView.sunDirW.w: the LUT was cooked at a specific altitude and the
    // deparameterisation needs that same radius, which this frag has no world position to derive.
    //
    // ⚠ BELOW THE HORIZON THIS IS A REAL ANSWER NOW, AND THAT IS A BEHAVIOUR CHANGE THIS PHASE OWNS.
    // Hosek INVERTED beneath the horizon (its c1 goes negative, so the exponent ran to +inf) and had
    // to be clamped to the horizon ring — which incidentally made that ring the fog target for
    // everything seen from above. The medium keeps integrating, hits the ground, and returns what
    // the ground actually looks like from here. gSkyColor is opaque everywhere, so this IS what
    // distant surfaces melt into: the control is "look down from a height" (skydome.h.fsl), and it
    // must show a horizon-haze-coloured ground rather than fading a downhill vista to black.
    float2 svUv = atmosSkyViewUvFromDir(gAtmosParams, gSkyView.sunDirW.w, dir);
    // ─── S2i: THE IMAGE DOES NOT GET THE LIGHT'S MEAN FIELD ──────────────────────────────────────
    // gAtmosSkyView is lerp(gap, deck, cover) — correct for the SH light, which integrates over
    // directions. It is wrong HERE, where one direction is sampled: a direction is cloud or gap and
    // never `cover` of both, so a 35%-cover cumulus day came out as a uniform 35% grey veil over the
    // whole sky, gaps included. That was "cloudy is washed out", and the gaps measured R/B 0.73
    // against a clear sky's 0.24.
    //
    // The clear arm rides its own LUT, and deckMix.z re-mixes: 0 draws the gap sky and lets MW's
    // cloud MESH supply the cloud (it is already anchored to the deck's radiance, sky.frag.fsl), 1
    // draws the mixed field for a deck that really is a closed lid. A lerp between the two fields
    // rather than a second lerp from the arms, so the cover=1 path is the byte-identical old one.
    float3 Lgap  = SampleLvlTex2D(gAtmosSkyViewClear, gSamplerBilinearClamp, svUv, 0).rgb;
    float3 Lmix  = SampleLvlTex2D(gAtmosSkyView,      gSamplerBilinearClamp, svUv, 0).rgb;
    float3 Lnative = lerp(Lgap, Lmix, saturate(gAtmosParams.deckMix.z));

    // Native W/(m^2 sr) -> SCENE units, with the strength lane already folded in host-side. A zero
    // scale here is LEGITIMATE (interior, feature off) and must read as a black sky.
    //
    // ⚠ THE NIGHT RAMP IS NO LONGER IN THIS LANE (S2e). It used to fade the drawn sky to black
    // because the closed form was undefined below the horizon; the medium computes twilight — ozone
    // is what makes it violet/indigo rather than muddy brown — and carries a moon and an airglow
    // floor, so there is nothing left for a fade to stand in for. The ramp's OTHER job, handing the
    // LIGHTING back to MW's authored night, is untouched and still runs host-side.
    float3 L = max(Lnative, f3(0.0f)) * gSkyView.radiance.w;

    // --- the sky is behind water too (W8) ----------------------------------------------------
    // Verbatim the gate and the reasoning sky.frag carries: the sky has no POSITION, only a
    // direction, and waterPathLength is homogeneous in the ray's length for both branches that
    // matter, so pushing it out 1e5 units is exact rather than a fudge. Gated on the camera being
    // SUBMERGED — above water a sky ray carries no water by construction.
    if (waterFogCameraSubmerged()) {
        float3 skyRel = dir * 1.0e5f;
        L = waterFogBlend(L, L, skyRel, waterFogSample(skyRel));
    }

    // Which units does the target want (scenecolor.h.fsl). L is genuine LINEAR radiance, so:
    // a gamma-domain target needs it encoded, and a display-referred target needs the curve applied
    // here because nothing downstream will. Both are no-ops on the shipped path (linear + scene-
    // referred), so this costs nothing and keeps the LDR build from showing a white sky.
    if (!sceneIsLinear()) { L = linearToSrgb(L); }
    L = tonemapInPass(L);

    // Alpha 1 unconditionally — see the gSkyColor note in the header. The sky pass PSO for this
    // draw has blending OFF, so this is a straight write and the value is not premultiplied by
    // anything.
    RETURN(float4(L, 1.0f));
}
