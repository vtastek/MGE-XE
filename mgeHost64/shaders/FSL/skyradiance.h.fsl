// mgeHost64 — THE DRAWN SKY'S RADIANCE IN ONE DIRECTION, native units. ONE COPY.
// (tasks/forge-atmosphere.md S2j)
//
// skyhw.frag draws this, the moon's shadow layer paints it, and every fogged surface melts toward it
// (skydome.h.fsl's fogHazeTarget). Three readers of one expression is exactly the case where one
// of them drifts: S2i taught the dome to re-mix the gap sky against the cover-mixed field, and the
// moon shadow kept sampling the mixed field alone, so under broken cloud its dark limb stopped
// matching the sky around it. Now none of them spells the sample out.
//
// ⚠ NOT IN atmosphere.h.fsl, AND ON PURPOSE. That header is included by the LUT cooks, which write
// gAtmosSkyView/gAtmosSkyViewClear/gAtmosTransmittance through their own SRT, so a function there
// that READS the PerFrame textures would not compile in the shaders that make them. This one needs opaque.srt.h
// (the textures + gAtmosParams) and atmosphere.h.fsl (the uv mapping), both included first.
#ifndef SKY_RADIANCE_H_FSL
#define SKY_RADIANCE_H_FSL

// `r` = the radius the sky-view LUT was cooked at (the camera's, in metres from the planet centre).
// Native W/(m^2 sr), clamped non-negative; the caller owns the native -> scene scale.
//
// S2i: gAtmosSkyView is lerp(gap, deck, cover), right for the SH light, which integrates over
// directions, and wrong for an image, where one direction is either cloud or gap. The clear arm rides
// its own LUT and deckMix.z re-mixes: 0 draws the gap sky and lets MW's cloud MESH supply the cloud,
// 1 draws the mixed field for a deck that really is a closed lid.
//
// ⚠ BELOW THE HORIZON THIS RETURNS THE HORIZON RING, NOT THE LUT'S LIT GROUND (S2j, 2026-09-23).
// The LUT's lower half is "air, then the ground at the end of the ray", and it is right for the SH
// light (atmos_sh reads the LUT directly, not through here). It is wrong as a FOG TARGET: a fogged
// fragment IS the surface at the end of its ray, so its ground term is the fragment's own shading,
// and what the fog adds on top is the air's in-scatter, whose saturated limit is the horizon haze.
// Used as-is it produced both reported defects at once: "horizon line is visible over statics" (the
// LUT steps from bright sky to dim lit ground across one texel row, and a static straddling the
// horizon wore that step) and "below horizon, water turns gray, doesn't match sky" (the sea melted
// into the lit ground). The dome draws through here too, so the snapshot (which the fog takes above
// the knee) and the haze (below it) keep agreeing below the horizon.
//
// Clamped in UV, not in angle: Hillaire's v axis splits at the camera's own horizon at exactly
// uv.y = 0.5 whatever the altitude, so the top sky row's centre is 0.5 - 0.5/H (H even; 108 ships).
// Clamping to a texel CENTRE keeps the bilinear tap off the ground row entirely.
//
// ⚠⚠ AND THE RING IS ENTERED AT THE SAME SCATTERING ANGLE, NOT THE SAME AZIMUTH (the "fan fog").
// Keeping the ray's own azimuth made every direction below the ring melt toward the horizon haze of
// its compass bearing, and all bearings meet at the NADIR: looking straight down in ash, the fog
// fanned out from the point under the camera, sun-side horizon on one side, anti-sun on the other.
// A saturated haze's radiance depends on the angle to the SUN (the phase function), not on the
// bearing. A horizontal ray toward the sun sits a few degrees from it; a vertical one sits at
// 90 deg + elevation on every bearing. So the ring's azimuth is solved from
//     cos(theta) = muRow*muS + sqrt(1-muRow^2) sqrt(1-muS^2) cos(phi)
// with theta the real ray's scattering angle and muRow the clamped row's own zenith cosine. That is
// the identity AT the row (no new seam where the clamp begins), and at the nadir it is one value for
// every bearing, which is what removes the fan. A theta the ring cannot reach (sun far below, or
// overhead) clamps to the nearest bearing that it can.
float3 atmosSkyRadianceNative(float3 dir, float r)
{
    float2 uv   = atmosSkyViewUvFromDir(gAtmosParams, r, dir);
    float  vRow = 0.5f - 0.5f / max(gAtmosParams.lutDims.y, 2.0f);
    if (uv.y > vRow)
    {
        uv.y = vRow;
        float muRow, unusedLvc;
        atmosSkyViewParams(gAtmosParams, float2(0.5f, vRow), r, muRow, unusedLvc);
        float3 toSun = gAtmosParams.sunDir.xyz;
        float3 d     = dir * rsqrt(max(dot(dir, dir), 1.0e-12f));   // fog's lifted dir is not unit
        float  den   = sqrt(max(0.0f, 1.0f - muRow * muRow))
                     * sqrt(max(0.0f, 1.0f - toSun.z * toSun.z));
        float  lvc   = (den > 1.0e-6f)
                     ? clamp((dot(d, toSun) - muRow * toSun.z) / den, -1.0f, 1.0f) : 1.0f;
        uv.x = atmosSkyViewUv(gAtmosParams, r, muRow, lvc).x;
    }
    float3 Lgap = SampleLvlTex2D(gAtmosSkyViewClear, gSamplerBilinearClamp, uv, 0).rgb;
    float3 Lmix = SampleLvlTex2D(gAtmosSkyView,      gSamplerBilinearClamp, uv, 0).rgb;
    return max(lerp(Lgap, Lmix, saturate(gAtmosParams.deckMix.z)), f3(0.0f));
}

// The unit direction ON THE GEOMETRIC HORIZON (z = 0) that sits at the same angle to the sun as the
// unit direction `d` — the bearing-free key the note above explains. For the fog's near-field lift
// (skydome.h.fsl), which raises a downward ray above the horizon and would otherwise carry the ray's
// own bearing up with it: that path, not the clamp, is what the ground right under the camera takes,
// so it needs the same key or the nadir still fans. The identity for any d already on the horizon,
// so the lift stays continuous where it starts. The side of the sun's vertical plane is kept; the
// LUT is symmetric in it, so which side is only a matter of keeping the vector continuous.
float3 atmosHorizonDirSameAngle(float3 d)
{
    float3 s   = gAtmosParams.sunDir.xyz;
    float  sH  = sqrt(max(0.0f, 1.0f - s.z * s.z));
    float3 dH  = float3(d.x, d.y, 0.0f);
    float  dHl = length(dH);
    if (!(sH > 1.0e-4f))    // sun overhead: every bearing is the same angle from it
        return (dHl > 1.0e-6f) ? (dH / dHl) : float3(1.0f, 0.0f, 0.0f);
    float3 sh   = float3(s.x, s.y, 0.0f) / sH;
    float3 side = float3(-sh.y, sh.x, 0.0f);
    float  cphi = clamp(dot(d, s) / sH, -1.0f, 1.0f);
    float  sphi = sqrt(max(0.0f, 1.0f - cphi * cphi)) * ((dot(dH, side) < 0.0f) ? -1.0f : 1.0f);
    return sh * cphi + side * sphi;
}

// THE SUN FLOOR: the unit direction at the SAME elevation as unit `d` whose angle to the sun is
// sqrt(theta^2 + thetaF^2) instead of theta. For fogHazeTarget (skydome.h.fsl), which must not hand
// an opaque surface the aerosol forward lobe: a fragment near the sun's direction stands between the
// eye and the sun, so the air in front of it is in its own shadow along those rays. See the host's
// g_fogHazeSunFloorDeg for the report this closes.
//
// Three choices, each against a specific artifact:
//   - ELEVATION IS KEPT and only the azimuth to the sun moves. Rotating in the (d, sun) plane instead
//     sends a direction just left of the sun to the left of the ring and one just right to the right,
//     and the ring's radiance varies with elevation — a pinwheel squeezed into the sun's disc. The
//     LUT is symmetric in the azimuth's sign, so the two sides of the sun's vertical plane sample the
//     same value at the centre: no seam. (It also keeps the near-field lift's elevation guarantee.)
//   - THE FLOOR IS SMOOTH, sqrt(theta^2 + thetaF^2), not max(theta, thetaF). A hard floor is a
//     constant plateau inside a gradient, and the kink draws a ring round the sun.
//   - Where no azimuth can reach the angle (sun or ray near the zenith), it clamps to the farthest
//     one, anti-sun. thetaF <= 0 returns d untouched — the A/B is exact.
float3 atmosSunFloorDir(float3 d, float thetaF)
{
    if (!(thetaF > 0.0f)) { return d; }
    float3 s   = gAtmosParams.sunDir.xyz;
    float  sH  = sqrt(max(0.0f, 1.0f - s.z * s.z));
    float  dHl = sqrt(max(0.0f, 1.0f - d.z * d.z));
    float  den = sH * dHl;
    if (!(den > 1.0e-4f)) { return d; }                 // sun or ray at the zenith: azimuth is moot
    float  th  = acos(clamp(dot(d, s), -1.0f, 1.0f));
    float  thF = min(sqrt(th * th + thetaF * thetaF), 3.14159265f);
    float  cphi = clamp((cos(thF) - d.z * s.z) / den, -1.0f, 1.0f);
    float  sphi = sqrt(max(0.0f, 1.0f - cphi * cphi));
    float3 sh   = float3(s.x, s.y, 0.0f) / sH;
    float3 side = float3(-sh.y, sh.x, 0.0f);
    if (dot(float3(d.x, d.y, 0.0f), side) < 0.0f) { sphi = -sphi; }
    return float3((sh * cphi + side * sphi).xy * dHl, d.z);
}

// THE SUN'S BEAM ON A HORIZONTAL SURFACE AT RADIUS r, per primary, native W/m^2 (S2j / sunsets).
// sky.frag's cloud layer is lit by this at the DECK's altitude instead of by the ground's E_total.
// At sunset the ground loses its direct beam first; a deck 1-2 km up is still in it, reddened, and
// stays in it for the ~1.2 degrees the horizon dips at that height. That afterglow is the drama.
//
// The beam term is atmos_sh.comp's E_sun, taken at r instead of at the camera: the air's transmittance
// times the cover-weighted deck share (the LUT's .a), for the same Jensen reason written there.
//
// ⚠ THE COSINE IS MEASURED FROM THE DECK'S OWN HORIZON, (mu - muH)/(1 - muH), not from its local
// horizontal plane. It reaches 0 exactly where the sun sets for that altitude and never before, and
// it is exactly 1 at the zenith, so a high sun lights the deck like the ground (noon is unchanged
// up to T(r)/T(ground), a few percent). Bruneton's LUT has no meaning for a ray that hits the ground,
// and the gate below keeps every lookup off that half of it.
float3 atmosSunBeamAt(float r)
{
    float mu  = gAtmosParams.sunDir.w;
    float muH = atmosHorizonCos(r, gAtmosParams.planet.x);
    if (!(mu > muH)) { return f3(0.0f); }
    float4 tr = SampleLvlTex2D(gAtmosTransmittance, gSamplerBilinearClamp,
                               atmosTransmittanceUv(gAtmosParams, r, mu), 0);
    float cosF = (mu - muH) / max(1.0f - muH, 1.0e-6f);
    return tr.rgb * lerp(1.0f, tr.a, saturate(gAtmosParams.deckMix.x)) * gAtmosParams.solar.xyz * cosF;
}

// ─── S3.5d: THE CLOUD LAYER INSIDE THE PHYSICAL SKY (tasks/forge-atmosphere.md) ──────────────────
// *"first bring the clouds into the physical sky. assign a virtual depth to cloud layer, and apply the
// sky ozone etc on it."* (user, 2026-10-14)
//
// MW's cloud mesh sits on the dome at no distance at all, so the air never touched it: a cloud at the
// horizon kept its full overhead level while the sky around it carried 100+ km of air. Here the layer
// is a SHELL at the deck's radius rc, and each texel is the point where the view ray meets it:
//   dist = -r mu + sqrt(r^2 mu^2 + (rc - r)(rc + r))    (rc^2 - r^2 factored: float32 at planet scale)
//   Tv   = T(r, mu) / T(rc, mu_c)                       (Bruneton's two-point transmittance; the
//                                                         clear air's .rgb: Rayleigh + Mie + ozone)
//   Lin  = L_sky * (1 - Tv) / (1 - T(r, mu))            (the share of the whole ray's in-scatter that
//                                                         the eye-to-deck segment holds, by optical
//                                                         depth; capped at L_sky)
//   seen = cloud * Tv + Lin
// Overhead the segment is ~1.5 km and the texture shows; at the horizon it is ~140 km and the layer
// melts into the sky behind it. rc never sits closer than radiance.z above the eye, so a low deck
// (Foggy's 50 m base) or a camera above it still gets a depth. radiance.y = the share (0 = off).
// SCENE units in and out.
float3 atmosCloudAerial(float3 dir, float3 Lc)
{
    float k = saturate(gSkyView.radiance.y);
    if (!(k > 0.0f)) { return Lc; }
    float3 d  = dir * rsqrt(max(dot(dir, dir), 1.0e-12f));
    float  r  = gSkyView.sunDirW.w;
    float  Rg = gAtmosParams.planet.x;
    float  rc = max(gSkyView.elemRadiance.w, r + max(gSkyView.radiance.z, 1.0f));
    float  mu = max(d.z, atmosHorizonCos(r, Rg) + 1.0e-4f);
    float  dist = -r * mu + sqrt(max(0.0f, r * r * mu * mu + (rc - r) * (rc + r)));
    float  muc  = clamp((r * mu + dist) / rc, -1.0f, 1.0f);
    float3 T0 = SampleLvlTex2D(gAtmosTransmittance, gSamplerBilinearClamp,
                               atmosTransmittanceUv(gAtmosParams, r, mu), 0).rgb;
    float3 Tc = SampleLvlTex2D(gAtmosTransmittance, gSamplerBilinearClamp,
                               atmosTransmittanceUv(gAtmosParams, rc, muc), 0).rgb;
    float3 Tv = saturate(T0 / max(Tc, f3(1.0e-6f)));
    float3 Ls = atmosSkyRadianceNative(d, r) * gSkyView.radiance.w;
    float3 Lin = min(Ls * (f3(1.0f) - Tv) / max(f3(1.0f) - T0, f3(1.0e-4f)), Ls);
    return lerp(Lc, Lc * Tv + Lin, k);
}

// ─── S3.5b SKY HAZE (tasks/forge-atmosphere.md) ──────────────────────────────────────────────────
// *"the cloud texture is the expected exposure. I wanted fog/haze thickness extinction to get that
// level and it is okay if thin top volume showed sky texture still."*
//
// A haze layer between the eye and everything the sky passes draw: L = L_behind*T + L_haze*(1-T).
//   T      = exp(-tauZ * exp(-h/H) * airmass(e)), airmass = 1/sqrt(sin^2 e + 1/M^2): thin overhead
//            (the sky texture shows), saturated at the horizon. h is the eye's altitude in the
//            medium, so climbing thins it. e < 0 counts as the horizon: the band between the eye plane
//            and the world's edge, which widens as the camera climbs, takes the haze's own value.
//   L_haze = the CLOUD anchor's luma (sky.frag's fully-lit texel) x level, in the HUE of the medium's
//            horizon at the same angle to the sun (sunsets keep their colour; the level is the clouds'),
//            or (S3.5c, hazeHue.w) in MW's own authored fog hue,
//            never brighter than that horizon itself (dusk: see the cap below).
// SCENE units in and out. tauZ = 0 returns L untouched: the pre-haze image.
//
// ⚠ ONE COPY OF THE PARAMETERS, IN gShadowParams.skyHaze0..2 (S3.4, 2026-10-15), NOT gSkyView. The fog
// melts statics toward the sky behind them (skydome.h.fsl fogHazeTarget), and while the haze lived on
// gSkyView — bound only on the sky passes' PerBatch set — the fog melted toward the UN-hazed horizon:
// *"Fog doesn't match, statics are colored one color, horizon is another."* (user, 2026-10-15). Every
// pass binds gShadowParams, so the sky, the clouds, the stars and the fog now read one haze. The
// caller supplies the eye's radius `r` (m) and the native -> scene `scale`, because the sky passes take
// them from gSkyView (per view) and the fog from gAtmosParams / gFrameData.
//   skyHaze0 = (tauZ, H m, horizon air mass M, level x the cloud anchor)
//   skyHaze1 = (MW fog hue xyz, luma 1; w = its share)
//   skyHaze2 = (anchor diffuse, beam scale, deck radius m, 0)
float atmosHazeTAt(float3 dir, float r)
{
    float4 h0   = gShadowParams.skyHaze0;
    float3 d    = dir * rsqrt(max(dot(dir, dir), 1.0e-12f));
    float  s    = max(d.z, 0.0f);
    float  M    = max(h0.z, 1.0f);
    float  h    = max(r - gAtmosParams.planet.x, 0.0f);
    float  am   = rsqrt(s * s + 1.0f / (M * M));
    return exp(-h0.x * exp(-h / max(h0.y, 1.0f)) * am);
}

float3 atmosHazeRadianceAt(float3 dir, float r, float scale)
{
    float4 h2 = gShadowParams.skyHaze2;
    float3 anchor = f3(h2.x);
    if (h2.y > 0.0f) {
        anchor += h2.y * atmosSunBeamAt(h2.z);
    }
    const float3 kY  = float3(0.2126f, 0.7152f, 0.0722f);
    float  lvl = dot(anchor, kY) * gShadowParams.skyHaze0.w;
    float3 d   = dir * rsqrt(max(dot(dir, dir), 1.0e-12f));
    float3 hz  = atmosSkyRadianceNative(atmosHorizonDirSameAngle(d), r);
    float  hl  = dot(hz, kY);
    // CAPPED at the un-hazed horizon itself: the haze only brings a horizon that is brighter than the
    // clouds DOWN to them. After sunset the cloud anchor (its night floor included) outshines the sky,
    // and uncapped the haze lifted the dusk sky 2.8x (nearfar @2700, 2026-10-14) — the wrong way, and
    // into the probes' sky, which dusk already reads too bright.
    lvl = min(lvl, hl * scale);
    if (!(hl > 1.0e-20f)) { return f3(0.0f); }
    // S3.5c: MW's authored horizon hue (luma 1) in place of the medium's, by skyHaze1.w.
    float4 h1  = gShadowParams.skyHaze1;
    float3 hue = lerp(hz / hl, h1.xyz, saturate(h1.w));
    return hue * lvl;
}

float3 atmosSkyHazedAt(float3 dir, float3 L, float r, float scale)
{
    if (!(gShadowParams.skyHaze0.x > 0.0f)) { return L; }
    float T = atmosHazeTAt(dir, r);
    return L * T + atmosHazeRadianceAt(dir, r, scale) * (1.0f - T);
}

// The sky passes' spellings: this view's eye radius and scale, from gSkyView.
float  atmosHazeOn()                         { return gShadowParams.skyHaze0.x; }
float  atmosHazeT(float3 dir)                { return atmosHazeTAt(dir, gSkyView.sunDirW.w); }
float3 atmosSkyHazed(float3 dir, float3 L)   { return atmosSkyHazedAt(dir, L, gSkyView.sunDirW.w, gSkyView.radiance.w); }

#endif // SKY_RADIANCE_H_FSL
