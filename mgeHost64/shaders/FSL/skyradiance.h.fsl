// mgeHost64 — THE DRAWN SKY'S RADIANCE IN ONE DIRECTION, native units. ONE COPY.
// (tasks/forge-atmosphere.md S2j)
//
// skyhw.frag draws this, the moon's shadow layer paints it, and every fogged surface melts toward it
// (skydome.h.fsl's fogHazeTarget). Three readers of one expression is exactly the case where one
// of them drifts: S2i taught the dome to re-mix the gap sky against the cover-mixed field, and the
// moon shadow kept sampling the mixed field alone, so under broken cloud its dark limb stopped
// matching the sky around it. Now none of them spells the sample out.
//
// ⚠ NOT IN atmosphere.h.fsl, AND ON PURPOSE. That header is included by the LUT cooks, which write
// gAtmosSkyView/gAtmosSkyViewClear/gAtmosTransmittance through their own SRT, so a function there
// that READS the PerFrame textures would not compile in the shaders that make them. This one needs opaque.srt.h
// (the textures + gAtmosParams) and atmosphere.h.fsl (the uv mapping), both included first.
#ifndef SKY_RADIANCE_H_FSL
#define SKY_RADIANCE_H_FSL

// `r` = the radius the sky-view LUT was cooked at (the camera's, in metres from the planet centre).
// Native W/(m^2 sr), clamped non-negative; the caller owns the native -> scene scale.
//
// S2i: gAtmosSkyView is lerp(gap, deck, cover), right for the SH light, which integrates over
// directions, and wrong for an image, where one direction is either cloud or gap. The clear arm rides
// its own LUT and deckMix.z re-mixes: 0 draws the gap sky and lets MW's cloud MESH supply the cloud,
// 1 draws the mixed field for a deck that really is a closed lid.
//
// ⚠ BELOW THE HORIZON THIS RETURNS THE HORIZON RING, NOT THE LUT'S LIT GROUND (S2j, 2026-09-23).
// The LUT's lower half is "air, then the ground at the end of the ray", and it is right for the SH
// light (atmos_sh reads the LUT directly, not through here). It is wrong as a FOG TARGET: a fogged
// fragment IS the surface at the end of its ray, so its ground term is the fragment's own shading,
// and what the fog adds on top is the air's in-scatter, whose saturated limit is the horizon haze.
// Used as-is it produced both reported defects at once: "horizon line is visible over statics" (the
// LUT steps from bright sky to dim lit ground across one texel row, and a static straddling the
// horizon wore that step) and "below horizon, water turns gray, doesn't match sky" (the sea melted
// into the lit ground). The dome draws through here too, so the snapshot (which the fog takes above
// the knee) and the haze (below it) keep agreeing below the horizon.
//
// Clamped in UV, not in angle: Hillaire's v axis splits at the camera's own horizon at exactly
// uv.y = 0.5 whatever the altitude, so the top sky row's centre is 0.5 - 0.5/H (H even; 108 ships).
// Clamping to a texel CENTRE keeps the bilinear tap off the ground row entirely.
//
// ⚠⚠ AND THE RING IS ENTERED AT THE SAME SCATTERING ANGLE, NOT THE SAME AZIMUTH (the "fan fog").
// Keeping the ray's own azimuth made every direction below the ring melt toward the horizon haze of
// its compass bearing, and all bearings meet at the NADIR: looking straight down in ash, the fog
// fanned out from the point under the camera, sun-side horizon on one side, anti-sun on the other.
// A saturated haze's radiance depends on the angle to the SUN (the phase function), not on the
// bearing. A horizontal ray toward the sun sits a few degrees from it; a vertical one sits at
// 90 deg + elevation on every bearing. So the ring's azimuth is solved from
//     cos(theta) = muRow*muS + sqrt(1-muRow^2) sqrt(1-muS^2) cos(phi)
// with theta the real ray's scattering angle and muRow the clamped row's own zenith cosine. That is
// the identity AT the row (no new seam where the clamp begins), and at the nadir it is one value for
// every bearing, which is what removes the fan. A theta the ring cannot reach (sun far below, or
// overhead) clamps to the nearest bearing that it can.
float3 atmosSkyRadianceNative(float3 dir, float r)
{
    float2 uv   = atmosSkyViewUvFromDir(gAtmosParams, r, dir);
    float  vRow = 0.5f - 0.5f / max(gAtmosParams.lutDims.y, 2.0f);
    if (uv.y > vRow)
    {
        uv.y = vRow;
        float muRow, unusedLvc;
        atmosSkyViewParams(gAtmosParams, float2(0.5f, vRow), r, muRow, unusedLvc);
        float3 toSun = gAtmosParams.sunDir.xyz;
        float3 d     = dir * rsqrt(max(dot(dir, dir), 1.0e-12f));   // fog's lifted dir is not unit
        float  den   = sqrt(max(0.0f, 1.0f - muRow * muRow))
                     * sqrt(max(0.0f, 1.0f - toSun.z * toSun.z));
        float  lvc   = (den > 1.0e-6f)
                     ? clamp((dot(d, toSun) - muRow * toSun.z) / den, -1.0f, 1.0f) : 1.0f;
        uv.x = atmosSkyViewUv(gAtmosParams, r, muRow, lvc).x;
    }
    float3 Lgap = SampleLvlTex2D(gAtmosSkyViewClear, gSamplerBilinearClamp, uv, 0).rgb;
    float3 Lmix = SampleLvlTex2D(gAtmosSkyView,      gSamplerBilinearClamp, uv, 0).rgb;
    return max(lerp(Lgap, Lmix, saturate(gAtmosParams.deckMix.z)), f3(0.0f));
}

// The unit direction ON THE GEOMETRIC HORIZON (z = 0) that sits at the same angle to the sun as the
// unit direction `d` — the bearing-free key the note above explains. For the fog's near-field lift
// (skydome.h.fsl), which raises a downward ray above the horizon and would otherwise carry the ray's
// own bearing up with it: that path, not the clamp, is what the ground right under the camera takes,
// so it needs the same key or the nadir still fans. The identity for any d already on the horizon,
// so the lift stays continuous where it starts. The side of the sun's vertical plane is kept; the
// LUT is symmetric in it, so which side is only a matter of keeping the vector continuous.
float3 atmosHorizonDirSameAngle(float3 d)
{
    float3 s   = gAtmosParams.sunDir.xyz;
    float  sH  = sqrt(max(0.0f, 1.0f - s.z * s.z));
    float3 dH  = float3(d.x, d.y, 0.0f);
    float  dHl = length(dH);
    if (!(sH > 1.0e-4f))    // sun overhead: every bearing is the same angle from it
        return (dHl > 1.0e-6f) ? (dH / dHl) : float3(1.0f, 0.0f, 0.0f);
    float3 sh   = float3(s.x, s.y, 0.0f) / sH;
    float3 side = float3(-sh.y, sh.x, 0.0f);
    float  cphi = clamp(dot(d, s) / sH, -1.0f, 1.0f);
    float  sphi = sqrt(max(0.0f, 1.0f - cphi * cphi)) * ((dot(dH, side) < 0.0f) ? -1.0f : 1.0f);
    return sh * cphi + side * sphi;
}

// THE SUN'S BEAM ON A HORIZONTAL SURFACE AT RADIUS r, per primary, native W/m^2 (S2j / sunsets).
// sky.frag's cloud layer is lit by this at the DECK's altitude instead of by the ground's E_total.
// At sunset the ground loses its direct beam first; a deck 1-2 km up is still in it, reddened, and
// stays in it for the ~1.2 degrees the horizon dips at that height. That afterglow is the drama.
//
// The beam term is atmos_sh.comp's E_sun, taken at r instead of at the camera: the air's transmittance
// times the cover-weighted deck share (the LUT's .a), for the same Jensen reason written there.
//
// ⚠ THE COSINE IS MEASURED FROM THE DECK'S OWN HORIZON, (mu - muH)/(1 - muH), not from its local
// horizontal plane. It reaches 0 exactly where the sun sets for that altitude and never before, and
// it is exactly 1 at the zenith, so a high sun lights the deck like the ground (noon is unchanged
// up to T(r)/T(ground), a few percent). Bruneton's LUT has no meaning for a ray that hits the ground,
// and the gate below keeps every lookup off that half of it.
float3 atmosSunBeamAt(float r)
{
    float mu  = gAtmosParams.sunDir.w;
    float muH = atmosHorizonCos(r, gAtmosParams.planet.x);
    if (!(mu > muH)) { return f3(0.0f); }
    float4 tr = SampleLvlTex2D(gAtmosTransmittance, gSamplerBilinearClamp,
                               atmosTransmittanceUv(gAtmosParams, r, mu), 0);
    float cosF = (mu - muH) / max(1.0f - muH, 1.0e-6f);
    return tr.rgb * lerp(1.0f, tr.a, saturate(gAtmosParams.deckMix.x)) * gAtmosParams.solar.xyz * cosF;
}

#endif // SKY_RADIANCE_H_FSL
