// mgeHost64 — Phase 1b distant STATICS (fragment stage, host-owned, GPU-driven).
//
// Faithful port of XE Mod Statics.fx::StaticPS: the per-subset texture is resolved host-side into
// gStaticsArrays[bucket] layer `layer` (TexIndex = (bucket<<16)|layer) — a descriptor-array of
// Texture2DArrays bucketed by (format, capped-size) so ALL distant-statics textures stay resident
// without overrunning the 1024 descriptor table (see opaque.srt.h / forgerender.cpp). Modulated by
// the per-vertex lit colour, then placeholder linear fog. Cutout statics (Flags bit1 = hasAlpha)
// alpha-test at MGE's 133/255 reference — the single-sample probe clips rather than the MSAA
// alpha-to-coverage StaticPS uses (calc_coverage); real A2C is a live-path (MSAA) refinement.

#include "opaque.srt.h"
#include "msmrecv.h.fsl"   // sunShadowVisibility() — MSM sun-shadow receiver
#include "skydome.h.fsl"   // applyFog() — extinguish into a silhouette, then melt into the SAMPLED sky

// Static semi-HDR tonemap — byte-identical to opaque.frag / distantland.frag::tonemap (XE
// FixedFuncEmu.fx). Applied to the final lit colour so the distant statics' point-light core rolls
// off the same as the near path (and the distant land, which also tonemaps). Maps 0->0, 1->0.84,
// clamps 2.2->1.0.
float3 tonemap(float3 c)
{
    c = clamp(c, 0.0f, 2.2f);
    c = (((0.0548303f * c - 0.189786f) * c - 0.154732f) * c + 1.12969f) * c;
    return c;
}

// MUST stay byte-identical to statics.vert.fsl's VSOutput, CENTROID modifiers included — see the
// long comment there for why Color/Fog are centroid (MSAA sliver extrapolation drove the lit colour
// negative / past 1.0; MGE's StatVertOut marks the same two).
STRUCT(VSOutput)
{
    DATA(float4,           Position, SV_Position);
    DATA(float2,           Uv,       TEXCOORD0);
    DATA(CENTROID(float4), Color,    COLOR);
    DATA(CENTROID(float),  Fog,      TEXCOORD1);
    DATA(FLAT(uint),       TexIndex, TEXCOORD2);
    DATA(FLAT(uint),       Flags,    TEXCOORD3);
    DATA(float3,           WorldPos, TEXCOORD4);
    DATA(float3,           WorldNormal, TEXCOORD5);   // Phase C: for the distant point-light loop
    DATA(CENTROID(float3), SunLight, TEXCOORD6);      // Phase B: the shadowable sun half of the lighting
};

ROOT_SIGNATURE(DefaultRootSignature)
float4 PS_MAIN( VSOutput In )
{
    INIT_MAIN;
    // TexIndex packs the bucket (which Texture2DArray) and the layer (slice within it). The bucket
    // is FLAT/coherent per draw (one EI subset = one texture), so this index is uniform — no divergence.
    uint bucket = In.TexIndex >> 16;
    uint layer  = In.TexIndex & 0xFFFFu;
    float4 tex = SampleTex2DArray(gStaticsArrays[bucket], gSamplerAnisotropic, float3(In.Uv, (float)layer));

    // Cutout alpha test (XE Mod Statics.fx ref 133/255). Only hasAlpha subsets test; opaque ones
    // never discard (stray low alpha is safe).
    if ((In.Flags & 0x2u) != 0u) {
        if (tex.a < (133.0f / 255.0f)) { discard; }
    }

    // Sun shadows (Phase B): statics.vert split its per-vertex lighting into Color (ambient +
    // emissive, never shadowed) and SunLight (the sun N.L term). Attenuating only the latter by the
    // MSM visibility is what keeps a shadowed static sitting in ambient instead of going black —
    // and vis == 1 reproduces the pre-split colour exactly.
    float sunVis = sunShadowVisibility(In.WorldPos, normalize(In.WorldNormal));
    float3 result = tex.rgb * (In.Color.rgb + In.SunLight * sunVis);

    // Phase C: baked DISTANT point lights (same camera-relative gLights set the distant land loops).
    // Statics carry their SUN+ambient per-vertex in Color; this ADDS point diffuse modulated by the
    // texture albedo (tex.rgb), matching the near opaque.frag evalOnePointLight form. Normal is the
    // interpolated world normal (re-normalized); positions are camera-relative like In.WorldPos.
    // Clustered forward: same froxel gate as distantland.frag — loop only this fragment's froxel
    // lights when active (froxelDims.x > 0), else the brute gLights loop. ONE inlined per-light body;
    // brute synthesizes full-word bitmasks so the result is byte-identical. Slice metric =
    // length(In.WorldPos), matching froxelassign.comp.
    {
        float3 N      = normalize(In.WorldNormal);
        uint   nL     = (uint)gLights.lightParams.x;
        float  reachK = gLights.lightParams.y;
        float3 pointDiffuse = float3(0.0f, 0.0f, 0.0f);
        int    tilesX = (int)gFrameData.froxelDims.x;
        bool   clustered = (tilesX > 0);
        uint   base = 0u;
        if (clustered)
        {
            int   tilesY = (int)gFrameData.froxelDims.y;
            int   NZ     = (int)gFrameData.froxelDims.z;
            float tile   = gFrameData.froxelDims.w;
            int tx = clamp((int)(In.Position.x / tile), 0, tilesX - 1);
            int ty = clamp((int)(In.Position.y / tile), 0, tilesY - 1);
            float dd = length(In.WorldPos);
            int zs = clamp((int)((log(max(dd, 1.0f)) - gFrameData.froxelZ.x) * gFrameData.froxelZ.y * (float)NZ), 0, NZ - 1);
            base = (((uint)ty * (uint)tilesX + (uint)tx) * (uint)NZ + (uint)zs) * 4u;
        }
        for (uint wi = 0u; wi < 4u; ++wi)
        {
            uint bits;
            if (clustered) {
                bits = gFroxelMask[base + wi];
            } else {
                uint lo = wi * 32u;
                uint cnt = (lo >= nL) ? 0u : min(32u, nL - lo);
                bits = (cnt >= 32u) ? 0xFFFFFFFFu : ((1u << cnt) - 1u);
            }
            while (bits != 0u)
            {
                uint i = wi * 32u + firstbitlow(bits);
                bits = bits & (bits - 1u);
                if (i >= nL) { continue; }
                float4 posR = gLights.lights[i * 3u + 0u];
                float3 lcol = gLights.lights[i * 3u + 1u].rgb;
                float3 fo   = gLights.lights[i * 3u + 2u].xyz;   // k0, k1, k2
                float  reach = posR.w * reachK;
                float3 toL  = posR.xyz - In.WorldPos;
                float  d2   = dot(toL, toL);
                if (d2 >= reach * reach) { continue; }
                float invD = rsqrt(max(d2, 1e-8f));
                float d    = d2 * invD;
                float att  = 1.0f / max(fo.z * d2 + fo.y * d + fo.x, 1e-4f);
                att *= 1.0f - smoothstep(POINT_LIGHT_TAIL * reach, reach, d);
                float lambert = saturate(dot(N, toL) * invD);
                pointDiffuse += lambert * att * lcol;
            }
        }
        result += tex.rgb * pointDiffuse;
    }

    // Match near + distant land: tonemap the final lit colour BEFORE fog so the point-light core
    // rolls off identically (opaque.frag order).
    result = tonemap(result);

    result = applyFog(result, In.WorldPos, In.Position.xy, In.Fog);

    // F12 distance grayscale parity (debugParams.x 1/2) with distantland.frag + opaque.frag.
    uint dbg = (uint)(gFrameData.debugParams.x + 0.5f);
    if (dbg == 1u || dbg == 2u) {
        float dist = length(In.WorldPos - gFrameData.eyePos.xyz);
        float g = saturate(dist * (1.0f / 8192.0f));
        RETURN(float4(g, g, g, 1.0f));
    }
    RETURN(float4(result, 1.0f));
}
