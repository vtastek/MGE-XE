// mgeHost64 — Phase 1b distant STATICS (vertex stage, host-owned, GPU-driven).
//
// Distant statics are loaded host-side (Data Files\distantland\statics\static_meshes = the unique
// mesh LIBRARY, usage.data = the placements) and drawn with instancing + bindless textures +
// execute-indirect — see tasks/forge-phase1.md and [[project_forge_dl_statics_format]]. Binding 0
// is the MGE StaticElem vertex (20 B: FLOAT16_4 pos, UBYTE4N normal{.w=emissive}, D3DCOLOR vcol,
// FLOAT16_2 uv). Binding 1 is the PER-INSTANCE stream: the object's world matrix (4 rows) + params
// (bindless texSlot, flags); cmdExecuteIndirect's StartInstanceLocation offsets into it per subset.
//
// Faithful port of XE Mod Statics.fx::StaticExteriorVS (transformStaticVert + lightStaticVert):
// per-VERTEX sun N.L + distant ambient + emissive, modulating the vertex colour. world = D3DX
// row-major, so worldPos = pos*M is the explicit row combination (convention-proof; the cbuffer
// viewProj keeps the column-major mul like opaque/distantland). Placeholder linear fog (1c = scatter).

#include "opaque.srt.h"

// Phase 4 hero-blend split. The SAME vertex body builds two containers: HERO_PASS 0 (the normal
// opaque statics draw) clips the hero-blend subsets offscreen; HERO_PASS 1 (the post-water blend
// draw) clips everything EXCEPT hero-blend. A subset is thus drawn in exactly one of the two passes,
// with no change to the GPU cull/scatter (it still scatters every subset into one instance stream;
// the two passes share it and each clips the half it doesn't own). flags bit5 (0x20) = hero-blend,
// set host-side on subsets with a NiAlphaProperty blend.
#ifndef HERO_PASS
#define HERO_PASS 0
#endif

STRUCT(VSInput)
{
    DATA(float4, Position, POSITION);    // FLOAT16_4 model pos (w = 1)
    DATA(float4, Normal,   NORMAL);      // UBYTE4N: xyz encoded normal, w = emissive
    DATA(float4, Color,    COLOR);       // D3DCOLOR per-vertex colour (B8G8R8A8 -> rgba)
    DATA(float2, Uv,       TEXCOORD0);   // FLOAT16_2 base-map UV
    // Per-instance (binding 1): the object's world matrix as 4 rows + packed params.
    DATA(float4, W0, TEXCOORD1);
    DATA(float4, W1, TEXCOORD2);
    DATA(float4, W2, TEXCOORD3);
    DATA(float4, W3, TEXCOORD4);
    DATA(float4, InstParams, TEXCOORD5); // x = packed texSlot (bucket<<16|layer), y = flags (bit1 = hasAlpha cutout)
};

// CENTROID on Color + Fog is REQUIRED, not cosmetic — MGE marks the same two (XE Common.fx
// StatVertOut: `centroid float4 color : COLOR0; centroid float4 fog : TEXCOORD0;`) and the port
// originally dropped it. Without centroid, a partially-covered MSAA pixel is shaded at the pixel
// CENTRE, which on a thin sliver triangle lies OUTSIDE the triangle, so its attributes are
// EXTRAPOLATED past the vertex range. Statics carry ALL their lighting in Color (per-vertex lit),
// so that overshoots >1 (blown white) or goes NEGATIVE (clamps to near-black) — verified in a
// RenderDoc pixel history. Land is immune (it lights per-pixel from a normal map), which is why
// only statics broke, and worst on thin/distant geometry where slivers dominate. Uv stays
// non-centroid, matching MGE (texcoords_range has no modifier there).
STRUCT(VSOutput)
{
    DATA(float4,           Position, SV_Position);
    DATA(float2,           Uv,       TEXCOORD0);
    DATA(CENTROID(float4), Color,    COLOR);     // per-vertex lit colour — MUST be centroid (see above)
    DATA(CENTROID(float),  Fog,      TEXCOORD1); // lerp factor — extrapolates out of [0,1] otherwise
    DATA(FLAT(uint),       TexIndex, TEXCOORD2);
    DATA(FLAT(uint),       Flags,    TEXCOORD3);
    DATA(float3,           WorldPos, TEXCOORD4); // F12 distance grayscale parity
    // Phase C: world-space normal for the distant point-light loop in statics.frag (statics carry
    // their SUN lighting per-vertex in Color, but a per-pixel normal is needed for point Lambert).
    // Also emitted by statics_heroblend.vert (HERO_PASS=1, same body); statics_blend.frag declares
    // the matching field so both frag signatures stay byte-identical to this VSOutput.
    DATA(float3,           WorldNormal, TEXCOORD5);
    // Sun shadows (forge-sun-shadows.md Phase B): the SUN half of the per-vertex lighting, split out
    // of Color so the frag can multiply it by the MSM sun visibility. Color keeps ambient + emissive
    // (never shadowed); Color + SunLight reproduces the pre-split value bit-for-bit when vis == 1.
    // CENTROID for the same sliver-extrapolation reason as Color — it IS part of that lighting.
    DATA(CENTROID(float3), SunLight, TEXCOORD6);
    // Real water reflection (WV2): below-water clip. Pass-all (0,0,0,1) in every non-reflect frame
    // cbuffer → Clip = 1 >= 0 (nothing clipped). Rasterizer system-value; no frag input, no PSO state.
    DATA(float,            Clip,     SV_ClipDistance0);
};

ROOT_SIGNATURE(DefaultRootSignature)
VSOutput VS_MAIN( VSInput In )
{
    INIT_MAIN;
    VSOutput Out;

    // worldPos = pos * M with M stored as 4 ROWS (W0..W3) in the instance stream — the explicit
    // row combination is identical to D3DX's row-vector pos*M regardless of HLSL matrix packing.
    float4 worldPos = In.Position.x * In.W0 + In.Position.y * In.W1
                    + In.Position.z * In.W2 + In.Position.w * In.W3;
    Out.WorldPos = worldPos.xyz;

    // Cbuffer viewProj is column-major (DXC default): mul(viewProj, worldPos) == worldPos*viewProj
    // (D3DX), the SAME reverse-Z mapping the near opaque + distant-land passes use (one depth).
    Out.Position = mul(gFrameData.viewProj, worldPos);

    // Lighting (XE Mod Statics.fx::lightStaticVert): decompress + world-transform the normal as a
    // direction (no post-normalise, matching MGE — distant statics use uniform scale), then
    // sun N.L + distant ambient + emissive, modulating the per-vertex colour.
    float3 n      = normalize(2.0f * In.Normal.xyz - 1.0f);
    float3 nWorld = n.x * In.W0.xyz + n.y * In.W1.xyz + n.z * In.W2.xyz;
    Out.WorldNormal = nWorld;   // Phase C: for the point-light Lambert in statics.frag (frag normalizes)
    float  emissive = In.Normal.w;
    // Phase B split: the SUN term rides its own interpolator so statics.frag can attenuate it by the
    // MSM sun visibility; ambient + emissive stay in Color (a shadow must never darken those). The
    // sum Color.rgb + SunLight is identical to the old single `light` product, so vis == 1 is a
    // byte-for-byte no-op against the pre-split image.
    float3 ambient = gFrameData.lodSunAmb.rgb + emissive;
    float3 sunlit  = gFrameData.sunCol.rgb * saturate(dot(nWorld, -gFrameData.sunDir.xyz));
    Out.Color    = float4(In.Color.rgb * ambient, In.Color.a);
    Out.SunLight = In.Color.rgb * sunlit;

    Out.TexIndex = (uint)(In.InstParams.x + 0.5f);
    Out.Flags    = (uint)(In.InstParams.y + 0.5f);

    // UV animation (XE Mod Statics.fx::texcoordsModifier). A subset whose source NIF carried an
    // NiUVController is flagged at bake time (static_meshes per-subset bool[2].uvCtrl -> flags bit2)
    // and scrolls its V at MGE's fixed rate — the approximation MGE uses for the ghostfence, whose
    // real controller we do not replay. gSamplerAnisotropic is WRAP, so V may run past 1 freely.
    // timeParams.x is MW SIM time already wrapped to [0,12.5) host-side, so 0.08*t is in [0,1) and
    // frac() is a formality — it is kept to mirror MGE's fmod(0.08*time, 1) exactly.
    Out.Uv = In.Uv;
    if ((Out.Flags & 0x4u) != 0u) {
        Out.Uv.y += frac(0.08f * gFrameData.timeParams.x);
    }
    // Hero UV animation (Phase 3): flags bits 16-23 = a 1-based anim slot. The host evaluates the
    // real NiUVController U/V keys of the ghostfence/lava layers per frame into gFrameData.uvOffsets,
    // so the shader just adds the float2 — no controller semantics leak in. Coexists with the legacy
    // 0.08 branch above (hero subsets carry no bit2; non-hero uvCtrl subsets carry no slot).
    uint animSlot = (Out.Flags >> 16) & 0xFFu;
    if (animSlot != 0u) {
        Out.Uv += gFrameData.uvOffsets[animSlot - 1u].xy;
    }

    // Placeholder distant fog (1c = atmospheric scatter), same linear ramp as distantland.vert so
    // statics + land read as one far mass.
    float dist = length(worldPos.xyz - gFrameData.eyePos.xyz);
    Out.Fog = saturate((gFrameData.fogParams.y - dist)
                       / (gFrameData.fogParams.y - gFrameData.fogParams.x));

    // Below-water clip (reflect-geo pass only): keep the above-water side of the water plane. worldPos
    // is camera-relative (statics are host-shifted by -eye), matching the plane. Pass-all elsewhere.
    Out.Clip = dot(gFrameData.gReflWaterClip.xyz, worldPos.xyz) + gFrameData.gReflWaterClip.w;

    // Phase 4 hero-blend split (see the HERO_PASS note up top). flags bit5 = hero-blend subset.
    // Clip the half this pass doesn't own offscreen (w kept 1, xy/z pushed way outside the guard
    // band → the triangle is frustum-culled, no rasterization/fragment cost).
    bool heroBlend = (Out.Flags & 0x20u) != 0u;
#if HERO_PASS
    if (!heroBlend) {
        Out.Position = float4(1e9f, 1e9f, 1e9f, 1.0f);   // blend pass: keep ONLY hero-blend
    } else {
        // Near/far HANDOVER (fixes the "second LOD at the edge" double). The NEAR path draws the real
        // fence within nearViewRange (lodParams.w); the distant statics near-cut carries a 768u slack
        // (forgerender nearCut = nearViewRange-768) so an OPAQUE mesh straddling the band never gaps.
        // For this translucent overlay that slack instead DOUBLE-composites the fence across the band:
        // alpha compounds (less transparent) + colour adds (brighter) + a ghost second copy appears at
        // the edge. A gap in a translucent overlay is invisible where a double is glaring, so clip the
        // blend pass at the FULL nearViewRange — the near real fence hands off with no overlap. The test
        // is PER-INSTANCE (the instance origin = W3.xyz, the -eye shifted translation row), NOT per-vertex:
        // a per-vertex distance test tears any triangle straddling the boundary (some verts pushed to 1e9,
        // the rest kept → one giant skewed triangle at garbage depth). length(W3.xy) is the same horizontal
        // camera distance the CPU/GPU cull uses (gi.posX-eye, gi.posY-eye), so the whole instance is kept
        // or clipped as a unit.
        float distXY = length(In.W3.xy);
        if (distXY < gFrameData.lodParams.w) { Out.Position = float4(1e9f, 1e9f, 1e9f, 1.0f); }
    }
#else
    // Opaque pass drops hero-blend ONLY when the blend pass is enabled (timeParams.y). Disabled =>
    // no clip here + the host skips the blend draw, so hero-blend falls back to drawing opaque
    // (a clean opaque<->blend A/B instead of the geometry vanishing).
    if (heroBlend && gFrameData.timeParams.y > 0.5f) { Out.Position = float4(1e9f, 1e9f, 1e9f, 1.0f); }
#endif
    RETURN(Out);
}
