// mgeHost64 — SUN shadow moments map for DL STATICS (the primary sun-caster proxy set).
//
// DL statics are the host-resident, GPU-instanced world proxy; drawn from the sun ortho VP they
// cast shadows into the near scene INCLUDING from off-screen (world-space, camera-independent) —
// exactly what the old DX9 system used as its shadow caster set. Near dynamics + missing pieces are
// submitted on top via the opaque.vert-paired sunshadow.frag. This variant pairs with statics.vert
// (its own vertex format / VSOutput), samples the statics bindless array, and applies the same
// 133/255 cutout statics.frag uses, then writes the 4 MSM moments from reverse-Z depth.
//
// VSOutput MUST stay byte-identical to statics.vert / statics.frag (centroid modifiers + the full
// field list, WorldNormal included) — a frag whose input doesn't match its paired vert's output
// hangs the GPU (see project_forge_shared_frag_vsoutput).

#include "opaque.srt.h"      // gStaticsArrays[], gSamplerAnisotropic, gFrameData
#include "msmpack.h.fsl"     // PackMoments()

// Stable dither for the grass caster's stochastic thinning. Keyed on UV — MESH data, so it cannot
// move with the camera. That matters more than it looks: the cascades are camera-centred, so a
// pattern keyed on the shadow-map pixel would swim across the world as you walk and the thinned
// shadow would crawl. UV is world-locked by construction. Same FNV-ish mixer the CPU scatter uses.
float grassShadowDither(float2 uv)
{
    uint2 q = (uint2)(abs(frac(uv)) * 4096.0f);
    uint  h = q.x * 73856093u ^ q.y * 19349663u;
    h ^= h >> 13; h *= 0x85EBCA6Bu; h ^= h >> 16;
    return (float)(h >> 8) * (1.0f / 16777216.0f);
}

STRUCT(VSOutput)
{
    DATA(float4,           Position,    SV_Position);
    DATA(float2,           Uv,          TEXCOORD0);
    DATA(CENTROID(float4), Color,       COLOR);
    DATA(CENTROID(float),  Fog,         TEXCOORD1);
    DATA(FLAT(uint),       TexIndex,    TEXCOORD2);
    DATA(FLAT(uint),       Flags,       TEXCOORD3);
    DATA(float3,           WorldPos,    TEXCOORD4);
    DATA(float3,           WorldNormal, TEXCOORD5);
    DATA(CENTROID(float3), SunLight,    TEXCOORD6);   // unused here; present to match statics.vert
};

STRUCT(PsOut)
{
    DATA(float4, moments, SV_Target0);
};

ROOT_SIGNATURE(DefaultRootSignature)
PsOut PS_MAIN( VSOutput In )
{
    INIT_MAIN;
    // Cutout statics (Flags bit1 = hasAlpha) test at MGE's 133/255 ref — MUST match statics.frag so
    // the shadow silhouette equals the drawn silhouette. Opaque subsets never discard.
    if ((In.Flags & 0x2u) != 0u) {
        uint bucket = In.TexIndex >> 16;
        uint layer  = In.TexIndex & 0xFFFFu;
        float4 tex = SampleTex2DArray(gStaticsArrays[bucket], gSamplerAnisotropic, float3(In.Uv, (float)layer));
        if (tex.a < (133.0f / 255.0f)) { discard; }
    }

    // ⚠ GRASS CASTS A THINNED, STOCHASTIC SHADOW (Flags bit8, set only by grass.vert). A dense
    // sward casting a SOLID silhouette carpets the ground it grows out of in flat darkness, which
    // is not what a grass canopy does — real grass transmits, and you see light and shadow THROUGH
    // it. So a fraction (1 - opacity) of the caster's fragments are dropped and the shadow map
    // records partial occlusion, which the moments blur and cascade 0's PCSS then filter into a
    // genuinely partial shadow.
    //
    // ⚠ IT HAS TO BE STOCHASTIC, because there is nothing to threshold. Measured over this bake's
    // groundcover atlases the alpha is BINARY — 84% at exactly 0, 16% at exactly 255, and ~0.1% in
    // between — so raising the caster's alpha reference from 133 to 200 removes 0.0% of the casting
    // area. The obvious "thin it by cutting higher" does literally nothing on this art.
    //
    // Only the GRASS lane sets bit8, so every distant static still casts exactly as before.
    if ((In.Flags & 0x100u) != 0u) {
        float op = gShadowParams.grassParams5.w;
        if (op < 0.999f && grassShadowDither(In.Uv) >= op) { discard; }
    }

    // Depth GROWS away from the sun (the ortho is reverse-Z), matching msmrecv.h.fsl's receiver.
    float  d = 1.0f - In.Position.z;
    PsOut Out;
    Out.moments = PackMoments(float4(d, d*d, d*d*d, d*d*d*d));
    RETURN(Out);
}
