// mgeHost64 — texture sampling helpers (FSL ONLY).
//
// These live here and NOT in opaque.srt.h because the HOST C++ also includes that header (it needs
// the SRT descriptor indices, with defaults.h supplying C++ versions of the STRUCT/DATA/BEGIN_SRT
// macros). A raw HLSL function in an .srt.h therefore breaks the C++ build. Same discipline as
// hizocclusion.h.fsl: shader-only code goes in a .h.fsl that C++ never sees.
//
// Include AFTER opaque.srt.h — needs gTextures, the static samplers, and gFrameData in scope.

// --- Per-mesh texture address mode (MW NiTexturingProperty::Map::clampMode) -----------------------
// MW authors meshes with a per-map address mode and the Forge path used to ignore it completely:
// EVERY draw sampled through gSamplerAnisotropic, which is anisotropic 8x REPEAT. Any mesh whose UVs
// run outside [0,1] and relies on CLAMP therefore TILED instead of holding its edge texel — the
// texture "kept going" past where the artist ended it (glaring on an alpha-tested cutout, which grew
// extra geometry out of the repeat). These four modes are MW's four, in MW's order, so the wire can
// ship the raw enum with no translation:
//   0 CLAMP_S_CLAMP_T   1 CLAMP_S_WRAP_T   2 WRAP_S_CLAMP_T   3 WRAP_S_WRAP_T (default)
// S = U, T = V. The clamp samplers are an MGE addition to the vendored The-Forge defaults.h — stock
// ships anisotropic in REPEAT only, so honouring clamp with matched filtering needed new statics.
//
// The branch is uniform across a draw (it comes from a FLAT per-draw lane), so it costs nothing.
// Decode lives HERE, once: a per-shader copy is how the wrap sampler survived in seven frags.
#define TEX_CLAMP_S_CLAMP_T 0u
#define TEX_CLAMP_S_WRAP_T  1u
#define TEX_WRAP_S_CLAMP_T  2u
#define TEX_WRAP_S_WRAP_T   3u

// --- Flip-book slices (NiFlipController) ---------------------------------------------------------
// A flip book claimed one bindless gTextures slot PER FRAME; a 300-frame book was a third of the
// whole residency. Books are uniform by construction (same format+size every frame), so they live
// in gFlipArrays: a descriptor-array of Texture2DArrays, one LAYER per frame. The slot encoding is
// shared verbatim with IPC::makeFlipSlot / the wire / packTexAlpha — one representation end to end,
// which is why no path needs an extra per-draw lane to say "this one is an array".
//   bit 15 = flip-array slice   bits 11..14 = bucket   bits 0..10 = layer
// Plain slots are < MAX_TEXTURES (880), so they can never collide with the flag.
#define FLIP_SLOT_FLAG   0x8000u
#define FLIP_LAYER_MASK  0x7FFu
bool isFlipSlot(uint texIdx) { return (texIdx & FLIP_SLOT_FLAG) != 0u; }

// clampMode arrives as the RAW ClampMode interpolator, which is a flag word, not just an address
// mode: bit2 = two-sided (alpha.frag), bit3 = enchanted-item glow (enchantglow.h.fsl). Mask to the
// two address bits HERE, once, in the two functions that actually sample. The comparisons below are
// equality tests with the last mode as the fallback, so an unmasked flag bit does not fail loudly —
// every compare simply misses and the draw silently samples WRAP no matter what MW authored. Doing
// it at the leaf means the next flag added to that word cannot reintroduce the bug in a caller that
// forgot to mask (alpha.frag masks its own; opaque.frag did not, and had no bits set to catch it).
#define TEX_ADDR_MASK 3u

float4 sampleFlip(uint texIdxIn, uint clampModeIn, float2 uv, bool lowAF)
{
    const uint texIdx    = texIdxIn;
    const uint clampMode = clampModeIn & TEX_ADDR_MASK;
    const uint bucket = (texIdx >> 11u) & (MAX_FLIP_BUCKETS - 1u);
    const float3 uvw  = float3(uv, (float)(texIdx & FLIP_LAYER_MASK));
    if (lowAF)
    {
        if (clampMode == TEX_CLAMP_S_CLAMP_T) { return SampleTex2DArray(gFlipArrays[bucket], gSampler2xClampClamp, uvw); }
        if (clampMode == TEX_CLAMP_S_WRAP_T)  { return SampleTex2DArray(gFlipArrays[bucket], gSampler2xClampWrap,  uvw); }
        if (clampMode == TEX_WRAP_S_CLAMP_T)  { return SampleTex2DArray(gFlipArrays[bucket], gSampler2xWrapClamp,  uvw); }
        return SampleTex2DArray(gFlipArrays[bucket], gSampler2xWrapWrap, uvw);
    }
    if (clampMode == TEX_CLAMP_S_CLAMP_T) { return SampleTex2DArray(gFlipArrays[bucket], gSamplerAnisoClampClamp, uvw); }
    if (clampMode == TEX_CLAMP_S_WRAP_T)  { return SampleTex2DArray(gFlipArrays[bucket], gSamplerAnisoClampWrap,  uvw); }
    if (clampMode == TEX_WRAP_S_CLAMP_T)  { return SampleTex2DArray(gFlipArrays[bucket], gSamplerAnisoWrapClamp,  uvw); }
    return SampleTex2DArray(gFlipArrays[bucket], gSamplerAnisotropic, uvw);
}

// lowAF: sample this draw at 2x anisotropy instead of 8x. The host sets it for ALPHA-TEST and
// ALPHA-BLENDED draws only (gFrameData.alphaParams.y, live A/B toggle) — those are the overdraw-
// and fetch-heavy part of the frame (foliage, grates, banners, glass) and they gain the least from
// high AF, so it is the cheapest AF to give back. Opaque geometry always keeps 8x. Both the address
// mode and the AF level are uniform per draw, so this whole chain is a uniform branch: free.
float4 sampleBase(uint texIdx, uint clampModeIn, float2 uv, bool lowAF)
{
    const uint clampMode = clampModeIn & TEX_ADDR_MASK;   // strip the flag bits (see TEX_ADDR_MASK)
    // Flip books route to gFlipArrays. texIdx is a FLAT per-draw lane, so this is as uniform as the
    // clamp/AF branches below and costs the same: nothing. Decoding ONCE here is the point — a
    // per-shader copy is how the wrap sampler survived in seven frags.
    if (isFlipSlot(texIdx)) { return sampleFlip(texIdx, clampMode, uv, lowAF); }
    if (lowAF)
    {
        if (clampMode == TEX_CLAMP_S_CLAMP_T) { return SampleTex2D(gTextures[texIdx], gSampler2xClampClamp, uv); }
        if (clampMode == TEX_CLAMP_S_WRAP_T)  { return SampleTex2D(gTextures[texIdx], gSampler2xClampWrap,  uv); }
        if (clampMode == TEX_WRAP_S_CLAMP_T)  { return SampleTex2D(gTextures[texIdx], gSampler2xWrapClamp,  uv); }
        return SampleTex2D(gTextures[texIdx], gSampler2xWrapWrap, uv);
    }
    if (clampMode == TEX_CLAMP_S_CLAMP_T) { return SampleTex2D(gTextures[texIdx], gSamplerAnisoClampClamp, uv); }
    if (clampMode == TEX_CLAMP_S_WRAP_T)  { return SampleTex2D(gTextures[texIdx], gSamplerAnisoClampWrap,  uv); }
    if (clampMode == TEX_WRAP_S_CLAMP_T)  { return SampleTex2D(gTextures[texIdx], gSamplerAnisoWrapClamp,  uv); }
    return SampleTex2D(gTextures[texIdx], gSamplerAnisotropic, uv);   // WRAP_S_WRAP_T — MW's default
}

// alphaParams.y = 1 when the host's "alpha draws at 2x AF" toggle is on. A draw qualifies if it is
// alpha-TESTED (alphaRef > 0 — cutout foliage/grates in the opaque + prepass + shadow paths) or it
// is in the alpha-BLENDED pass (which passes alphaBlended = true unconditionally).
bool useLowAF(float alphaRef, bool alphaBlended)
{
    return (gFrameData.alphaParams.y > 0.5f) && (alphaBlended || (alphaRef > 0.0f));
}
