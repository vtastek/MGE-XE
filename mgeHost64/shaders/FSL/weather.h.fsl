// mgeHost64 — WEATHER SURFACE STATE (receiver). The host integrates wetness and snow cover from MW's
// own precipitation counters over wall time and publishes them in gShadowParams.weatherState:
//   x = wetness 0..1, y = snow cover 0..1, z = wet darkening depth, w = snow albedo.
// Both are 0 in dry weather and indoors, so this is the identity there and the dry look is untouched.
//
// EXPOSURE is what makes it read as weather rather than a tint: rain and snow land on surfaces that
// FACE UP and are NOT COVERED. Covered = something stands above this point in gSkyHeight, the
// top-down max(terrain, statics) height map the sky occlusion already marches (one sample) — so the
// ground under an overhang, a balcony or a stilt-strider shell stays dry. Requires opaque.srt.h.
#ifndef WEATHER_H
#define WEATHER_H

float weatherCover(float3 worldPosRel)
{
    float4 m  = gShadowParams.skyAOMap;
    float2 uv = (worldPosRel.xy + gFrameData.lodEye.xy - m.xy) * m.z;
    if (any(uv < float2(0.0f, 0.0f)) || any(uv > float2(1.0f, 1.0f))) { return 0.0f; }
    float  h  = SampleLvlTex2D(gSkyHeight, gSamplerPointClamp, uv, 0.0f).r;
    float  z  = worldPosRel.z + gFrameData.lodEye.z;
    // Soft over 64 units above the point itself, so the surface that BUILT the max does not cover itself.
    return saturate((h - z - 48.0f) / 64.0f);
}

// How wet this exposed surface is, 0..1. Rain wets walls too (wind, splash), roofs and ground most.
float weatherWetness(float3 N, float3 worldPosRel)
{
    float w = gShadowParams.weatherState.x;
    if (w <= 0.0f) { return 0.0f; }
    return w * (1.0f - weatherCover(worldPosRel)) * saturate(0.35f + 0.65f * N.z);
}

// Wet darkening + snow on the albedo. N = the surface's geometric world normal. snowScale < 1 for
// alpha-tested foliage cards: a flat leaf card facing up would otherwise turn into a white silhouette.
void weatherApply(inout float3 albedo, float3 N, float3 worldPosRel, float snowScale)
{
    float4 w = gShadowParams.weatherState;
    if (w.x <= 0.0f && w.y <= 0.0f) { return; }
    float open  = 1.0f - weatherCover(worldPosRel);
    float wetE  = w.x * open * saturate(0.35f + 0.65f * N.z);
    float snowE = w.y * open * saturate((N.z - 0.35f) * 2.5f) * snowScale;
    albedo *= (1.0f - w.z * wetE);
    albedo  = lerp(albedo, float3(w.w, w.w, w.w * 1.04f), snowE);
}

// PUDDLES — standing water on flat, open ground, 0..1. Where it pools is a fixed world pattern (two
// octaves of value noise, ~3-6 m blobs) thresholded by the level: as rain goes on the blobs grow from
// their centres and merge, and they shrink back the same way as it drains. Flat only (N.z), so slopes
// shed the water. LOW-frequency by design: an edge every few metres, never per-pixel speckle.
float weatherHash(float2 p)
{
    p = frac(p * float2(127.1f, 311.7f));
    p += dot(p, p + 34.23f);
    return frac(p.x * p.y);
}
float weatherVnoise(float2 p)
{
    const float2 i = floor(p);
    const float2 f = frac(p);
    const float2 u = f * f * (3.0f - 2.0f * f);
    return lerp(lerp(weatherHash(i), weatherHash(i + float2(1.0f, 0.0f)), u.x),
                lerp(weatherHash(i + float2(0.0f, 1.0f)), weatherHash(i + float2(1.0f, 1.0f)), u.x), u.y);
}
float weatherPuddle(float3 N, float3 worldPosRel)
{
    const float lvl = gShadowParams.weatherState2.x;
    if (lvl <= 0.0f) { return 0.0f; }
    // Eye-relative + eye split (the eye folded mod the noise period first) so float32 keeps the fraction.
    const float  kScale = 1.0f / 420.0f;
    const float2 eyeT = frac(gFrameData.lodEye.xy * (kScale / 64.0f)) * 64.0f;
    const float2 p = worldPosRel.xy * kScale + eyeT;
    const float  n = 0.65f * weatherVnoise(p) + 0.35f * weatherVnoise(p * 2.3f + 17.1f);
    // Threshold falls as the level rises; max cover = the share of the noise range let under water.
    const float  thr = 1.0f - lvl * gShadowParams.weatherState2.y * 1.6f;
    const float  edge = 0.035f;
    float pud = smoothstep(thr - edge, thr + edge, n);
    pud *= smoothstep(0.94f, 0.985f, N.z) * (1.0f - weatherCover(worldPosRel));
    return pud;
}

// A wet surface's specular: water fills the micro-relief, so roughness falls toward a thin film's.
// Only where a PBR material exists to carry the lobe (terrain/statics/meshes with a _paramh).
float weatherRoughness(float rough, float3 N, float3 worldPosRel)
{
    float wetE = weatherWetness(N, worldPosRel);
    return lerp(rough, min(rough, 0.12f), wetE * 0.85f);
}
#endif // WEATHER_H
