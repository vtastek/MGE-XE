    const float bAmp = dot(bw, gSwParams.bodyAmp);
    const float sp = swSponge(id, d0);



    if (sp > 0.0f && eta + d0 >  0.25f )
    {
        const float relax = 1.0f - exp(-gSwParams.phys.w * dt * sp);
        eta = lerp(eta, swSwell(wC, cM).x * bAmp, relax);
    }


    if (bw.g > 0.02f && eta + d0 >  0.25f  && gSwParams.chop.z > 0.0f)
    {
        const float T = max(gSwParams.chop.w, 0.1f);
        const float ph = frac(gSwParams.origin.z / T);
        const float2 fl = swFlow(wC);
        const float2 p1 = (wC - fl * (ph * T)) / 70.0f;
        const float2 p2 = (wC - fl * (frac(ph + 0.5f) * T)) / 70.0f + 31.7f;
        const float wgt = abs(2.0f * ph - 1.0f);
        const float n = lerp(swNoise(p1), swNoise(p2), wgt) - 0.5f;
        const float tgt = gSwParams.chop.z * 2.0f * n;
        eta = lerp(eta, tgt, (1.0f - exp(-3.0f * dt)) * bw.g);
