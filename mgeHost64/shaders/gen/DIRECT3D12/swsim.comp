        const float b = LoadRWTex2D(gSwPrevD, clamp(i + int2(1, 0), int2(0, 0), int2(N1, N1))).w;
        const float c = LoadRWTex2D(gSwPrevD, clamp(i + int2(0, 1), int2(0, 0), int2(N1, N1))).w;
